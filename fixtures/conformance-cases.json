  "cliEnvelopeCases": [
    {
      "id": "inspect-valid",
      "input": {
        "invokedCommand": "inspect",
        "exitCode": 0,
        "output": {
          "schemaVersion": 4,
          "cliVersion": "8.0.0",
          "command": "inspect",
          "status": "valid",
          "result": {
            "page": {
              "cursor": null,
              "records": []
            }
          },
          "error": null
        }
      },
      "expected": "interpret-result"
    },
    {
      "id": "scope-valid",
      "input": {
        "invokedCommand": "scope",
        "exitCode": 0,
        "output": {
          "schemaVersion": 4,
          "cliVersion": "8.0.0",
          "command": "scope",
          "status": "valid",
          "result": {
            "relevant": true,
            "page": {
              "cursor": null,
              "records": []
            }
          },
          "error": null
        }
      },
      "expected": "interpret-result"
    },
    {
      "id": "content-valid",
      "input": {
        "invokedCommand": "content",
        "exitCode": 0,
        "output": {
          "schemaVersion": 4,
          "cliVersion": "8.0.0",
          "command": "content",
          "status": "valid",
          "result": {
            "chunk": {
              "content": "bounded"
            }
          },
          "error": null
        }
      },
      "expected": "interpret-result"
    },
    {
      "id": "schema-mismatch",
      "input": {
        "invokedCommand": "inspect",
        "exitCode": 0,
        "output": {
          "schemaVersion": 1,
          "cliVersion": "8.0.0",
          "command": "inspect",
          "status": "valid",
          "result": {},
          "error": null
        }
      },
      "expected": "reject-envelope",
      "scenario": "Inspect returns an otherwise plausible envelope using unsupported machine schema version 1."
    },
    {
      "id": "version-mismatch",
      "input": {
        "invokedCommand": "inspect",
        "exitCode": 0,
        "output": {
          "schemaVersion": 4,
          "cliVersion": "9.0.0",
          "command": "inspect",
          "status": "valid",
          "result": {},
          "error": null
        }
      },
      "expected": "reject-envelope",
      "scenario": "The machine envelope reports unsupported CLI 9.0.0 while the declared and installed root package is 8.0.0."
    },
    {
      "id": "command-mismatch",
      "input": {
        "invokedCommand": "inspect",
        "exitCode": 0,
        "output": {
          "schemaVersion": 4,
          "cliVersion": "8.0.0",
          "command": "validate",
          "status": "valid",
          "result": {},
          "error": null
        }
      },
      "expected": "reject-envelope"
    },
    {
      "id": "status-exit-mismatch",
      "input": {
        "invokedCommand": "inspect",
        "exitCode": 1,
        "output": {
          "schemaVersion": 4,
          "cliVersion": "8.0.0",
          "command": "inspect",
          "status": "valid",
          "result": {},
          "error": null
        }
      },
      "expected": "reject-envelope"
    },
    {
      "id": "inspect-content-leak",
      "input": {
        "invokedCommand": "inspect",
        "exitCode": 0,
        "output": {
          "schemaVersion": 4,
          "cliVersion": "8.0.0",
          "command": "inspect",
          "status": "valid",
          "result": {
            "page": {
              "cursor": null,
              "records": [
                {
                  "asset": {
                    "content": "not allowed"
                  }
                }
              ]
            }
          },
          "error": null
        }
      },
      "expected": "reject-envelope"
    },
    {
      "id": "invocation-too-large",
      "input": {
        "outputBytes": 1048577
      },
      "expected": "reject-output"
    },
    {
      "id": "ordinary-aggregate-too-large",
