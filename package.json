{
  "name": "@moldea.ai/skill-conformance",
  "version": "5.0.9",
  "private": true,
  "description": "Development-only conformance checks for the moldea Agent Skill.",
  "type": "module",
  "workspaces": [
    "qualification",
    "website"
  ],
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10.9.0"
  },
  "moldeaRelease": {
    "cliJsonSchemaVersion": 4,
    "coreVersionRange": "^4.0.1"
  },
  "scripts": {
    "docs:check": "npm --workspace website run docs:check",
    "docs:generate": "npm --workspace website run docs:generate",
    "eval:semantic": "node --experimental-strip-types tooling/evidence-identity/run-semantic-evaluation.mjs",
    "eval:semantic:diagnose": "node --experimental-strip-types tooling/evidence-identity/run-semantic-evaluation.mjs --diagnose-batch",
    "eval:semantic:identity": "node --experimental-strip-types tooling/evidence-identity/record-semantic-identity.mjs",
    "eval:semantic:preflight": "node --experimental-strip-types tests/semantic-evaluation-runner.mjs --preflight",
    "eval:semantic:verify": "node --experimental-strip-types tests/semantic-evaluation-runner.mjs --verify-attempts",
    "managed-readme:check": "node tooling/managed-readme/generate-portable.mjs --check",
    "managed-readme:generate": "node tooling/managed-readme/generate-portable.mjs",
    "matcher:check": "node tooling/relevance-gate/generate-matcher.mjs --check",
    "matcher:generate": "node tooling/relevance-gate/generate-matcher.mjs",
    "qualification": "npm --workspace qualification run qualification --",
    "qualification:dry-run": "npm --workspace qualification run qualification -- run --adapter custom --implementation custom --dry-run --json",
    "qualification:dry-run:all": "npm run qualification:dry-run && npm --workspace qualification run qualification -- run-batch --all --dry-run --workers 4 --json",
    "qualification:format:check": "npm --workspace qualification run format:check",
    "qualification:lint": "npm --workspace qualification run lint",
    "qualification:list": "npm --workspace qualification run qualification -- list",
    "qualification:test": "npm --workspace qualification test",
    "qualification:test:integration": "npm --workspace qualification run test:integration",
    "qualification:test:unit": "npm --workspace qualification run test:unit",
    "qualification:typecheck": "npm --workspace qualification run typecheck",
    "qualification:verify": "npm --workspace qualification run qualification -- verify",
    "path:check": "node tooling/path-portability/index.mjs",
    "resource:calibrate": "node tooling/resource-calibration/index.mjs --record --samples 3",
    "resource:check": "node tooling/resource-calibration/index.mjs --check",
    "release:check": "npm run managed-readme:check && npm run matcher:check && npm test && node --experimental-strip-types tooling/release-identity/check-release.mjs",
    "release:evidence:pin": "node --experimental-strip-types tooling/release-identity/pin-evidence.mjs",
    "release:evidence:record": "node --experimental-strip-types tooling/release-identity/record-evidence.mjs",
    "release:identity:check": "node --experimental-strip-types tooling/release-identity/check-release.mjs --identity-only",
    "release:update-cli": "node tooling/release-identity/update-cli.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test tooling/*/*.test-unit.mjs tests/*.test-unit.mjs",
    "test:integration": "node --experimental-strip-types --test tooling/*/*.test-integration.mjs tests/*.test-integration.mjs",
    "website:build": "npm --workspace website run build",
    "website:check": "npm --workspace website run check",
    "website:dev": "npm --workspace website run dev"
  },
  "devDependencies": {
    "@moldea.ai/cli": "8.0.0",
    "esbuild": "0.28.2",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  }
}
