{
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@moldea.ai/cli": "13.0.2",
    "@moldea.ai/website-ui": "4.5.3",
    "@types/node": "22.20.1",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "jg-crypto": "0.3.0",
    "jg-exception": "1.7.1",
    "jg-fs": "1.7.0",
    "jg-git-commands": "0.4.0",
    "jg-plans": "0.3.0",
    "jg-process": "1.6.2",
    "jg-utilities": "1.7.2",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "moldeaRelease": {
    "cliJsonSchemaVersion": 7,
    "cliVersionRange": "^13.0.0",
    "coreVersionRange": "^9.0.0"
  },
  "version": "10.0.3",
  "name": "@moldea.ai/skill-conformance",
  "private": true,
  "description": "Development-only conformance checks for the moldea Agent Skill.",
  "type": "module",
  "workspaces": [
    "website"
  ],
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "candidate:prepare": "node src/packages/skill-candidate.ts",
    "docs:check": "npm --workspace website run docs:check",
    "docs:generate": "npm --workspace website run docs:generate",
    "evidence:pack": "node src/command-line/evidence.ts pack",
    "evidence:prepare": "node src/command-line/evidence.ts prepare",
    "evidence:publish": "node src/command-line/evidence.ts publish",
    "eval:journeys": "node src/scripted-journeys/command-line/runner.ts",
    "eval:semantic": "node src/semantic/command-line/runner.ts",
    "eval:semantic:diagnose": "node src/semantic/command-line/runner.ts --diagnose-batch",
    "eval:semantic:compose": "node src/semantic/command-line/compose.ts",
    "eval:semantic:identity": "node src/semantic/command-line/runner.ts --preflight",
    "eval:semantic:preflight": "node src/semantic/command-line/runner.ts --preflight",
    "eval:semantic:verify": "node src/semantic/command-line/runner.ts --verify-attempts",
    "format": "prettier --write --config .prettierrc package.json tsconfig.base.json tsconfig.json tsconfig.test.json eslint.config.ts vitest src",
    "format:check": "prettier --check --config .prettierrc package.json tsconfig.base.json tsconfig.json tsconfig.test.json eslint.config.ts vitest src",
    "lint": "eslint --flag unstable_native_nodejs_ts_config eslint.config.ts vitest src",
    "managed-readme:check": "npm run portable:check",
    "managed-readme:generate": "npm run portable:generate",
    "matcher:check": "npm run portable:check",
    "matcher:generate": "npm run portable:generate",
    "path:check": "node src/paths/check.ts",
    "portable:check": "node src/portable/generate.ts --check",
    "portable:generate": "node src/portable/generate.ts",
    "resource:calibrate": "node src/resources/calibrate.ts --record --samples 3",
    "resource:check": "node src/resources/calibrate.ts --check",
    "release:check": "npm run portable:check && npm test && node src/release/check.ts",
    "release:evidence:pin": "node src/command-line/evidence.ts pin",
    "release:identity:check": "node src/release/check.ts --identity-only",
    "release:update-cli": "node src/release/update-cli.ts",
    "runtime:build": "node src/portable/runtime-build.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:e2e": "npm --workspace website run test:e2e",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "test:integration": "vitest run --config vitest/test-integration.config.ts",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:root && npm --workspace website run typecheck",
    "website:build": "npm --workspace website run build",
    "website:check": "npm --workspace website run check",
    "website:dev": "npm --workspace website run dev"
  }
}
