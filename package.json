{
  "name": "@moldea.ai/skill-conformance",
  "version": "3.1.0",
  "private": true,
  "description": "Development-only conformance checks for the moldea Agent Skill.",
  "type": "module",
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  },
  "moldeaRelease": {
    "cliJsonSchemaVersion": 2
  },
  "scripts": {
    "docs:check": "npm --prefix website run docs:check",
    "docs:generate": "npm --prefix website run docs:generate",
    "eval:semantic": "node tests/semantic-evaluation-runner.mjs",
    "qualification": "npm --prefix qualification run qualification --",
    "qualification:dry-run": "npm --prefix qualification run qualification -- run --adapter custom --implementation custom --dry-run --json",
    "qualification:format:check": "npm --prefix qualification run format:check",
    "qualification:lint": "npm --prefix qualification run lint",
    "qualification:list": "npm --prefix qualification run qualification -- list",
    "qualification:test": "npm --prefix qualification test",
    "qualification:test:integration": "npm --prefix qualification run test:integration",
    "qualification:test:unit": "npm --prefix qualification run test:unit",
    "qualification:typecheck": "npm --prefix qualification run typecheck",
    "qualification:verify": "npm --prefix qualification run qualification -- verify",
    "release:check": "npm test && npm run qualification:verify && node tooling/release-identity/check-release.mjs",
    "release:identity:check": "node tooling/release-identity/check-release.mjs --identity-only",
    "release:update-cli": "node tooling/release-identity/update-cli.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tooling/*/*.test-unit.mjs tests/*.test-unit.mjs",
    "test:integration": "node --test tooling/*/*.test-integration.mjs tests/*.test-integration.mjs",
    "website:build": "npm --prefix website run build",
    "website:check": "npm --prefix website run check",
    "website:dev": "npm --prefix website run dev"
  },
  "devDependencies": {
    "@moldea.ai/cli": "4.0.0",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  }
}
