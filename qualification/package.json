{
  "name": "@moldea.ai/adapter-qualification",
  "version": "0.0.0",
  "private": true,
  "description": "Local adapter support qualification for the moldea Agent Skill.",
  "type": "module",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10.9.0 <12.0.0"
  },
  "scripts": {
    "format": "prettier --write --config .prettierrc . ../tooling/package-candidate/index.d.mts ../tooling/codex-evaluation-host/host.mjs ../tooling/codex-evaluation-host/host.test-unit.mjs ../tooling/codex-evaluation-host/host.test-integration.mjs ../tooling/codex-evaluation-host/index.d.mts ../README.md ../package.json",
    "format:check": "prettier --check --config .prettierrc . ../tooling/package-candidate/index.d.mts ../tooling/codex-evaluation-host/host.mjs ../tooling/codex-evaluation-host/host.test-unit.mjs ../tooling/codex-evaluation-host/host.test-integration.mjs ../tooling/codex-evaluation-host/index.d.mts ../README.md ../package.json",
    "lint": "eslint eslint.config.js profiles src vitest",
    "qualification": "node src/bin/index.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "vitest run --config vitest/test-integration.config.ts",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "8.4.1",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
