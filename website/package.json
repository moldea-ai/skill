{
  "name": "@moldea.ai/skill-website",
  "version": "0.0.0",
  "description": "The private static documentation application for the moldea Agent Skill.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10.9.0 <12.0.0"
  },
  "scripts": {
    "build": "node scripts/generate.ts && astro build && node scripts/verify-build.ts",
    "check": "npm run docs:check && npm run test:unit && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:integration:artifact",
    "dev": "node scripts/generate.ts && astro dev",
    "docs:check": "node scripts/check.ts",
    "docs:generate": "node scripts/generate.ts",
    "format": "prettier --write --config .prettierrc . ../docs ../README.md ../package.json ../.github/workflows/website.yml ../.github/workflows/pages.yml",
    "format:check": "prettier --check --config .prettierrc . ../docs ../README.md ../package.json ../.github/workflows/website.yml ../.github/workflows/pages.yml",
    "lint": "eslint astro.config.ts eslint.config.js playwright.config.ts scripts src vitest",
    "preview": "vite preview --base / --host 127.0.0.1 --port 4321 --strictPort",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:integration": "npm run build && npm run test:integration:artifact",
    "test:integration:artifact": "vitest run --config vitest/test-integration.config.ts",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "typecheck": "node scripts/generate.ts && astro check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/ubuntu-sans": "5.2.10",
    "@lucide/astro": "1.31.0",
    "@playwright/test": "1.62.1",
    "@shikijs/rehype": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "astro": "7.2.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "unified": "11.0.5",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  }
}
