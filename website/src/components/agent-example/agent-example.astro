---
import { UserRound } from '@lucide/astro';
import Conversation from '@moldea.ai/website-ui/conversation';
import ConversationMessage from '@moldea.ai/website-ui/conversation-message';
import { withBase } from '@moldea.ai/website-ui/site';

import AgentArtifacts from '../agent-artifacts/agent-artifacts.astro';

const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<article
  class="min-w-0"
  aria-label="Illustrative support agent project"
  data-agent-example
>
  <Conversation ariaLabel="Developer and coding agent conversation">
    <ConversationMessage role="user">
      <span
        slot="avatar"
        class="inline-flex size-8 items-center justify-center rounded-xl bg-primary text-primary-foreground"
        aria-hidden="true"
        ><UserRound class="size-4" /></span
      >
      <p
        class="text-sm leading-6 font-medium"
        data-user-request
      >
        Create a <code class="inline-code">support</code> agent using our refund policy and existing order
        lookup.
      </p>
    </ConversationMessage>
    <ConversationMessage role="assistant">
      <img
        slot="avatar"
        src={skillMarkPath}
        width="207"
        height="215"
        alt=""
        class="dark:invert"
        data-agent-response-mark
      />
      <div
        class="min-w-0"
        data-agent-response
        data-agent-response-card
      >
        <p
          class="mb-4 text-sm leading-6 font-medium"
          data-agent-message
        >
          I created the <code class="inline-code">support</code> agent and connected everything it needs.
        </p>
        <AgentArtifacts />
      </div>
    </ConversationMessage>
  </Conversation>
</article>
