---
import { Bot, Check, FileCode, FileText, Link2, MessageSquareText } from '@lucide/astro';
import Accordion from '@moldea.ai/website-ui/accordion';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import TabbedPanels from '@moldea.ai/website-ui/tabbed-panels';

import {
  getLandingExampleFile,
  LANDING_EXAMPLE,
  LANDING_EXAMPLE_INITIAL_FILES,
} from '../../lib/landing-example/index.ts';

const SOURCE_TABS = [
  { id: 'agent-code', label: 'Agent code', slotName: 'agent-code' },
  { id: 'instructions', label: 'Instructions', slotName: 'instructions' },
  { id: 'connections', label: 'Connections', slotName: 'connections' },
] as const;
const agentSource = getLandingExampleFile(
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE.paths.agent,
);
const instructionSource = getLandingExampleFile(
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE.paths.instruction,
);
const manifestSource = getLandingExampleFile(
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE.paths.manifest,
);
---

<article
  class="overflow-hidden rounded-2xl border border-border bg-background shadow-raised"
  aria-label="Illustrative support agent project"
  data-agent-example
>
  <header
    class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3 sm:px-6"
  >
    <div class="flex items-center gap-3">
      <span class="inline-flex size-8 items-center justify-center rounded-lg bg-muted">
        <Bot
          class="size-4"
          aria-hidden="true"
        />
      </span>
      <p class="text-sm font-semibold">Illustrative project</p>
    </div>
    <p class="hidden font-mono text-xs text-muted-foreground sm:block">support agent</p>
  </header>

  <ol
    class="grid px-4 sm:px-6 md:grid-cols-4 md:px-0"
    aria-label="From request to checked agent"
    data-agent-example-sequence
  >
    <li class="relative border-b border-border py-5 md:border-e md:border-b-0 md:px-5 md:py-6">
      <div
        class="mb-4 flex items-center gap-2 text-xs font-bold tracking-wide text-muted-foreground uppercase"
      >
        <MessageSquareText
          class="size-4"
          aria-hidden="true"
        />
        Your request
      </div>
      <p class="text-sm leading-6 font-semibold">
        {LANDING_EXAMPLE.request}
      </p>
    </li>

    <li class="relative border-b border-border py-5 md:border-e md:border-b-0 md:px-5 md:py-6">
      <div
        class="mb-4 flex items-center gap-2 text-xs font-bold tracking-wide text-muted-foreground uppercase"
      >
        <FileText
          class="size-4"
          aria-hidden="true"
        />
        From your project
      </div>
      <ul class="grid gap-2 text-sm leading-5">
        <li><strong>Refunds:</strong> within 30 days</li>
        <li><strong>App rule:</strong> decides eligibility</li>
        <li><strong>Tool:</strong> existing order lookup</li>
      </ul>
    </li>

    <li class="relative border-b border-border py-5 md:border-e md:border-b-0 md:px-5 md:py-6">
      <div
        class="mb-4 flex items-center gap-2 text-xs font-bold tracking-wide text-muted-foreground uppercase"
      >
        <FileCode
          class="size-4"
          aria-hidden="true"
        />
        Your coding agent builds
      </div>
      <ul class="grid gap-2 font-mono text-xs leading-5">
        <li><strong class="font-sans">Model:</strong> <code>{LANDING_EXAMPLE.model}</code></li>
        <li><strong class="font-sans">Instructions:</strong> <code>instruction.md</code></li>
        <li><strong class="font-sans">Agent code:</strong> <code>src/agent.ts</code></li>
        <li><strong class="font-sans">Connections:</strong> <code>moldea.yaml</code></li>
      </ul>
    </li>

    <li class="py-5 md:px-5 md:py-6">
      <div
        class="mb-4 flex items-center gap-2 text-xs font-bold tracking-wide text-muted-foreground uppercase"
      >
        <Link2
          class="size-4"
          aria-hidden="true"
        />
        Software checks
      </div>
      <div class="flex gap-3">
        <span
          class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-success/15 text-success"
        >
          <Check
            class="size-4"
            aria-hidden="true"
          />
        </span>
        <div>
          <p class="text-sm font-semibold">Instructions connected.</p>
          <p class="mt-1 text-xs leading-5 text-muted-foreground">
            The code connects the saved instructions to the agent. Checked without a model call.
          </p>
        </div>
      </div>
    </li>
  </ol>

  <div class="border-t border-border px-3 py-2 sm:px-5 sm:py-4">
    <Accordion
      group="landing-agent-source"
      id="landing-agent-source"
      title="Inspect the files"
      description="The source behind this example is tested with the real local toolchain."
    >
      <div class="border-t border-border pt-5">
        <TabbedPanels
          ariaLabel="Illustrative project files"
          id="landing-agent-files"
          items={SOURCE_TABS}
        >
          <div
            slot="agent-code"
            class="max-h-72 overflow-auto rounded-xl border border-border bg-code p-4"
          >
            <CodeBlock
              copyable={false}
              language="typescript"
              source={agentSource}
              variant="plain"
            />
          </div>
          <div
            slot="instructions"
            class="max-h-72 overflow-auto rounded-xl border border-border bg-code p-4"
          >
            <CodeBlock
              copyable={false}
              language="markdown"
              source={instructionSource}
              variant="plain"
            />
          </div>
          <div
            slot="connections"
            class="max-h-72 overflow-auto rounded-xl border border-border bg-code p-4"
          >
            <CodeBlock
              copyable={false}
              language="yaml"
              source={manifestSource}
              variant="plain"
            />
          </div>
        </TabbedPanels>
        <p class="mt-4 text-xs leading-5 text-muted-foreground">
          <InlineBrandText
            text="The example uses the installed moldea CLI and OpenAI adapter. It performs no network or model request."
          />
        </p>
      </div>
    </Accordion>
  </div>
</article>
