---
import { UserRound } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import AgentArtifacts from '../agent-artifacts/agent-artifacts.astro';

const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<article
  class="min-w-0"
  aria-label="Illustrative support agent project"
  data-agent-example
>
  <ol
    class="relative grid gap-4"
    aria-label="Developer and coding agent conversation"
    data-agent-conversation
  >
    <li
      class="relative flex max-w-[92%] items-start gap-3 sm:max-w-none"
      data-user-message
    >
      <span
        class="absolute top-9 -bottom-4 left-[1.125rem] w-px bg-border"
        aria-hidden="true"
      ></span>
      <span
        class="dark-surface-selection relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground"
        aria-hidden="true"
      >
        <UserRound
          class="size-4"
          aria-hidden="true"
        />
      </span>
      <div
        class="rounded-2xl rounded-tl-sm border border-border bg-background px-4 py-3 shadow-surface"
      >
        <p class="mb-1 text-xs font-semibold text-muted-foreground">You</p>
        <p
          class="text-sm leading-6 font-medium sm:whitespace-nowrap lg:whitespace-normal xl:whitespace-nowrap"
          data-user-request
        >
          Create a <code class="inline-code">support</code> agent using our refund policy and existing
          order lookup.
        </p>
      </div>
    </li>
    <li
      class="relative min-w-0 items-start gap-3 sm:flex"
      data-agent-response
    >
      <span
        class="absolute top-0 left-0 z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-secondary sm:relative"
      >
        <img
          src={skillMarkPath}
          width="207"
          height="215"
          alt=""
          class="h-5 w-auto dark:invert"
          data-agent-response-mark
        />
      </span>
      <div class="min-w-0 flex-1">
        <div
          class="min-w-0 sm:overflow-hidden sm:rounded-2xl sm:rounded-tl-sm sm:border sm:border-border sm:bg-card sm:p-5 sm:shadow-raised"
        >
          <p class="mb-1 pl-12 text-xs font-semibold text-muted-foreground sm:pl-0">Coding agent</p>
          <p
            class="mb-3 pl-12 text-sm leading-6 font-medium sm:pl-0"
            data-agent-message
          >
            I created the <code class="inline-code">support</code> agent and connected everything it needs.
          </p>
          <AgentArtifacts />
        </div>
      </div>
    </li>
  </ol>
</article>
