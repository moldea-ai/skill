---
import { FileCode, FileText, Link2 } from '@lucide/astro';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

import {
  getLandingExampleLine,
  LANDING_EXAMPLE,
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE_MAINTAINED_FILES,
} from '../../lib/landing-example/index.ts';
const policyDiff = `-${getLandingExampleLine(
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE.paths.refundPolicy,
  'return completedDays',
)}
+${getLandingExampleLine(
  LANDING_EXAMPLE_MAINTAINED_FILES,
  LANDING_EXAMPLE.paths.refundPolicy,
  'return completedDays',
)}`;
/** Derives one visible boundary result from the executable fixture assertion. */
const getBoundaryCase = (days: number): { days: number; result: 'false' | 'true' } => {
  const assertion = getLandingExampleLine(
    LANDING_EXAMPLE_MAINTAINED_FILES,
    LANDING_EXAMPLE.paths.refundPolicyTest,
    `isRefundEligible(${days})`,
  );
  const match = assertion.match(/, (false|true)\);$/u);
  if (match?.[1] !== 'false' && match?.[1] !== 'true') {
    throw new Error(`Landing example boundary result is invalid: ${assertion}`);
  }

  return { days, result: match[1] };
};
const boundaryCases = [
  getBoundaryCase(LANDING_EXAMPLE.maintainedRefundWindowDays),
  getBoundaryCase(LANDING_EXAMPLE.maintainedRefundWindowDays + 1),
];
const initialContextLine = getLandingExampleLine(
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE.paths.policyContext,
  'Customers may request',
);
const maintainedContextLine = getLandingExampleLine(
  LANDING_EXAMPLE_MAINTAINED_FILES,
  LANDING_EXAMPLE.paths.policyContext,
  'Customers may request',
);
const initialInstructionLine = getLandingExampleLine(
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE.paths.instruction,
  'Explain that refunds',
);
const maintainedInstructionLine = getLandingExampleLine(
  LANDING_EXAMPLE_MAINTAINED_FILES,
  LANDING_EXAMPLE.paths.instruction,
  'Explain that refunds',
);
---

<section
  id="behavior-alignment"
  class="scroll-mt-24 border-b border-border bg-sidebar py-12 sm:py-16"
  aria-labelledby="behavior-alignment-title"
  data-behavior-alignment
>
  <div class="page-shell">
    <header
      class="grid gap-5 lg:grid-cols-[minmax(0,0.9fr)_minmax(20rem,0.6fr)] lg:items-end lg:gap-12"
    >
      <div>
        <p class="eyebrow mb-4">When the project changes</p>
        <h2
          id="behavior-alignment-title"
          class="section-title max-w-4xl text-3xl font-semibold sm:text-4xl lg:text-5xl"
        >
          Change the rule. Find what follows.
        </h2>
      </div>
      <p class="text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        <InlineBrandText
          text="moldea shows your coding agent which instructions depend on the rule, so it can review them together."
        />
      </p>
    </header>

    <div
      class="dark-surface-selection mt-7 rounded-xl bg-primary p-4 text-primary-foreground sm:p-5"
    >
      <p class="text-xs font-bold tracking-wide text-current/60 uppercase">Your next request</p>
      <p class="mt-2 max-w-4xl text-lg leading-7 font-semibold">
        {LANDING_EXAMPLE.maintenanceRequest}
      </p>
    </div>

    <div
      class="mt-5 grid items-stretch gap-3 lg:grid-cols-[minmax(0,1fr)_4rem_minmax(0,1fr)] lg:items-center"
      data-behavior-alignment-flow
    >
      <article
        class="min-w-0 border-y border-border bg-background py-5 sm:rounded-xl sm:border sm:p-5"
      >
        <div class="flex items-center gap-3 px-1 sm:px-0">
          <span class="inline-flex size-9 items-center justify-center rounded-lg bg-muted">
            <FileCode
              class="size-4"
              aria-hidden="true"
            />
          </span>
          <div>
            <p class="eyebrow">Application rule</p>
            <h3 class="mt-1 font-semibold">Refund eligibility</h3>
          </div>
        </div>
        <div
          class="mt-5 overflow-auto rounded-xl border border-border bg-code p-4"
          data-maintenance-diff="application"
        >
          <CodeBlock
            copyable={false}
            language="diff"
            source={policyDiff}
            variant="plain"
          />
        </div>
        <div class="mt-4">
          <p class="text-xs font-bold tracking-wide text-muted-foreground uppercase">
            Tests updated
          </p>
          <dl class="mt-3 grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-sm">
            {
              boundaryCases.map(({ days, result }) => (
                <>
                  <dt>
                    <code>{days} days</code>
                  </dt>
                  <dd class:list={['font-mono font-bold', result === 'true' && 'text-success']}>
                    {result === 'true' ? 'Eligible' : 'Outside window'}
                  </dd>
                </>
              ))
            }
          </dl>
        </div>
      </article>

      <div class="flex items-center justify-center py-2 lg:py-0">
        <div
          class="flex items-center gap-2 text-center text-xs font-semibold text-muted-foreground lg:flex-col"
        >
          <span
            class="inline-flex size-9 items-center justify-center rounded-full border border-border bg-background shadow-surface"
          >
            <Link2
              class="size-4"
              aria-hidden="true"
            />
          </span>
          <span>Connected</span>
        </div>
      </div>

      <article
        class="min-w-0 border-y border-border bg-background py-5 sm:rounded-xl sm:border sm:p-5"
      >
        <div class="flex items-center gap-3 px-1 sm:px-0">
          <span class="inline-flex size-9 items-center justify-center rounded-lg bg-muted">
            <FileText
              class="size-4"
              aria-hidden="true"
            />
          </span>
          <div>
            <p class="eyebrow">Related agent behavior</p>
            <h3 class="mt-1 font-semibold">Policy and instructions</h3>
          </div>
        </div>
        <div
          class="mt-5 rounded-xl border border-border bg-code p-3"
          data-maintenance-diff="context"
        >
          <code class="grid gap-1 font-mono text-xs leading-5 text-code-foreground">
            <span class="flex min-w-0 gap-2 rounded-md bg-destructive/10 px-2 py-1">
              <span aria-hidden="true">-</span>
              <span class="min-w-0 break-words">{initialContextLine}</span>
            </span>
            <span class="flex min-w-0 gap-2 rounded-md bg-success/10 px-2 py-1">
              <span aria-hidden="true">+</span>
              <span class="min-w-0 break-words">{maintainedContextLine}</span>
            </span>
          </code>
        </div>
        <div
          class="mt-3 rounded-xl border border-border bg-code p-3"
          data-maintenance-diff="instruction"
        >
          <code class="grid gap-1 font-mono text-xs leading-5 text-code-foreground">
            <span class="flex min-w-0 gap-2 rounded-md bg-destructive/10 px-2 py-1">
              <span aria-hidden="true">-</span>
              <span class="min-w-0 break-words">{initialInstructionLine}</span>
            </span>
            <span class="flex min-w-0 gap-2 rounded-md bg-success/10 px-2 py-1">
              <span aria-hidden="true">+</span>
              <span class="min-w-0 break-words">{maintainedInstructionLine}</span>
            </span>
          </code>
        </div>
      </article>
    </div>
  </div>
</section>
