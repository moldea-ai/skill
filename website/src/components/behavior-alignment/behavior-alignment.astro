---
import { Check, FileCode, FileText, Link2, UserRound } from '@lucide/astro';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import ConnectionLabel from '@moldea.ai/website-ui/connection-label';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import {
  getLandingExampleLine,
  LANDING_EXAMPLE,
  LANDING_EXAMPLE_INITIAL_FILES,
  LANDING_EXAMPLE_MAINTAINED_FILES,
} from '../../lib/landing-example/index.ts';

const createLineDiff = (initialLine: string, maintainedLine: string): string =>
  `-${initialLine}
+${maintainedLine}`;
const policyDiff = createLineDiff(
  getLandingExampleLine(
    LANDING_EXAMPLE_INITIAL_FILES,
    LANDING_EXAMPLE.paths.refundPolicy,
    'return completedDays',
  ),
  getLandingExampleLine(
    LANDING_EXAMPLE_MAINTAINED_FILES,
    LANDING_EXAMPLE.paths.refundPolicy,
    'return completedDays',
  ),
);
const initialBoundaryAssertions = [
  getLandingExampleLine(
    LANDING_EXAMPLE_INITIAL_FILES,
    LANDING_EXAMPLE.paths.refundPolicyTest,
    `isRefundEligible(${LANDING_EXAMPLE.initialRefundWindowDays})`,
  ),
  getLandingExampleLine(
    LANDING_EXAMPLE_INITIAL_FILES,
    LANDING_EXAMPLE.paths.refundPolicyTest,
    `isRefundEligible(${LANDING_EXAMPLE.initialRefundWindowDays + 1})`,
  ),
];
const maintainedBoundaryAssertions = [
  getLandingExampleLine(
    LANDING_EXAMPLE_MAINTAINED_FILES,
    LANDING_EXAMPLE.paths.refundPolicyTest,
    `isRefundEligible(${LANDING_EXAMPLE.maintainedRefundWindowDays})`,
  ),
  getLandingExampleLine(
    LANDING_EXAMPLE_MAINTAINED_FILES,
    LANDING_EXAMPLE.paths.refundPolicyTest,
    `isRefundEligible(${LANDING_EXAMPLE.maintainedRefundWindowDays + 1})`,
  ),
];
const testDiff = [
  ...initialBoundaryAssertions.map((line) => `-${line}`),
  ...maintainedBoundaryAssertions.map((line) => `+${line}`),
].join('\n');
const contextDiff = createLineDiff(
  getLandingExampleLine(
    LANDING_EXAMPLE_INITIAL_FILES,
    LANDING_EXAMPLE.paths.policyContext,
    'Customers may request',
  ),
  getLandingExampleLine(
    LANDING_EXAMPLE_MAINTAINED_FILES,
    LANDING_EXAMPLE.paths.policyContext,
    'Customers may request',
  ),
);
const instructionDiff = createLineDiff(
  getLandingExampleLine(
    LANDING_EXAMPLE_INITIAL_FILES,
    LANDING_EXAMPLE.paths.instruction,
    'Explain that refunds',
  ),
  getLandingExampleLine(
    LANDING_EXAMPLE_MAINTAINED_FILES,
    LANDING_EXAMPLE.paths.instruction,
    'Explain that refunds',
  ),
);
const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<section
  id="behavior-alignment"
  class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
  aria-labelledby="behavior-alignment-title"
  data-behavior-alignment
>
  <div class="page-shell">
    <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
      <div>
        <p class="eyebrow mb-4">When the project changes</p>
        <h2
          id="behavior-alignment-title"
          class="section-title max-w-4xl text-3xl font-semibold sm:text-4xl lg:text-5xl"
        >
          Change one rule. See everything it affects.
        </h2>
      </div>
      <p class="text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        <InlineBrandText
          text="moldea records which project files and agent behavior belong together, so the coding agent can review the complete change."
        />
      </p>
    </header>

    <ol
      class="relative mt-8 grid gap-4"
      aria-label="Developer and coding agent maintenance conversation"
      data-behavior-conversation
    >
      <li
        class="relative flex max-w-3xl items-start gap-3"
        data-behavior-user-message
      >
        <span
          class="absolute top-9 -bottom-4 left-[1.125rem] w-px bg-border"
          aria-hidden="true"
        ></span>
        <span
          class="dark-surface-selection relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground"
          aria-hidden="true"
          data-behavior-user-mark
        >
          <UserRound
            class="size-4"
            aria-hidden="true"
          />
        </span>
        <div
          class="rounded-2xl rounded-tl-sm border border-border bg-background px-4 py-3 shadow-surface"
        >
          <p class="mb-1 text-xs font-semibold text-muted-foreground">Developer</p>
          <p class="text-sm leading-6 font-medium sm:text-base">
            {LANDING_EXAMPLE.maintenanceRequest}
          </p>
        </div>
      </li>

      <li
        class="flex min-w-0 items-start gap-3"
        data-behavior-agent-response
      >
        <span
          class="relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-secondary"
        >
          <img
            src={skillMarkPath}
            width="207"
            height="215"
            alt=""
            class="h-5 w-auto dark:invert"
            data-behavior-agent-mark
          />
        </span>
        <article class="min-w-0 flex-1">
          <div
            class="overflow-hidden rounded-2xl rounded-tl-sm border border-border bg-card shadow-raised"
          >
            <div class="px-4 pt-4 sm:px-5 sm:pt-5">
              <p class="mb-1 text-xs font-semibold text-muted-foreground">Coding agent</p>
              <p class="text-sm font-semibold sm:text-base">
                I updated the refund rule and everything connected to it.
              </p>
            </div>

            <div
              class="grid items-stretch gap-4 p-4 sm:p-5 lg:grid-cols-[minmax(0,1fr)_5rem_minmax(0,1fr)]"
              data-behavior-alignment-flow
            >
              <section
                class="flex min-w-0 flex-col rounded-xl border border-border bg-sidebar p-4 sm:p-5"
                aria-labelledby="application-behavior-title"
              >
                <div class="mb-5 flex items-center gap-3">
                  <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted">
                    <FileCode
                      class="size-5"
                      aria-hidden="true"
                    />
                  </span>
                  <div>
                    <p class="eyebrow">Application behavior</p>
                    <h3
                      id="application-behavior-title"
                      class="mt-1 text-xl font-semibold"
                    >
                      Refund window updated
                    </h3>
                  </div>
                </div>
                <div class="grid flex-1 content-start gap-3">
                  <FilePreview path="src/refund-policy.ts">
                    <div
                      class="p-4"
                      data-maintenance-diff="application"
                    >
                      <CodeBlock
                        copyable={false}
                        language="diff"
                        source={policyDiff}
                        variant="plain"
                      />
                    </div>
                  </FilePreview>
                  <FilePreview path="src/refund-policy.test-unit.ts">
                    <div
                      class="p-4"
                      data-maintenance-diff="tests"
                    >
                      <CodeBlock
                        copyable={false}
                        language="diff"
                        source={testDiff}
                        variant="plain"
                      />
                    </div>
                  </FilePreview>
                </div>
                <p class="mt-4 flex items-center gap-2 text-sm font-semibold">
                  <Check
                    class="size-4 text-emerald-700 dark:text-emerald-300"
                    aria-hidden="true"
                  />
                  <code>14 days</code> eligible, <code>15 days</code> outside the window
                </p>
              </section>

              <div class="flex items-center justify-center">
                <ConnectionLabel>
                  <Link2
                    slot="icon"
                    class="size-4"
                  />
                  Declared relationship
                </ConnectionLabel>
              </div>

              <section
                class="flex min-w-0 flex-col rounded-xl border border-border bg-sidebar p-4 sm:p-5"
                aria-labelledby="agent-behavior-title"
              >
                <div class="mb-5 flex items-center gap-3">
                  <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted">
                    <FileText
                      class="size-5"
                      aria-hidden="true"
                    />
                  </span>
                  <div>
                    <p class="eyebrow">Agent behavior</p>
                    <h3
                      id="agent-behavior-title"
                      class="mt-1 text-xl font-semibold"
                    >
                      Linked guidance updated
                    </h3>
                  </div>
                </div>
                <div class="grid flex-1 content-start gap-3">
                  <FilePreview path="moldea/context/refund-policy.md">
                    <div
                      class="p-4"
                      data-maintenance-diff="context"
                    >
                      <CodeBlock
                        copyable={false}
                        language="diff"
                        source={contextDiff}
                        variant="plain"
                      />
                    </div>
                  </FilePreview>
                  <FilePreview path="moldea/agents/support/instruction.md">
                    <div
                      class="p-4"
                      data-maintenance-diff="instruction"
                    >
                      <CodeBlock
                        copyable={false}
                        language="diff"
                        source={instructionDiff}
                        variant="plain"
                      />
                    </div>
                  </FilePreview>
                </div>
                <p class="mt-4 flex items-center gap-2 text-sm font-semibold">
                  <Check
                    class="size-4 text-emerald-700 dark:text-emerald-300"
                    aria-hidden="true"
                  />
                  Both linked files reviewed with the application change
                </p>
              </section>
            </div>
          </div>
        </article>
      </li>
    </ol>
  </div>
</section>
