---
import { BOOKING_EXAMPLE, BOOKING_EXAMPLE_BEFORE_FILES } from '../../lib/booking-example/index.ts';
import {
  ProjectFileTree,
  type IProjectFileTreeEntry,
  type IProjectFileTreeFile,
} from '../project-file-tree/index.ts';

// keep the connected files in the same compact repository hierarchy as the landing example
const entries: IProjectFileTreeEntry[] = [
  { kind: 'directory', label: 'src/', depth: 0 },
  { kind: 'file', id: 'service', depth: 1 },
  { kind: 'file', id: 'availability', depth: 1 },
  { kind: 'directory', label: 'moldea/', depth: 0 },
  { kind: 'directory', label: 'agents/booking/', depth: 1 },
  { kind: 'file', id: 'instructions', depth: 2 },
  { kind: 'directory', label: 'context/', depth: 1 },
  { kind: 'file', id: 'policy', depth: 2 },
];
const files: IProjectFileTreeFile[] = Object.values(BOOKING_EXAMPLE.files)
  .filter((file) => file.id !== 'tests')
  .map(({ id, label, language, path, source }) => {
    const before = BOOKING_EXAMPLE_BEFORE_FILES[path];
    return { id, label, language, path, source, ...(before === undefined ? {} : { before }) };
  });
---

<ProjectFileTree
  entries={entries}
  files={files}
  idPrefix="booking"
  label="Booking assistant connected files"
/>
