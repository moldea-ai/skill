---
import {
  ArrowDown,
  ArrowRight,
  Bot,
  BrainCircuit,
  Check,
  CircleCheck,
  FileCheck,
  FileCode,
  FileText,
  FolderTree,
  GitBranch,
  Link2,
  Search,
  ShieldCheck,
  Terminal,
  Unlink,
  UserRound,
  Wrench,
} from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import ConnectionLabel from '@moldea.ai/website-ui/connection-label';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../adapter-company-logo/adapter-company-logo.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { LANDING_EXAMPLE, LANDING_EXAMPLE_PREVIEW } from '../../lib/landing-example/index.ts';
import { PRODUCT_PAGE_METADATA } from '../../lib/model/constants.ts';

const basePath = import.meta.env.BASE_URL;
const pageMetadata = PRODUCT_PAGE_METADATA.capabilities;
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: pageMetadata.title }];
const capabilityLinks = [
  { href: '#project-truth', icon: FolderTree, label: 'Establish project truth' },
  { href: '#plan-agent-systems', icon: BrainCircuit, label: 'Plan agent systems' },
  { href: '#create-agents', icon: Bot, label: 'Create agents' },
  { href: '#build-agent-skills', icon: FileCheck, label: 'Build Agent Skills' },
  { href: '#keep-behavior-current', icon: GitBranch, label: 'Keep behavior current' },
  { href: '#evaluate-and-repair', icon: ShieldCheck, label: 'Evaluate and repair' },
] as const;
const skillMarkPath = withBase('/logo/icon-xs-light.png', basePath);
---

<BaseLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
  {breadcrumbs}
>
  <div class="page-shell pt-4 sm:pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="mt-4 border-b border-border bg-background sm:mt-6 sm:border-y">
    <div class="page-shell py-10 sm:py-16 lg:py-20">
      <div class="max-w-4xl">
        <p class="eyebrow mb-4">Capabilities</p>
        <h1 class="section-title font-semibold">From project knowledge to working agents.</h1>
        <p class="mt-5 max-w-3xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          <InlineBrandText
            text="moldea gives your coding agent a complete workflow for planning, building, maintaining, and checking agent-enabled projects."
          />
        </p>
      </div>

      <nav
        class="mt-8 sm:mt-10"
        aria-label="Capabilities on this page"
      >
        <ul
          class="grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            capabilityLinks.map(({ href, icon: CapabilityIcon, label }) => (
              <li>
                <a
                  class="group flex h-full items-center gap-3 bg-card px-4 py-3.5 text-sm font-semibold transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring sm:px-5"
                  href={href}
                >
                  <CapabilityIcon
                    class="size-4 shrink-0 text-muted-foreground transition-colors group-hover:text-foreground"
                    aria-hidden="true"
                  />
                  <span class="min-w-0">{label}</span>
                  <ArrowRight
                    class="ms-auto size-4 shrink-0 text-muted-foreground"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <section
    id="project-truth"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="project-truth-title"
    data-capability-section
  >
    <div
      class="page-shell grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-14"
    >
      <div>
        <p class="eyebrow mb-3">01 Project truth</p>
        <h2
          id="project-truth-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Give every session the same starting point.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          <InlineBrandText
            text="moldea saves the facts, responsibilities, and decisions that future coding agents need. Temporary sprint details stay out."
          />
        </p>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">
          Start once with <InlineBrandText text="Initialize moldea" />. Initialization creates the
          smallest useful foundation and does not create an agent automatically.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
          <ActionLink
            class="font-bold"
            href={withBase('/docs/project-state/', basePath)}
            variant="link"
          >
            Project state guide
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/examples/initialize-a-project/', basePath)}
            variant="link"
          >
            See initialization
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/examples/add-project-context/', basePath)}
            variant="link"
          >
            Add project context
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>

      <div
        class="overflow-hidden rounded-2xl border border-border bg-card shadow-raised"
        data-project-truth-visual
      >
        <div class="grid gap-px bg-border sm:grid-cols-3">
          {
            [
              ['Platform', 'Owns the application runtime'],
              ['Product', 'Owns support workflows'],
              ['Security', 'Approves production access'],
            ].map(([owner, responsibility]) => (
              <div class="bg-card p-4 sm:p-5">
                <p class="text-xs font-bold tracking-wide text-muted-foreground uppercase">
                  {owner}
                </p>
                <p class="mt-2 text-sm leading-6 font-semibold">{responsibility}</p>
              </div>
            ))
          }
        </div>
        <div class="grid gap-5 p-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] sm:p-6">
          <div
            class="rounded-xl border border-emerald-600/30 bg-emerald-600/10 p-4 dark:border-emerald-400/30 dark:bg-emerald-400/10"
          >
            <p
              class="flex items-center gap-2 text-sm font-semibold text-emerald-800 dark:text-emerald-200"
            >
              <CircleCheck
                class="size-4"
                aria-hidden="true"
              />
              Saved for the next session
            </p>
            <ul class="mt-3 grid gap-2 text-sm leading-6">
              <li>Refund eligibility belongs to the application.</li>
              <li>The support agent explains the rule.</li>
            </ul>
          </div>
          <div class="rounded-xl border border-border bg-muted/40 p-4">
            <p class="text-sm font-semibold">Left in the sprint</p>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              Today’s handoff time and temporary review notes.
            </p>
          </div>
        </div>
        <div class="border-t border-border px-4 py-4 sm:px-6">
          <div class="flex items-center gap-3 text-sm font-semibold">
            <FolderTree
              class="size-4 text-muted-foreground"
              aria-hidden="true"
            />
            <code>moldea/</code>
          </div>
          <div
            class="ms-2 mt-3 grid gap-2 border-s border-border ps-5 text-sm text-muted-foreground"
          >
            <code>project.md</code>
            <code>context/team-responsibilities.md</code>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    id="plan-agent-systems"
    class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
    aria-labelledby="plan-agent-systems-title"
    data-capability-section
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3">02 Plan the system</p>
        <h2
          id="plan-agent-systems-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Put each responsibility where it belongs.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          The plan separates fixed rules, judgment, and approval before implementation begins. The
          right design may use zero, one, or several agents.
        </p>
      </header>

      <div
        class="mt-8 rounded-2xl border border-border bg-card shadow-raised"
        data-planning-visual
      >
        <div class="flex items-start gap-3 border-b border-border p-4 sm:p-5">
          <span
            class="dark-surface-selection inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground"
          >
            <UserRound
              class="size-4"
              aria-hidden="true"
            />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-semibold text-muted-foreground">You</p>
            <p class="mt-1 text-sm leading-6 font-medium sm:text-base">
              Plan personalized promotions without giving the agent control over prices.
            </p>
          </div>
        </div>
        <div class="grid gap-px bg-border md:grid-cols-3">
          <article class="bg-card p-5 sm:p-6">
            <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted">
              <Terminal
                class="size-5"
                aria-hidden="true"
              />
            </span>
            <p class="eyebrow mt-5">Software</p>
            <h3 class="mt-1 text-lg font-semibold">Protect the fixed rules</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              Eligibility, discount limits, inventory, and final price stay deterministic.
            </p>
          </article>
          <article class="bg-card p-5 sm:p-6">
            <span class="inline-flex size-10 items-center justify-center rounded-xl bg-secondary">
              <img
                src={skillMarkPath}
                width="207"
                height="215"
                alt=""
                class="h-5 w-auto dark:invert"
              />
            </span>
            <p class="eyebrow mt-5">One agent</p>
            <h3 class="mt-1 text-lg font-semibold">Shape the approved offer</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              Choose wording and channel from the offers the application permits.
            </p>
          </article>
          <article class="bg-card p-5 sm:p-6">
            <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted">
              <ShieldCheck
                class="size-5"
                aria-hidden="true"
              />
            </span>
            <p class="eyebrow mt-5">Person</p>
            <h3 class="mt-1 text-lg font-semibold">Approve high-risk campaigns</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              Keep the consequential decision with the accountable team.
            </p>
          </article>
        </div>
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-5 py-4 text-sm"
        >
          <span class="font-semibold">A clear boundary before code changes.</span>
          <span class="text-muted-foreground">Planning is read-only.</span>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/planning-agent-systems/', basePath)}
          variant="link"
        >
          Planning guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/examples/plan-an-agent-system/', basePath)}
          variant="link"
        >
          See the planning example
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </section>

  <section
    id="create-agents"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="create-agents-title"
    data-capability-section
  >
    <div
      class="page-shell grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-14"
    >
      <div>
        <p class="eyebrow mb-3">03 Create agents</p>
        <h2
          id="create-agents-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Build an agent from real project boundaries.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          Responsibilities, instructions, tools, schemas, and runtime wiring stay connected to the
          project that owns them.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
          <ActionLink
            class="font-bold"
            href={withBase('/docs/designing-agents/', basePath)}
            variant="link"
          >
            Agent design guide
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/examples/create-a-support-agent/', basePath)}
            variant="link"
          >
            See the complete example
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/evidence/qualification/', basePath)}
            variant="link"
          >
            Check runtime qualifications
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>

      <div
        class="rounded-2xl border border-border bg-card p-4 shadow-raised sm:p-6"
        data-agent-system-visual
      >
        <div
          class="mx-auto max-w-md rounded-2xl border border-border bg-background p-5 text-center"
        >
          <span
            class="mx-auto inline-flex size-11 items-center justify-center rounded-xl bg-secondary"
          >
            <img
              src={skillMarkPath}
              width="207"
              height="215"
              alt=""
              class="h-6 w-auto dark:invert"
            />
          </span>
          <p class="eyebrow mt-4">Support agent</p>
          <h3 class="mt-1 text-xl font-semibold">Answers refund questions</h3>
        </div>
        <div
          class="flex justify-center py-3 text-muted-foreground"
          aria-hidden="true"
        >
          <ArrowDown class="size-5" />
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-border bg-background p-4">
            <FileText
              class="size-5 text-muted-foreground"
              aria-hidden="true"
            />
            <p class="mt-3 text-sm font-semibold">Instructions</p>
            <code class="mt-1 block text-xs break-all text-muted-foreground">instruction.md</code>
          </div>
          <div class="rounded-xl border border-border bg-background p-4">
            <Search
              class="size-5 text-muted-foreground"
              aria-hidden="true"
            />
            <p class="mt-3 text-sm font-semibold">Order lookup</p>
            <code class="mt-1 block text-xs break-all text-muted-foreground">lookup-order</code>
          </div>
          <div class="rounded-xl border border-border bg-background p-4">
            <div class="flex items-center justify-between gap-3">
              <Bot
                class="size-5 text-muted-foreground"
                aria-hidden="true"
              />
              <AdapterCompanyLogo
                adapterId="openai"
                size="xs"
              />
            </div>
            <p class="mt-3 text-sm font-semibold">Runtime</p>
            <code class="mt-1 block text-xs break-all text-muted-foreground">gpt-6-astra</code>
          </div>
        </div>
        <p
          class="mt-4 flex items-center gap-2 text-sm font-semibold text-emerald-800 dark:text-emerald-200"
        >
          <Link2
            class="size-4"
            aria-hidden="true"
          />
          Every declared capability resolves to project evidence.
        </p>
      </div>
    </div>
  </section>

  <section
    id="build-agent-skills"
    class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
    aria-labelledby="build-agent-skills-title"
    data-capability-section
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3">04 Build Agent Skills</p>
        <h2
          id="build-agent-skills-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Package a repeatable workflow, not just a prompt.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          A skill explains when to activate, what guidance to load, what software to run, and how to
          verify the result.
        </p>
      </header>

      <div
        class="mt-8 grid overflow-hidden rounded-2xl border border-border bg-card shadow-raised lg:grid-cols-2"
        data-skill-visual
      >
        <div class="border-b border-border p-5 sm:p-7 lg:border-e lg:border-b-0">
          <div class="flex items-center gap-3">
            <FolderTree
              class="size-5 text-muted-foreground"
              aria-hidden="true"
            />
            <code class="font-semibold">release-review/</code>
          </div>
          <ul class="ms-2 mt-4 grid gap-3 border-s border-border ps-5 text-sm">
            <li class="flex items-center gap-3">
              <FileText
                class="size-4 text-muted-foreground"
                aria-hidden="true"
              /><code>SKILL.md</code>
            </li>
            <li class="flex items-center gap-3">
              <FileText
                class="size-4 text-muted-foreground"
                aria-hidden="true"
              /><code>references/release-policy.md</code>
            </li>
            <li class="flex items-center gap-3">
              <Terminal
                class="size-4 text-muted-foreground"
                aria-hidden="true"
              /><code>scripts/verify-release.mjs</code>
            </li>
            <li class="flex items-center gap-3">
              <FileCode
                class="size-4 text-muted-foreground"
                aria-hidden="true"
              /><code>assets/report-template.md</code>
            </li>
          </ul>
        </div>
        <div class="p-5 sm:p-7">
          <div class="rounded-xl border border-border bg-background p-4">
            <p class="text-xs font-semibold text-muted-foreground">Request</p>
            <p class="mt-1 text-sm leading-6 font-semibold">
              Review this release before publication.
            </p>
          </div>
          <div
            class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 py-4 text-center text-xs font-semibold text-muted-foreground"
          >
            <span>Guidance loads</span><ArrowRight
              class="size-4"
              aria-hidden="true"
            /><span>Verifier runs</span>
          </div>
          <div
            class="rounded-xl border border-emerald-600/30 bg-emerald-600/10 p-4 dark:border-emerald-400/30 dark:bg-emerald-400/10"
          >
            <p
              class="flex items-center gap-2 text-sm font-semibold text-emerald-800 dark:text-emerald-200"
            >
              <FileCheck
                class="size-4"
                aria-hidden="true"
              />
              The skill owns the workflow. Software owns the deterministic check.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-5">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/designing-skills/', basePath)}
          variant="link"
        >
          Skill design guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </section>

  <section
    id="keep-behavior-current"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="keep-behavior-current-title"
    data-capability-section
  >
    <div class="page-shell">
      <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
        <div>
          <p class="eyebrow mb-3">05 Keep behavior current</p>
          <h2
            id="keep-behavior-current-title"
            class="text-3xl font-semibold tracking-tight sm:text-4xl"
          >
            Change one rule. Follow every connection.
          </h2>
        </div>
        <p class="text-base leading-7 text-muted-foreground">
          A shorter refund window changes application logic, boundary tests, project context, and
          the support agent’s explanation together.
        </p>
      </header>

      <div
        class="mt-8 rounded-2xl border border-border bg-card p-4 shadow-raised sm:p-6"
        data-maintenance-visual
      >
        <div class="grid items-center gap-4 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]">
          <div class="min-w-0">
            <p class="mb-3 text-sm font-semibold">Application behavior</p>
            <div class="grid gap-3">
              <FilePreview path={LANDING_EXAMPLE_PREVIEW.policyDiff.path}>
                <div class="p-4">
                  <CodeBlock
                    ariaLabel={`${LANDING_EXAMPLE_PREVIEW.policyDiff.path} code`}
                    copyable={false}
                    language="diff"
                    source={LANDING_EXAMPLE_PREVIEW.policyDiff.source}
                    variant="plain"
                  />
                </div>
              </FilePreview>
              <FilePreview path={LANDING_EXAMPLE_PREVIEW.testDiff.path}>
                <div class="p-4">
                  <CodeBlock
                    ariaLabel={`${LANDING_EXAMPLE_PREVIEW.testDiff.path} code`}
                    copyable={false}
                    language="diff"
                    source={LANDING_EXAMPLE_PREVIEW.testDiff.source}
                    variant="plain"
                  />
                </div>
              </FilePreview>
            </div>
          </div>
          <div class="flex justify-center">
            <ConnectionLabel
              ><Link2
                slot="icon"
                class="size-4"
              />Declared relationship</ConnectionLabel
            >
          </div>
          <div class="min-w-0">
            <p class="mb-3 text-sm font-semibold">Agent behavior</p>
            <div class="grid gap-3">
              <FilePreview path={LANDING_EXAMPLE_PREVIEW.contextDiff.path}>
                <div class="p-4">
                  <CodeBlock
                    ariaLabel={`${LANDING_EXAMPLE_PREVIEW.contextDiff.path} code`}
                    copyable={false}
                    language="diff"
                    source={LANDING_EXAMPLE_PREVIEW.contextDiff.source}
                    variant="plain"
                  />
                </div>
              </FilePreview>
              <FilePreview path={LANDING_EXAMPLE_PREVIEW.instructionDiff.path}>
                <div class="p-4">
                  <CodeBlock
                    ariaLabel={`${LANDING_EXAMPLE_PREVIEW.instructionDiff.path} code`}
                    copyable={false}
                    language="diff"
                    source={LANDING_EXAMPLE_PREVIEW.instructionDiff.source}
                    variant="plain"
                  />
                </div>
              </FilePreview>
            </div>
          </div>
        </div>
        <p class="mt-5 flex flex-wrap items-center gap-2 text-sm font-semibold">
          <Check
            class="size-4 text-emerald-700 dark:text-emerald-300"
            aria-hidden="true"
          />
          <code>{LANDING_EXAMPLE.maintainedRefundWindowDays} days</code> eligible,
          <code>{LANDING_EXAMPLE.maintainedRefundWindowDays + 1} days</code> outside the window
        </p>
      </div>

      <div
        class="mt-4 grid gap-3 rounded-xl border border-border bg-card p-4 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center"
        data-consolidation-visual
      >
        <div>
          <p class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">Before</p>
          <p class="mt-1 text-sm font-semibold">The same responsibility appears in two files.</p>
        </div>
        <ArrowRight
          class="mx-auto hidden size-5 text-muted-foreground sm:block"
          aria-hidden="true"
        />
        <ArrowDown
          class="mx-auto size-5 text-muted-foreground sm:hidden"
          aria-hidden="true"
        />
        <div>
          <p class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">After</p>
          <p class="mt-1 text-sm font-semibold">
            One authoritative owner, with every unique fact preserved.
          </p>
        </div>
        <p class="text-sm leading-6 text-muted-foreground sm:col-span-3">
          Consolidation can leave application and agent files unchanged. When project truth remains
          accurate, the correct result can also be no <code>moldea</code> edit.
        </p>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/continuous-maintenance/', basePath)}
          variant="link"
        >
          Maintenance guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/examples/maintain-a-refund-policy/', basePath)}
          variant="link"
        >
          Refund example
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/examples/compress-project-context/', basePath)}
          variant="link"
        >
          Consolidate context
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/examples/dedicated-repositories/', basePath)}
          variant="link"
