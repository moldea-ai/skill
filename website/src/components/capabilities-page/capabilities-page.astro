  </section>

  <section
    id="evaluate-and-repair"
    class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
    aria-labelledby="evaluate-and-repair-title"
    data-capability-section
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3">06 Evaluate and repair</p>
        <h2
          id="evaluate-and-repair-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Inspect first. Repair only when asked.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          Evaluation reports what is wrong without writing files. Reconciliation corrects drift.
          Validation checks the repository structure. Each operation keeps a distinct promise.
        </p>
      </header>

      <div
        class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-3"
        data-evaluation-visual
      >
        {
          [
            {
              description: 'Read-only findings about alignment and evidence.',
              icon: Search,
              title: 'Evaluate',
            },
            {
              description: 'The smallest authorized correction to intended state.',
              icon: Wrench,
              title: 'Reconcile',
            },
            {
              description: 'Deterministic format and relationship checks.',
              icon: FileCheck,
              title: 'Validate',
            },
          ].map(({ description, icon: OperationIcon, title }) => (
            <article class="bg-card p-5 sm:p-6">
              <OperationIcon
                class="size-5 text-muted-foreground"
                aria-hidden="true"
              />
              <h3 class="mt-4 text-lg font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
            </article>
          ))
        }
      </div>

      <div
        class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center"
        data-repair-visual
      >
        <div class="rounded-2xl border border-border bg-card p-5 sm:p-6">
          <div class="flex items-start gap-3">
            <span
              class="dark-surface-selection inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground"
            >
              <UserRound
                class="size-4"
                aria-hidden="true"
              />
            </span>
            <div>
              <p class="text-xs font-semibold text-muted-foreground">You</p>
              <p class="mt-1 font-semibold">Fix <InlineBrandText text="moldea" />.</p>
            </div>
          </div>
          <div class="mt-5 flex items-start gap-3 border-t border-border pt-5">
            <span
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-secondary"
            >
              <img
                src={skillMarkPath}
                width="207"
                height="215"
                alt=""
                class="h-5 w-auto dark:invert"
              />
            </span>
            <div>
              <p class="text-xs font-semibold text-muted-foreground">Coding agent</p>
              <p class="mt-1 text-sm leading-6 font-semibold">
                I restored the broken connection and validated the project.
              </p>
            </div>
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center">
          <div class="rounded-xl border border-destructive/30 bg-destructive/10 p-4">
            <p class="flex items-center gap-2 text-sm font-semibold text-foreground">
              <Unlink
                class="size-4 text-destructive"
                aria-hidden="true"
              />Broken
            </p>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              The support agent no longer loads its instructions.
            </p>
          </div>
          <ArrowRight
            class="mx-auto hidden size-5 text-muted-foreground sm:block"
            aria-hidden="true"
          />
          <ArrowDown
            class="mx-auto size-5 text-muted-foreground sm:hidden"
            aria-hidden="true"
          />
          <div
            class="rounded-xl border border-emerald-600/30 bg-emerald-600/10 p-4 dark:border-emerald-400/30 dark:bg-emerald-400/10"
          >
            <p
              class="flex items-center gap-2 text-sm font-semibold text-emerald-800 dark:text-emerald-200"
            >
              <Link2
                class="size-4"
                aria-hidden="true"
              />Restored
            </p>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              The declared path resolves and the check passes.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-5 max-w-4xl text-sm leading-6 text-muted-foreground">
        Repair requires a previously initialized project and existing evidence. It does not silently
        initialize a project, guess a policy, upgrade dependencies, or claim completion before
        checks pass.
      </p>
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/evaluate-reconcile-validate/#repair-a-project', basePath)}
          variant="link"
        >
          Repair and evaluation guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/examples/evaluate-and-reconcile/', basePath)}
          variant="link"
        >
          See an evaluation
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/examples/validate-structure/', basePath)}
          variant="link"
        >
          See validation
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </section>

  <section
    class="bg-elevated py-10 sm:py-12"
    aria-labelledby="capabilities-next-title"
  >
    <div class="page-shell flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="eyebrow mb-2">Continue</p>
        <h2
          id="capabilities-next-title"
          class="text-2xl font-semibold tracking-tight"
        >
          See these capabilities work together.
        </h2>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={withBase('/how-it-works/', basePath)}
          variant="link"
          >How it works <ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
        <ActionLink
          class="font-bold"
          href={withBase('/docs/', basePath)}
          variant="link"
          >Open the docs <ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
      </div>
    </div>
  </section>
</BaseLayout>
