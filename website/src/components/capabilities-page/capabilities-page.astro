---
import {
  ArrowDown,
  ArrowRight,
  Bot,
  BrainCircuit,
  Check,
  CircleCheck,
  FileCheck,
  FileText,
  FolderTree,
  GitBranch,
  Link2,
  Search,
  ShieldCheck,
  ShoppingCart,
  Terminal,
  Unlink,
  Wrench,
} from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../adapter-company-logo/adapter-company-logo.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { PRODUCT_PAGE_METADATA } from '../../lib/model/constants.ts';
import CapabilityConversation from './capability-conversation/capability-conversation.astro';

const basePath = import.meta.env.BASE_URL;
const pageMetadata = PRODUCT_PAGE_METADATA.capabilities;
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: pageMetadata.title }];
const capabilityLinks = [
  { href: '#project-truth', icon: FolderTree, label: 'Establish project truth' },
  { href: '#plan-agent-systems', icon: BrainCircuit, label: 'Plan agent systems' },
  { href: '#create-agents', icon: Bot, label: 'Create agents' },
  { href: '#build-agent-skills', icon: FileCheck, label: 'Build Agent Skills' },
  { href: '#keep-behavior-current', icon: GitBranch, label: 'Keep behavior current' },
  { href: '#evaluate-and-repair', icon: ShieldCheck, label: 'Evaluate and repair' },
] as const;
const skillMarkPath = withBase('/logo/icon-xs-light.png', basePath);
---

<BaseLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
  {breadcrumbs}
>
  <div class="page-shell pt-4 sm:pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="mt-4 border-b border-border bg-background sm:mt-6 sm:border-y">
    <div class="page-shell py-10 sm:py-16 lg:py-20">
      <div class="max-w-4xl">
        <p class="eyebrow mb-4">Capabilities</p>
        <h1 class="section-title font-semibold">From project knowledge to working agents.</h1>
        <p class="mt-5 max-w-3xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          <InlineBrandText
            text="moldea gives your coding agent a complete workflow for planning, building, maintaining, and checking agent-enabled projects."
          />
        </p>
      </div>

      <nav
        class="mt-8 sm:mt-10"
        aria-label="Capabilities on this page"
      >
        <ul
          class="grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            capabilityLinks.map(({ href, icon: CapabilityIcon, label }) => (
              <li>
                <a
                  class="group flex h-full items-center gap-3 bg-card px-4 py-3.5 text-sm font-semibold transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring sm:px-5"
                  href={href}
                >
                  <CapabilityIcon
                    class="size-4 shrink-0 text-muted-foreground transition-colors group-hover:text-foreground"
                    aria-hidden="true"
                  />
                  <span class="min-w-0">{label}</span>
                  <ArrowRight
                    class="ms-auto size-4 shrink-0 text-muted-foreground"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <section
    id="project-truth"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="project-truth-title"
    data-capability-section
  >
    <div
      class="page-shell grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-14"
    >
      <div>
        <p class="eyebrow mb-3">01 Project truth</p>
        <h2
          id="project-truth-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Give every session the same starting point.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          <InlineBrandText
            text="moldea saves the facts, responsibilities, and decisions that future coding agents need. Temporary sprint details stay out."
          />
        </p>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">
          Start once with <InlineBrandText text="Initialize moldea" />. Initialization creates the
          smallest useful foundation and does not create an agent automatically.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
          <ActionLink
            class="font-bold"
            href={withBase('/docs/project-state/', basePath)}
            variant="link"
          >
            Project state guide
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/examples/initialize-a-project/', basePath)}
            variant="link"
          >
            See initialization
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/examples/add-project-context/', basePath)}
            variant="link"
          >
            Add project context
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>

      <div data-project-truth-visual>
        <CapabilityConversation ariaLabel="Developer and coding agent project context conversation">
          <p slot="request">
            Our support team can approve refunds up to <code class="inline-code">$100</code>.
            Finance approves anything higher.
          </p>
          <p slot="response">
            I saved the rule and its owner, so future sessions start with the same answer.
          </p>

          <div class="grid gap-3 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <div class="rounded-xl border border-border bg-background p-3 sm:p-4">
              <div class="flex items-center gap-2 text-sm font-semibold">
                <FolderTree
                  class="size-4 text-muted-foreground"
                  aria-hidden="true"
                />
                <code>storefront/</code>
              </div>
              <ul
                class="ms-1 mt-3 border-s border-border ps-3 text-xs sm:ms-2 sm:ps-4 sm:text-sm"
                aria-label="Saved project files"
              >
                <li
                  class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                >
                  <code class="font-semibold">moldea/</code>
                  <ul
                    class="ms-1 mt-2 grid gap-2 border-s border-border ps-3 text-muted-foreground sm:ms-2 sm:ps-4"
                  >
                    <li
                      class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                    >
                      <code>moldea.yaml</code>
                    </li>
                    <li
                      class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                    >
                      <code>project.md</code>
                    </li>
                    <li
                      class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                    >
                      <code class="text-foreground">context/</code>
                      <ul class="ms-1 mt-2 border-s border-border ps-3 sm:ms-2 sm:ps-4">
                        <li
                          class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                        >
                          <code>refunds.md</code>
                        </li>
                      </ul>
                    </li>
                  </ul>
                </li>
              </ul>
            </div>

            <div
              class="rounded-xl border border-emerald-600/30 bg-emerald-600/10 p-4 dark:border-emerald-400/30 dark:bg-emerald-400/10"
            >
              <p
                class="flex items-center gap-2 text-sm font-semibold text-emerald-800 dark:text-emerald-200"
              >
                <CircleCheck
                  class="size-4 shrink-0"
                  aria-hidden="true"
                />
                Saved as project truth
              </p>
              <blockquote class="mt-3 text-sm leading-6 font-semibold">
                “Support approves refunds up to <code>$100</code>. Finance reviews larger refunds.”
              </blockquote>
              <p class="mt-3 text-xs leading-5 text-muted-foreground">
                Stored beside the code and reviewed through Git.
              </p>
            </div>
          </div>
        </CapabilityConversation>
      </div>
    </div>
  </section>

  <section
    id="plan-agent-systems"
    class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
    aria-labelledby="plan-agent-systems-title"
    data-capability-section
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3">02 Plan the system</p>
        <h2
          id="plan-agent-systems-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Put each responsibility where it belongs.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          The plan separates fixed rules, judgment, and approval before implementation begins. The
          right design may use zero, one, or several agents.
        </p>
      </header>

      <div
        class="mt-8"
        data-planning-visual
      >
        <CapabilityConversation ariaLabel="Developer and coding agent planning conversation">
          <p slot="request">
            Plan personalized promotions without giving the agent control over prices.
          </p>
          <p slot="response">
            I designed one focused agent. Software protects every price, and people approve the
            campaigns that need judgment.
          </p>

          <div class="grid gap-3 md:grid-cols-3">
            <article class="rounded-xl border border-border bg-background p-4 sm:p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex size-9 items-center justify-center rounded-lg bg-muted">
                  <Terminal
                    class="size-4"
                    aria-hidden="true"
                  />
                </span>
                <span class="text-xs font-bold text-muted-foreground">01</span>
              </div>
              <p class="eyebrow mt-4">Software</p>
              <h3 class="mt-1 font-semibold">Sets the allowed offer</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                Checks eligibility, inventory, and the final price.
              </p>
            </article>
            <article class="rounded-xl border border-border bg-background p-4 sm:p-5">
              <div class="flex items-center justify-between gap-3">
                <span
                  class="inline-flex size-9 items-center justify-center rounded-lg bg-secondary"
                >
                  <Bot
                    class="size-4"
                    aria-hidden="true"
                  />
                </span>
                <span class="text-xs font-bold text-muted-foreground">02</span>
              </div>
              <p class="eyebrow mt-4">Promotion agent</p>
              <h3 class="mt-1 font-semibold">Writes the message</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                Turns an approved offer into useful customer copy.
              </p>
            </article>
            <article class="rounded-xl border border-border bg-background p-4 sm:p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex size-9 items-center justify-center rounded-lg bg-muted">
                  <ShieldCheck
                    class="size-4"
                    aria-hidden="true"
                  />
                </span>
                <span class="text-xs font-bold text-muted-foreground">03</span>
              </div>
              <p class="eyebrow mt-4">Marketing team</p>
              <h3 class="mt-1 font-semibold">Approves higher-risk sends</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                Keeps consequential campaigns with accountable people.
              </p>
            </article>
          </div>

          <div
            class="mt-3 flex flex-wrap items-center justify-between gap-2 rounded-xl bg-muted/60 px-4 py-3 text-sm"
          >
            <span class="font-semibold">One useful agent, with clear limits.</span>
            <span class="text-muted-foreground">Planning is read-only.</span>
          </div>
        </CapabilityConversation>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/planning-agent-systems/', basePath)}
          variant="link"
        >
          Planning guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/examples/plan-an-agent-system/', basePath)}
          variant="link"
        >
          See the planning example
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </section>

  <section
    id="create-agents"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="create-agents-title"
    data-capability-section
  >
    <div
      class="page-shell grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-14"
    >
      <div>
        <p class="eyebrow mb-3">03 Create agents</p>
        <h2
          id="create-agents-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Build an agent from real project boundaries.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          Responsibilities, instructions, tools, schemas, and runtime wiring stay connected to the
          project that owns them.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
          <ActionLink
            class="font-bold"
            href={withBase('/docs/designing-agents/', basePath)}
            variant="link"
          >
            Agent design guide
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/examples/create-a-support-agent/', basePath)}
            variant="link"
          >
            See the complete example
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/evidence/qualification/', basePath)}
            variant="link"
          >
            Check runtime qualifications
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>

      <div
        class="rounded-2xl border border-border bg-card p-4 shadow-raised sm:p-6"
        data-agent-system-visual
      >
        <div
          class="mx-auto max-w-md rounded-2xl border border-border bg-background p-5 text-center"
        >
          <span
            class="mx-auto inline-flex size-11 items-center justify-center rounded-xl bg-secondary"
          >
            <img
              src={skillMarkPath}
              width="207"
              height="215"
              alt=""
              class="h-6 w-auto dark:invert"
            />
          </span>
          <p class="eyebrow mt-4">Support agent</p>
          <h3 class="mt-1 text-xl font-semibold">Answers refund questions</h3>
        </div>
        <div
          class="flex justify-center py-3 text-muted-foreground"
          aria-hidden="true"
        >
          <ArrowDown class="size-5" />
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-border bg-background p-4">
            <FileText
              class="size-5 text-muted-foreground"
              aria-hidden="true"
            />
            <p class="mt-3 text-sm font-semibold">Instructions</p>
            <code class="mt-1 block text-xs break-all text-muted-foreground">instruction.md</code>
          </div>
          <div class="rounded-xl border border-border bg-background p-4">
            <Search
              class="size-5 text-muted-foreground"
              aria-hidden="true"
            />
            <p class="mt-3 text-sm font-semibold">Order lookup</p>
            <code class="mt-1 block text-xs break-all text-muted-foreground">lookup-order</code>
          </div>
          <div class="rounded-xl border border-border bg-background p-4">
            <div class="flex items-center justify-between gap-3">
              <Bot
                class="size-5 text-muted-foreground"
                aria-hidden="true"
              />
              <AdapterCompanyLogo
                adapterId="openai"
                size="xs"
              />
            </div>
            <p class="mt-3 text-sm font-semibold">Runtime</p>
            <code class="mt-1 block text-xs break-all text-muted-foreground">gpt-6-astra</code>
          </div>
        </div>
        <p
          class="mt-4 flex items-center gap-2 text-sm font-semibold text-emerald-800 dark:text-emerald-200"
        >
          <Link2
            class="size-4"
            aria-hidden="true"
          />
          Every declared capability resolves to project evidence.
        </p>
      </div>
    </div>
  </section>

  <section
    id="build-agent-skills"
    class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
    aria-labelledby="build-agent-skills-title"
    data-capability-section
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3">04 Build Agent Skills</p>
        <h2
          id="build-agent-skills-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Package a repeatable workflow, not just a prompt.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          A skill explains when to activate, what guidance to load, what software to run, and how to
          verify the result.
        </p>
      </header>

      <div
        class="mt-8"
        data-skill-visual
      >
        <CapabilityConversation ariaLabel="Developer and coding agent skill creation conversation">
          <p slot="request">
            Create a release review skill using our policy and existing verifier.
          </p>
          <p slot="response">
            I created the release review workflow and kept its guidance, check, and report together.
          </p>

          <div class="grid gap-3 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
            <div class="rounded-xl border border-border bg-background p-3 sm:p-5">
              <div class="flex items-center gap-2 text-sm font-semibold">
                <FolderTree
                  class="size-4 text-muted-foreground"
                  aria-hidden="true"
                />
                <code>release-review/</code>
              </div>
              <ul
                class="ms-1 mt-3 grid gap-2 border-s border-border ps-3 text-xs sm:ms-2 sm:ps-4 sm:text-sm"
                aria-label="Release review skill files"
              >
                <li
                  class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                >
                  <code>SKILL.md</code>
                </li>
                <li
                  class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                >
                  <code class="font-semibold">references/</code>
                  <ul
                    class="ms-1 mt-2 border-s border-border ps-3 text-muted-foreground sm:ms-2 sm:ps-4"
                  >
                    <li
                      class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                    >
                      <code>policy.md</code>
                    </li>
                  </ul>
                </li>
                <li
                  class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                >
                  <code class="font-semibold">scripts/</code>
                  <ul
                    class="ms-1 mt-2 border-s border-border ps-3 text-muted-foreground sm:ms-2 sm:ps-4"
                  >
                    <li
                      class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                    >
                      <code>verify.mjs</code>
                    </li>
                  </ul>
                </li>
                <li
                  class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                >
                  <code class="font-semibold">assets/</code>
                  <ul
                    class="ms-1 mt-2 border-s border-border ps-3 text-muted-foreground sm:ms-2 sm:ps-4"
                  >
                    <li
                      class="relative before:absolute before:top-3 before:-left-3 before:w-2 before:border-t before:border-border sm:before:-left-4 sm:before:w-3"
                    >
                      <code>report.md</code>
                    </li>
                  </ul>
                </li>
              </ul>
            </div>

            <div class="rounded-xl border border-border bg-background p-4 sm:p-5">
              <p class="eyebrow">Release review</p>
              <ol class="mt-4 grid gap-3">
                <li class="flex items-center gap-3">
                  <span
                    class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted"
                  >
                    <FileText
                      class="size-4"
                      aria-hidden="true"
                    />
                  </span>
                  <span class="min-w-0 text-sm font-semibold">Policy loaded only when needed</span>
                </li>
                <li class="flex items-center gap-3">
                  <span
                    class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted"
                  >
                    <Terminal
                      class="size-4"
                      aria-hidden="true"
                    />
                  </span>
                  <span class="min-w-0 text-sm font-semibold">Deterministic verifier runs</span>
                </li>
                <li class="flex items-center gap-3">
                  <span
                    class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted"
                  >
                    <FileCheck
                      class="size-4"
                      aria-hidden="true"
                    />
                  </span>
                  <span class="min-w-0 text-sm font-semibold">Review uses the report template</span>
                </li>
              </ol>
              <p
                class="mt-4 flex items-center gap-2 rounded-lg bg-emerald-600/10 px-3 py-2.5 text-sm font-semibold text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-200"
              >
                <Check
                  class="size-4 shrink-0"
                  aria-hidden="true"
                />
                One reusable workflow, ready for the next release
              </p>
            </div>
          </div>
        </CapabilityConversation>
      </div>

      <div class="mt-5">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/designing-skills/', basePath)}
          variant="link"
        >
          Skill design guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </section>

  <section
    id="keep-behavior-current"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="keep-behavior-current-title"
    data-capability-section
  >
    <div class="page-shell">
      <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
        <div>
          <p class="eyebrow mb-3">05 Keep behavior current</p>
          <h2
            id="keep-behavior-current-title"
            class="text-3xl font-semibold tracking-tight sm:text-4xl"
          >
            Change one rule. Follow every connection.
          </h2>
        </div>
        <p class="text-base leading-7 text-muted-foreground">
          A product change can affect application logic, tests, project context, and agent guidance.
          The coding agent follows the declared connections before editing.
        </p>
      </header>

      <div
        class="mt-8"
        data-maintenance-visual
      >
        <CapabilityConversation ariaLabel="Developer and coding agent maintenance conversation">
          <p slot="request">
