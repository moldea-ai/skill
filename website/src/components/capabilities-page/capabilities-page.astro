    data-capability-section
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3">06 Evaluate and repair</p>
        <h2
          id="evaluate-and-repair-title"
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          Inspect first. Repair only when asked.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          Evaluation reports what is wrong without writing files. Reconciliation corrects drift.
          Validation checks the repository structure. Each operation keeps a distinct promise.
        </p>
      </header>

      <div
        class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-border bg-border md:grid-cols-3"
        data-evaluation-visual
      >
        {
          [
            {
              description: 'Read-only findings about alignment and evidence.',
              icon: Search,
              title: 'Evaluate',
            },
            {
              description: 'The smallest authorized correction to intended state.',
              icon: Wrench,
              title: 'Reconcile',
            },
            {
              description: 'Deterministic format and relationship checks.',
              icon: FileCheck,
              title: 'Validate',
            },
          ].map(({ description, icon: OperationIcon, title }) => (
            <article class="bg-card p-5 sm:p-6">
              <OperationIcon
                class="size-5 text-muted-foreground"
                aria-hidden="true"
              />
              <h3 class="mt-4 text-lg font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
            </article>
          ))
        }
      </div>

      <div
        class="mt-6"
        data-repair-visual
      >
        <CapabilityConversation ariaLabel="Developer and coding agent repair conversation">
          <p slot="request">Fix <InlineBrandText text="moldea" />.</p>
          <p slot="response">
            I found the broken instruction link, repaired it, and ran the deterministic check again.
          </p>

          <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center">
            <div class="rounded-xl border border-destructive/30 bg-destructive/10 p-4">
              <p class="flex items-center gap-2 text-sm font-semibold text-foreground">
                <Unlink
                  class="size-4 text-destructive"
                  aria-hidden="true"
                />Broken link
              </p>
              <div class="mt-3 rounded-lg border border-destructive/20 bg-background/70 p-3">
                <code class="block text-xs break-all">moldea/agents/support/instructions.md</code>
                <p class="mt-2 text-xs text-muted-foreground">File not found</p>
              </div>
            </div>
            <ArrowRight
              class="mx-auto hidden size-5 text-muted-foreground sm:block"
              aria-hidden="true"
            />
            <ArrowDown
              class="mx-auto size-5 text-muted-foreground sm:hidden"
              aria-hidden="true"
            />
            <div
              class="rounded-xl border border-emerald-600/30 bg-emerald-600/10 p-4 dark:border-emerald-400/30 dark:bg-emerald-400/10"
            >
              <p
                class="flex items-center gap-2 text-sm font-semibold text-emerald-800 dark:text-emerald-200"
              >
                <Link2
                  class="size-4"
                  aria-hidden="true"
                />Connection restored
              </p>
              <div
                class="mt-3 rounded-lg border border-emerald-600/20 bg-background/70 p-3 dark:border-emerald-400/20"
              >
                <code class="block text-xs break-all">moldea/agents/support/instruction.md</code>
                <p
                  class="mt-2 flex items-center gap-2 text-xs font-semibold text-emerald-800 dark:text-emerald-200"
                >
                  <Check
                    class="size-3.5 shrink-0"
                    aria-hidden="true"
                  />Deterministic validation passed
                </p>
              </div>
            </div>
          </div>
        </CapabilityConversation>
      </div>
      <p class="mt-5 max-w-4xl text-sm leading-6 text-muted-foreground">
        Repair requires a previously initialized project and existing evidence. It does not silently
        initialize a project, guess a policy, upgrade dependencies, or claim completion before
        checks pass.
      </p>
