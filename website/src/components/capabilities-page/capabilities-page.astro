---
import { ArrowRight, ChevronDown } from '@lucide/astro';
import ActionButton from '@moldea.ai/website-ui/action-button';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Dialog from '@moldea.ai/website-ui/dialog';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';
import { CAPABILITY_CATEGORIES } from '../../lib/capability-examples/index.ts';
import { PRODUCT_PAGE_METADATA } from '../../lib/model/constants.ts';
import CapabilityExample from './capability-example/capability-example.astro';

const basePath = import.meta.env.BASE_URL;
const pageMetadata = PRODUCT_PAGE_METADATA.capabilities;
---

<BaseLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
>
  <header class="border-b border-border bg-background sm:border-y">
    <div class="page-shell py-10 sm:py-16 lg:py-20">
      <div class="max-w-4xl">
        <p class="eyebrow mb-4">Capabilities</p>
        <h1 class="page-title">Project context first. Agent capabilities when you need them.</h1>
        <p class="mt-5 max-w-3xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          <InlineBrandText
            text="Explore 48 ways to use moldea for project knowledge, agent design, maintenance, and repair. Start with a request, follow the connected artifacts, and see what still needs your judgment."
          />
        </p>
        <div class="mt-5">
          <Dialog
            id="capabilities-reading-guide"
            title="Reading the examples"
            triggerLabel="About these examples"
            triggerVariant="outline"
            triggerSize="sm"
            closeLabel="Close example guidance"
            isOverlayCloseEnabled
          >
            <div class="space-y-4 text-sm leading-6 text-muted-foreground">
              <p>
                These are suggested requests and illustrative outcomes. Source previews from the
                support and booking projects share their executable fixtures. Other diagrams explain
                the documented workflow or a named adapter fixture.
              </p>
              <p>
                Each example states its evidence boundary. A completed static check does not prove
                every runtime behavior, and an unverified relationship does not prove a defect.
              </p>
              <p>
                For independently recorded coding sessions and their results, visit <a
                  class="font-semibold text-foreground underline underline-offset-4"
                  href={withBase('/evidence/', basePath)}
                  >Evidence</a
                >.
              </p>
            </div>
          </Dialog>
        </div>
      </div>
      <nav
        class="mt-8 sm:mt-10"
        aria-label="Capabilities on this page"
      >
        <ul
          class="grid divide-y divide-border border-y border-border sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-3"
        >
          {
            CAPABILITY_CATEGORIES.map((category, index) => (
              <li>
                <a
                  class="group flex h-full items-center gap-3 px-1 py-4 text-sm font-semibold text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring focus-visible:outline-solid sm:px-4"
                  href={`#${category.id}`}
                >
                  <span
                    class="text-xs font-normal text-muted-foreground"
                    aria-hidden="true"
                  >
                    0{index + 1}
                  </span>
                  <span class="min-w-0">{category.label}</span>
                  <ArrowRight
                    class="ml-auto size-4 shrink-0 text-muted-foreground"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>
  {
    CAPABILITY_CATEGORIES.map((category, index) => (
      <section
        id={category.id}
        class="scroll-mt-24 border-b border-border py-10 sm:py-16"
        aria-labelledby={`${category.id}-title`}
        data-capability-section
      >
        <div class="page-shell">
          <div class="mb-3 max-w-3xl sm:mb-8">
            <p class="eyebrow mb-3">
              0{index + 1} {category.label}
            </p>
            <h2
              id={`${category.id}-title`}
              class="section-title"
            >
              {category.title}
            </h2>
            <p class="mt-4 text-base leading-7 text-muted-foreground">
              <InlineBrandText text={category.description} />
            </p>
            <a
              class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring focus-visible:outline-solid"
              href={withBase(category.guide.href, basePath)}
              aria-label={`${category.guide.label} guide`}
            >
              <>
                <InlineBrandText text={category.guide.label} />
                <ArrowRight
                  class="size-4"
                  aria-hidden="true"
                />
              </>
            </a>
          </div>
          <div
            id={`${category.id}-examples`}
            class="grid min-w-0 grid-cols-1 gap-x-6 sm:gap-y-6 lg:grid-cols-2"
            data-capability-list
          >
            {category.examples.slice(0, 4).map((example) => (
              <CapabilityExample example={example} />
            ))}
          </div>
          <noscript>
            <div class="grid min-w-0 grid-cols-1 gap-x-6 sm:mt-6 sm:gap-y-6 lg:grid-cols-2">
              {category.examples.slice(4).map((example) => (
                <CapabilityExample example={example} />
              ))}
            </div>
          </noscript>
          <template data-capability-more>
            {category.examples.slice(4).map((example) => (
              <CapabilityExample
                example={example}
                idPrefix="pending-"
              />
            ))}
          </template>
          <div class="mt-3 flex justify-center pt-1">
            <ActionButton
              hidden
              variant="outline"
              class="w-full sm:w-auto"
              aria-controls={`${category.id}-examples`}
              aria-label={`Load 4 more examples: ${category.label}`}
              data-capability-load
            >
              <ChevronDown
                class="size-4"
                aria-hidden="true"
              />
              Load more
            </ActionButton>
          </div>
          <p
            class="mt-2 text-center text-xs text-muted-foreground"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            data-capability-count
          >
            <span
              data-capability-enhanced-count
              hidden
            >
              4 of 8 examples
            </span>
            <noscript>8 of 8 examples</noscript>
          </p>
        </div>
      </section>
    ))
  }
  <section
    class="bg-elevated py-10 sm:py-16"
    aria-label="See these capabilities work"
  >
    <div class="page-shell flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-base leading-7 text-muted-foreground">
        Follow one complete booking workflow, or explore the operating guidance behind each example.
      </p>
      <div class="flex flex-wrap gap-3">
        <ActionLink
          href={withBase('/how-it-works/', basePath)}
          variant="primary"
          >How it works<ArrowRight
            class="size-4"
            aria-hidden="true"
          /></ActionLink
        >
        <ActionLink
          href={withBase('/docs/', basePath)}
          variant="outline"
          >Read the docs</ActionLink
        >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initializeCapabilityDisclosure, disposeCapabilityDisclosure } from './disclosure.ts';

  initializeCapabilityDisclosure();
  document.addEventListener('astro:page-load', initializeCapabilityDisclosure);
  document.addEventListener('astro:before-swap', disposeCapabilityDisclosure);
</script>
