---
import { UserRound } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

// content and accessible name for one capability conversation
export interface Props {
  ariaLabel: string;
}

const { ariaLabel } = Astro.props;
const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<ol
  class="relative grid gap-4"
  aria-label={ariaLabel}
  data-capability-conversation
>
  <li class="relative flex max-w-3xl items-start gap-3">
    <span
      class="absolute top-9 -bottom-4 left-[1.125rem] w-px bg-border"
      aria-hidden="true"
    ></span>
    <span
      class="dark-surface-selection relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground"
      aria-hidden="true"
    >
      <UserRound
        class="size-4"
        aria-hidden="true"
      />
    </span>
    <div
      class="rounded-2xl rounded-tl-sm border border-border bg-background px-4 py-3 shadow-surface"
    >
      <p class="mb-1 text-xs font-semibold text-muted-foreground">You</p>
      <div class="text-sm leading-6 font-medium sm:text-base">
        <slot name="request" />
      </div>
    </div>
  </li>

  <li class="flex min-w-0 items-start gap-3">
    <span
      class="relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-secondary"
      aria-hidden="true"
    >
      <img
        src={skillMarkPath}
        width="207"
        height="215"
        alt=""
        class="h-5 w-auto dark:invert"
      />
    </span>
    <article class="min-w-0 flex-1">
      <div
        class="overflow-hidden rounded-2xl rounded-tl-sm border border-border bg-card p-3 shadow-raised sm:p-5"
      >
        <p class="mb-1 text-xs font-semibold text-muted-foreground">Coding agent</p>
        <div class="text-sm leading-6 font-medium sm:text-base">
          <slot name="response" />
        </div>
        <div class="mt-4">
          <slot />
        </div>
      </div>
    </article>
  </li>
</ol>
