---
import { UserRound } from '@lucide/astro';
import Conversation from '@moldea.ai/website-ui/conversation';
import ConversationMessage from '@moldea.ai/website-ui/conversation-message';
import { withBase } from '@moldea.ai/website-ui/site';

// Skill-specific avatars and request/response slots around the shared conversation.
export interface Props {
  ariaLabel: string;
}
const { ariaLabel } = Astro.props;
const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<Conversation {ariaLabel}>
  <ConversationMessage role="user">
    <span
      slot="avatar"
      class="inline-flex size-8 items-center justify-center rounded-xl bg-primary text-primary-foreground"
      aria-hidden="true"
      ><UserRound class="size-4" /></span
    >
    <div class="text-sm leading-6 font-medium sm:text-base"><slot name="request" /></div>
  </ConversationMessage>
  <ConversationMessage role="assistant">
    <img
      slot="avatar"
      src={skillMarkPath}
      width="207"
      height="215"
      alt=""
      class="dark:invert"
    />
    <div class="text-sm leading-6 font-medium sm:text-base"><slot name="response" /></div>
    <div class="mt-4 min-w-0"><slot /></div>
  </ConversationMessage>
</Conversation>
