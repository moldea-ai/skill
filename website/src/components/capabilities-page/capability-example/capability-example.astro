---
import { ArrowUpRight } from '@lucide/astro';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import CodeDiff from '@moldea.ai/website-ui/code-diff';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import type { ICapabilityExample } from '../../../lib/capability-examples/index.ts';

interface Props {
  example: ICapabilityExample;
  idPrefix?: string;
}

const { example, idPrefix = '' } = Astro.props;
const exampleId = `${idPrefix}${example.id}`;
const { visual } = example;
const basePath = import.meta.env.BASE_URL;
---

<article
  id={exampleId}
  class="min-w-0 scroll-mt-24 border-b border-border py-6 wrap-anywhere outline-offset-4 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-solid sm:rounded-xl sm:border sm:bg-card sm:p-6"
  aria-labelledby={`${exampleId}-title`}
  tabindex="-1"
  data-capability-example
>
  <h3
    id={`${exampleId}-title`}
    class="text-xl leading-7 font-bold tracking-tight text-foreground outline-offset-4 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-solid"
    tabindex="-1"
  >
    <InlineBrandText text={example.title} />
  </h3>
  <div class="mt-4 border-l-2 border-primary/50 pl-3">
    <p class="text-xs font-semibold text-muted-foreground">Try this request</p>
    <p class="mt-1 text-sm leading-6 text-foreground">
      <InlineBrandText text={example.request} />
    </p>
  </div>
  <figure class="mt-5 min-w-0">
    {
      visual.kind === 'flow' ? (
        <ol
          class="grid min-w-0 grid-cols-1 gap-0"
          aria-label="How the example connects"
        >
          {visual.steps.map((step, index) => (
            <li class="relative flex gap-3 pb-4 last:pb-0">
              <span class="relative flex w-7 shrink-0 justify-center">
                <span
                  class="z-10 flex size-7 items-center justify-center rounded-full border border-border bg-secondary text-xs font-bold text-foreground"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                {index < visual.steps.length - 1 && (
                  <span
                    class="absolute top-7 bottom-0 border-l border-border"
                    aria-hidden="true"
                  />
                )}
              </span>
              <div class="min-w-0 pt-0.5">
                <p class="text-sm font-semibold text-foreground">
                  <InlineBrandText text={step.title} />
                </p>
                <p class="mt-1 text-sm leading-6 text-muted-foreground">
                  <InlineBrandText text={step.detail} />
                </p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <FilePreview path={visual.path}>
          {visual.kind === 'source' ? (
            <div class="bg-elevated p-3 sm:p-4 dark:bg-code">
              <CodeBlock
                ariaLabel={`${example.title} source`}
                source={visual.source}
                language={visual.language}
                copyable={false}
                variant="plain"
              />
            </div>
          ) : (
            <CodeDiff
              oldValue={visual.oldValue}
              newValue={visual.newValue}
              language={visual.language}
              ariaLabel={`${example.title} changes`}
              view="unified"
              variant="plain"
            />
          )}
        </FilePreview>
      )
    }
    <figcaption class="mt-3 text-xs leading-5 text-muted-foreground">
      <InlineBrandText text={visual.caption} />
    </figcaption>
  </figure>
  <dl class="mt-5 grid gap-3 text-sm leading-6">
    <div>
      <dt class="font-semibold text-foreground">Expected outcome</dt>
      <dd class="mt-1 text-muted-foreground"><InlineBrandText text={example.outcome} /></dd>
    </div>
    <div>
      <dt class="font-semibold text-foreground">Keep in mind</dt>
      <dd class="mt-1 text-muted-foreground"><InlineBrandText text={example.boundary} /></dd>
    </div>
  </dl>
  <a
    class="mt-4 inline-flex max-w-full items-center gap-1.5 text-sm font-semibold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring focus-visible:outline-solid"
    href={withBase(example.source.href, basePath)}
  >
    <InlineBrandText text={example.source.label} />
    <ArrowUpRight
      class="size-3.5 shrink-0"
      aria-hidden="true"
    />
  </a>
</article>
