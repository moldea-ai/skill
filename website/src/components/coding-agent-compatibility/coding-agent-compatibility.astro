---
import { ArrowRight } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

const basePath = import.meta.env.BASE_URL;

const codingAgents = [
  {
    company: 'OpenAI',
    height: 300,
    logoPath: '/coding-agents/codex.svg',
    name: 'Codex',
    width: 300,
  },
  {
    company: 'Anthropic',
    height: 248,
    logoPath: '/coding-agents/claude-code.svg',
    name: 'Claude Code',
    width: 248,
  },
  {
    company: 'Anysphere',
    height: 532,
    logoPath: '/coding-agents/cursor.svg',
    name: 'Cursor',
    width: 467,
  },
  {
    company: 'Anomaly',
    height: 300,
    logoPath: '/coding-agents/opencode.svg',
    name: 'OpenCode',
    width: 300,
  },
  {
    company: 'GitHub',
    height: 96,
    logoPath: '/coding-agents/github-copilot.svg',
    name: 'GitHub Copilot',
    width: 96,
  },
  {
    company: 'Cline',
    height: 96,
    logoPath: '/coding-agents/cline.svg',
    name: 'Cline',
    width: 92,
  },
] as const;
---

<section
  class="border-y border-border bg-sidebar py-section-gap"
  aria-labelledby="coding-agent-compatibility-title"
>
  <div class="page-shell">
    <header class="mb-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-end">
      <div>
        <p class="eyebrow mb-4">Host-agnostic by design</p>
        <h2
          id="coding-agent-compatibility-title"
          class="section-title max-w-4xl font-semibold"
        >
          Use the coding agent you already trust.
        </h2>
      </div>
      <div class="lg:justify-self-end">
        <p class="text-lg leading-8 text-muted-foreground">
          <InlineBrandText
            text="moldea is a portable Agent Skill. Install the same grounded operating layer in compatible hosts without changing how your team asks for work."
          />
        </p>
      </div>
    </header>

    <ul
      class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-3 lg:grid-cols-6"
    >
      {
        codingAgents.map(({ company, height, logoPath, name, width }) => (
          <li
            class="flex min-w-0 flex-col items-center justify-center bg-background px-3 py-6 text-center"
            data-coding-agent-card={name}
          >
            <div class="flex h-12 items-center justify-center">
              <img
                class:list={[
                  'size-10 object-contain',
                  name !== 'Claude Code' && name !== 'OpenCode' && 'dark:invert',
                ]}
                src={withBase(logoPath, basePath)}
                width={width}
                height={height}
                alt=""
                loading="lazy"
                decoding="async"
                data-coding-agent-mark
              />
            </div>
            <h3 class="mt-3 font-semibold tracking-tight">{name}</h3>
            <p class="mt-1 text-xs text-muted-foreground">{company}</p>
          </li>
        ))
      }
    </ul>

    <ActionLink
      class="mt-5 font-bold"
      href={withBase('/docs/coding-agent-compatibility/', basePath)}
      variant="link"
    >
      Read the compatibility guide
      <ArrowRight
        class="size-4"
        aria-hidden="true"
      />
    </ActionLink>
  </div>
</section>
