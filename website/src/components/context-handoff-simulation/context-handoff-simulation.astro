---
import { ArrowRight } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { withBase } from '@moldea.ai/website-ui/site';

import Conversation from '../conversation/conversation.astro';
import type { IConversationTurn } from '../conversation/types.ts';

const basePath = import.meta.env.BASE_URL;

const requestedHandoffConversation = [
  {
    role: 'agent',
    message:
      'I found an invoice-processing service, but the repository does not establish whether it only extracts invoice data or also authorizes payment decisions. Which boundary is correct?',
  },
  {
    role: 'developer',
    message:
      'It extracts and validates invoice data for accounting systems. It never authorizes payments.',
  },
  {
    role: 'agent',
    message:
      'Understood. I’ll use that boundary to complete the project foundation without inventing payment authority.',
  },
] satisfies IConversationTurn[];
const proactiveHandoffConversation = [
  {
    role: 'developer',
    message:
      'Platform owns the application runtime and delivery pipeline. Product owns workflow definitions. Security approves production access.',
  },
  {
    role: 'agent',
    message:
      'I checked those responsibilities against the existing project context. They establish durable ownership and approval boundaries, so I kept them with the project without inventing new runtime or agent behavior.',
  },
] satisfies IConversationTurn[];
---

<section
  class="page-shell py-section-gap"
  aria-labelledby="context-handoff-title"
>
  <header class="mb-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-end">
    <div>
      <p class="eyebrow mb-4">Context handoff</p>
      <h2
        id="context-handoff-title"
        class="section-title max-w-4xl font-semibold"
      >
        The agent can ask. You can also lead.
      </h2>
    </div>
    <p class="text-lg leading-8 text-muted-foreground lg:justify-self-end">
      Answer a focused question or share what you know. The agent checks it against repository
      evidence before deciding what belongs in durable project context.
    </p>
  </header>

  <div class="grid gap-5 lg:grid-cols-2">
    <Conversation
      eyebrow="When the agent asks"
      title="Answer the missing boundary."
      description="A focused reply is enough for the work to continue."
      turns={requestedHandoffConversation}
    />

    <Conversation
      eyebrow="When you already have context"
      title="Share what is true."
      description="No special command is needed after adoption."
      turns={proactiveHandoffConversation}
    />
  </div>

  <ActionLink
    class="mt-8 font-bold"
    href={withBase('/examples/', basePath)}
    variant="link"
  >
    Browse interaction examples
    <ArrowRight
      class="size-4"
      aria-hidden="true"
    />
  </ActionLink>
</section>
