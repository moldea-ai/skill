---
import { Bot, UserRound } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IConversationTurn } from './types.ts';

interface Props {
  description?: string;
  eyebrow: string;
  title: string;
  turns: IConversationTurn[];
}

const { description, eyebrow, title, turns } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const roleDetails = {
  agent: { icon: Bot, label: 'Coding agent' },
  developer: { icon: UserRound, label: 'Developer' },
  skill: { icon: null, label: 'Skill guidance' },
} as const;
---

<section class="surface-card overflow-hidden">
  <header class="border-b border-border bg-muted/50 p-5 sm:p-6">
    <p class="eyebrow mb-2">{eyebrow}</p>
    <h3 class="text-xl font-semibold tracking-tight">{title}</h3>
    {description && <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>}
  </header>
  <ol class="grid gap-4 p-4 sm:p-6">
    {
      turns.map((turn) => {
        const { icon: RoleIcon, label } = roleDetails[turn.role];
        const messageSegments =
          typeof turn.message === 'string'
            ? [{ kind: 'text', text: turn.message } as const]
            : turn.message;

        return (
          <li class:list={['flex gap-3', turn.role === 'developer' ? 'sm:pe-10' : 'sm:ps-10']}>
            <span
              class:list={[
                'mt-1 inline-flex size-8 shrink-0 items-center justify-center rounded-lg',
                turn.role === 'skill'
                  ? 'bg-accent text-accent-foreground'
                  : 'bg-primary text-primary-foreground',
              ]}
            >
              {RoleIcon ? (
                <RoleIcon
                  class="size-4"
                  aria-hidden="true"
                />
              ) : (
                <>
                  <img
                    class="h-5 w-auto dark:hidden"
                    src={withBase('/logo/icon-xs-light.png', basePath)}
                    width="207"
                    height="215"
                    alt=""
                    data-skill-guidance-mark
                  />
                  <img
                    class="hidden h-5 w-auto dark:block"
                    src={withBase('/logo/icon-xs-dark.png', basePath)}
                    width="207"
                    height="215"
                    alt=""
                    data-skill-guidance-mark
                  />
                </>
              )}
            </span>
            <div class="min-w-0 flex-1 rounded-xl border bg-background p-4">
              <p class="mb-1 text-xs font-bold tracking-wide text-muted-foreground uppercase">
                {label}
              </p>
              <p class="leading-7">
                {messageSegments.map((segment) =>
                  segment.kind === 'code' ? (
                    <code class="rounded-md bg-code px-1.5 py-1 font-mono text-[0.86em] font-semibold text-code-foreground">
                      {segment.text}
                    </code>
                  ) : (
                    segment.text
                  ),
                )}
              </p>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
