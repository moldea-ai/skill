---
import { ExternalLink } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import type { IBreadcrumb } from '@moldea.ai/website-ui/breadcrumbs';
import DocumentationShell from '@moldea.ai/website-ui/documentation-shell';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import type { IRenderedMarkdownHeading } from '@moldea.ai/website-ui/markdown';

import { SKILLS_DIRECTORY_URL, SOURCE_REPOSITORY_URL } from '../../lib/model/constants.ts';
import type { INavigationGroup, ISkillMetadata, IWebsiteDocument } from '../../lib/model/types.ts';

interface Props {
  breadcrumbs: IBreadcrumb[];
  currentDocument: IWebsiteDocument;
  headings: readonly IRenderedMarkdownHeading[];
  navigation: INavigationGroup[];
  orderedDocuments: IWebsiteDocument[];
  skill: ISkillMetadata;
}

const { breadcrumbs, currentDocument, headings, navigation, orderedDocuments, skill } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const currentIndex = orderedDocuments.findIndex(({ route }) => route === currentDocument.route);
const previousDocument = currentIndex > 0 ? orderedDocuments[currentIndex - 1] : undefined;
const nextDocument =
  currentIndex >= 0 && currentIndex < orderedDocuments.length - 1
    ? orderedDocuments[currentIndex + 1]
    : undefined;
const adjacentPages = {
  ...(previousDocument === undefined
    ? {}
    : {
        previousPage: {
          href: previousDocument.route,
          label: previousDocument.navigationTitle,
        },
      }),
  ...(nextDocument === undefined
    ? {}
    : {
        nextPage: {
          href: nextDocument.route,
          label: nextDocument.navigationTitle,
        },
      }),
};
const navigationGroups = navigation.map((group) => ({
  items: group.documents.map((document) => ({
    href: document.route,
    label: document.navigationTitle,
  })),
  label: group.label,
}));
---

<DocumentationShell
  {basePath}
  {breadcrumbs}
  currentRoute={currentDocument.route}
  {headings}
  navigationAriaLabel="Documentation navigation"
  {navigationGroups}
  {...adjacentPages}
>
  <header
    slot="header"
    class="mb-10 border-b border-border pb-8"
  >
    <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
      <span class="inline-flex items-center rounded-full border bg-muted px-3 py-1.5 font-semibold">
        v{skill.version}
      </span>
      <span class="text-muted-foreground">Portable Agent Skill</span>
    </div>
    <h1 class="page-title">
      <InlineBrandText
        text={currentDocument.title}
        variant="compact"
      />
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">
      <InlineBrandText
        text={currentDocument.description}
        variant="compact"
      />
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <ActionLink
        class="font-bold"
        href={SKILLS_DIRECTORY_URL}
        size="md"
        target="_blank"
        rel="noopener noreferrer"
        data-primary-action
      >
        Get the skill
        <ExternalLink
          class="size-3.5"
          aria-hidden="true"
        />
      </ActionLink>
      <ActionLink
        class="font-bold"
        href={`${SOURCE_REPOSITORY_URL}/blob/main/${currentDocument.sourcePath}`}
        size="md"
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
      >
        View source
        <ExternalLink
          class="size-3.5"
          aria-hidden="true"
        />
      </ActionLink>
    </div>
  </header>

  <slot />
</DocumentationShell>
