---
import { ArrowRight } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

interface Props {
  description: string;
  href: string;
  metric: string;
  questions: string[];
  title: string;
}

const { description, href, metric, questions, title } = Astro.props;
const basePath = import.meta.env.BASE_URL;
---

<a
  class="surface-card interactive-card group flex min-w-0 flex-col p-5 sm:p-7"
  href={withBase(href, basePath)}
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="inline-flex size-11 items-center justify-center rounded-xl bg-muted text-foreground"
    >
      <slot name="icon" />
    </span>
    <span
      class="rounded-full border border-success bg-success px-3 py-1 text-xs font-bold text-success-foreground"
    >
      Passed
    </span>
  </div>
  <p class="eyebrow mt-6">{metric}</p>
  <h2 class="mt-2 text-2xl font-semibold tracking-tight">{title}</h2>
  <p class="mt-3 leading-7 text-muted-foreground">{description}</p>
  <div class="mt-6 border-t border-border pt-5">
    <p class="text-sm font-semibold">Use this evidence to answer:</p>
    <ul class="mt-3 grid gap-2 text-sm leading-6 text-muted-foreground">
      {questions.map((question) => <li>{question}</li>)}
    </ul>
  </div>
  <span class="mt-6 inline-flex items-center gap-2 font-semibold text-link">
    Review the evidence
    <ArrowRight
      class="size-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none motion-reduce:transition-none"
      aria-hidden="true"
    />
  </span>
</a>
