---
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import type { IEvidenceDisplayStatus } from '../evidence-status/types.ts';
interface Props {
  description: string;
  status: IEvidenceDisplayStatus;
  title: string;
}
const { description, status, title } = Astro.props;
---

<section class="surface-card flex min-w-0 flex-col p-5 sm:p-7">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 class="max-w-xl text-2xl font-semibold tracking-tight">{title}</h2><EvidenceStatus
      {status}
    />
  </div><p class="mt-3 max-w-2xl leading-7 text-muted-foreground">{description}</p><div
    class="mt-6 min-w-0"
  >
    <slot name="visual" />
  </div><div class="mt-auto pt-6"><slot name="actions" /></div>
</section>
