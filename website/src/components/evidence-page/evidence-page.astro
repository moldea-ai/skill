---
import { ArrowRight, Bot, GitBranch, Link2, Search, ShieldCheck } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../adapter-company-logo/adapter-company-logo.astro';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import {
  getQualificationReleaseEvidenceSummary,
  getSemanticReleaseEvidenceSummary,
} from '../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const semanticSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  model.currentSemanticAssurance,
);
const decisionStatus = semanticSummary.result?.status ?? model.semanticEvaluation.status;
const anthropicProfile = model.qualification.profiles.find(
  ({ adapterId }) => adapterId === 'anthropic',
);
const qualificationStatus = anthropicProfile
  ? getQualificationReleaseEvidenceSummary(anthropicProfile).status
  : 'not-recorded';
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Evidence' }];
const integrationLogos = [
  'anthropic',
  'cloudflare-agents',
  'google-genai',
  'langchain',
  'openai',
  'vercel-ai-sdk',
] as const;
const decisionSteps = [
  { icon: Search, label: 'Find the relevant project rule' },
  { icon: Link2, label: 'Follow it to the code it governs' },
  { icon: ShieldCheck, label: 'Respect the boundary and explain the result' },
] as const;
---

<BaseLayout
  title="Evidence"
  description="See how moldea gives coding agents durable project context, then inspect the decisions and integrations used to verify it."
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="relative mt-6 overflow-hidden border-y border-border">
    <HeroBackdrop />
    <div class="page-shell relative py-12 sm:py-16 lg:py-20">
      <div class="max-w-5xl">
        <p class="eyebrow mb-4">Why not just use a coding agent?</p>
        <h1 class="section-title font-semibold">
          The agent writes code. <code class="inline-code">moldea</code> gives the project a memory.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
          A coding agent can inspect your repository. <code class="inline-code">moldea</code> gives it
          maintained context about which decisions matter, what they govern, and how to check the result,
          all in Git.
        </p>
      </div>

      <section
        class="surface-card mt-10 overflow-hidden shadow-raised"
        aria-labelledby="same-request-title"
      >
        <div
          class="flex flex-wrap items-center gap-3 border-b border-border bg-muted/40 p-5 sm:p-6"
        >
          <span class="inline-flex size-10 items-center justify-center rounded-xl bg-background">
            <Bot
              class="size-5"
              aria-hidden="true"
            />
          </span>
          <div>
            <p class="text-xs font-bold tracking-[0.12em] text-muted-foreground uppercase">
              Same coding agent, same request
            </p>
            <h2
              id="same-request-title"
              class="mt-1 text-xl font-semibold"
            >
              “Change refunds to 30 days.”
            </h2>
          </div>
        </div>

        <div class="grid lg:grid-cols-2">
          <article
            class="min-w-0 border-b border-border p-5 sm:p-6 lg:border-r lg:border-b-0 lg:p-8"
          >
            <p class="eyebrow mb-3">Coding agent alone</p>
            <h3 class="text-2xl font-semibold">The session starts by inferring the project.</h3>
            <div class="mt-5 overflow-hidden rounded-xl border border-border bg-muted/30 p-4">
              <p class="mb-3 text-xs font-bold text-muted-foreground uppercase">What it receives</p>
              <CodeBlock
                copyable={false}
                source={'Developer request\nChange refunds to 30 days.'}
                variant="plain"
              />
            </div>
            <ol class="mt-5 grid gap-3 text-sm leading-6 text-muted-foreground">
              <li class="flex gap-3">
                <span class="font-mono text-xs font-bold text-foreground">01</span>
                Search the repository for anything that looks relevant.
              </li>
              <li class="flex gap-3">
                <span class="font-mono text-xs font-bold text-foreground">02</span>
                Infer which code, guides, and agent behavior must stay aligned.
              </li>
            </ol>
            <p class="mt-6 border-t border-border pt-5 font-semibold">
              The next session has to infer those relationships again.
            </p>
          </article>

          <article class="min-w-0 p-5 sm:p-6 lg:p-8">
            <div class="flex flex-wrap items-center gap-3">
              <p class="eyebrow w-full sm:w-auto">
                Coding agent with <code class="font-mono">moldea</code>
              </p>
              <span class="rounded-full bg-foreground px-3 py-1 text-xs font-bold text-background">
                Context included
              </span>
            </div>
            <h3 class="mt-3 text-2xl font-semibold">The session starts from maintained context.</h3>
            <div class="mt-5 overflow-hidden rounded-xl border-2 border-foreground bg-muted/30 p-4">
              <p class="mb-3 text-xs font-bold text-muted-foreground uppercase">What it receives</p>
              <CodeBlock
                copyable={false}
                source={'Developer request + context\nRule: Refunds last 30 days.\nConnected:\n- refund behavior\n- support agent'}
                variant="plain"
              />
            </div>
            <ol class="mt-5 grid gap-3 text-sm leading-6 text-muted-foreground">
              <li class="flex gap-3">
                <span class="font-mono text-xs font-bold text-foreground">01</span>
                Read the saved decision and follow its connections to the project.
              </li>
              <li class="flex gap-3">
                <span class="font-mono text-xs font-bold text-foreground">02</span>
                Update the behavior and maintained context, then run the recorded checks.
              </li>
            </ol>
            <p class="mt-6 border-t border-border pt-5 font-semibold">
              The next session starts with the same project-owned context.
            </p>
          </article>
        </div>
      </section>
    </div>
  </header>

  <section
    class="page-shell py-14 sm:py-18"
    aria-labelledby="evidence-paths-title"
  >
    <div class="max-w-3xl">
      <p class="eyebrow mb-3">Inspect the proof</p>
      <h2
        id="evidence-paths-title"
        class="text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        Two questions. Every result opens into the full journey.
      </h2>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <article class="surface-card flex min-w-0 flex-col overflow-hidden">
        <div class="p-5 sm:p-7">
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow">Decision evaluation</p>
            <EvidenceStatus status={decisionStatus} />
          </div>
          <h3 class="mt-4 text-2xl font-semibold">Did the agent use the context correctly?</h3>
          <p class="mt-3 leading-7 text-muted-foreground">
            A difficult request tests whether the agent finds the right rule, changes the right
            files, preserves developer authority, and avoids invented project facts.
          </p>
          <ol class="mt-6 grid gap-3">
            {
              decisionSteps.map(({ icon: StepIcon, label }, index) => (
                <li class="flex items-center gap-3 rounded-xl bg-muted/40 px-4 py-3">
                  <StepIcon
                    class="size-4 shrink-0"
                    aria-hidden="true"
                  />
                  <span class="text-sm font-semibold">{label}</span>
                  <span class="ms-auto font-mono text-xs text-muted-foreground">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="mt-auto border-t border-border p-5 sm:px-7">
          <ActionLink
            class="font-bold"
            href={withBase(model.semanticEvaluation.route, basePath)}
          >
            Open the decision journeys
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </article>

      <article class="surface-card flex min-w-0 flex-col overflow-hidden">
        <div class="border-b border-border bg-muted/30 p-5 sm:p-7">
          <div class="flex flex-wrap items-center gap-2">
            {
              integrationLogos.map((adapterId) => (
                <AdapterCompanyLogo
                  adapterId={adapterId}
                  size="sm"
                />
              ))
            }
          </div>
        </div>
        <div class="flex flex-1 flex-col p-5 sm:p-7">
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow">Adapter qualification</p>
            <EvidenceStatus status={qualificationStatus} />
          </div>
          <h3 class="mt-4 text-2xl font-semibold">Does it work through your integration?</h3>
          <p class="mt-3 leading-7 text-muted-foreground">
            A coding agent completes realistic tasks through the published skill and exact adapter
            package. Project checks and an independent judge verify the result.
          </p>
          <div class="mt-6 flex items-start gap-3 rounded-xl bg-muted/40 px-4 py-4">
            <GitBranch
              class="mt-1 size-4 shrink-0"
              aria-hidden="true"
            />
            <p class="text-sm leading-6 text-muted-foreground">
              Qualification uses isolated project fixtures. It does not call the provider API or run
              the project’s own AI agent.
            </p>
          </div>
          <div class="mt-auto pt-6">
            <ActionLink
              class="font-bold"
              href={withBase(model.qualification.route, basePath)}
            >
              Choose your integration
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
