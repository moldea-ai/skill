---
import { ArrowDown, ArrowRight, FolderGit2, ListChecks, MessagesSquare } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import RecordedJourneys from '../recorded-journeys/recorded-journeys.astro';
import { PlatformMark } from '../platform-mark/index.ts';
import RecordedChange from '../recorded-change/recorded-change.astro';
import RecordedProject from '../recorded-project/recorded-project.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import { PROJECT_RUN_ROUTE } from '../../lib/project-runs/index.ts';
import { getSemanticReleaseEvidenceSummary } from '../../lib/release-evidence/index.ts';

import { getSemanticPreviewCase } from './presentation.ts';

const model = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const semanticSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  model.currentSemanticAssurance,
);
const changeCase = getSemanticPreviewCase(model.semanticEvaluation, 'bound-context-maintenance');
const projectAttempts = model.projectRuns?.pages.flatMap(({ attempts }) => attempts) ?? [];
const projectPreview = projectAttempts[0];
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Evidence' }];
const semanticRoute = withBase(model.semanticEvaluation.route, basePath);
---

<BaseLayout
  title="Evidence"
  description="See how we tested moldea with real requests, checked project connections, and recorded complete coding sessions."
  {breadcrumbs}
>
  <header class="border-b border-border bg-background">
    <div class="page-shell pt-4 sm:pt-7">
      <Breadcrumbs
        {basePath}
        items={breadcrumbs}
      />
    </div>
    <div
      class="page-shell grid items-center gap-8 py-10 sm:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)] lg:gap-10 lg:py-20"
      data-evidence-hero
    >
      <div class="min-w-0">
        <p class="eyebrow mb-4">Evidence</p>
        <h1 class="page-title">We tested the work. You can inspect the results.</h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          See how coding agents use <code class="inline-code">moldea</code> in individual decisions, complete
          projects, and scripted conversations. Open the requests, changes, and checks behind the available
          results.
        </p>
        <div class="mt-7">
          <ActionLink
            href="#decisions"
            size="lg"
            class="font-bold"
          >
            Explore the evidence<ArrowDown
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>
      <nav
        class="grid min-w-0 gap-3"
        aria-label="Evidence sections"
      >
        <a
          href="#decisions"
          class="flex min-w-0 items-start gap-3 rounded-2xl border border-border bg-card p-4 link-feedback sm:gap-4 sm:p-5"
        >
          <span
            class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-secondary text-muted-foreground"
          >
            <ListChecks
              class="size-5"
              aria-hidden="true"
            />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-base font-semibold">Agent decisions</span>
            <span class="mt-1 block text-sm leading-6 text-muted-foreground"
              >Inspect choices about context, code changes, and task boundaries.</span
            >
            <span class="mt-2 block text-xs font-medium text-muted-foreground">
              {
                semanticSummary.result === null
                  ? 'Explore the test scenarios'
                  : `${semanticSummary.result.totalCaseCount} recorded tests`
              }
            </span>
          </span>
          <ArrowDown
            class="mt-1 size-4 shrink-0 text-muted-foreground"
            aria-hidden="true"
          />
        </a>
        {
          model.projectRuns !== null && (
            <a
              href="#projects"
              class="flex min-w-0 items-start gap-3 rounded-2xl border border-border bg-card p-4 link-feedback sm:gap-4 sm:p-5"
            >
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-secondary text-muted-foreground">
                <FolderGit2
                  class="size-5"
                  aria-hidden="true"
                />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-base font-semibold">Coding projects</span>
                <span class="mt-1 block text-sm leading-6 text-muted-foreground">
                  Follow recorded requests, tool calls, file edits, and corrections.
                </span>
                <span class="mt-2 block text-xs font-medium text-muted-foreground">
                  {projectAttempts.length} projects
                </span>
              </span>
              <ArrowDown
                class="mt-1 size-4 shrink-0 text-muted-foreground"
                aria-hidden="true"
              />
            </a>
          )
        }
        {
          model.scriptedJourneys !== null && (
            <a
              href="#journeys"
              class="flex min-w-0 items-start gap-3 rounded-2xl border border-border bg-card p-4 link-feedback sm:gap-4 sm:p-5"
            >
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-secondary text-muted-foreground">
                <MessagesSquare
                  class="size-5"
                  aria-hidden="true"
                />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-base font-semibold">Scripted journeys</span>
                <span class="mt-1 block text-sm leading-6 text-muted-foreground">
                  Compare ChatGPT and Claude conversations with locally checked changes.
                </span>
                <span class="mt-2 block text-xs font-medium text-muted-foreground">
                  {model.scriptedJourneys.journeys.length} scripted journeys
                </span>
              </span>
              <ArrowDown
                class="mt-1 size-4 shrink-0 text-muted-foreground"
                aria-hidden="true"
              />
            </a>
          )
        }
      </nav>
    </div>
  </header>

  <section
    id="decisions"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="decisions-title"
    data-evidence-path
  >
    <div
      class="page-shell grid items-center gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14"
    >
      <div class="min-w-0">
        <p class="eyebrow mb-3">01 Follow the request</p>
        <h2
          id="decisions-title"
          class="section-title"
        >
          Did the agent change the right things?
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          We ask for a code change that also affects saved project knowledge. Then we check the
          implementation, the tests, and the notes it leaves for the next session.
        </p>
        <div
          class="mt-6 grid gap-3"
          data-evidence-path-action
        >
          <ActionLink
            href={semanticRoute}
            variant="primary"
            class="w-full font-bold"
            >Explore decisions<ArrowRight
              class="size-4"
              aria-hidden="true"
            /></ActionLink
          >
        </div>
        <p class="mt-3 text-xs leading-5 text-muted-foreground">
          Includes read-only requests, missing rules, context changes, and attempts to override the
          task.
        </p>
      </div>
      <div class="min-w-0">
        <RecordedChange evaluationCase={changeCase} />
        {
          changeCase !== null && (
            <div class="mt-3">
              <ActionLink
                href={`${semanticRoute}#semantic-case-${changeCase.id}`}
                variant="link"
              >
                Open this test's conversation and checks
                <ArrowRight
                  class="size-4"
                  aria-hidden="true"
                />
              </ActionLink>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    model.projectRuns !== null && (
      <section
        id="projects"
        class="scroll-mt-24 bg-elevated py-12 sm:py-16"
        aria-labelledby="projects-title"
        data-evidence-path
      >
        <div class="page-shell grid items-center gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14">
          <div class="min-w-0">
            <p class="eyebrow mb-3">02 Watch the work</p>
            <h2
              id="projects-title"
              class="section-title"
            >
              What happens in a complete coding task?
            </h2>
            <p class="mt-4 text-base leading-7 text-muted-foreground">
              Open a project and follow the requests, agent messages, tool calls, and file edits.
              These recordings show what happened, including follow-up changes and limits in the
              available evidence.
            </p>
            <div
              class="mt-6 grid gap-3"
              data-evidence-path-action
            >
              <ActionLink
                href={withBase(PROJECT_RUN_ROUTE, basePath)}
                variant="primary"
                class="w-full font-bold"
              >
                Explore project runs
                <ArrowRight
                  class="size-4"
                  aria-hidden="true"
                />
              </ActionLink>
            </div>
          </div>
          <div class="min-w-0">
            {projectPreview !== undefined && <RecordedProject attempt={projectPreview} />}
            {projectPreview !== undefined && (
              <div class="mt-3">
                <ActionLink
                  href={withBase(projectPreview.route, basePath)}
                  variant="link"
                >
                  Open the recorded session
                  <ArrowRight
                    class="size-4"
                    aria-hidden="true"
                  />
                </ActionLink>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }
  {
    model.scriptedJourneys !== null && (
      <section
        id="journeys"
        class="scroll-mt-24 border-t border-border bg-elevated py-12 sm:py-16"
        aria-labelledby="journeys-title"
        data-evidence-path
      >
        <div class="page-shell grid items-center gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14">
          <>
            <div class="min-w-0">
              <>
                <p class="eyebrow mb-3">03 Follow scripted journeys</p>
                <h2
                  id="journeys-title"
                  class="section-title"
                >
                  The same requests, run in ChatGPT and Claude projects
                </h2>
                <p class="mt-4 text-base leading-7 text-muted-foreground">
                  Follow a sequence of project requests on both platforms. Compare the exported
                  changes and replies with the local assessment at every step.
                </p>
                <div class="mt-5 flex flex-wrap gap-5">
                  <>
                    <PlatformMark platform="chatgpt" />
                    <PlatformMark platform="claude" />
                  </>
                </div>
                <div
                  class="mt-6 grid gap-3"
                  data-evidence-path-action
                >
                  <ActionLink
                    href={withBase(model.scriptedJourneys.route, basePath)}
                    variant="primary"
                    class="w-full font-bold"
                  >
                    Explore scripted journeys
                    <ArrowRight
                      class="size-4"
                      aria-hidden="true"
                    />
                  </ActionLink>
                </div>
              </>
            </div>
            <RecordedJourneys model={model.scriptedJourneys} />
          </>
        </div>
      </section>
    )
  }
</BaseLayout>
