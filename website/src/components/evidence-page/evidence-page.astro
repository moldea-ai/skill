---
import {
  ArrowRight,
  Bot,
  Cable,
  FileSearch,
  FolderGit2,
  ListChecks,
  MessageSquareText,
} from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../adapter-company-logo/adapter-company-logo.astro';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import { PROJECT_RUN_ROUTE } from '../../lib/project-runs/index.ts';
import {
  getQualificationReleaseEvidenceSummary,
  getSemanticReleaseEvidenceSummary,
} from '../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const semanticSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  model.currentSemanticAssurance,
);
const decisionStatus = semanticSummary.result?.status ?? model.semanticEvaluation.status;
const anthropicProfile = model.qualification.profiles.find(
  ({ adapterId }) => adapterId === 'anthropic',
);
const qualificationStatus = anthropicProfile
  ? getQualificationReleaseEvidenceSummary(anthropicProfile).status
  : 'not-recorded';
const adapterIds = new Set(model.qualification.profiles.map(({ adapterId }) => adapterId));
const adapterPreview = [
  { id: 'openai', name: 'OpenAI' },
  { id: 'anthropic', name: 'Anthropic' },
  { id: 'google-genai', name: 'Google GenAI' },
  { id: 'langgraph', name: 'LangGraph' },
  { id: 'vercel-ai-sdk', name: 'Vercel AI SDK' },
  { id: 'eve', name: 'Eve' },
].filter(({ id }) => adapterIds.has(id));
const projectPreviews =
  model.projectRuns?.pages.flatMap(({ attempts }) => attempts).slice(0, 3) ?? [];
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Evidence' }];
---

<BaseLayout
  title="Evidence"
  description="Explore moldea through semantic evaluations, adapter qualifications, and coding sessions in mock projects."
  {breadcrumbs}
>
  <div class="page-shell pt-4 sm:pt-7">
    <Breadcrumbs
      {basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="relative overflow-hidden border-b border-border bg-background">
    <HeroBackdrop />
    <div
      class="page-shell relative grid gap-10 py-12 sm:py-18 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.7fr)] lg:items-end lg:gap-16 lg:py-24"
    >
      <div class="min-w-0">
        <p class="eyebrow mb-4">Evidence</p>
        <h1 class="display-title max-w-4xl">See the work behind the result.</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-muted-foreground sm:text-lg">
          <InlineBrandText
            text="Explore how moldea makes decisions, connects to real agent runtimes, and holds up across complete coding projects."
          />
        </p>
      </div>
      <nav
        class="grid overflow-hidden rounded-2xl border border-border bg-card/90 shadow-raised backdrop-blur-sm"
        aria-label="Evidence sections"
      >
        <a
          class="group flex items-center justify-between gap-4 border-b border-border px-5 py-4 font-semibold transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring sm:px-6"
          href="#decisions"
        >
          Decisions <ArrowRight
            class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
            aria-hidden="true"
          />
        </a>
        <a
          class:list={[
            'group flex items-center justify-between gap-4 px-5 py-4 font-semibold transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring sm:px-6',
            model.projectRuns !== null && 'border-b border-border',
          ]}
          href="#integrations"
        >
          Integrations <ArrowRight
            class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
            aria-hidden="true"
          />
        </a>
        {
          model.projectRuns !== null && (
            <a
              class="group flex items-center justify-between gap-4 px-5 py-4 font-semibold transition-colors hover:bg-muted/60 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring sm:px-6"
              href="#projects"
            >
              Project runs{' '}
              <ArrowRight
                class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
                aria-hidden="true"
              />
            </a>
          )
        }
      </nav>
    </div>
  </header>

  <section
    id="decisions"
    class="dark-surface-selection scroll-mt-20 border-b border-border bg-primary py-14 text-primary-foreground sm:py-20"
    aria-labelledby="decisions-title"
    data-evidence-path="decision"
  >
    <div class="page-shell grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="min-w-0">
        <span
          class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary-foreground/10"
          ><ListChecks
            class="size-6"
            aria-hidden="true"
          /></span
        >
        <p class="mt-6 text-xs font-bold tracking-[0.16em] text-primary-foreground/60 uppercase">
          Decision evaluation
        </p>
        <h2
          id="decisions-title"
          class="section-title mt-3 max-w-xl"
        >
          Did the agent make the right call?
        </h2>
        <div class="mt-5"><EvidenceStatus status={decisionStatus} /></div>
        <p class="mt-6 max-w-xl text-base leading-8 text-primary-foreground/75">
          See which context it used, what it changed, and whether it respected the project's
          boundaries.
        </p>
        <div
          class="mt-8 max-w-sm"
          data-evidence-path-action
        >
          <ActionLink
            class="w-full justify-between font-semibold"
            variant="secondary"
            href={withBase(model.semanticEvaluation.route, basePath)}
          >
            Explore decisions <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>
      <div
        class="overflow-hidden rounded-3xl border border-primary-foreground/15 bg-primary-foreground p-5 text-primary shadow-raised sm:p-7"
      >
        <p class="text-xs font-bold tracking-[0.14em] text-primary/50 uppercase">
          Follow the decision
        </p>
        <ol
          class="mt-5 grid gap-3"
          aria-label="Decision evidence"
        >
          <li class="flex items-center gap-4 rounded-xl border border-primary/10 bg-primary/5 p-4">
            <MessageSquareText
              class="size-5 shrink-0"
              aria-hidden="true"
            /><span class="font-semibold">The developer's request</span>
          </li>
          <li class="flex items-center gap-4 rounded-xl border border-primary/10 bg-primary/5 p-4">
            <Bot
              class="size-5 shrink-0"
              aria-hidden="true"
            /><span class="font-semibold">The agent's choices</span>
          </li>
          <li class="flex items-center gap-4 rounded-xl border border-primary/10 bg-primary/5 p-4">
            <FileSearch
              class="size-5 shrink-0"
              aria-hidden="true"
            /><span class="font-semibold">The evidence behind the assessment</span>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section
    id="integrations"
    class="scroll-mt-20 border-b border-border bg-background py-14 sm:py-20"
    aria-labelledby="integrations-title"
    data-evidence-path="qualification"
  >
    <div class="page-shell grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div class="order-2 min-w-0 lg:order-1">
        <div class="rounded-3xl border border-border bg-card p-5 shadow-raised sm:p-7">
          <p class="text-xs font-bold tracking-[0.14em] text-muted-foreground uppercase">
            Across agent runtimes
          </p>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            {
              adapterPreview.map(({ id, name }) => (
                <div class="flex min-w-0 items-center gap-3 rounded-xl border border-border bg-muted/30 p-3">
                  <AdapterCompanyLogo
                    adapterId={id}
                    size="sm"
                  />
                  <span class="min-w-0 font-semibold">{name}</span>
                </div>
              ))
            }
          </div>
          <p class="mt-5 text-sm leading-6 text-muted-foreground">
            Open a profile to inspect its project, runtime connection, and checks.
          </p>
        </div>
      </div>
      <div class="order-1 min-w-0 lg:order-2">
        <span
          class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary"
          ><Cable
            class="size-6"
            aria-hidden="true"
          /></span
        >
        <p class="eyebrow mt-6">Adapter qualification</p>
        <h2
          id="integrations-title"
          class="section-title mt-3 max-w-xl"
        >
          Does the integration work?
        </h2>
        <div class="mt-5"><EvidenceStatus status={qualificationStatus} /></div>
        <p class="mt-6 max-w-xl text-base leading-8 text-muted-foreground">
          Explore example projects built through supported adapter packages and inspect how each
          runtime receives its instructions.
        </p>
        <div
          class="mt-8 max-w-sm"
          data-evidence-path-action
        >
          <ActionLink
            class="w-full justify-between font-semibold"
            href={withBase(model.qualification.route, basePath)}
          >
            Explore adapters <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>
    </div>
  </section>

  {
    model.projectRuns !== null && (
      <section
        id="projects"
        class="scroll-mt-20 bg-sidebar py-14 sm:py-20"
        aria-labelledby="projects-title"
        data-evidence-path="projects"
      >
        <div class="page-shell grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
          <div class="min-w-0">
            <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
              <FolderGit2
                class="size-6"
                aria-hidden="true"
              />
            </span>
            <p class="eyebrow mt-6">Project runs</p>
            <h2
              id="projects-title"
              class="section-title mt-3 max-w-xl"
            >
              What happened in the project?
            </h2>
            <div class="mt-5">
              <EvidenceStatus status="passed" />
            </div>
            <p class="mt-6 max-w-xl text-base leading-8 text-muted-foreground">
              Follow real coding work from the request through agent messages, tool calls, changed
              files, and the resulting project.
            </p>
            <div
              class="mt-8 max-w-sm"
              data-evidence-path-action
            >
              <ActionLink
                class="w-full justify-between font-semibold"
                href={withBase(PROJECT_RUN_ROUTE, basePath)}
              >
                Explore project runs{' '}
                <ArrowRight
                  class="size-4"
                  aria-hidden="true"
                />
              </ActionLink>
            </div>
          </div>
          <div class="grid gap-3">
            {projectPreviews.map((attempt) => (
              <article class="rounded-2xl border border-border bg-card p-5 shadow-surface sm:p-6">
                <h3 class="text-lg font-semibold">{attempt.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{attempt.excerpt}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
