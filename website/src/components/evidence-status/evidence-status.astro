---
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import { EVIDENCE_STATUS_PRESENTATION } from './constants.ts';
import type { IEvidenceDisplayStatus } from './types.ts';

interface Props {
  status: IEvidenceDisplayStatus;
}

const { status } = Astro.props;
const presentation = EVIDENCE_STATUS_PRESENTATION[status];
---

<span
  class="light-surface-selection inline-flex"
  data-evidence-status={status}
>
  <StatusBadge
    label={presentation.label}
    tone={presentation.tone}
  />
</span>
