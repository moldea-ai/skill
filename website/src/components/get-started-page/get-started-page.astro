---
import { ArrowRight, Bot, FileBraces, FolderGit2, Terminal } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import IconTile from '@moldea.ai/website-ui/icon-tile';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';
import {
  CLOUD_WEBSITE_URL,
  GIT_VERSION_RANGE,
  INSTALL_COMMAND,
  NODE_VERSION_RANGE,
  PRODUCT_PAGE_METADATA,
  SKILLS_DIRECTORY_URL,
} from '../../lib/model/constants.ts';
import { ProjectFileTree } from '../project-file-tree/index.ts';
import SkillConversation from '../skill-conversation/skill-conversation.astro';

import {
  INITIALIZE_EXAMPLE_ENTRIES,
  INITIALIZE_EXAMPLE_FILES,
  MAINTENANCE_EXAMPLE_ENTRIES,
  MAINTENANCE_EXAMPLE_FILES,
} from './constants.ts';

const basePath = import.meta.env.BASE_URL;
const pageMetadata = PRODUCT_PAGE_METADATA.getStarted;
const prAssuranceUrl = new URL('pr-assurance', CLOUD_WEBSITE_URL).href;
const stepLinks = [
  { href: '#install', label: 'Install' },
  { href: '#initialize', label: 'Initialize' },
  { href: '#keep-working', label: 'Keep working' },
  { href: '#fix', label: 'Fix' },
] as const;
// the sections an explicit repair reports, with illustrative values
const repairReport = [
  { term: 'Checked', detail: 'Project foundation, refund policy, and its link to the code' },
  { term: 'Fixed', detail: 'AGENTS.md managed block refreshed' },
  { term: 'Verified', detail: 'Structural validation passed' },
  { term: 'Needs input', detail: 'None' },
  { term: 'Not checked', detail: 'None' },
] as const;
const requirementClass =
  'grid grid-cols-[2rem_minmax(0,1fr)] content-start gap-3 bg-card p-4 text-sm sm:p-5';
// step sections center their columns; Initialize top-aligns its substantially taller example
const stepSectionClass = 'grid scroll-mt-24 gap-8 border-t pt-10 lg:grid-cols-2 lg:gap-16';
const bandLinkClass =
  'inline-flex min-h-10 items-center gap-2 px-1 text-sm font-bold text-primary-foreground link-feedback focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-foreground focus-visible:outline-solid';
---

<BaseLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
>
  <div class="page-shell pb-section-gap">
    <header class="max-w-4xl pt-10 pb-12 sm:pt-16">
      <p class="eyebrow mb-4">Get started</p>
      <h1 class="page-title">Get started with moldea</h1>
      <p class="mt-5 max-w-3xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        Install the Skill in your repository, initialize it once, then keep working with your coding
        agent as usual. When something seems off, ask it to fix <code class="inline-code"
          >moldea</code
        >.
      </p>
      <nav
        class="mt-8 flex flex-wrap gap-2"
        aria-label="Setup steps"
      >
        {
          stepLinks.map(({ href, label }) => (
            <ActionLink
              href={href}
              variant="outline"
              size="sm"
            >
              {label}
            </ActionLink>
          ))
        }
      </nav>
    </header>

    <section
      id="before-you-start"
      class="scroll-mt-24 border-t pt-10"
      aria-labelledby="before-you-start-title"
    >
      <h2
        id="before-you-start-title"
        class="text-xl font-semibold tracking-tight sm:text-2xl"
      >
        Before you start
      </h2>
      <ul
        class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4"
      >
        <li class={requirementClass}>
          <IconTile size="sm"><Bot /></IconTile>
          <div class="min-w-0">
            <p class="font-semibold">A coding agent</p>
            <p class="mt-1 leading-6 text-muted-foreground">
              Codex, Claude Code, Cursor, or another <a
                class="text-link"
                href={withBase('/docs/coding-agent-compatibility/', basePath)}
                >compatible agent</a
              >
            </p>
          </div>
        </li>
        <li class={requirementClass}>
          <IconTile size="sm"><Terminal /></IconTile>
          <div class="min-w-0">
            <p class="font-semibold">Node.js</p>
            <p class="mt-1 leading-6 text-muted-foreground">
              Version <code class="inline-code">{NODE_VERSION_RANGE}</code>, required by the Skill
              and its local CLI
            </p>
          </div>
        </li>
        <li class={requirementClass}>
          <IconTile size="sm"><FileBraces /></IconTile>
          <div class="min-w-0">
            <p class="font-semibold">A root <code class="inline-code">package.json</code></p>
            <p class="mt-1 leading-6 text-muted-foreground">
              Initialization adds <code class="inline-code">@moldea.ai/cli</code> to it
            </p>
          </div>
        </li>
        <li class={requirementClass}>
          <IconTile size="sm"><FolderGit2 /></IconTile>
          <div class="min-w-0">
            <p class="font-semibold">A Git repository</p>
            <p class="mt-1 leading-6 text-muted-foreground">
              Git <code class="inline-code">{GIT_VERSION_RANGE}</code>, with the Skill installed
              inside it, not globally
            </p>
          </div>
        </li>
      </ul>
    </section>

    <div class="mt-section-gap grid gap-section-gap">
      <section
        id="install"
        class:list={[stepSectionClass, 'items-center']}
        aria-labelledby="install-title"
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">01 · Install</p>
          <h2
            id="install-title"
            class="section-title"
          >
            Add the Skill to your repository.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">Run this from the repository root.</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
            <ActionLink
              class="font-bold"
              href={SKILLS_DIRECTORY_URL}
              target="_blank"
            >
              Get the skill on skills.sh
            </ActionLink>
            <ActionLink
              class="font-bold"
              href={withBase('/docs/getting-started/', basePath)}
              variant="link"
            >
              Pin a release
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
          </div>
        </div>
        <div
          class="min-w-0"
          data-install-command
        >
          <CodeBlock
            language="sh"
            source={INSTALL_COMMAND}
          />
        </div>
      </section>

      <section
        id="initialize"
        class:list={[stepSectionClass, 'items-start']}
        aria-labelledby="initialize-title"
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">02 · Initialize</p>
          <h2
            id="initialize-title"
            class="section-title"
          >
            Initialize the project once.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">
            Open the repository in your coding agent and ask it to <code class="inline-code"
              >Initialize moldea</code
            >. It reads the repository, saves a short project foundation under <code
              class="inline-code">moldea/</code
            >, links it from your README, and connects it to <code class="inline-code"
              >AGENTS.md</code
            >.
          </p>
          <h3 class="mt-6 text-base font-semibold">What to expect</h3>
          <ul class="mt-3 grid list-disc gap-2 ps-5 text-sm leading-6 text-muted-foreground">
            <li>
              One question if the repository doesn't make the project's purpose or boundaries clear.
            </li>
            <li>One confirmation before it registers agents your project already has.</li>
            <li>
              A block to add to <code class="inline-code">AGENTS.md</code> yourself if it can't edit that
              file.
            </li>
          </ul>
          <ActionLink
            class="mt-6 font-bold"
            href={withBase('/examples/initialize-a-project/', basePath)}
            variant="link"
          >
            See initialization
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
        <div class="min-w-0">
          <SkillConversation ariaLabel="Developer and coding agent initialization conversation">
            <p slot="request">Initialize moldea</p>
            <p slot="question">
              I read the repository, but it doesn't say what this project is for. What does it do,
              and who uses it?
            </p>
            <p slot="answer">
              It's the backend for Trailside, our online hiking and camping gear store. Our
              customers and support team use it.
            </p>
            <p slot="response">
              I saved the project foundation, linked it from your README, and connected it to
              <code class="inline-code">AGENTS.md</code>. Structural validation passed.
            </p>
            <ProjectFileTree
              entries={INITIALIZE_EXAMPLE_ENTRIES}
              files={INITIALIZE_EXAMPLE_FILES}
              idPrefix="get-started-initialize"
              label="Files initialization adds and updates"
            />
          </SkillConversation>
        </div>
      </section>

      <section
        id="keep-working"
        class:list={[stepSectionClass, 'items-center']}
        aria-labelledby="keep-working-title"
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">03 · Keep working</p>
          <h2
            id="keep-working-title"
            class="section-title"
          >
            Keep working as usual.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">
            Ask for outcomes in your own words. You don't need to mention <code class="inline-code"
              >moldea</code
            > again: your coding agent saves new decisions with the project and keeps them current as
            the code changes.
          </p>
          <ActionLink
            class="mt-6 font-bold"
            href={withBase('/how-it-works/', basePath)}
            variant="link"
          >
            How it works
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
        <div class="min-w-0">
          <SkillConversation ariaLabel="Developer and coding agent maintenance conversation">
            <p slot="request">Our refund window is now 14 days instead of 30. Update the app.</p>
            <p slot="response">
              I updated the refund rule and its test, saved the new policy in <code
                class="inline-code">moldea/context/refund-policy.md</code
              >, and linked it to the code that enforces it. The tests and <code class="inline-code"
                >moldea</code
              > checks passed.
            </p>
            <ProjectFileTree
              entries={MAINTENANCE_EXAMPLE_ENTRIES}
              files={MAINTENANCE_EXAMPLE_FILES}
              idPrefix="get-started-maintenance"
              label="Files the policy change updates"
            />
          </SkillConversation>
        </div>
      </section>

      <section
        id="fix"
        class:list={[stepSectionClass, 'items-center']}
        aria-labelledby="fix-title"
      >
        <div class="min-w-0">
          <p class="eyebrow mb-4">04 · Fix</p>
          <h2
            id="fix-title"
            class="section-title"
          >
            Ask for a fix when something seems off.
          </h2>
          <p class="mt-5 leading-8 text-muted-foreground">
            Say <code class="inline-code">Fix moldea</code> when saved context looks wrong or a check
            reports a problem. Repair checks the saved context and its connections to your code, corrects
            what it can, and tells you what needs your input.
          </p>
          <p class="mt-4 text-sm leading-7 text-muted-foreground">
            After you update the Skill, ask for <code class="inline-code">Fix moldea</code> once so the
            block in <code class="inline-code">AGENTS.md</code> matches the new version.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
            <ActionLink
              class="font-bold"
              href={withBase('/docs/evaluate-reconcile-validate/#repair-a-project', basePath)}
              variant="link"
            >
              Repair guide
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
            <ActionLink
              class="font-bold"
              href={withBase('/docs/getting-started/#update-or-remove-the-skill', basePath)}
              variant="link"
            >
              Update the Skill
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
          </div>
        </div>
        <div class="min-w-0">
          <SkillConversation ariaLabel="Developer and coding agent repair conversation">
            <p slot="request">I just updated the Skill. Fix moldea</p>
            <p slot="response">
              I checked the setup, refreshed the managed block in <code class="inline-code"
                >AGENTS.md</code
              >, and validated the result.
            </p>
            <dl
              class="grid gap-3 rounded-xl border border-border bg-background p-4 text-sm"
              data-repair-report
            >
              {
                repairReport.map(({ term, detail }) => (
                  <div class="grid gap-1 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-3">
                    <dt class="font-semibold">{term}</dt>
                    <dd class="text-muted-foreground">{detail}</dd>
                  </div>
                ))
              }
            </dl>
          </SkillConversation>
        </div>
      </section>
    </div>
  </div>

  <section
    class="dark-surface-selection bg-primary py-10 text-primary-foreground sm:py-12"
    aria-labelledby="get-started-next-title"
  >
    <div class="page-shell flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="eyebrow mb-2 text-primary-foreground/60">Continue</p>
        <h2
          id="get-started-next-title"
          class="text-2xl font-semibold tracking-tight"
        >
          Review pull requests with the same context.
        </h2>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={prAssuranceUrl}
          target="_blank"
          variant="secondary"
        >
          Explore PR Assurance
        </ActionLink>
        <a
          class={bandLinkClass}
          href={withBase('/docs/', basePath)}
        >
          Open the docs
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </a>
        <a
          class={bandLinkClass}
          href={withBase('/docs/getting-started/', basePath)}
        >
          Setup reference
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
