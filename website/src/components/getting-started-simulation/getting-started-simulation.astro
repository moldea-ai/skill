---
import { ArrowRight, Bot, Check, Copy, Terminal } from '@lucide/astro';
import ActionButton from '@moldea.ai/website-ui/action-button';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { withBase } from '@moldea.ai/website-ui/site';

import { INSTALL_COMMAND } from '../../lib/model/constants.ts';

const basePath = import.meta.env.BASE_URL;
---

<section
  class="border-b border-border bg-sidebar py-section-gap"
  aria-labelledby="getting-started-title"
  data-getting-started
>
  <div class="page-shell">
    <header class="mb-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-end">
      <div>
        <p class="eyebrow mb-4">Start in minutes</p>
        <h2
          id="getting-started-title"
          class="section-title max-w-4xl scroll-mt-24 font-semibold"
        >
          One install. One ordinary request.
        </h2>
      </div>
      <div class="lg:justify-self-end">
        <p class="text-lg leading-8 text-muted-foreground">
          Add the skill to your project and establish durable, Git-owned context. Initialization is
          the recommended starting point, and you can still begin with the outcome you want.
        </p>
        <ActionLink
          class="mt-5 font-bold"
          href={withBase('/docs/getting-started/', basePath)}
          variant="link"
        >
          Read the getting-started guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </header>

    <div
      class="surface-card overflow-hidden"
      aria-label="Getting started simulation"
    >
      <div class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <ol class="grid content-start gap-8 p-5 sm:p-8 lg:p-10">
          <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4">
            <span
              class="dark-surface-selection inline-flex size-10 items-center justify-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground"
              aria-hidden="true"
            >
              01
            </span>
            <div class="min-w-0">
              <h3 class="text-xl font-semibold tracking-tight">Install the skill.</h3>
              <div
                class="mt-4 flex min-w-0 items-center rounded-xl border bg-code p-1 ps-4 shadow-inset"
              >
                <Terminal
                  class="size-4 shrink-0 text-muted-foreground"
                  aria-hidden="true"
                />
                <code
                  class="min-w-0 flex-1 px-3 font-mono text-sm wrap-anywhere whitespace-pre-wrap text-code-foreground"
                  >{INSTALL_COMMAND}</code
                >
                <ActionButton
                  class="shrink-0 px-3 font-bold"
                  size="md"
                  type="button"
                  data-getting-started-copy={INSTALL_COMMAND}
                  data-primary-action
                  aria-label="Copy install command"
                >
                  <Copy
                    class="copy-icon size-4"
                    aria-hidden="true"
                  />
                  <Check
                    class="copied-icon hidden size-4"
                    aria-hidden="true"
                  />
                  <span
                    class="hidden sm:inline"
                    data-copy-label
                    >Copy</span
                  >
                </ActionButton>
              </div>
            </div>
          </li>

          <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4">
            <span
              class="dark-surface-selection inline-flex size-10 items-center justify-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground"
              aria-hidden="true"
            >
              02
            </span>
            <div class="min-w-0">
              <h3 class="text-xl font-semibold tracking-tight">
                Establish the durable project foundation.
              </h3>
              <div class="mt-4 flex gap-3 rounded-xl border bg-background p-4">
                <span
                  class="dark-surface-selection inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground"
                >
                  <span
                    class="font-mono text-xs font-bold"
                    aria-hidden="true"
                    >D</span
                  >
                  <span class="sr-only">Developer</span>
                </span>
                <div>
                  <p class="mb-1 text-xs font-bold tracking-wide text-muted-foreground uppercase">
                    Developer
                  </p>
                  <p class="font-mono text-sm leading-6">
                    Initialize <code
                      class="rounded-md bg-code px-1.5 py-1 font-mono text-[0.86em] font-semibold text-code-foreground"
                      >moldea</code
                    >
                  </p>
                </div>
              </div>
            </div>
          </li>

          <li
            class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4"
            data-getting-started-ordinary-work
          >
            <span
              class="dark-surface-selection inline-flex size-10 items-center justify-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground"
              aria-hidden="true"
            >
              03
            </span>
            <div class="min-w-0">
              <h3
                id="getting-started-ordinary-work-title"
                class="text-xl font-semibold tracking-tight"
              >
                Describe the outcome naturally.
              </h3>
              <div class="mt-4 flex gap-3 rounded-xl border bg-background p-4">
                <span
                  class="dark-surface-selection inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground"
                >
                  <span
                    class="font-mono text-xs font-bold"
                    aria-hidden="true"
                    >D</span
                  >
                  <span class="sr-only">Developer</span>
                </span>
                <div>
                  <p class="mb-1 text-xs font-bold tracking-wide text-muted-foreground uppercase">
                    Developer
                  </p>
                  <p class="font-mono text-sm leading-6">
                    Create a support agent grounded in our current refund policy.
                  </p>
                </div>
              </div>
            </div>
          </li>
        </ol>

        <div
          class="dark-surface-selection flex flex-col border-t border-border bg-primary p-5 text-primary-foreground sm:p-8 lg:border-s lg:border-t-0 lg:p-10"
          data-getting-started-agent-panel
        >
          <div class="flex items-center gap-3">
            <span
              class="inline-flex size-10 items-center justify-center rounded-xl bg-primary-foreground/10"
            >
              <Bot
                class="size-5"
                aria-hidden="true"
              />
            </span>
            <div>
              <p class="text-xs font-bold tracking-[0.16em] text-current/60 uppercase">
                Coding agent ↔ skill
              </p>
              <p class="font-semibold">Your coding agent handles the rest</p>
            </div>
          </div>

          <ol class="mt-8 grid gap-5">
            <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-3">
              <Check
                class="mt-0.5 size-5"
                aria-hidden="true"
              />
              <div>
                <p class="font-semibold">Reads your project</p>
                <p class="mt-1 text-sm leading-6 text-current/65">
                  Understands the implementation and documentation before writing anything.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-3">
              <Check
                class="mt-0.5 size-5"
                aria-hidden="true"
              />
              <div>
                <p class="font-semibold">Clarifies only when needed</p>
                <p class="mt-1 text-sm leading-6 text-current/65">
                  If a material gap remains, it asks one focused question. Reply naturally, and it
                  continues.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-3">
              <Check
                class="mt-0.5 size-5"
                aria-hidden="true"
              />
              <div>
                <p class="font-semibold">Builds and checks grounded context</p>
                <p class="mt-1 text-sm leading-6 text-current/65">
                  Captures only durable project facts, validates the result, and tells you exactly
                  what changed. No agent is created unless you ask for one.
                </p>
              </div>
            </li>
          </ol>

          <div class="mt-8 lg:mt-auto lg:pt-8">
            <div
              class="light-surface-selection rounded-xl bg-primary-foreground p-4 text-primary"
              data-getting-started-completion
            >
              <p class="text-xs font-bold tracking-wide uppercase">Done</p>
              <p class="mt-1 font-semibold">
                Project context initialized. Keep working with your coding agent as usual.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p
      class="sr-only"
      aria-live="polite"
      data-getting-started-copy-status
    >
    </p>
  </div>
</section>

<script>
  const initializeGettingStartedCopyControl = (): void => {
    const button = document.querySelector<HTMLButtonElement>('[data-getting-started-copy]');

    if (!button || button.getAttribute('data-copy-initialized') === 'true') return;

    button.setAttribute('data-copy-initialized', 'true');
    button.addEventListener('click', async () => {
      const command = button.getAttribute('data-getting-started-copy');
      const status = document.querySelector<HTMLElement>('[data-getting-started-copy-status]');
      const label = button.querySelector<HTMLElement>('[data-copy-label]');

      if (!command || !status || !label) return;

      try {
        await navigator.clipboard.writeText(command);
        label.textContent = 'Copied';
        button.querySelector('.copy-icon')?.classList.add('hidden');
        button.querySelector('.copied-icon')?.classList.remove('hidden');
        status.textContent = 'Install command copied to the clipboard.';
      } catch {
        status.textContent = 'The install command could not be copied. Select it manually.';
      }
    });
  };

  document.addEventListener('astro:page-load', initializeGettingStartedCopyControl);
  initializeGettingStartedCopyControl();
</script>
