---
import { ArrowRight, ExternalLink } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import { withBase } from '@moldea.ai/website-ui/site';

import { INSTALL_COMMAND, SKILLS_DIRECTORY_URL } from '../../lib/model/constants.ts';

const basePath = import.meta.env.BASE_URL;
---

<header class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
  <div>
    <p class="eyebrow mb-4">Start in minutes</p>
    <h2
      id="getting-started-title"
      class="section-title max-w-4xl scroll-mt-24 text-3xl font-semibold sm:text-4xl lg:text-5xl"
    >
      Install. Initialize. Start building.
    </h2>
  </div>
  <div class="lg:justify-self-end">
    <p class="text-lg leading-8 text-muted-foreground">
      Install the skill once, initialize the project, then ask for the agent you need.
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
      <ActionLink
        class="font-bold"
        href={SKILLS_DIRECTORY_URL}
        size="lg"
        target="_blank"
        rel="noopener noreferrer"
        data-primary-action
      >
        Get the skill
        <ExternalLink
          class="size-3.5"
          aria-hidden="true"
        />
      </ActionLink>
      <ActionLink
        class="font-bold"
        href={withBase('/docs/getting-started/', basePath)}
        variant="link"
      >
        Read the setup guide
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
    </div>
  </div>
</header>

<ol
  class="mt-8 grid gap-7 sm:gap-3 md:grid-cols-3"
  aria-label="Getting started"
  data-getting-started
>
  <li class="min-w-0 sm:rounded-xl sm:border sm:border-border sm:bg-card sm:p-6 sm:shadow-surface">
    <div class="flex items-center gap-3">
      <span
        class="dark-surface-selection inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary font-mono text-xs font-bold text-primary-foreground"
        aria-hidden="true"
      >
        01
      </span>
      <h3 class="text-xl font-semibold tracking-tight">Install the skill</h3>
    </div>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">
      Add it to the project where your coding agent works.
    </p>
    <div
      class="mt-4 min-w-0"
      data-install-command
    >
      <CodeBlock
        language="sh"
        source={INSTALL_COMMAND}
      />
    </div>
  </li>

  <li class="min-w-0 sm:rounded-xl sm:border sm:border-border sm:bg-card sm:p-6 sm:shadow-surface">
    <div class="flex items-center gap-3">
      <span
        class="dark-surface-selection inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary font-mono text-xs font-bold text-primary-foreground"
        aria-hidden="true"
      >
        02
      </span>
      <h3 class="text-xl font-semibold tracking-tight">Initialize the project</h3>
    </div>
    <div class="mt-4 rounded-xl bg-background p-4 shadow-inset">
      <p class="eyebrow mb-2">Tell your coding agent</p>
      <p class="font-mono text-sm leading-6">
        Initialize <code class="inline-code">moldea</code>
      </p>
    </div>
    <p class="mt-4 text-sm leading-6 text-muted-foreground">
      Saves the project’s starting context. Agent files are added when you ask for them.
    </p>
  </li>

  <li
    class="min-w-0 sm:rounded-xl sm:border sm:border-border sm:bg-card sm:p-6 sm:shadow-surface"
    data-getting-started-ordinary-work
  >
    <div class="flex items-center gap-3">
      <span
        class="dark-surface-selection inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary font-mono text-xs font-bold text-primary-foreground"
        aria-hidden="true"
      >
        03
      </span>
      <h3 class="text-xl font-semibold tracking-tight">Ask for the outcome</h3>
    </div>
    <div
      class="dark-surface-selection mt-4 rounded-xl bg-primary p-4 text-primary-foreground shadow-inset"
    >
      <p class="eyebrow mb-2 text-current/65">Tell your coding agent</p>
      <p class="font-mono text-sm leading-6">
        Create a support agent grounded in our current refund policy.
      </p>
    </div>
    <p class="mt-4 text-sm leading-6 text-muted-foreground">
      It can now use the saved project context while building the connected files shown above.
    </p>
  </li>
</ol>
