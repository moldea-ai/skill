---
import {
  ArrowRight,
  Bot,
  Check,
  ExternalLink,
  FileText,
  Link2,
  ShieldCheck,
  UserRound,
} from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import { LANDING_EXAMPLE } from '../../lib/landing-example/index.ts';
import { INSTALL_COMMAND, SKILLS_DIRECTORY_URL } from '../../lib/model/constants.ts';

const basePath = import.meta.env.BASE_URL;
---

<section
  aria-labelledby="getting-started-title"
  data-getting-started
>
  <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
    <div>
      <p class="eyebrow mb-4">Start in minutes</p>
      <h2
        id="getting-started-title"
        class="section-title max-w-4xl scroll-mt-24"
      >
        One install. One ordinary request.
      </h2>
    </div>
    <div class="lg:justify-self-end">
      <p class="text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        Add the skill, initialize the project once, then ask your coding agent for the outcome you
        want.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={SKILLS_DIRECTORY_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-primary-action
        >
          Get the skill
          <ExternalLink
            class="size-3.5"
            aria-hidden="true"
            data-external-link-icon
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={withBase('/docs/getting-started/', basePath)}
          variant="link"
        >
          Read the setup guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </header>

  <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-card shadow-raised">
    <div class="grid items-stretch lg:grid-cols-2">
      <ol
        class="grid content-start gap-7 p-5 sm:p-8 lg:p-10"
        aria-label="Getting started"
      >
        <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4">
          <span
            class="dark-surface-selection inline-flex size-10 items-center justify-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground"
            aria-hidden="true"
          >
            01
          </span>
          <div class="min-w-0">
            <p class="eyebrow mb-2">Add the skill</p>
            <h3 class="text-xl font-semibold tracking-tight">Install it in this project.</h3>
            <div
              class="mt-4 min-w-0"
              data-install-command
            >
              <CodeBlock
                language="sh"
                source={INSTALL_COMMAND}
              />
            </div>
            <p class="mt-3 flex items-center gap-2 text-sm font-semibold text-muted-foreground">
              <Check
                class="size-4"
                aria-hidden="true"
              />
              Available to the coding agent
            </p>
          </div>
        </li>

        <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4">
          <span
            class="dark-surface-selection inline-flex size-10 items-center justify-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground"
            aria-hidden="true"
          >
            02
          </span>
          <div class="min-w-0">
            <p class="eyebrow mb-2">One-time setup</p>
            <h3 class="text-xl font-semibold tracking-tight">Initialize the project once.</h3>
            <div
              class="mt-4 flex items-start gap-3 rounded-xl border border-border bg-background p-4"
            >
              <span
                class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted"
              >
                <UserRound
                  class="size-4"
                  aria-hidden="true"
                />
              </span>
              <div class="min-w-0">
                <p class="mb-1 text-xs font-semibold text-muted-foreground">You</p>
                <p class="text-sm leading-6 font-medium">
                  <InlineBrandText text="Initialize moldea" />
                </p>
              </div>
            </div>
          </div>
        </li>

        <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-4">
          <span
            class="dark-surface-selection inline-flex size-10 items-center justify-center rounded-xl bg-primary font-mono text-sm font-bold text-primary-foreground"
            aria-hidden="true"
          >
            03
          </span>
          <div class="min-w-0">
            <p class="eyebrow mb-2">Normal work</p>
            <h3 class="text-xl font-semibold tracking-tight">Describe the outcome naturally.</h3>
            <div
              class="mt-4 flex items-start gap-3 rounded-xl border border-border bg-background p-4"
            >
              <span
                class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted"
              >
                <UserRound
                  class="size-4"
                  aria-hidden="true"
                />
              </span>
              <div class="min-w-0">
                <p class="mb-1 text-xs font-semibold text-muted-foreground">You</p>
                <p class="text-sm leading-6 font-medium">{LANDING_EXAMPLE.request}</p>
              </div>
            </div>
          </div>
        </li>
      </ol>

      <div
        class="dark-surface-selection border-t border-border bg-primary p-5 text-primary-foreground sm:p-8 lg:border-s lg:border-t-0 lg:p-10"
        data-getting-started-agent-panel
      >
        <div class="flex items-center gap-3">
          <span
            class="inline-flex size-10 items-center justify-center rounded-xl bg-primary-foreground/10"
          >
            <Bot
              class="size-5"
              aria-hidden="true"
            />
          </span>
          <div>
            <p class="text-xs font-semibold tracking-[0.12em] text-current/60 uppercase">
              Coding agent and skill
            </p>
            <h3 class="mt-1 font-semibold">Your coding agent handles the rest</h3>
          </div>
        </div>

        <ol class="mt-7 grid gap-5">
          <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-3">
            <Check
              class="mt-0.5 size-5"
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold">Reads saved project truth</p>
              <p class="mt-1 text-sm leading-6 text-current/65">
                Starts with the facts and decisions the project already owns.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-3">
            <Check
              class="mt-0.5 size-5"
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold">Builds the connected agent</p>
              <p class="mt-1 text-sm leading-6 text-current/65">
                Creates the model call, instructions, tool, and declared relationships together.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-3">
            <Check
              class="mt-0.5 size-5"
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold">Runs deterministic checks</p>
              <p class="mt-1 text-sm leading-6 text-current/65">
                Verifies the saved structure and supported runtime connections before reporting.
              </p>
            </div>
          </li>
        </ol>

        <div
          class="light-surface-selection mt-7 rounded-xl border border-emerald-600/30 bg-primary-foreground p-4 text-primary sm:p-5"
          data-getting-started-completion
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-xs font-semibold tracking-[0.12em] text-primary/60 uppercase">
                Verified result
              </p>
              <p class="mt-1 text-lg font-semibold">Support agent ready.</p>
            </div>
            <ShieldCheck
              class="size-9 shrink-0 text-emerald-700 dark:text-emerald-700"
              aria-hidden="true"
            />
          </div>
          <ul
            class="mt-4 grid gap-2"
            aria-label="Created support agent result"
          >
            <li
              class="flex items-center gap-3 rounded-lg bg-primary/5 px-3 py-2.5 text-sm font-semibold"
            >
              <FileText
                class="size-4 shrink-0 text-emerald-700 dark:text-emerald-700"
                aria-hidden="true"
              />
              Project instructions saved
            </li>
            <li
              class="flex items-center gap-3 rounded-lg bg-primary/5 px-3 py-2.5 text-sm font-semibold"
            >
              <Link2
                class="size-4 shrink-0 text-emerald-700 dark:text-emerald-700"
                aria-hidden="true"
              />
              Order lookup connected
            </li>
            <li
              class="flex items-center gap-3 rounded-lg bg-primary/5 px-3 py-2.5 text-sm font-semibold"
            >
              <Check
                class="size-4 shrink-0 text-emerald-700 dark:text-emerald-700"
                aria-hidden="true"
              />
              Deterministic checks passed
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
