---
import { ArrowRight, GitBranch } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AgentExample from '../agent-example/agent-example.astro';
import BehaviorAlignment from '../behavior-alignment/behavior-alignment.astro';
import CodingAgentCompatibility from '../coding-agent-compatibility/coding-agent-compatibility.astro';
import GettingStartedSimulation from '../getting-started-simulation/getting-started-simulation.astro';
import OpenSourceSystem from '../open-source-system/open-source-system.astro';
import RepositoryFormat from '../repository-format/repository-format.astro';
import WhyMoldea from '../why-moldea/why-moldea.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import { SKILLS_DIRECTORY_URL } from '../../lib/model/constants.ts';
import {
  getQualificationReleaseEvidenceSummary,
  getSemanticReleaseEvidenceSummary,
} from '../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const qualificationSummaries = model.qualification.profiles.map(
  getQualificationReleaseEvidenceSummary,
);
const qualifiedProfileCount = qualificationSummaries.filter(
  ({ status }) => status === 'passed',
).length;
const semanticReleaseSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  model.currentSemanticAssurance,
);
const successfulSemanticCaseCount =
  (semanticReleaseSummary.result?.passedCaseCount ?? 0) +
  (semanticReleaseSummary.result?.recoveredCaseCount ?? 0);
---

<BaseLayout
  title="moldea Agent Skill"
  description="Give coding agents saved project context, visible connections between agent behavior and code, and repeatable software checks."
>
  <section
    class="relative overflow-hidden border-b border-border bg-sidebar"
    data-home-hero
  >
    <HeroBackdrop />
    <div class="page-shell relative py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-5xl text-center">
        <p class="eyebrow mb-4">Open source Agent Skill, version {model.skill.version}</p>
        <h1
          class="section-title font-semibold"
          data-hero-title
        >
          Build your agent. Keep its pieces connected.
        </h1>
        <p
          class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9"
        >
          <InlineBrandText
            text="moldea gives your coding agent saved project context and software checks for the connections between instructions, tools, and code."
          />
        </p>
        <div
          class="mt-8 flex flex-col items-stretch justify-center gap-3 min-[24rem]:flex-row min-[24rem]:items-center"
          data-hero-actions
        >
          <ActionLink
            class="font-bold shadow-raised"
            href="#getting-started-title"
            size="lg"
            data-primary-action
          >
            Install the skill
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href="#deterministic-checks"
            size="lg"
            variant="outline"
          >
            See what gets checked
          </ActionLink>
        </div>
      </div>

      <div class="mt-10 sm:mt-12">
        <AgentExample />
      </div>
    </div>
  </section>

  <WhyMoldea />

  <BehaviorAlignment />

  <OpenSourceSystem />

  <RepositoryFormat />

  <section class="page-shell py-section-gap">
    <div class="surface-card overflow-hidden">
      <div
        class="grid gap-8 p-6 sm:p-9 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:items-center lg:p-12"
      >
        <div>
          <p class="eyebrow mb-4">Release evidence</p>
          <h2 class="section-title max-w-4xl font-semibold">We do not ship on confidence alone.</h2>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
            Semantic scenarios test whether the skill preserves developer authority, gathers
            relevant evidence, maintains or evaluates the right surfaces, and refuses unsupported
            conclusions. Adapter qualification exercises complete project journeys with
            deterministic verification. Failed and incomplete attempts remain available for
            inspection.
          </p>
          <ActionLink
            class="mt-8 font-bold"
            href={withBase('/evidence/', basePath)}
          >
            Review the evidence
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
        <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          <div class="rounded-xl border border-border bg-muted/30 p-5">
            <dt class="text-sm font-semibold">Skill scenarios with verified release evidence</dt>
            <dd class="mt-2 font-mono text-3xl font-bold">
              {successfulSemanticCaseCount}/{model.semanticEvaluation.caseCount}
            </dd>
            <dd class="mt-2 text-sm leading-6 text-muted-foreground">
              Authority, evidence, maintenance, evaluation, and safe refusal boundaries.
            </dd>
          </div>
          <div class="rounded-xl border border-border bg-muted/30 p-5">
            <dt class="text-sm font-semibold">Adapter profiles with passing release evidence</dt>
            <dd class="mt-2 font-mono text-3xl font-bold">
              {qualifiedProfileCount}/{model.qualification.profiles.length}
            </dd>
            <dd class="mt-2 text-sm leading-6 text-muted-foreground">
              Exact project profiles backed by fresh or explicitly retained qualification evidence.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <GettingStartedSimulation />

  <CodingAgentCompatibility />

  <section class="page-shell pb-section-gap">
    <div class="grid gap-8 border-t border-border pt-12 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <GitBranch
          class="mb-5 size-7"
          aria-hidden="true"
        />
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Give your coding agent a system it can keep using.
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-muted-foreground">
          <InlineBrandText
            text="Install moldea, initialize the project once, then ask your coding agent for the outcome you want."
          />
        </p>
      </div>
      <ActionLink
        class="font-bold"
        href={SKILLS_DIRECTORY_URL}
        size="lg"
        target="_blank"
        rel="noopener noreferrer"
        data-primary-action
      >
        Get the skill on skills.sh
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
    </div>
  </section>
</BaseLayout>
