---
import { ArrowRight, Cable, ListChecks, Sparkles } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AgentExample from '../agent-example/agent-example.astro';
import BehaviorAlignment from '../behavior-alignment/behavior-alignment.astro';
import CapabilitiesOverview from '../capabilities-overview/capabilities-overview.astro';
import CodingAgentCompatibility from '../coding-agent-compatibility/coding-agent-compatibility.astro';
import GettingStartedSimulation from '../getting-started-simulation/getting-started-simulation.astro';
import OpenSourceSystem from '../open-source-system/open-source-system.astro';
import RepositoryFormat from '../repository-format/repository-format.astro';
import WhyMoldea from '../why-moldea/why-moldea.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import {
  getQualificationReleaseEvidenceSummary,
  getSemanticReleaseEvidenceSummary,
} from '../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const qualificationSummaries = model.qualification.profiles.map(
  getQualificationReleaseEvidenceSummary,
);
const qualifiedProfileCount = qualificationSummaries.filter(
  ({ status }) => status === 'passed',
).length;
const semanticReleaseSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  model.currentSemanticAssurance,
);
const successfulSemanticCaseCount =
  (semanticReleaseSummary.result?.passedCaseCount ?? 0) +
  (semanticReleaseSummary.result?.recoveredCaseCount ?? 0);
const hasSemanticReleaseEvidence = semanticReleaseSummary.result !== null;
const hasQualificationReleaseEvidence = qualificationSummaries.some(
  ({ kind }) => kind !== 'not-recorded',
);
---

<BaseLayout
  title="moldea Agent Skill"
  description="Give coding agents saved project context, visible connections between agent behavior and code, and repeatable software checks."
>
  <section
    class="border-b border-border bg-background"
    data-home-hero
  >
    <div
      class="page-shell grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)] lg:gap-12 lg:py-20"
    >
      <div class="min-w-0">
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-border bg-background/80 px-3 py-1.5 text-sm font-semibold shadow-surface backdrop-blur"
          >
            <Sparkles
              class="size-3.5"
              aria-hidden="true"
            />
            Agent Skill · v{model.skill.version}
          </span>
          <span class="text-sm text-muted-foreground">Git-native · local-first · open source</span>
        </div>
        <h1
          class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl xl:text-6xl"
          data-hero-title
        >
          Build agents that fit your project.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-muted-foreground">
          <InlineBrandText
            text="moldea gives your coding agent project context that survives each session, then runs deterministic software checks on what it builds."
          />
        </p>
        <div
          class="mt-7 flex flex-wrap gap-3"
          data-hero-actions
        >
          <ActionLink
            class="font-bold shadow-raised"
            href="#getting-started-title"
            size="lg"
            data-primary-action
          >
            Install the skill
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href="#deterministic-checks"
            size="lg"
            variant="outline"
          >
            See what gets checked
          </ActionLink>
        </div>
      </div>

      <AgentExample />
    </div>
  </section>

  <WhyMoldea />

  <CapabilitiesOverview />

  <BehaviorAlignment />

  <OpenSourceSystem />

  <RepositoryFormat />

  <section
    class="relative overflow-hidden border-b border-border bg-sidebar py-12 sm:py-16"
    aria-labelledby="home-evidence-title"
    data-home-evidence
  >
    <HeroBackdrop />
    <div class="page-shell relative">
      <div
        class="dark-surface-selection -mx-4 overflow-hidden bg-primary text-primary-foreground sm:mx-0 sm:rounded-3xl sm:shadow-raised"
      >
        <header
          class="grid gap-5 px-4 py-7 sm:px-8 sm:py-9 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-end lg:px-10"
        >
          <div>
            <p class="eyebrow mb-4 text-current/60">Proof before release</p>
            <h2
              id="home-evidence-title"
              class="section-title max-w-4xl text-3xl font-semibold sm:text-4xl lg:text-5xl"
            >
              See what was tested.
            </h2>
          </div>
          <p
            class="text-base leading-7 text-current/70 sm:text-lg sm:leading-8 lg:justify-self-end"
          >
            Open the request, project changes, and verdict behind each recorded result.
          </p>
        </header>

        <div class="grid gap-px bg-primary-foreground/15 md:grid-cols-2">
          <article
            class="light-surface-selection flex min-w-0 flex-col bg-primary-foreground p-5 text-primary sm:p-7"
            data-home-evidence-card="decision"
          >
            <div class="flex items-center gap-3">
              <span
                class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10"
              >
                <ListChecks
                  class="size-5"
                  aria-hidden="true"
                />
              </span>
              <p class="text-xs font-semibold tracking-[0.12em] text-primary/60 uppercase">
                Decision evaluation
              </p>
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-tight sm:text-2xl">
              Did it make the right call?
            </h3>
            <p class="mt-3 max-w-xl text-sm leading-6 text-primary/70 sm:text-base sm:leading-7">
              See how it chooses context, changes files, and respects your boundaries.
            </p>
            <div
              class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-primary/10 pt-5 sm:mt-7"
            >
              {
                hasSemanticReleaseEvidence ? (
                  <p
                    class="text-sm font-semibold"
                    data-semantic-release-count
                  >
                    <span class="block font-mono text-2xl tracking-tight">
                      {successfulSemanticCaseCount}/{model.semanticEvaluation.caseCount}
                    </span>
                    decisions verified
                  </p>
                ) : (
                  <p
                    class="max-w-xs text-sm text-primary/65"
                    data-semantic-release-count
                  >
                    No release decision result is recorded yet.
                  </p>
                )
              }
              <ActionLink
                class="font-bold"
                href={withBase(model.semanticEvaluation.route, basePath)}
              >
                Inspect the decisions
                <ArrowRight
                  class="size-4"
                  aria-hidden="true"
                />
              </ActionLink>
            </div>
          </article>

          <article
            class="light-surface-selection flex min-w-0 flex-col bg-primary-foreground p-5 text-primary sm:p-7"
            data-home-evidence-card="qualification"
          >
            <div class="flex items-center gap-3">
              <span
                class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10"
              >
                <Cable
                  class="size-5"
                  aria-hidden="true"
                />
              </span>
              <p class="text-xs font-semibold tracking-[0.12em] text-primary/60 uppercase">
                Adapter qualification
              </p>
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-tight sm:text-2xl">
              Does it work with your integration?
            </h3>
            <p class="mt-3 max-w-xl text-sm leading-6 text-primary/70 sm:text-base sm:leading-7">
              Browse the projects built and checked with each supported adapter.
            </p>
            <div
              class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-primary/10 pt-5 sm:mt-7"
            >
              {
                hasQualificationReleaseEvidence ? (
                  <p
                    class="text-sm font-semibold"
                    data-qualification-release-count
                  >
                    <span class="block font-mono text-2xl tracking-tight">
                      {qualifiedProfileCount}/{model.qualification.profiles.length}
                    </span>
                    adapter setups qualified
                  </p>
                ) : (
                  <p
                    class="max-w-xs text-sm text-primary/65"
                    data-qualification-release-count
                  >
                    No adapter qualification result is recorded yet.
                  </p>
                )
              }
              <ActionLink
                class="font-bold"
                href={withBase(model.qualification.route, basePath)}
              >
                Inspect the adapters
                <ArrowRight
                  class="size-4"
                  aria-hidden="true"
                />
              </ActionLink>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section
    class="bg-sidebar py-12 sm:py-16"
    data-adoption
  >
    <div class="page-shell">
      <GettingStartedSimulation />
      <CodingAgentCompatibility />
    </div>
  </section>
</BaseLayout>
