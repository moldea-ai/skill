---
import { ArrowRight, Cable, ListChecks } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AgentExample from '../agent-example/agent-example.astro';
import BehaviorAlignment from '../behavior-alignment/behavior-alignment.astro';
import CodingAgentCompatibility from '../coding-agent-compatibility/coding-agent-compatibility.astro';
import GettingStartedSimulation from '../getting-started-simulation/getting-started-simulation.astro';
import OpenSourceSystem from '../open-source-system/open-source-system.astro';
import RepositoryFormat from '../repository-format/repository-format.astro';
import WhyMoldea from '../why-moldea/why-moldea.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import {
  getQualificationReleaseEvidenceSummary,
  getSemanticReleaseEvidenceSummary,
} from '../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const qualificationSummaries = model.qualification.profiles.map(
  getQualificationReleaseEvidenceSummary,
);
const qualifiedProfileCount = qualificationSummaries.filter(
  ({ status }) => status === 'passed',
).length;
const semanticReleaseSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  model.currentSemanticAssurance,
);
const successfulSemanticCaseCount =
  (semanticReleaseSummary.result?.passedCaseCount ?? 0) +
  (semanticReleaseSummary.result?.recoveredCaseCount ?? 0);
const directlyPassedSemanticCaseCount = semanticReleaseSummary.result?.passedCaseCount ?? 0;
const recoveredSemanticCaseCount = semanticReleaseSummary.result?.recoveredCaseCount ?? 0;
const hasSemanticReleaseEvidence = semanticReleaseSummary.result !== null;
const hasQualificationReleaseEvidence = qualificationSummaries.some(
  ({ kind }) => kind !== 'not-recorded',
);
---

<BaseLayout
  title="moldea Agent Skill"
  description="Give coding agents saved project context, visible connections between agent behavior and code, and repeatable software checks."
>
  <section
    class="relative overflow-hidden border-b border-border bg-sidebar"
    data-home-hero
  >
    <HeroBackdrop />
    <div class="page-shell relative py-12 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-5xl text-center">
        <p class="eyebrow mb-4">Open source Agent Skill, version {model.skill.version}</p>
        <h1
          class="section-title font-semibold"
          data-hero-title
        >
          Build your agent. Keep its pieces connected.
        </h1>
        <p
          class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9"
        >
          <InlineBrandText
            text="moldea gives your coding agent saved project context and software checks for the connections between instructions, tools, and code."
          />
        </p>
        <div
          class="mt-8 flex flex-col items-stretch justify-center gap-3 min-[24rem]:flex-row min-[24rem]:items-center"
          data-hero-actions
        >
          <ActionLink
            class="font-bold shadow-raised"
            href="#getting-started-title"
            size="lg"
            data-primary-action
          >
            Install the skill
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href="#deterministic-checks"
            size="lg"
            variant="outline"
          >
            See what gets checked
          </ActionLink>
        </div>
      </div>

      <div class="mt-10 sm:mt-12">
        <AgentExample />
      </div>
    </div>
  </section>

  <WhyMoldea />

  <BehaviorAlignment />

  <OpenSourceSystem />

  <RepositoryFormat />

  <section
    class="border-b border-border bg-background py-12 sm:py-section-gap"
    aria-labelledby="home-evidence-title"
    data-home-evidence
  >
    <div class="page-shell">
      <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-end">
        <div>
          <p class="eyebrow mb-4">Proof before release</p>
          <h2
            id="home-evidence-title"
            class="section-title max-w-4xl font-semibold"
          >
            See what was tested.
          </h2>
        </div>
        <p class="text-lg leading-8 text-muted-foreground lg:justify-self-end">
          Open the request, project changes, and verdict behind each recorded result.
        </p>
      </header>

      <div class="mt-7 grid sm:gap-3 md:grid-cols-2 md:gap-4">
        <article
          class="flex min-w-0 flex-col border-b border-border py-6 sm:rounded-xl sm:border sm:bg-card sm:p-7 sm:shadow-surface"
          data-home-evidence-card="decision"
        >
          <div class="flex items-center gap-3">
            <span
              class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted"
            >
              <ListChecks
                class="size-5"
                aria-hidden="true"
              />
            </span>
            <p class="eyebrow">Decision evaluation</p>
          </div>
          <h3 class="mt-4 text-xl font-semibold tracking-tight sm:mt-5 sm:text-2xl">
            Did it make the right call?
          </h3>
          <p
            class="mt-3 max-w-xl text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7"
          >
            Inspect whether the skill found the right context, changed the right files, and
            respected the developer's boundaries.
          </p>
          <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-2 text-sm sm:mt-6">
            {
              hasSemanticReleaseEvidence ? (
                <>
                  <p
                    class="font-semibold"
                    data-semantic-release-count
                  >
                    <span class="font-mono text-lg">
                      {successfulSemanticCaseCount}/{model.semanticEvaluation.caseCount}
                    </span>{' '}
                    decisions verified
                  </p>
                  <p
                    class="text-muted-foreground"
                    data-semantic-release-outcomes
                  >
                    {directlyPassedSemanticCaseCount} passed directly, {recoveredSemanticCaseCount}{' '}
                    confirmed on retry
                  </p>
                </>
              ) : (
                <p
                  class="text-muted-foreground"
                  data-semantic-release-count
                >
                  No release decision result is recorded yet.
                </p>
              )
            }
          </div>
          <ActionLink
            class="mt-5 self-start font-bold sm:mt-6"
            href={withBase(model.semanticEvaluation.route, basePath)}
            variant="link"
          >
            Inspect the decisions
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </article>

        <article
          class="flex min-w-0 flex-col py-6 sm:rounded-xl sm:border sm:border-border sm:bg-card sm:p-7 sm:shadow-surface"
          data-home-evidence-card="qualification"
        >
          <div class="flex items-center gap-3">
            <span
              class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted"
            >
              <Cable
                class="size-5"
                aria-hidden="true"
              />
            </span>
            <p class="eyebrow">Adapter qualification</p>
          </div>
          <h3 class="mt-4 text-xl font-semibold tracking-tight sm:mt-5 sm:text-2xl">
            Does it work with your integration?
          </h3>
          <p
            class="mt-3 max-w-xl text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7"
          >
            Inspect the real project changes and source checks for every supported adapter setup.
          </p>
          <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-2 text-sm sm:mt-6">
            {
              hasQualificationReleaseEvidence ? (
                <p
                  class="font-semibold"
                  data-qualification-release-count
                >
                  <span class="font-mono text-lg">
                    {qualifiedProfileCount}/{model.qualification.profiles.length}
                  </span>{' '}
                  adapter setups qualified
                </p>
              ) : (
                <p
                  class="text-muted-foreground"
                  data-qualification-release-count
                >
                  No adapter qualification result is recorded yet.
                </p>
              )
            }
          </div>
          <ActionLink
            class="mt-5 self-start font-bold md:mt-auto md:pt-6"
            href={withBase(model.qualification.route, basePath)}
            variant="link"
          >
            Inspect the adapters
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </article>
      </div>
    </div>
  </section>

  <section
    class="bg-sidebar py-section-gap"
    aria-labelledby="getting-started-title"
    data-adoption
  >
    <div class="page-shell">
      <GettingStartedSimulation />
      <CodingAgentCompatibility />
    </div>
  </section>
</BaseLayout>
