---
import {
  ArrowDown,
  ArrowRight,
  Bot,
  Check,
  FileCheck,
  FileCode,
  FileText,
  GitBranch,
  Link2,
  Search,
  ShieldCheck,
  Terminal,
  UserRound,
} from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';
import BookingArtifacts from '../booking-artifacts/booking-artifacts.astro';
import { BOOKING_EXAMPLE } from '../../lib/booking-example/index.ts';
import { PRODUCT_PAGE_METADATA } from '../../lib/model/constants.ts';
import { SITE_GHOST_LINK_CLASS_NAME } from '../../lib/site/index.ts';

const basePath = import.meta.env.BASE_URL;
const pageMetadata = PRODUCT_PAGE_METADATA.howItWorks;
const skillMarkPath = withBase('/logo/icon-xs-light.png', basePath);
const requestedOutcomeMarkPath = withBase('/logo/icon-xs-dark.png', basePath);
const connectionItems = [
  {
    icon: FileText,
    label: 'Agent guidance',
    path: BOOKING_EXAMPLE.files.instructions.path,
    title: 'Offer only returned time slots',
  },
  {
    icon: Terminal,
    label: 'Availability tool',
    path: BOOKING_EXAMPLE.files.availability.path,
    title: 'Read open times from the service',
  },
  {
    icon: ShieldCheck,
    label: 'Software guardrail',
    path: BOOKING_EXAMPLE.files.service.path,
    title: 'Hold same-day requests for staff',
  },
  {
    icon: FileCheck,
    label: 'Project checks',
    path: BOOKING_EXAMPLE.files.tests.path,
    title: 'Protect availability and approval',
  },
] as const;
---

<BaseLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
>
  <header class="border-b border-border bg-background sm:border-y">
    <div
      class="page-shell grid items-center gap-10 py-10 sm:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)] lg:gap-6 lg:py-20"
    >
      <div
        class="min-w-0"
        data-workflow-hero-copy
      >
        <p class="eyebrow mb-4">How it works</p>
        <h1 class="page-title">From project context to a working agent.</h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          <InlineBrandText
            text="Start with the project rules your coding agent needs. This booking example shows how moldea uses that foundation when you build and maintain a runtime agent."
          />
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <ActionLink
            class="font-bold shadow-raised"
            href="#project-context"
            size="lg"
          >
            Follow the workflow
            <ArrowDown
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class={`font-bold ${SITE_GHOST_LINK_CLASS_NAME}`}
            href={withBase('/docs/how-it-works/', basePath)}
            size="lg"
            variant="ghost"
          >
            Read the technical guide
          </ActionLink>
        </div>
      </div>

      <ol
        class="relative grid gap-4"
        aria-label="Developer and coding agent booking conversation"
        data-workflow-conversation
      >
        <li class="relative flex max-w-2xl items-start gap-3">
          <span
            class="absolute top-9 -bottom-4 left-[1.125rem] w-px bg-border"
            aria-hidden="true"
          ></span>
          <span
            class="dark-surface-selection relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground"
            aria-hidden="true"
          >
            <UserRound
              class="size-4"
              aria-hidden="true"
            />
          </span>
          <div
            class="rounded-2xl rounded-tl-sm border border-border bg-card px-4 py-3 shadow-surface"
          >
            <p class="text-xs font-semibold text-muted-foreground">You</p>
            <p class="mt-1 text-sm leading-6 font-medium sm:text-base">
              {BOOKING_EXAMPLE.request}
            </p>
          </div>
        </li>
        <li class="flex min-w-0 items-start gap-3">
          <span
            class="relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-secondary"
            aria-hidden="true"
          >
            <img
              src={skillMarkPath}
              width="207"
              height="215"
              alt=""
              class="h-5 w-auto dark:invert"
            />
          </span>
          <article
            class="min-w-0 flex-1 overflow-hidden rounded-2xl rounded-tl-sm border border-border bg-card shadow-raised"
          >
            <div class="px-4 pt-3 pb-4 sm:px-5 sm:pt-4">
              <p class="text-xs font-semibold text-muted-foreground">Coding agent</p>
              <p class="mt-1 text-sm leading-6 font-medium sm:text-base">
                I connected live availability, kept same-day approval in the scheduling service, and
                checked the complete flow.
              </p>
              <div class="mt-4"><BookingArtifacts /></div>
            </div>
            <div class="border-t border-border bg-secondary/50 px-4 py-3 sm:px-5">
              <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
                <span class="rounded-md border border-border bg-background px-2.5 py-1.5"
                  >10:00 available</span
                >
                <ArrowRight
                  class="size-3.5 text-muted-foreground"
                  aria-hidden="true"
                />
                <span
                  class="rounded-md border border-warning/40 bg-warning/10 px-2.5 py-1.5 text-warning-foreground dark:text-foreground"
                  >Same day: staff approval</span
                >
              </div>
              <p class="mt-2 text-xs text-muted-foreground">
                Illustrative project. Open a file to inspect the example.
              </p>
            </div>
          </article>
        </li>
      </ol>
    </div>
  </header>

  <section
    id="project-context"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="project-context-title"
    data-workflow-stage="project-context"
  >
    <div
      class="page-shell grid gap-8 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-center lg:gap-14"
    >
      <div>
        <p class="eyebrow mb-3">01 Understand</p>
        <h2
          id="project-context-title"
          class="section-title"
        >
          Find the rules behind the request.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          The coding agent starts with the project facts that matter for this task. It learns who
          owns each decision before it changes a prompt or a line of code.
        </p>
        <div class="mt-5">
          <ActionLink
            class="font-bold"
            href={withBase('/docs/project-state/', basePath)}
            variant="link"
          >
            Project state guide
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>

      <div
        class="grid min-w-0 gap-4"
        data-context-selection
      >
        <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground">
          <Search
            class="size-4"
            aria-hidden="true"
          />
          Two rules selected for this request
        </div>
        <FilePreview
          path={BOOKING_EXAMPLE.files.policy.path}
          label="Your project policy"
        >
          <div class="p-4 sm:p-5">
            <p class="text-base font-semibold">Same-day requests need staff approval.</p>
            <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded-md bg-secondary px-2.5 py-1.5 font-semibold">Customer asks</span>
              <ArrowRight
                class="size-3.5 text-muted-foreground"
                aria-hidden="true"
              />
              <span
                class="rounded-md border border-warning/40 bg-warning/10 px-2.5 py-1.5 font-semibold text-warning-foreground dark:text-foreground"
                >Staff decides</span
              >
            </div>
          </div>
        </FilePreview>
        <FilePreview
          path="moldea/project.md"
          label="Who owns the decision"
        >
          <div class="p-4 sm:p-5">
            <p class="text-sm font-semibold">
              The scheduling service enforces availability and approval state.
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              The assistant explains the status. It cannot approve the booking.
            </p>
          </div>
        </FilePreview>
      </div>
    </div>
  </section>

  <section
    id="connections"
    class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
    aria-labelledby="connections-title"
    data-workflow-stage="connections"
  >
    <div class="page-shell">
      <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
        <div>
          <p class="eyebrow mb-3">02 Connect</p>
          <h2
            id="connections-title"
            class="section-title"
          >
            See the complete change before editing.
          </h2>
        </div>
        <p class="text-base leading-7 text-muted-foreground">
          The relationships in <code class="inline-code">moldea.yaml</code> show which parts of the project
          may be affected. Each connection is a reason to inspect, not an instruction to rewrite.
        </p>
      </header>

      <div
        class="-mx-4 mt-8 overflow-hidden border-y border-border bg-card sm:mx-0 sm:rounded-2xl sm:border sm:shadow-raised"
        data-connection-map
      >
        <div
          class="flex items-center justify-between gap-4 border-b border-border px-4 py-3 sm:px-6"
        >
          <div class="flex min-w-0 items-center gap-2.5">
            <Link2
              class="size-4 shrink-0 text-muted-foreground"
              aria-hidden="true"
            />
            <code class="truncate text-xs font-semibold sm:text-sm">moldea/moldea.yaml</code>
          </div>
          <span class="shrink-0 text-xs font-semibold text-emerald-800 dark:text-emerald-200"
            >4 links found</span
          >
        </div>
        <div
          class="relative grid lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:items-stretch"
        >
          <article class="bg-elevated p-5 sm:p-6 lg:border-e lg:border-border">
            <span
              class="dark-surface-selection inline-flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-surface"
              aria-hidden="true"
            >
              <img
                src={requestedOutcomeMarkPath}
                width="207"
                height="215"
                alt=""
                class="h-5 w-auto"
                data-requested-outcome-agent-mark
              />
            </span>
            <p class="eyebrow mt-5">Requested outcome</p>
            <h3 class="mt-2 text-lg leading-7 font-semibold">
              A booking assistant with safe boundaries
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">
              Offer real availability. Keep same-day approval with staff.
            </p>
          </article>

          <div
            class="flex items-center justify-center border-y border-border bg-background py-2.5 text-muted-foreground lg:hidden"
            aria-hidden="true"
          >
            <ArrowDown class="size-4" />
          </div>

          <span
            class="absolute top-1/2 left-[36%] z-10 hidden size-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background text-muted-foreground shadow-surface lg:inline-flex"
            aria-hidden="true"
          >
            <ArrowRight class="size-4" />
          </span>

          <ol
            class="divide-y divide-border bg-background"
            aria-label="Parts connected to the booking assistant"
          >
            {
              connectionItems.map(({ icon: ConnectionIcon, label, path, title }) => (
                <li
                  class="grid grid-cols-[2.25rem_minmax(0,1fr)_auto] items-center gap-x-3 px-4 py-3.5 sm:px-5"
                  data-connection-item
                >
                  <span class="row-span-2 inline-flex size-9 items-center justify-center rounded-lg bg-muted">
                    <ConnectionIcon
                      class="size-4"
                      aria-hidden="true"
                    />
                  </span>
                  <p class="text-xs font-semibold text-muted-foreground">{label}</p>
                  <Check
                    class="row-span-2 size-4 text-emerald-700 dark:text-emerald-300"
                    aria-hidden="true"
                  />
                  <div class="mt-0.5 flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-1">
                    <h3 class="text-sm font-semibold">{title}</h3>
                    <code class="min-w-0 text-xs break-all text-muted-foreground">{path}</code>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <p
          class="flex items-center justify-center gap-2 border-t border-border bg-emerald-600/10 px-4 py-3 text-center text-sm font-semibold text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-200"
        >
          <Check
            class="size-4 shrink-0"
            aria-hidden="true"
          />Four affected parts found before the first edit.
        </p>
      </div>
      <div class="mt-5">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/continuous-maintenance/', basePath)}
          variant="link"
        >
          Continuous maintenance guide
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </section>

  <section
    id="connected-change"
    class="dark-surface-selection scroll-mt-24 border-b border-border bg-primary pt-12 text-primary-foreground sm:py-16"
    aria-labelledby="connected-change-title"
    data-workflow-stage="connected-change"
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3 text-primary-foreground/60">03 Change</p>
        <h2
          id="connected-change-title"
          class="section-title"
        >
          Update each owner once.
        </h2>
        <p class="mt-4 text-base leading-7 text-primary-foreground/70">
          Software keeps the hard rule. Agent guidance explains it. Project context records the
          responsibility so another session does not have to rediscover it.
        </p>
      </header>

      <div
        class="light-surface-selection -mx-4 mt-8 bg-primary-foreground text-primary sm:mx-0 sm:overflow-hidden sm:rounded-3xl sm:shadow-raised"
        data-connected-change
      >
        <div class="flex items-start gap-3 px-4 py-5 sm:px-7 sm:py-6">
          <span
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-[var(--website-ui-light-secondary)]"
            aria-hidden="true"
          >
            <img
              src={skillMarkPath}
              width="207"
              height="215"
              alt=""
              class="h-5 w-auto"
            />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-semibold text-primary/60">Coding agent</p>
            <p class="mt-1 text-sm leading-6 font-medium sm:text-base">
              I connected live availability, kept same-day requests pending for staff approval, and
              updated the booking assistant to explain the result.
            </p>
          </div>
        </div>
        <div
          class="grid border-t border-primary/10 md:grid-cols-3 md:grid-rows-[auto_1fr] md:gap-y-4 md:divide-x md:divide-primary/10"
        >
          <article
            class="grid min-w-0 gap-y-4 px-4 py-5 sm:px-7 md:row-span-2 md:grid-rows-subgrid"
          >
            <div class="flex items-center gap-3">
              <span
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-[var(--website-ui-light-secondary)]"
              >
                <FileCode
                  class="size-4"
                  aria-hidden="true"
                />
              </span>
              <div>
                <p class="text-xs text-primary/60">Software</p>
                <h3 class="mt-0.5 text-sm font-semibold">Enforces the approval path</h3>
              </div>
            </div>
            <div
              class="theme-surface-selection text-foreground [&>[data-file-preview]]:flex [&>[data-file-preview]]:h-full [&>[data-file-preview]]:flex-col [&>[data-file-preview]]:bg-card"
            >
              <FilePreview path={BOOKING_EXAMPLE.files.service.path}>
                <div class="flex-1 bg-card p-3">
                  <CodeBlock
                    source={BOOKING_EXAMPLE.serviceExcerpt}
                    language="typescript"
                    copyable={false}
                    variant="plain"
                  />
                </div>
              </FilePreview>
            </div>
          </article>
          <article
            class="grid min-w-0 gap-y-4 border-t border-primary/10 px-4 py-5 sm:px-7 md:row-span-2 md:grid-rows-subgrid md:border-t-0"
          >
            <div class="flex items-center gap-3">
              <span
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-[var(--website-ui-light-secondary)]"
              >
                <Bot
                  class="size-4"
                  aria-hidden="true"
                />
              </span>
              <div>
                <p class="text-xs text-primary/60">Agent</p>
                <h3 class="mt-0.5 text-sm font-semibold">Explains only verified options</h3>
              </div>
            </div>
            <div
              class="theme-surface-selection text-foreground [&>[data-file-preview]]:flex [&>[data-file-preview]]:h-full [&>[data-file-preview]]:flex-col [&>[data-file-preview]]:bg-card"
            >
              <FilePreview path={BOOKING_EXAMPLE.files.instructions.path}>
                <div class="flex-1 bg-card p-3">
                  <p class="text-sm leading-6">Never describe a pending request as confirmed.</p>
                  <div class="mt-3 rounded-lg bg-secondary p-3 text-sm leading-6">
                    Your request is waiting for staff approval.
                  </div>
                  <p class="mt-2 text-xs text-muted-foreground">Example customer response</p>
                </div>
              </FilePreview>
            </div>
          </article>
          <article
            class="grid min-w-0 gap-y-4 border-t border-primary/10 px-4 py-5 sm:px-7 md:row-span-2 md:grid-rows-subgrid md:border-t-0"
          >
            <div class="flex items-center gap-3">
              <span
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-[var(--website-ui-light-secondary)]"
              >
                <FileText
                  class="size-4"
                  aria-hidden="true"
                />
              </span>
              <div>
                <p class="text-xs text-primary/60">Project truth</p>
                <h3 class="mt-0.5 text-sm font-semibold">Records the ownership boundary</h3>
              </div>
            </div>
            <div
              class="theme-surface-selection text-foreground [&>[data-file-preview]]:flex [&>[data-file-preview]]:h-full [&>[data-file-preview]]:flex-col [&>[data-file-preview]]:bg-card"
            >
              <FilePreview path={BOOKING_EXAMPLE.files.policy.path}>
                <div class="flex-1 bg-card p-3 text-sm leading-6">
                  <p>The scheduling service enforces the rule. Staff owns the approval decision.</p>
                </div>
              </FilePreview>
            </div>
          </article>
        </div>
        <p
          class="flex items-center gap-2 border-t border-primary/10 px-4 py-4 text-sm font-semibold text-emerald-700 sm:px-7"
        >
          <Check
            class="size-4 shrink-0"
            aria-hidden="true"
          />Each rule keeps one owner. No duplicate prompt policy.
        </p>
      </div>
    </div>
  </section>

  <section
    id="verification"
    class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
    aria-labelledby="verification-title"
    data-workflow-stage="verification"
  >
    <div
      class="page-shell grid gap-8 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-center lg:gap-14"
    >
      <div>
        <p class="eyebrow mb-3">04 Prove</p>
        <h2
          id="verification-title"
          class="section-title"
        >
          Check what the customer will actually get.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          Try an unavailable time, an available time today, and an available time tomorrow. Each
          must produce the right result before the assistant reports a booking.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
          <ActionLink
            class="font-bold"
            href={withBase('/docs/evaluate-reconcile-validate/', basePath)}
            variant="link"
          >
            Evaluation guide
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/evidence/', basePath)}
            variant="link"
          >
            Inspect recorded evidence
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
        </div>
      </div>

      <div
        class="min-w-0"
        data-verification-board
      >
        <FilePreview
          path={BOOKING_EXAMPLE.files.tests.path}
          label="Expected booking results"
        >
          <div
            class="border-b border-border px-3 py-4 sm:px-5"
            data-booking-availability
          >
            <p class="text-xs font-semibold text-muted-foreground">Availability</p>
            <dl class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm">
              <div class="flex items-baseline gap-2">
                <dt class="text-muted-foreground">Today:</dt>
                <dd>
                  <code class="font-semibold">{BOOKING_EXAMPLE.availability.today.join(', ')}</code>
                </dd>
              </div>
              <div class="flex items-baseline gap-2">
                <dt class="text-muted-foreground">Tomorrow:</dt>
                <dd>
                  <code class="font-semibold"
                    >{BOOKING_EXAMPLE.availability.tomorrow.join(', ')}</code
                  >
                </dd>
              </div>
            </dl>
          </div>
          <table class="w-full text-left text-sm">
            <caption class="sr-only">Booking requests and expected customer outcomes</caption>
            <thead class="border-b border-border bg-muted/30 text-xs text-muted-foreground">
              <tr
                ><th
                  scope="col"
                  class="px-3 py-3 sm:px-5"
                  >Request</th
                ><th
                  scope="col"
                  class="px-3 py-3 sm:px-5"
                  >Result</th
                ></tr
              >
            </thead>
            <tbody class="divide-y divide-border">
              {
                BOOKING_EXAMPLE.checks.map((check) => (
                  <tr data-verification-row>
                    <th
                      scope="row"
                      class="px-3 py-4 font-normal sm:px-5"
                    >
                      <span class="flex flex-wrap items-baseline gap-x-1.5 font-semibold">
                        <span>{check.isSameDay ? 'Today' : 'Tomorrow'}</span>
                        <span aria-hidden="true">·</span>
                        <code>{check.slot}</code>
                      </span>
                      <span class="mt-1 block text-xs text-muted-foreground">{check.label}</span>
                    </th>
                    <td class="px-3 py-4 sm:px-5">
                      <span class="flex items-center gap-2 font-semibold">
                        <Check
                          class="size-4 shrink-0 text-success"
                          aria-hidden="true"
                        />
                        {check.outcome}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p
            class="border-t border-border bg-secondary/50 px-3 py-3 text-xs leading-5 text-muted-foreground sm:px-5"
          >
            The example's code is tested against these outcomes, including empty availability.
            Recorded skill tests are on the Evidence page.
          </p>
        </FilePreview>
      </div>
    </div>
  </section>

  <section
    id="next-session"
    class="scroll-mt-24 border-b border-border bg-elevated py-12 sm:py-16"
    aria-labelledby="next-session-title"
    data-workflow-stage="next-session"
  >
    <div class="page-shell">
      <header class="max-w-3xl">
        <p class="eyebrow mb-3">05 Carry forward</p>
        <h2
          id="next-session-title"
          class="section-title"
        >
          The next session starts with the result.
        </h2>
        <p class="mt-4 text-base leading-7 text-muted-foreground">
          The rule, its owner, and its connections stay in the repository. A later coding agent can
          use them without relying on hidden model memory or a perfect handoff.
        </p>
      </header>

      <div
        class="mt-8 grid gap-4 lg:grid-cols-[minmax(0,0.86fr)_auto_minmax(0,1.14fr)] lg:items-stretch"
        data-next-session-visual
      >
        <article class="rounded-2xl border border-border bg-card p-5 shadow-surface sm:p-6">
          <div class="flex items-center justify-between gap-4">
            <p class="eyebrow">First session</p>
            <span class="inline-flex size-9 items-center justify-center rounded-xl bg-muted">
              <FileText
                class="size-4"
                aria-hidden="true"
              />
            </span>
          </div>
          <p class="mt-5 text-lg leading-7 font-semibold">
            “Same-day bookings require staff approval.”
          </p>
          <dl class="mt-5 grid gap-3 border-t border-border pt-4 text-sm">
            <div class="flex items-center justify-between gap-4">
              <dt class="text-muted-foreground">Owner</dt>
              <dd class="font-semibold">Scheduling service</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-muted-foreground">Saved in</dt>
              <dd><code class="font-semibold">booking-policy.md</code></dd>
            </div>
          </dl>
        </article>

        <div
          class="flex items-center justify-center text-muted-foreground"
          aria-hidden="true"
        >
          <ArrowRight class="hidden size-5 lg:block" />
          <ArrowDown class="size-5 lg:hidden" />
        </div>

        <article
          class="overflow-hidden rounded-2xl border border-border bg-card shadow-raised"
          data-later-session-chat
        >
          <div
            class="flex items-center justify-between gap-4 border-b border-border px-5 py-4 sm:px-6"
          >
            <p class="eyebrow">Later session</p>
            <span class="inline-flex size-9 items-center justify-center rounded-xl bg-muted">
              <GitBranch
                class="size-4"
                aria-hidden="true"
              />
            </span>
          </div>
          <ol
            class="grid gap-4 px-4 py-5 sm:px-6 sm:py-6"
            aria-label="Later booking conversation"
          >
            <li class="relative flex max-w-lg items-start gap-3">
              <span
                class="absolute top-9 -bottom-4 left-[1.125rem] w-px bg-border"
                aria-hidden="true"
              ></span>
              <span
                class="dark-surface-selection relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground"
                aria-hidden="true"
              >
                <UserRound
                  class="size-4"
                  aria-hidden="true"
                />
              </span>
              <div
                class="rounded-2xl rounded-tl-sm border border-border bg-background px-4 py-3 shadow-surface"
                data-chat-message="request"
              >
                <p class="text-xs font-semibold text-muted-foreground">You</p>
                <p class="mt-1 text-sm leading-6 font-medium">
                  Add rescheduling to the booking assistant.
                </p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span
                class="relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-secondary"
                aria-hidden="true"
              >
                <img
                  src={skillMarkPath}
                  width="207"
                  height="215"
                  alt=""
                  class="h-5 w-auto dark:invert"
                />
              </span>
              <div
                class="rounded-2xl rounded-tl-sm border border-border bg-background px-4 py-3 shadow-surface"
                data-chat-message="response"
              >
                <p class="text-xs font-semibold text-muted-foreground">Coding agent</p>
                <p class="mt-1 text-sm leading-6 font-medium">
                  I’ll reuse live availability and preserve staff approval for same-day changes.
                </p>
              </div>
            </li>
          </ol>
          <p
            class="flex items-center gap-2 border-t border-border bg-emerald-600/10 px-5 py-4 text-sm font-semibold text-emerald-800 sm:px-6 dark:bg-emerald-400/10 dark:text-emerald-200"
          >
            <Check
              class="size-4 shrink-0"
              aria-hidden="true"
            />Project memory, available when the next task needs it.
          </p>
        </article>
      </div>
      <div class="mt-5">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/how-it-works/', basePath)}
          variant="link"
        >
          Read the technical workflow
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </section>

  <section
    class="dark-surface-selection bg-primary py-10 text-primary-foreground sm:py-12"
    aria-labelledby="workflow-next-title"
  >
    <div class="page-shell flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="eyebrow mb-2 text-primary-foreground/60">See the result</p>
        <h2
          id="workflow-next-title"
          class="text-2xl font-semibold tracking-tight"
        >
          Open the proof behind the workflow.
        </h2>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-3">
        <ActionLink
          class="font-bold"
          href={withBase('/evidence/', basePath)}
          variant="secondary"
        >
          Inspect the evidence
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <a
          class="inline-flex min-h-10 items-center gap-2 px-1 text-sm font-bold text-primary-foreground link-feedback focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-foreground"
          href={withBase('/capabilities/', basePath)}
        >
          Explore every capability
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
