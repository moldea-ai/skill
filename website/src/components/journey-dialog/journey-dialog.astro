---
import Dialog from '@moldea.ai/website-ui/dialog';
import ActionButton from '@moldea.ai/website-ui/action-button';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { ArrowRight } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import { JourneyViewer } from '../journey-viewer/index.ts';
import type { IScriptedJourneysWebsiteModel } from '../../lib/scripted-journeys/index.ts';

interface Props {
  model: IScriptedJourneysWebsiteModel;
  journey: IScriptedJourneysWebsiteModel['journeys'][number];
}
const { model, journey } = Astro.props;
const url = withBase(journey.route, import.meta.env.BASE_URL);
---

<div
  data-journey-launcher
  data-journey-url={url}
>
  <Dialog
    id={`journey-dialog-${journey.id}`}
    title={journey.title}
    triggerLabel={`Open ${journey.title} results`}
    triggerAriaLabel={`Open ${journey.title} results`}
    triggerVariant="ghost"
    triggerSize="lg"
    triggerClass="h-auto w-full justify-start rounded-none px-0 py-6 text-left whitespace-normal hover:bg-secondary/40"
    size="large"
    panelClass="sm:h-[calc(100dvh-2rem)]!"
    isOverlayCloseEnabled
  >
    <span
      slot="trigger"
      class="block w-full"
      ><slot /></span
    >
    <JourneyViewer
      {model}
      {journey}
      lazy
    />
    <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-border pt-4">
      <ActionButton
        data-journey-retry
        hidden
        variant="outline"
        >Try again</ActionButton
      >
      <ActionLink
        href={url}
        variant="link"
        size="sm"
      >
        Open the full page
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
    </div>
  </Dialog>
  <a
    href={url}
    class="block py-6 link-feedback"
    data-journey-fallback
  >
    {journey.title}{' '}<span class="ml-2 text-xs text-muted-foreground">Open conversation</span>
  </a>
</div>

<style>
  /* Keep native links when enhancement is unavailable, without duplicate active controls. */
  [data-journey-launcher]:has(> [data-dialog-root] > [data-dialog-trigger]:not([hidden]))
    > [data-journey-fallback] {
    display: none;
  }
</style>
