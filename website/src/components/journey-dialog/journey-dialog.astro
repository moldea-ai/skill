---
import Dialog from '@moldea.ai/website-ui/dialog';
import ActionButton from '@moldea.ai/website-ui/action-button';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { ArrowRight } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import { JourneyViewer } from '../journey-viewer/index.ts';
import type { IScriptedJourneysWebsiteModel } from '../../lib/scripted-journeys/index.ts';

interface Props {
  model: IScriptedJourneysWebsiteModel;
  journey: IScriptedJourneysWebsiteModel['journeys'][number];
}
const { model, journey } = Astro.props;
const url = withBase(journey.route, import.meta.env.BASE_URL);
const rowContent = await Astro.slots.render('default');
---

<div
  data-journey-launcher
  data-journey-url={url}
>
  <Dialog
    id={`journey-dialog-${journey.id}`}
    title={journey.title}
    triggerLabel={`Open ${journey.title} results`}
    triggerAriaLabel={`Open ${journey.title} results`}
    triggerVariant="ghost"
    triggerSize="lg"
    triggerClass="h-auto w-full justify-start rounded-none px-0 py-6 text-left whitespace-normal hover:bg-secondary/40"
    size="large"
    panelClass="sm:h-[calc(100dvh-2rem)]!"
    isOverlayCloseEnabled
  >
    <span
      slot="trigger"
      class="block w-full"
      ><Fragment set:html={rowContent} /></span
    >
    <JourneyViewer
      {model}
      {journey}
      lazy
    />
    <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-border pt-4">
      <ActionButton
        data-journey-retry
        hidden
        variant="outline"
        >Try again</ActionButton
      >
      <ActionLink
        href={url}
        variant="link"
        size="sm"
      >
        Open the full page
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
    </div>
  </Dialog>
  <ActionLink
    href={url}
    variant="ghost"
    size="lg"
    class="h-auto w-full justify-start rounded-none px-0 py-6 text-left whitespace-normal hover:bg-secondary/40"
    aria-label={`Open ${journey.title} results`}
    data-journey-fallback
  >
    <span class="block w-full"><Fragment set:html={rowContent} /></span>
  </ActionLink>
</div>

<style>
  :global(
    [data-journey-launcher]:not([data-journey-ready='true'])
      > [data-dialog-root]
      > [data-dialog-trigger]
  ),
  :global(
    [data-journey-launcher]:has(> [data-journey-fallback]:focus-within)
      > [data-dialog-root]
      > [data-dialog-trigger]
  ) {
    display: none;
  }

  /* Keep a focused native link until focus moves, even if enhancement finishes meanwhile. */
  :global(
    [data-journey-launcher][data-journey-ready='true']:has(
        > [data-dialog-root][data-enhanced='true']
      )
      > [data-journey-fallback]:not(:focus-within)
  ) {
    display: none;
  }
</style>
