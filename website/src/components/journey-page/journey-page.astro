---
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import { JourneyViewer } from '../journey-viewer/index.ts';
import BaseLayout from '../../layouts/base-layout.astro';
import type { IScriptedJourneysWebsiteModel } from '../../lib/scripted-journeys/index.ts';

interface Props {
  model: IScriptedJourneysWebsiteModel;
  journey: IScriptedJourneysWebsiteModel['journeys'][number];
}
const { model, journey } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { href: model.route, label: 'Scripted journeys' },
  { label: journey.title },
];
---

<BaseLayout
  title={`${journey.title}: scripted journey`}
  description={journey.summary}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      {basePath}
      items={breadcrumbs}
    />
  </div>
  <header class="page-shell py-10 sm:py-14">
    <p class="eyebrow mb-4">Recorded conversation</p>
    <h1 class="page-title">{journey.title}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-muted-foreground">{journey.summary}</p>
    <ActionLink
      href={withBase(model.route, basePath)}
      variant="link"
      class="mt-5"
      >All journeys and run details</ActionLink
    >
  </header>
  <div class="page-shell pb-12 sm:pb-16">
    <div class="max-w-4xl">
      <h2 class="sr-only">Recorded requests and replies</h2>
      <JourneyViewer
        {model}
        {journey}
      />
    </div>
  </div>
</BaseLayout>
