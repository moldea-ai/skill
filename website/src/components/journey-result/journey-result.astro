---
import CodeDiff from '@moldea.ai/website-ui/code-diff';
import Dialog from '@moldea.ai/website-ui/dialog';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';
import { withBase } from '@moldea.ai/website-ui/site';

import EvidenceStatus from '../evidence-status/evidence-status.astro';
import { PlatformMark } from '../platform-mark/index.ts';
import { RecordedFileTree } from '../recorded-file-tree/index.ts';
import {
  describeJourneyCheck,
  type IJourneyWebsiteResult,
} from '../../lib/scripted-journeys/index.ts';

interface Props {
  result: IJourneyWebsiteResult;
  id: string;
}
const { result, id } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const replyHtml = await renderMarkdownFragment(result.reply, {
  basePath,
  localLinks: 'unwrap',
});
---

<div
  class="min-w-0"
  data-journey-result={result.platform}
>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4">
    <h3 class="text-base"><PlatformMark platform={result.platform} /></h3><EvidenceStatus
      status={result.status}
    />
  </div>
  <section class="mt-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h4
        id={`${id}-files`}
        class="text-sm font-semibold"
      >
        Recorded file changes
      </h4>{
        result.patch.trim() && (
          <Dialog
            id={`${id}-diff`}
            title="Recorded file changes"
            triggerLabel="Inspect diff"
            triggerAriaLabel={`Inspect ${result.platform === 'chatgpt' ? 'ChatGPT' : 'Claude'} diff`}
            size="large"
          >
            <CodeDiff
              patch={result.patch}
              view="split"
              ariaLabel="Recorded journey patch"
            />
          </Dialog>
        )
      }
    </div>
    <div
      class="mt-3"
      data-brand-plain
    >
      {
        result.files.length > 0 ? (
          <RecordedFileTree
            changes={result.files}
            label="Changed files in this step"
          />
        ) : (
          <p class="text-sm leading-6 text-muted-foreground">
            {result.facts === null
              ? 'No step capture is available.'
              : 'No files changed in this step.'}
          </p>
        )
      }
    </div>
    {
      result.patchUrl && (
        <a
          href={withBase(result.patchUrl, basePath)}
          class="mt-3 inline-block text-xs font-medium text-muted-foreground underline underline-offset-4 link-feedback"
        >
          Raw patch
        </a>
      )
    }
  </section>
  <section class="mt-6 border-t border-border pt-5">
    <h4
      id={`${id}-checks`}
      class="text-sm font-semibold"
    >
      Trusted local checks
    </h4><p class="mt-1 text-xs leading-5 text-muted-foreground">
      Applied locally to reconstructed files and the captured reply.
    </p><ul class="mt-3 space-y-3">
      {
        result.checks.map((check) => (
          <li class="min-w-0">
            <div class="flex flex-wrap items-start gap-2">
              <EvidenceStatus status={check.status} />
              <span class="min-w-0 flex-1 text-xs leading-5 break-words">
                {describeJourneyCheck(check.check)}
              </span>
            </div>
            <p class="mt-1 text-xs leading-5 text-muted-foreground">{check.detail}</p>
            {check.check.kind === 'reply-matches' && check.check.reference && (
              <p class="mt-1 text-xs leading-5 text-muted-foreground">
                Skill reference: <code>{check.check.reference.path}</code>.{' '}
                {check.check.reference.statement}
              </p>
            )}
          </li>
        ))
      }
    </ul>{
      result.checks.length === 0 && (
        <p class="mt-3 text-sm text-muted-foreground">No checks ran for this blocked step.</p>
      )
    }
  </section>
  {
    result.unverified.length > 0 && (
      <section class="mt-6 border-t border-border pt-5">
        <>
          <div class="flex flex-wrap items-center gap-2">
            <>
              <h4
                id={`${id}-unverified`}
                class="text-sm font-semibold"
              >
                Claims beyond these checks
              </h4>
              <EvidenceStatus status="unverified" />
            </>
          </div>
          <ul class="mt-3 list-disc space-y-2 pl-4 text-xs leading-6 text-muted-foreground">
            {result.unverified.map((claim) => (
              <li>{claim}</li>
            ))}
          </ul>
        </>
      </section>
    )
  }
  <details class="mt-6 border-t border-border pt-5">
    <summary class="cursor-pointer text-sm font-semibold">Agent-reported reply</summary><p
      class="mt-2 text-xs leading-5 text-muted-foreground"
    >
      Captured by the harness from text the agent supplied. It is not an independent execution
      trace.
    </p><div
      class="markdown-content mt-4 min-w-0 text-sm break-words"
      set:html={replyHtml}
    />{
      result.replyUrl && (
        <a
          href={withBase(result.replyUrl, basePath)}
          class="mt-3 inline-block text-xs underline underline-offset-4 link-feedback"
        >
          Raw reply
        </a>
      )
    }
  </details>
  <details class="mt-5 border-t border-border pt-5">
    <summary class="cursor-pointer text-sm font-semibold">Sandbox-captured facts</summary>{
      result.facts ? (
        <dl class="mt-3 space-y-2 text-xs leading-6 text-muted-foreground">
          <>
            <div>
              <>
                <dt>Issued at</dt>
                <dd class="font-mono break-all">{result.facts.issuedAt}</dd>
              </>
            </div>
            <div>
              <>
                <dt>Recorded at</dt>
                <dd class="font-mono break-all">{result.facts.recordedAt}</dd>
              </>
            </div>
            <div>
              <>
                <dt>Local CLI present when recorded</dt>
                <dd>{result.facts.cliPresent ? 'Yes' : 'No'}</dd>
              </>
            </div>
          </>
        </dl>
      ) : (
        <p class="mt-3 text-sm text-muted-foreground">No facts were captured.</p>
      )
    }<p class="mt-3 text-xs leading-5 text-muted-foreground">
      These are harness observations inside a model-controlled workspace. CLI presence does not
      establish that the agent ran it.
    </p>
  </details>
  <details class="mt-5 border-t border-border pt-5">
    <summary class="cursor-pointer text-sm font-semibold">Agent-reported activity</summary>{
      result.activity ? (
        <dl class="mt-3 space-y-4 text-xs leading-6 text-muted-foreground">
          {Object.entries(result.activity).map(([category, entries]) => (
            <div>
              <dt class="font-semibold text-foreground capitalize">{category}</dt>
              <dd>
                {entries.length > 0 ? (
                  <ul class="mt-1 space-y-1">
                    {entries.map((entry) => (
                      <li class="break-words">
                        {category === 'notes' ? entry : <code>{entry}</code>}
                      </li>
                    ))}
                  </ul>
                ) : (
                  'None reported'
                )}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="mt-3 text-sm text-muted-foreground">No activity was reported.</p>
      )
    }{
      result.activityUrl && (
        <a
          href={withBase(result.activityUrl, basePath)}
          class="mt-3 inline-block text-xs underline underline-offset-4 link-feedback"
        >
          Raw activity JSON
        </a>
      )
    }
  </details>
</div>
