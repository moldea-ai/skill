---
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import JourneyResult from '../journey-result/journey-result.astro';
import type { IScriptedJourneysWebsiteModel } from '../../lib/scripted-journeys/index.ts';

interface Props {
  step: IScriptedJourneysWebsiteModel['journeys'][number]['steps'][number];
  journeyId: string;
  number: number;
}
const { step, journeyId, number } = Astro.props;
const id = `journey-${journeyId}-${step.id}`;
const platforms = ['chatgpt', 'claude'] as const;
---

<article
  class="min-w-0 border-t border-border py-9 sm:py-12"
  aria-labelledby={`${id}-request`}
  data-journey-step
>
  <div class="mb-7 flex min-w-0 items-start gap-3 sm:gap-4">
    <span
      class="flex size-8 shrink-0 items-center justify-center rounded-full border border-border font-mono text-xs text-muted-foreground"
      >{String(number).padStart(2, '0')}</span
    ><div class="min-w-0">
      <p class="eyebrow mb-2">Exact request</p><h2
        id={`${id}-request`}
        class="text-xl leading-8 font-semibold tracking-tight break-words sm:text-2xl"
      >
        <InlineBrandText
          text={step.request}
          variant="compact"
        />
      </h2>
    </div>
  </div>
  <div data-journey-platforms>
    <div
      class="mb-6 grid grid-cols-2 gap-2 rounded-lg border border-border bg-elevated p-1 [hidden]:hidden"
      data-platform-controls
      hidden
      aria-label={`Platform results for request ${number}`}
    >
      {
        platforms.map((platform) => (
          <button
            type="button"
            id={`${id}-${platform}-tab`}
            aria-controls={`${id}-${platform}-panel`}
            class="min-h-10 rounded-md px-3 text-sm font-semibold text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring aria-selected:bg-card aria-selected:text-foreground aria-selected:shadow-sm"
            data-platform-tab={platform}
          >
            {platform === 'chatgpt' ? 'ChatGPT' : 'Claude'}
          </button>
        ))
      }
    </div>
    <div class="grid gap-8 sm:grid-cols-2 sm:gap-8 lg:gap-12">
      {
        platforms.map((platform) => {
          const result = step.results.find((candidate) => candidate.platform === platform);
          return (
            <div
              id={`${id}-${platform}-panel`}
              class="min-w-0"
              data-platform-panel={platform}
            >
              {result ? (
                <JourneyResult
                  {result}
                  id={`${id}-${platform}`}
                />
              ) : (
                <p class="text-sm leading-7 text-muted-foreground">
                  No {platform === 'chatgpt' ? 'ChatGPT' : 'Claude'} step was recorded.
                </p>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</article>

<script>
  // this domain-specific comparison shows both platforms on desktop and one keyboard tab on mobile
  // Website UI's always-tabbed panels cannot express that responsive behavior without duplicate content
  let comparisons: AbortController | null = null;
  const initializeJourneyComparisons = () => {
    comparisons?.abort();
    comparisons = new AbortController();
    const { signal } = comparisons;
    for (const root of document.querySelectorAll<HTMLElement>('[data-journey-platforms]')) {
      const controls = root.querySelector<HTMLElement>('[data-platform-controls]');
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-platform-tab]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[data-platform-panel]')];
      if (!controls || tabs.length !== 2 || panels.length !== 2) continue;
      const mobile = window.matchMedia('(max-width: 639px)');
      let selected = 0;
      const update = () => {
        controls.hidden = !mobile.matches;
        if (mobile.matches) controls.setAttribute('role', 'tablist');
        else controls.removeAttribute('role');
        tabs.forEach((tab, index) => {
          tab.setAttribute('role', 'tab');
          tab.setAttribute('aria-selected', String(index === selected));
          tab.tabIndex = index === selected ? 0 : -1;
        });
        panels.forEach((panel, index) => {
          panel.hidden = mobile.matches && index !== selected;
          if (mobile.matches) {
            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', tabs[index]!.id);
            panel.tabIndex = 0;
          } else {
            panel.removeAttribute('role');
            panel.removeAttribute('aria-labelledby');
            panel.removeAttribute('tabindex');
          }
        });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener(
          'click',
          () => {
            selected = index;
            update();
          },
          { signal },
        );
        tab.addEventListener(
          'keydown',
          (event) => {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            selected = event.key === 'Home' ? 0 : event.key === 'End' ? 1 : 1 - selected;
            update();
            tabs[selected]!.focus();
          },
          { signal },
        );
      });
      mobile.addEventListener('change', update, { signal });
      update();
    }
  };
  document.addEventListener('astro:page-load', initializeJourneyComparisons);
  document.addEventListener('astro:before-swap', () => comparisons?.abort());
  initializeJourneyComparisons();
</script>
