---
import ConversationMessage from '@moldea.ai/website-ui/conversation-message';

import JourneyResult from '../journey-result/journey-result.astro';
import type { IJourneyRenderResult } from '../../lib/scripted-journeys/index.ts';

interface Props {
  request: string;
  result: IJourneyRenderResult;
  id: string;
  number: number;
}
const { request, result, id, number } = Astro.props;
---

<ConversationMessage role="user">
  <p class="mb-2 text-xs text-muted-foreground">Request {number}</p>
  <p
    class="text-sm leading-7 break-words whitespace-pre-wrap"
    data-journey-request
  >
    {request}
  </p>
</ConversationMessage>
<ConversationMessage role="assistant">
  <JourneyResult
    {result}
    {id}
  />
</ConversationMessage>
