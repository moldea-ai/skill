---
import StatusBadge from '@moldea.ai/website-ui/status-badge';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { ArrowUpRight, CircleCheck, CircleX, CircleMinus } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import { PlatformMark } from '../platform-mark/index.ts';
import {
  getJourneyPlatformStatus,
  getJourneyRevisions,
  getJourneyCellProvenance,
  JOURNEY_RESOLUTION_LABELS,
  type IScriptedJourneysWebsiteModel,
} from '../../lib/scripted-journeys/index.ts';

interface Props {
  model: IScriptedJourneysWebsiteModel;
  journeys?: IScriptedJourneysWebsiteModel['journeys'];
  offset?: number;
}
const { model, journeys = model.journeys, offset = 0 } = Astro.props;
const platforms = ['chatgpt', 'claude'] as const;
const basePath = import.meta.env.BASE_URL;
---

<div data-journeys-matrix>
  <div
    class="hidden grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-6 border-b border-border pb-4 sm:grid"
    aria-hidden="true"
  >
    <p class="self-center text-xs font-semibold tracking-wider text-muted-foreground uppercase">
      Scripted journey
    </p>
    {platforms.map((platform) => <PlatformMark {platform} />)}
  </div>
  <ul class="divide-y divide-border">
    {
      journeys.map((journey, index) => {
        const revisions = getJourneyRevisions(model, journey.id);
        return (
          <li class="grid min-w-0 gap-5 py-6 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] sm:items-center sm:gap-6">
            <a
              href={withBase(journey.route, basePath)}
              class="group flex min-w-0 items-start gap-3 rounded-sm link-feedback"
            >
              <span class="mt-1 font-mono text-xs text-muted-foreground">
                {String(offset + index + 1).padStart(2, '0')}
              </span>
              <span class="min-w-0">
                <>
                  <span class="flex items-center gap-2 font-semibold">
                    <InlineBrandText
                      text={journey.title}
                      variant="compact"
                    />
                    <ArrowUpRight
                      class="size-4 shrink-0 text-muted-foreground"
                      aria-hidden="true"
                    />
                  </span>
                  <span class="mt-1.5 block text-sm leading-6 text-muted-foreground">
                    <InlineBrandText
                      text={journey.summary}
                      variant="compact"
                    />
                  </span>
                  {!journey.current && (
                    <span class="mt-2 block text-xs text-muted-foreground">Earlier catalog</span>
                  )}
                  <span class="mt-2 block font-mono text-xs text-muted-foreground">
                    {revisions[0]!.steps.length}{' '}
                    {revisions[0]!.steps.length === 1 ? 'request' : 'requests'}
                  </span>
                </>
              </span>
            </a>
            <div class="grid grid-cols-2 gap-4 sm:contents">
              {platforms.map((platform) => {
                const status = getJourneyPlatformStatus(model, journey.id, platform);
                const provenance = getJourneyCellProvenance(model, journey.id, platform);
                const Icon = ['passed-initially', 'recovered', 'legacy-passed'].includes(status)
                  ? CircleCheck
                  : ['confirmed-failure', 'legacy-failed'].includes(status)
                    ? CircleX
                    : CircleMinus;
                return (
                  <div
                    role="group"
                    aria-label={`${journey.title}, ${platform === 'chatgpt' ? 'ChatGPT' : 'Claude'}: ${JOURNEY_RESOLUTION_LABELS[status]}`}
                    class="flex min-w-0 flex-wrap items-center gap-2"
                    data-journey-outcome={status}
                  >
                    <span class="basis-full text-xs text-muted-foreground sm:sr-only">
                      {platform === 'chatgpt' ? 'ChatGPT' : 'Claude'}
                    </span>
                    <Icon
                      class="size-4 shrink-0 text-muted-foreground"
                      aria-hidden="true"
                    />
                    <StatusBadge
                      label={JOURNEY_RESOLUTION_LABELS[status]!}
                      tone={
                        status === 'confirmed-failure' || status === 'legacy-failed'
                          ? 'danger'
                          : status === 'awaiting-confirmation' || status === 'blocked'
                            ? 'warning'
                            : status === 'not-run'
                              ? 'neutral'
                              : 'info'
                      }
                      size="sm"
                      truncate
                    />
                    <span
                      class="flex basis-full flex-wrap gap-1"
                      role="group"
                      aria-label="Recorded trials"
                    >
                      {revisions
                        .flatMap((revision) =>
                          revision.steps[0]!.results.filter(
                            (result) => result.platform === platform,
                          ),
                        )
                        .map((result) => (
                          <span
                            class="rounded border border-border px-1.5 py-0.5 font-mono text-xs text-muted-foreground"
                            title={`${result.label}: ${result.journeyStatus}`}
                          >
                            {result.label === 'Initial observation' ? 'Initial' : result.label} ·{' '}
                            {result.journeyStatus}
                          </span>
                        ))}
                    </span>
                    {provenance && (
                      <span class="basis-full text-xs leading-5 text-muted-foreground">
                        {provenance}
                      </span>
                    )}
                  </div>
                );
              })}
            </div>
          </li>
        );
      })
    }
  </ul>
</div>
