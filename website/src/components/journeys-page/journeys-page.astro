---
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import EvidenceStatus from '../evidence-status/evidence-status.astro';
import { JourneysMatrix } from '../journeys-matrix/index.ts';
import { PlatformMark } from '../platform-mark/index.ts';
import BaseLayout from '../../layouts/base-layout.astro';
import type { IScriptedJourneysWebsiteModel } from '../../lib/scripted-journeys/index.ts';

interface Props {
  model: IScriptedJourneysWebsiteModel;
}
const { model } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { label: 'Scripted journeys' },
];
---

<BaseLayout
  title="Scripted journeys in ChatGPT and Claude"
  description="Follow the same project requests in ChatGPT and Claude, with recorded changes and local assessments."
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      {basePath}
      items={breadcrumbs}
    />
  </div>
  <header class="mt-6 border-y border-border bg-elevated">
    <div
      class="page-shell grid gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-end"
    >
      <div class="min-w-0">
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <EvidenceStatus status={model.status} /><span
            class="font-mono text-xs text-muted-foreground"
            >Skill {model.skill.version} · {model.evaluatedAt.slice(0, 10)}</span
          >
        </div><p class="eyebrow mb-4">Same requests. Two projects.</p><h1 class="page-title">
          Follow the skill across a conversation.
        </h1><p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
          The same requests, run in ChatGPT and Claude projects. Open a journey to compare the
          changes, replies, and local checks at each step.
        </p>
      </div>
      <div class="border-t border-border pt-6 lg:border-t-0 lg:border-l lg:pl-8">
        <div class="flex flex-wrap gap-6">
          <PlatformMark platform="chatgpt" /><PlatformMark platform="claude" />
        </div><p class="mt-5 text-sm leading-7 text-muted-foreground">
          A harness issues one request at a time in a single chat per platform. Each journey has a
          fresh fixture. The exported changes are reconstructed and checked locally.
        </p><ActionLink
          href={withBase('/docs/scripted-journeys/', basePath)}
          variant="link"
          class="mt-4"
          >Read the method and limits</ActionLink
        >
      </div>
    </div>
  </header>
  <section
    class="page-shell py-10 sm:py-14"
    aria-labelledby="journeys-heading"
  >
    <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow mb-2">Request by request</p><h2
          id="journeys-heading"
          class="section-title"
        >
          Explore the journeys
        </h2>
      </div><p class="text-sm text-muted-foreground">
        {model.journeys.length} journeys · {
          model.journeys.reduce((count, journey) => count + journey.steps.length, 0)
        } requests per platform
      </p>
    </div><JourneysMatrix {model} />
  </section>
  <section
    class="border-t border-border bg-elevated"
    aria-labelledby="provenance-heading"
  >
    <div class="page-shell py-10 sm:py-14">
      <h2
        id="provenance-heading"
        class="text-2xl font-semibold tracking-tight"
      >
        The recorded configuration
      </h2><p class="mt-3 max-w-3xl text-sm leading-7 text-muted-foreground">
        These results describe this run and its recorded configuration. They are diagnostic evidence
        from scripted sessions, rather than a general platform success rate.
      </p>
      <dl class="mt-7 grid min-w-0 gap-6 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-muted-foreground">Run</dt><dd class="mt-2 font-mono text-xs break-all">
            {model.runId}
          </dd>
        </div><div>
          <dt class="text-muted-foreground">Skill commit</dt><dd
            class="mt-2 font-mono text-xs break-all"
          >
            {model.skill.commit}
          </dd>
        </div><div>
          <dt class="text-muted-foreground">Instructions</dt><dd class="mt-2">
            Version {model.instructions.version}
          </dd>
        </div><div>
          <dt class="text-muted-foreground">Local assessment date</dt><dd class="mt-2">
            {model.evaluatedAt.slice(0, 10)}
          </dd>
        </div>
      </dl>
      <div class="mt-8 grid gap-7 sm:grid-cols-2">
        {
          model.platforms.map((platform) => (
            <article class="min-w-0 border-t border-border pt-5">
              <h3>
                <PlatformMark platform={platform.platform} />
              </h3>
              <p class="mt-4 font-semibold">
                {platform.configuration.model ?? 'Model not recorded'}
              </p>
              <dl class="mt-3 space-y-2 text-sm text-muted-foreground">
                {Object.entries(platform.configuration.settings).map(([key, value]) => (
                  <div class="flex flex-wrap justify-between gap-2">
                    <dt>{key}</dt>
                    <dd class="break-words">{value}</dd>
                  </div>
                ))}
                <div class="flex justify-between gap-2">
                  <>
                    <dt>Journey restarts</dt>
                    <dd>
                      {Object.values(platform.restartCounts).reduce((sum, count) => sum + count, 0)}
                    </dd>
                  </>
                </div>
              </dl>
              {platform.configuration.interventions.length > 0 && (
                <details class="mt-4 text-sm">
                  <summary class="cursor-pointer font-medium">
                    Operator interventions ({platform.configuration.interventions.length})
                  </summary>
                  <ul class="mt-3 list-disc space-y-2 pl-5 leading-6 text-muted-foreground">
                    {platform.configuration.interventions.map((note) => (
                      <li>
                        <InlineBrandText
                          text={note}
                          variant="compact"
                        />
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          ))
        }
      </div>
      <details class="mt-8 border-t border-border pt-5 text-sm">
        <summary class="cursor-pointer font-medium">Assessor identity and source hashes</summary><dl
          class="mt-4 grid gap-4 font-mono text-xs break-all"
        >
          <div>
            <dt class="text-muted-foreground">Assessor commit</dt><dd class="mt-1">
              {model.assessor.commit}
            </dd>
          </div><div>
            <dt class="text-muted-foreground">Assessor source SHA-256</dt><dd class="mt-1">
              {model.assessor.sourceSha256}
            </dd>
          </div><div>
            <dt class="text-muted-foreground">Input bundle SHA-256</dt><dd class="mt-1">
              {model.bundleSha256}
            </dd>
          </div><div>
            <dt class="text-muted-foreground">Instructions SHA-256</dt><dd class="mt-1">
              {model.instructions.sha256}
            </dd>
          </div>
        </dl>
      </details>
      <div class="mt-6 flex flex-wrap gap-5">
        <ActionLink
          href={withBase(model.assessmentUrl, basePath)}
          variant="link"
          >Raw assessment JSON</ActionLink
        ><ActionLink
          href={withBase(model.definitionsUrl, basePath)}
          variant="link"
          >Exact journey definitions</ActionLink
        >
      </div><p class="mt-7 text-xs leading-6 text-muted-foreground">
        ChatGPT and Claude marks identify the products tested. They do not imply endorsement by
        OpenAI or Anthropic.
      </p>
    </div>
  </section>
</BaseLayout>
