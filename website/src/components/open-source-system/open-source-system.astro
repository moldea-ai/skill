---
import { ArrowRight, Check, CircleAlert } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../adapter-company-logo/adapter-company-logo.astro';
import {
  getLandingExampleLine,
  LANDING_EXAMPLE,
  LANDING_EXAMPLE_DISCONNECTED_FILES,
  LANDING_EXAMPLE_MAINTAINED_FILES,
} from '../../lib/landing-example/index.ts';
import { PACKAGES_WEBSITE_URL } from '../../lib/model/constants.ts';

const basePath = import.meta.env.BASE_URL;
const disconnectedInstruction = getLandingExampleLine(
  LANDING_EXAMPLE_DISCONNECTED_FILES,
  LANDING_EXAMPLE.paths.agent,
  'instructions:',
);
const connectedInstruction = getLandingExampleLine(
  LANDING_EXAMPLE_MAINTAINED_FILES,
  LANDING_EXAMPLE.paths.agent,
  'instructions:',
);
const adapterIds = ['openai', 'anthropic', 'vercel-ai-sdk'] as const;
---

<section
  id="deterministic-checks"
  class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
  aria-labelledby="open-source-system-title"
  data-open-source-system
>
  <div class="page-shell">
    <header class="grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-12">
      <div>
        <p class="eyebrow mb-4">Deterministic by design</p>
        <h2
          id="open-source-system-title"
          class="section-title text-3xl font-semibold sm:text-4xl lg:text-5xl"
        >
          Software checks the connections.
        </h2>
      </div>
      <p class="text-lg leading-8 text-muted-foreground">
        Same files, tool versions, and settings. Same result. These checks run locally, without
        asking a model to judge its own work.
      </p>
    </header>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 sm:gap-4">
      <article class="min-w-0 sm:rounded-xl sm:border sm:border-border sm:p-5">
        <h3 class="flex items-center gap-2 text-lg font-semibold">
          <CircleAlert
            class="size-5 shrink-0 text-destructive"
            aria-hidden="true"
          /> Saved, but disconnected
        </h3>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          The instructions exist. The agent uses a different prompt.
        </p>
        <div class="mt-4">
          <CodeBlock
            copyable={false}
            language="typescript"
            source={disconnectedInstruction}
          />
        </div>
        <p class="mt-3 text-sm font-medium text-destructive">
          The check catches the missing connection.
        </p>
      </article>
      <article class="min-w-0 sm:rounded-xl sm:border sm:border-border sm:p-5">
        <h3 class="flex items-center gap-2 text-lg font-semibold">
          <Check
            class="size-5 shrink-0 text-success"
            aria-hidden="true"
          /> Connected to the agent
        </h3>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          The agent’s code loads the saved instructions.
        </p>
        <div class="mt-4">
          <CodeBlock
            copyable={false}
            language="typescript"
            source={connectedInstruction}
          />
        </div>
        <p class="mt-3 text-sm font-medium">The check confirms the connection.</p>
      </article>
    </div>
    <p class="mt-5 text-sm leading-6 text-muted-foreground">
      A passing check confirms the wiring. Whether the agent behaves correctly still needs review
      and testing.
    </p>
    <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-2xl">
        <h3 class="text-lg font-semibold">Checks that understand your integration.</h3>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          <InlineBrandText
            text="moldea adapters recognize how each supported library connects instructions, tools, and code."
          />
        </p>
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          <ActionLink
            href={PACKAGES_WEBSITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            variant="link"
            >Explore packages</ActionLink
          >
          <ActionLink
            href={withBase('/evidence/qualification/', basePath)}
            variant="link"
            >See every integration <ArrowRight
              class="size-4"
              aria-hidden="true"
            /></ActionLink
          >
        </div>
      </div>
      <ul
        class="flex shrink-0 items-center gap-3"
        aria-label="Example supported integrations"
      >
        {
          adapterIds.map((adapterId) => (
            <li>
              <AdapterCompanyLogo
                adapterId={adapterId}
                size="sm"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
