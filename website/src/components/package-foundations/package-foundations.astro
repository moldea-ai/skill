---
import { ArrowUpRight } from '@lucide/astro';

import { PACKAGES_WEBSITE_URL } from '../../lib/model/constants.ts';
import InlineBrandText from '../inline-brand-text/inline-brand-text.astro';

const foundationAreas = [
  {
    label: 'CLI',
    title: 'Verified local execution',
    description: 'Runs exact, compatible tooling without global or transient fallbacks.',
  },
  {
    label: 'Core',
    title: 'Deterministic contracts',
    description: 'Owns parsing, validation, indexing, and machine-readable diagnostics.',
  },
  {
    label: 'Repository',
    title: 'Coherent source evidence',
    description: 'Produces stable snapshots of the repository state the skill reasons about.',
  },
  {
    label: 'Adapters',
    title: 'Runtime-specific evidence',
    description: 'Inspects supported integrations before semantic conclusions are drawn.',
  },
] as const;
---

<section
  class="bg-sidebar py-section-gap"
  aria-labelledby="package-foundations-title"
>
  <div
    class="page-shell grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center"
  >
    <div>
      <p class="eyebrow mb-4">Battle-tested foundations</p>
      <h2
        id="package-foundations-title"
        class="section-title max-w-4xl font-semibold"
      >
        More than instructions. A tested software foundation.
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
        <InlineBrandText
          text="moldea pairs its semantic operating model with versioned packages for contracts, repository operations, runtime evidence, and deterministic validation. Critical mechanics stay explicit, repeatable, and independently testable."
        />
      </p>
      <a
        class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-xl border border-input bg-background px-5 py-3 font-bold shadow-surface hover:bg-muted"
        href={PACKAGES_WEBSITE_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <InlineBrandText text="Explore moldea packages" />
        <ArrowUpRight
          class="size-4"
          aria-hidden="true"
        />
      </a>
    </div>

    <ol class="grid gap-3 sm:grid-cols-2">
      {
        foundationAreas.map(({ description, label, title }, index) => (
          <li class="surface-card min-w-0 p-5">
            <div class="mb-8 flex items-center justify-between gap-4">
              <span class="font-mono text-xs font-bold text-muted-foreground">0{index + 1}</span>
              <span class="rounded-full border bg-muted px-2.5 py-1 font-mono text-xs font-bold">
                {label}
              </span>
            </div>
            <h3 class="text-xl font-semibold tracking-tight">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
