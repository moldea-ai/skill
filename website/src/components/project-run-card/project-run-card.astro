---
import { ArrowUpRight, FolderGit2 } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IProjectAttempt } from '../../lib/project-runs/index.ts';

interface Props {
  attempt: IProjectAttempt;
  number: number;
}
const { attempt, number } = Astro.props;
---

<article
  class="flex min-w-0 flex-col border-b border-border py-6 sm:rounded-2xl sm:border sm:bg-card sm:p-7"
  data-project-story
>
  <div class="mb-6 flex items-center justify-between text-muted-foreground">
    <FolderGit2
      class="size-6"
      aria-hidden="true"
    />
    <span class="font-mono text-xs">{String(number).padStart(2, '0')}</span>
  </div>
  <h2 class="text-xl font-semibold break-words sm:text-2xl">
    <InlineBrandText text={attempt.title} />
  </h2>
  <p class="mt-3 flex-1 text-sm leading-7 break-words text-muted-foreground">
    <InlineBrandText text={attempt.excerpt} />
  </p>
  <ActionLink
    class="mt-6 self-start"
    variant="outline"
    href={withBase(attempt.route, import.meta.env.BASE_URL)}
    aria-label={`Explore ${attempt.title}`}
  >
    Explore the project <ArrowUpRight
      class="size-4"
      aria-hidden="true"
    />
  </ActionLink>
</article>
