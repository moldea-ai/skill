---
import { ArrowRight } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IProjectAttempt } from '../../lib/project-runs/index.ts';

interface Props {
  attempt: IProjectAttempt;
}

const { attempt } = Astro.props;
---

<article
  class="group flex min-w-0 flex-col border-b border-border py-7 sm:rounded-3xl sm:border sm:bg-card sm:p-7 sm:shadow-surface sm:transition-shadow sm:hover:shadow-raised"
  data-project-story
>
  <h3 class="text-2xl font-semibold tracking-tight break-words sm:text-3xl">
    <InlineBrandText text={attempt.title} />
  </h3>
  <p class="mt-3 text-sm leading-7 break-words text-muted-foreground sm:text-base">
    <InlineBrandText text={attempt.summary} />
  </p>
  <div class="mt-auto pt-7">
    <ActionLink
      class="w-full justify-between font-semibold"
      variant="outline"
      href={withBase(attempt.route, import.meta.env.BASE_URL)}
      aria-label={`Explore ${attempt.title}`}
    >
      Explore project <ArrowRight
        class="size-4"
        aria-hidden="true"
      />
    </ActionLink>
  </div>
</article>
