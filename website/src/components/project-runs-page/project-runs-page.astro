---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';
import { type IProjectRunModel, type IProjectRunPage } from '../../lib/project-runs/index.ts';
import ProjectRunCard from '../project-run-card/project-run-card.astro';

interface Props {
  run: IProjectRunModel;
  page: IProjectRunPage;
}
const { run, page } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { label: 'Project runs' },
];
const allAttempts = run.pages.flatMap(({ attempts }) => attempts);
const featuredAttempt = allAttempts.find(({ initialRequest }) => initialRequest !== null);
---

<BaseLayout
  title={page.number === 1 ? 'Project runs' : `Project runs, page ${page.number}`}
  description={`Explore ${allAttempts.length} mock projects and the coding sessions, context, and source records behind them. Page ${page.number} of ${run.pages.length}.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      {basePath}
      items={breadcrumbs}
    />
  </div>
  <header class="mt-6 border-y border-border">
    <div
      class="page-shell grid gap-9 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.78fr)] lg:items-center lg:gap-14 lg:py-20"
    >
      <div class="min-w-0">
        <p class="eyebrow mb-4">Project runs</p>
        <h1 class="page-title max-w-4xl">See the work behind each project.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
          Follow the developer request, the coding agent's conversation, and the source changes in
          each mock project.
        </p>
        <p class="mt-7 text-sm font-semibold text-foreground">
          <span class="font-mono text-xl">{allAttempts.length}</span>
          {allAttempts.length === 1 ? ' project to explore' : ' projects to explore'}
        </p>
      </div>
      {
        featuredAttempt !== undefined && (
          <aside class="min-w-0 rounded-3xl border border-border bg-card p-5 shadow-surface sm:p-7">
            <p class="eyebrow mb-4">Start with a request</p>
            <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">
              <InlineBrandText text={featuredAttempt.title} />
            </h2>
            <p class="mt-4 line-clamp-4 text-sm leading-7 text-muted-foreground sm:text-base">
              <InlineBrandText text={featuredAttempt.initialRequest!.text} />
            </p>
            <ActionLink
              class="mt-6 w-full justify-between font-semibold"
              href={withBase(featuredAttempt.route, basePath)}
              variant="outline"
            >
              Explore this project
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
          </aside>
        )
      }
    </div>
  </header>
  <section
    class="page-shell py-10 sm:py-16"
    aria-labelledby="projects-title"
  >
    {
      run.provenance !== 'public' && (
        <p
          class="mb-6 border-l-2 border-border pl-4 text-sm leading-6 text-muted-foreground"
          data-project-preview
        >
          {run.provenance === 'local'
            ? 'Local preview. Source links will be available with the public records.'
            : 'Illustrative test records. These are not recorded coding sessions.'}
        </p>
      )
    }
    <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.7fr)] sm:items-end">
      <h2
        id="projects-title"
        class="section-title"
      >
        Browse project runs
      </h2>
      <p class="text-sm leading-7 text-muted-foreground sm:justify-self-end">
        <InlineBrandText
          text="Open a project to see what was asked, what changed, and where moldea fit into the work."
        />
      </p>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-2 lg:gap-6">
      {page.attempts.map((attempt) => <ProjectRunCard {attempt} />)}
    </div>
    {
      page.attempts.length === 0 && (
        <p class="py-8 text-muted-foreground">No project records are included in this run.</p>
      )
    }
    {
      (page.previous !== null || page.next !== null) && (
        <nav
          class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6"
          aria-label="Project pages"
        >
          {page.previous !== null && (
            <ActionLink
              variant="outline"
              href={withBase(page.previous, basePath)}
              rel="prev"
            >
              <ArrowLeft
                class="size-4"
                aria-hidden="true"
              />{' '}
              Previous
            </ActionLink>
          )}
          <p class="text-sm text-muted-foreground">
            Page {page.number} of {run.pages.length}
          </p>
          {page.next !== null && (
            <ActionLink
              variant="outline"
              href={withBase(page.next, basePath)}
              rel="next"
            >
              Next{' '}
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>
