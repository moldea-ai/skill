---
import { ArrowLeft, ArrowRight, FolderGit2 } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';
import { type IProjectRunModel, type IProjectRunPage } from '../../lib/project-runs/index.ts';
import ProjectRunCard from '../project-run-card/project-run-card.astro';

interface Props {
  run: IProjectRunModel;
  page: IProjectRunPage;
}
const { run, page } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { label: 'Project runs' },
];
const allAttempts = run.pages.flatMap(({ attempts }) => attempts);
---

<BaseLayout
  title={page.number === 1 ? 'Project runs' : `Project runs, page ${page.number}`}
  description={`Explore ${allAttempts.length} mock projects and the coding sessions, context, and source records behind them. Page ${page.number} of ${run.pages.length}.`}
  {breadcrumbs}
>
  <div class="page-shell pt-4 sm:pt-7">
    <Breadcrumbs
      {basePath}
      items={breadcrumbs}
    />
  </div>
  <header class="relative overflow-hidden border-b border-border bg-sidebar">
    <HeroBackdrop />
    <div
      class="page-shell relative grid gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.7fr)] lg:items-center lg:gap-16 lg:py-20"
    >
      <div class="min-w-0">
        <p class="eyebrow mb-4">Project runs</p>
        <h1 class="display-title max-w-3xl">Explore the projects behind the evidence.</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-muted-foreground sm:text-lg">
          <InlineBrandText
            text="See how a coding agent used moldea while building and maintaining mock projects with different needs and boundaries."
          />
        </p>
      </div>
      <div
        class="dark-surface-selection -mx-4 bg-primary p-6 text-primary-foreground sm:mx-0 sm:rounded-3xl sm:p-7 sm:shadow-raised"
      >
        <div
          class="flex items-end justify-between gap-4 border-b border-primary-foreground/15 pb-5"
        >
          <p class="text-sm font-semibold text-primary-foreground/70">Projects to explore</p>
          <strong class="font-mono text-6xl leading-none tracking-tight sm:text-7xl"
            >{allAttempts.length}</strong
          >
        </div>
        <nav
          class="mt-3"
          aria-label="Explore project examples"
        >
          {
            allAttempts.slice(0, 3).map((attempt) => (
              <a
                class="group flex items-center justify-between gap-4 border-b border-primary-foreground/15 py-3 text-sm font-semibold last:border-0 hover:text-primary-foreground/70 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-ring"
                href={withBase(attempt.route, basePath)}
              >
                {attempt.title}
                <ArrowRight
                  class="size-4 shrink-0 transition-transform group-hover:translate-x-1 motion-reduce:transform-none"
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </header>
  <section
    class="page-shell py-10 sm:py-16"
    aria-labelledby="projects-title"
  >
    {
      run.provenance !== 'public' && (
        <p
          class="mb-6 border-l-2 border-border pl-4 text-sm leading-6 text-muted-foreground"
          data-project-preview
        >
          {run.provenance === 'local'
            ? 'Local preview. Source links will be available with the public records.'
            : 'Illustrative test records. These are not recorded coding sessions.'}
        </p>
      )
    }
    <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.7fr)] sm:items-end">
      <div>
        <div class="flex items-center gap-3">
          <FolderGit2
            class="size-5 text-muted-foreground"
            aria-hidden="true"
          />
          <h2
            id="projects-title"
            class="section-title"
          >
            Choose a project.
          </h2>
        </div>
      </div>
      <p class="text-sm leading-7 text-muted-foreground sm:justify-self-end">
        <InlineBrandText
          text="Open a project to see what was asked, what changed, and where moldea fit into the work."
        />
      </p>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-2 lg:gap-6">
      {page.attempts.map((attempt) => <ProjectRunCard {attempt} />)}
    </div>
    {
      page.attempts.length === 0 && (
        <p class="py-8 text-muted-foreground">No project records are included in this run.</p>
      )
    }
    {
      (page.previous !== null || page.next !== null) && (
        <nav
          class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6"
          aria-label="Project pages"
        >
          {page.previous !== null && (
            <ActionLink
              variant="outline"
              href={withBase(page.previous, basePath)}
              rel="prev"
            >
              <ArrowLeft
                class="size-4"
                aria-hidden="true"
              />{' '}
              Previous
            </ActionLink>
          )}
          <p class="text-sm text-muted-foreground">
            Page {page.number} of {run.pages.length}
          </p>
          {page.next !== null && (
            <ActionLink
              variant="outline"
              href={withBase(page.next, basePath)}
              rel="next"
            >
              Next{' '}
              <ArrowRight
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>
