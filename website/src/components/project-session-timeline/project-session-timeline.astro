---
import { Clock3, FilePenLine, SquareTerminal, UserRound } from '@lucide/astro';
import CodeBlock from '@moldea.ai/website-ui/code-block';
import Dialog from '@moldea.ai/website-ui/dialog';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IProjectSessionEntry } from '../../lib/project-runs/types.ts';

import { formatProjectToolInput } from './utilities.ts';

interface Props {
  entries: IProjectSessionEntry[];
}

const { entries } = Astro.props;
const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
const messageHtml = await Promise.all(
  entries.map((entry) =>
    entry.kind === 'message' && entry.role !== 'developer'
      ? renderMarkdownFragment(entry.content, {
          basePath: import.meta.env.BASE_URL,
          localLinks: 'unwrap',
          productNameTreatment: 'code',
        })
      : null,
  ),
);
const toolPreview = (entry: IProjectSessionEntry): string =>
  entry.content
    .split('\n')
    .find((line) => line.trim().length > 0)
    ?.trim()
    .slice(0, 100) ?? '';
const displayInputs = entries.map((entry) =>
  entry.kind === 'tool' ? formatProjectToolInput(entry.content) : null,
);
const ordinalClass = 'shrink-0 whitespace-nowrap font-mono text-xs text-muted-foreground';
---

<ol
  class="relative space-y-4 before:absolute before:top-0 before:bottom-0 before:left-4 before:w-px before:bg-border sm:before:left-6"
  aria-label="Recorded session events"
>
  {
    entries.map((entry, index) => (
      <li
        class="relative min-w-0 pl-10 sm:pl-14"
        data-session-entry={entry.kind}
      >
        {entry.kind === 'message' &&
        entry.role !== 'developer' &&
        !(entry.isRedacted && entry.content === '[redacted]') ? (
          <article
            class:list={[
              'min-w-0 rounded-2xl border p-4 shadow-surface sm:p-5',
              entry.role === 'assistant'
                ? 'border-border bg-card'
                : 'border-border bg-secondary/60',
            ]}
            data-session-role={entry.role}
          >
            <div class="mb-3 flex items-start justify-between gap-3">
              <div class="flex min-w-0 items-center gap-2">
                <span
                  class:list={[
                    'inline-flex size-8 items-center justify-center rounded-lg',
                    entry.role === 'assistant'
                      ? 'bg-secondary text-foreground'
                      : 'bg-foreground text-background',
                  ]}
                >
                  {entry.role === 'assistant' ? (
                    <img
                      src={skillMarkPath}
                      width="207"
                      height="215"
                      alt=""
                      class="h-4 w-auto dark:invert"
                      data-agent-response-mark
                    />
                  ) : (
                    <UserRound
                      class="size-4"
                      aria-hidden="true"
                    />
                  )}
                </span>
                <span class="text-xs font-bold tracking-wide text-muted-foreground uppercase">
                  {entry.title}
                </span>
              </div>
              <span
                class={ordinalClass}
                data-session-ordinal
              >
                #{entry.ordinal}
                {entry.lastOrdinal !== entry.ordinal && <>–{entry.lastOrdinal}</>}
              </span>
            </div>
            <div
              class="prose-moldea prose-moldea-wrap-code replay-markdown min-w-0 text-sm leading-7 sm:text-base"
              set:html={messageHtml[index]}
            />
          </article>
        ) : entry.kind === 'tool' ? (
          <article
            class="min-w-0 rounded-xl border border-border bg-card p-4 shadow-surface sm:p-5"
            data-session-tool
          >
            <div class="flex min-w-0 items-start gap-2 text-sm">
              {entry.patchTargets && entry.patchTargets.length > 0 ? (
                <FilePenLine
                  class="size-4 shrink-0 text-foreground"
                  aria-hidden="true"
                />
              ) : (
                <SquareTerminal
                  class="size-4 shrink-0 text-muted-foreground"
                  aria-hidden="true"
                />
              )}
              <span class="min-w-0 flex-1 font-semibold">Tool call · {entry.title}</span>
              <span
                class={ordinalClass}
                data-session-ordinal
              >
                #{entry.ordinal}
                {entry.lastOrdinal !== entry.ordinal && <>–{entry.lastOrdinal}</>}
              </span>
            </div>
            {entry.patchTargets && entry.patchTargets.length > 0 ? (
              <div class="mt-3">
                <p class="text-xs text-muted-foreground">Patch targets</p>
                <ul class="mt-1.5 flex min-w-0 flex-wrap gap-1.5 text-xs">
                  {entry.patchTargets.map(({ action, path }) => (
                    <li class="max-w-full rounded-md bg-secondary px-2 py-1 text-foreground">
                      {action} <code class="break-all">{path}</code>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <code class="mt-2 block truncate text-xs text-muted-foreground">
                {toolPreview(entry)}
              </code>
            )}
            <Dialog
              id={`project-tool-${entry.ordinal}`}
              title={`${entry.title} · event ${entry.ordinal}`}
              triggerLabel="Read call and result"
              triggerAriaLabel={`Read ${entry.title} call ${entry.ordinal} and result`}
              triggerClass="mt-3 w-full justify-between"
              size="medium"
              closeLabel="Close tool call"
              isOverlayCloseEnabled
            >
              <div class="grid min-w-0 gap-6">
                <section class="min-w-0">
                  <h2 class="mb-2 text-sm font-semibold">Input</h2>
                  <div class="min-w-0">
                    <CodeBlock
                      ariaLabel={`${entry.title} input`}
                      copyable={false}
                      language={displayInputs[index]?.language ?? 'javascript'}
                      source={displayInputs[index]?.source ?? entry.content}
                    />
                  </div>
                </section>
                <section class="min-w-0">
                  <h2 class="mb-2 text-sm font-semibold">Tool result</h2>
                  <div class="min-w-0">
                    <CodeBlock
                      ariaLabel={`${entry.title} result`}
                      copyable={false}
                      language="text"
                      source={entry.output?.trim() ?? ''}
                    />
                  </div>
                </section>
              </div>
            </Dialog>
          </article>
        ) : entry.kind === 'message' ? (
          <div
            class="min-w-0 rounded-lg border border-border bg-muted/30 p-4 text-sm text-muted-foreground sm:p-5"
            data-session-context
          >
            <div class="flex items-start justify-between gap-3">
              <span>
                {entry.isRedacted && entry.content === '[redacted]'
                  ? 'Redacted message'
                  : entry.title}
              </span>
              <span
                class={ordinalClass}
                data-session-ordinal
              >
                #{entry.ordinal}
                {entry.lastOrdinal !== entry.ordinal && <>–{entry.lastOrdinal}</>}
              </span>
            </div>
            <Dialog
              id={`project-context-${entry.ordinal}`}
              title={entry.title}
              triggerLabel="Read message"
              triggerAriaLabel={`Read ${entry.title.toLowerCase()} message ${entry.ordinal}`}
              triggerClass="mt-2 w-full justify-between"
              size="medium"
              closeLabel="Close message"
              isOverlayCloseEnabled
            >
              <div class="min-w-0">
                <CodeBlock
                  ariaLabel={`${entry.title} message`}
                  copyable={false}
                  language="text"
                  source={entry.content}
                />
              </div>
            </Dialog>
          </div>
        ) : entry.kind === 'compaction' && entry.compaction !== undefined ? (
          <article
            class="min-w-0 rounded-lg border border-border bg-muted/30 p-4 text-sm sm:p-5"
            data-session-compaction
          >
            <div class="flex items-start justify-between gap-3">
              <span class="font-semibold text-foreground">{entry.title}</span>
              <span
                class={ordinalClass}
                data-session-ordinal
              >
                #{entry.ordinal}
              </span>
            </div>
            <p class="mt-2 text-muted-foreground">
              {entry.compaction.replacementHistory.length} replacement{' '}
              {entry.compaction.replacementHistory.length === 1 ? 'message' : 'messages'} and{' '}
              {entry.compaction.retainedUserMessages.length} retained user{' '}
              {entry.compaction.retainedUserMessages.length === 1 ? 'message' : 'messages'}.
              {entry.compaction.encryptedSummaryOmitted && ' Encrypted summary omitted.'}
            </p>
            <Dialog
              id={`project-compaction-${entry.ordinal}`}
              title={`Preserved context · event ${entry.ordinal}`}
              triggerLabel="Read preserved context"
              triggerAriaLabel={`Read preserved context from compaction event ${entry.ordinal}`}
              triggerClass="mt-3 w-full justify-between"
              size="medium"
              closeLabel="Close preserved context"
              isOverlayCloseEnabled
            >
              <div class="grid min-w-0 gap-6">
                <p class="text-sm leading-6 text-muted-foreground">
                  This view shows the host's context snapshot at compaction. The timeline keeps the
                  original conversation turns separately.
                  {entry.compaction.encryptedSummaryOmitted &&
                    ' The encrypted summary is not included in this recording.'}
                </p>
                {entry.compaction.message && (
                  <section class="min-w-0">
                    <h2 class="mb-2 text-sm font-semibold">Host note</h2>
                    <div class="min-w-0">
                      <CodeBlock
                        ariaLabel="Compaction host note"
                        copyable={false}
                        language="text"
                        source={entry.compaction.message}
                      />
                    </div>
                  </section>
                )}
                <section class="min-w-0">
                  <h2 class="mb-3 text-sm font-semibold">Replacement history</h2>
                  <ol class="grid min-w-0 gap-4">
                    {entry.compaction.replacementHistory.map(({ role, content }, position) => (
                      <li class="min-w-0">
                        <p class="mb-2 text-xs font-semibold text-muted-foreground">
                          Message {position + 1} · {role}
                        </p>
                        <div class="min-w-0">
                          <CodeBlock
                            ariaLabel={`Replacement message ${position + 1}`}
                            copyable={false}
                            language="text"
                            source={content}
                          />
                        </div>
                      </li>
                    ))}
                  </ol>
                </section>
                <section class="min-w-0">
                  <h2 class="mb-3 text-sm font-semibold">Retained user messages</h2>
                  <ol class="grid min-w-0 gap-4">
                    {entry.compaction.retainedUserMessages.map(({ order, text, complete }) => (
                      <li class="min-w-0">
                        <p class="mb-2 text-xs font-semibold text-muted-foreground">
                          Order {order} · {complete ? 'complete' : 'partial'}
                        </p>
                        <div class="min-w-0">
                          <CodeBlock
                            ariaLabel={`Retained user message ${order}`}
                            copyable={false}
                            language="text"
                            source={text}
                          />
                        </div>
                      </li>
                    ))}
                  </ol>
                </section>
              </div>
            </Dialog>
          </article>
        ) : (
          <div class="flex min-h-9 items-start gap-3 py-1 pr-4 text-xs text-muted-foreground sm:pr-5">
            <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1">
              <span class="inline-flex size-7 items-center justify-center rounded-full border border-border bg-background">
                <Clock3
                  class="size-3.5"
                  aria-hidden="true"
                />
              </span>
              <span class="font-semibold text-foreground">{entry.title}</span>
              {entry.content && (
                <span>
                  <InlineBrandText
                    text={entry.content}
                    variant="compact"
                  />
                </span>
              )}
            </div>
            <span
              class={ordinalClass}
              data-session-ordinal
            >
              #{entry.ordinal}
              {entry.lastOrdinal !== entry.ordinal && <>–{entry.lastOrdinal}</>}
            </span>
          </div>
        )}
      </li>
    ))
  }
</ol>
