---
import { prettifyTime } from 'web-utils-kit';

import type {
  IQualificationAttemptCaseModel,
  IQualificationProfileCaseModel,
} from '../../lib/qualification/index.ts';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import EvidenceText from '../evidence-text/evidence-text.astro';
import QualificationTrialEvidence from '../qualification-trial-evidence/qualification-trial-evidence.astro';

interface Props {
  evidence: IQualificationAttemptCaseModel;
  scenario: IQualificationProfileCaseModel['scenario'];
}

const { evidence, scenario } = Astro.props;
const { result, trials } = evidence;
const confirmationStatus = 'confirmationStatus' in result ? result.confirmationStatus : null;
---

<article class="surface-card min-w-0 overflow-hidden">
  <header class="border-b border-border p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-3">
      <EvidenceStatus status={result.status} />
      <code class="text-xs text-muted-foreground">{result.caseId}</code>
      <time
        class="ms-auto text-sm text-muted-foreground"
        datetime={`PT${result.durationMs / 1_000}S`}
      >
        {prettifyTime(result.durationMs)}
      </time>
    </div>
    <h3 class="mt-4 text-2xl font-semibold tracking-tight">{result.title}</h3>
    {
      confirmationStatus !== null && (
        <p class="mt-3 text-sm text-muted-foreground">
          Confirmation decision: <span class="font-mono text-foreground">{confirmationStatus}</span>
        </p>
      )
    }
    {
      result.status === 'recovered' && (
        <p class="mt-4 max-w-3xl leading-7 text-muted-foreground">
          The initial trial failed. Two fresh passing confirmations recovered this case, and the
          original failure remains visible below.
        </p>
      )
    }
    {
      result.failures.length > 0 && (
        <div class="mt-5 rounded-xl border border-destructive/30 bg-destructive/10 p-4">
          <p class="font-semibold text-foreground">Case failures</p>
          <ul class="mt-2 list-disc space-y-1 ps-5 text-sm leading-6 text-foreground">
            {result.failures.map((failure) => (
              <li>
                <EvidenceText text={failure} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </header>

  <section
    class="grid gap-4 p-5 sm:p-6"
    aria-labelledby={`${result.caseId}-trial-history-title`}
  >
    <div>
      <h4
        id={`${result.caseId}-trial-history-title`}
        class="text-lg font-semibold"
      >
        Ordered trial history
      </h4>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        Each trial owns a pristine project, actor evidence, deterministic checks, workspace
        assertions, and an independent judge decision.
      </p>
    </div>
    <ol class="grid gap-4">
      {
        trials.map((trial, index) => (
          <li>
            <QualificationTrialEvidence
              caseId={result.caseId}
              evidence={trial}
              index={index}
              scenario={scenario}
            />
          </li>
        ))
      }
    </ol>
  </section>
</article>
