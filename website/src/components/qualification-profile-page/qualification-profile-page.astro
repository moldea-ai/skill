---
import { ArrowDown, ArrowRight, ShieldCheck } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import ResultSummary from '@moldea.ai/website-ui/result-summary';
import { withBase } from '@moldea.ai/website-ui/site';
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import AdapterCompanyLogo from '../adapter-company-logo/adapter-company-logo.astro';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import QualificationCaseEvidence from '../qualification-case-evidence/qualification-case-evidence.astro';
import QualificationProfileTechnical from '../qualification-profile-technical/qualification-profile-technical.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import {
  createQualificationJourneyCollection,
  type IQualificationProfileModel,
} from '../../lib/qualification/index.ts';
import { getQualificationReleaseEvidenceSummary } from '../../lib/release-evidence/index.ts';

interface Props {
  profile: IQualificationProfileModel;
}

const { profile } = Astro.props;
const { releaseEvidence } = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const releaseSummary = getQualificationReleaseEvidenceSummary(profile);
const journeyCollection = createQualificationJourneyCollection(profile);
const effectiveAttempts = journeyCollection.attempts;
const effectiveJourneys = journeyCollection.journeys;
const successfulJourneyCount = effectiveJourneys.filter(
  ({ evidence }) => evidence.result.status === 'passed' || evidence.result.status === 'recovered',
).length;
const resultTone =
  releaseSummary.status === 'passed'
    ? 'success'
    : releaseSummary.status === 'failed' || releaseSummary.status === 'errored'
      ? 'danger'
      : 'warning';
const resultTitle =
  releaseSummary.status === 'passed'
    ? 'Qualification passed'
    : releaseSummary.status === 'failed'
      ? 'Qualification failed'
      : releaseSummary.status === 'errored'
        ? 'Evidence unavailable'
        : releaseSummary.status === 'not-recorded'
          ? 'No release result'
          : 'Result incomplete';
const resultStatusLabel =
  releaseSummary.status === 'passed'
    ? 'Verified'
    : releaseSummary.status === 'failed'
      ? 'Failed'
      : releaseSummary.status === 'errored'
        ? 'Unavailable'
        : 'Review';
const resultDescription =
  releaseSummary.status === 'passed'
    ? `All ${effectiveJourneys.length} project journeys reached the expected result.`
    : effectiveJourneys.length === 0
      ? 'No complete project result is available for this integration.'
      : `${successfulJourneyCount} of ${effectiveJourneys.length} project journeys reached the expected result.`;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { href: '/evidence/qualification/', label: 'Qualification' },
  { label: profile.title },
];
---

<BaseLayout
  title={profile.title}
  description={`Follow the complete project journeys and verified result for ${profile.title}.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="relative mt-6 overflow-hidden border-y border-border">
    <HeroBackdrop />
    <div class="page-shell relative py-14 sm:py-18 lg:py-20">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3">
          <EvidenceStatus status={releaseSummary.status} />
          <span class="text-sm font-semibold text-muted-foreground">
            {successfulJourneyCount}/{effectiveJourneys.length} journeys verified
          </span>
        </div>
        <p class="eyebrow mt-6 mb-4">Adapter qualification</p>
        <div class="flex items-center gap-4">
          <AdapterCompanyLogo adapterId={profile.adapterId} /><h1
            class="section-title font-semibold"
          >
            {profile.title}
          </h1>
        </div>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
          {
            profile.adapterId === 'custom'
              ? 'Checks the shared project behavior every integration relies on.'
              : 'Checks that the saved integration setup stays aligned with the files this project actually uses.'
          }
        </p>
        <p class="mt-3 max-w-3xl leading-7 text-muted-foreground">
          Open any journey to follow the developer request, coding-agent work, project changes, and
          independent verdict in one place.
        </p>
        <ActionLink
          class="mt-7 font-bold"
          href="#qualification-journeys"
          variant="primary"
        >
          Follow the journeys
          <ArrowDown
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
  </header>

  <div class="page-shell">
    <section
      id="qualification-journeys"
      class="scroll-mt-24 py-12"
      aria-labelledby="qualification-journeys-title"
    >
      <div class="grid gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(18rem,0.45fr)] lg:items-end">
        <div>
          <p class="eyebrow mb-3">The proof</p>
          <h2
            id="qualification-journeys-title"
            class="text-3xl font-semibold tracking-tight"
          >
            What happened in every project
          </h2>
        </div>
        <ResultSummary
          title={resultTitle}
          description={resultDescription}
          tone={resultTone}
        >
          <ShieldCheck
            slot="icon"
            class="size-5"
            aria-hidden="true"
          />
          <StatusBadge
            slot="status"
            label={resultStatusLabel}
            size="sm"
            tone={resultTone}
          />
        </ResultSummary>
      </div>

      {
        effectiveJourneys.length === 0 ? (
          <div class="mt-8 rounded-xl border border-dashed border-border bg-muted/30 p-6">
            <p class="font-semibold">No complete journey evidence is available.</p>
            <p class="mt-2 max-w-3xl leading-7 text-muted-foreground">
              The profile contract remains inspectable in the technical details below.
            </p>
          </div>
        ) : (
          <div class="mt-8 grid gap-10">
            <nav
              aria-label="Journey chapters"
              class="flex flex-wrap gap-2"
            >
              {journeyCollection.chapters.map((chapter) => (
                <ActionLink
                  href={`#${chapter.id}`}
                  variant="outline"
                >
                  {chapter.title}
                </ActionLink>
              ))}
            </nav>
            {journeyCollection.chapters.map((chapter) => (
              <section
                id={chapter.id}
                class="scroll-mt-24"
                aria-labelledby={`${chapter.id}-title`}
              >
                <h3
                  id={`${chapter.id}-title`}
                  class="text-2xl font-semibold tracking-tight"
                >
                  {chapter.title}
                </h3>
                <p class="mt-2 max-w-3xl leading-7 text-muted-foreground">{chapter.description}</p>
                <div class="mt-5 grid gap-3">
                  {chapter.journeys.map(({ evidence, presentation, profileCase }, index) => (
                    <QualificationCaseEvidence
                      evidence={evidence}
                      group={chapter.id}
                      id={`qualification-${profileCase.id}`}
                      number={index + 1}
                      {presentation}
                      {profileCase}
                    />
                  ))}
                </div>
              </section>
            ))}
          </div>
        )
      }
    </section>

    <section
      class="border-t border-border py-12"
      aria-labelledby="qualification-technical-title"
    >
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">For technical review</p>
        <h2
          id="qualification-technical-title"
          class="text-3xl font-semibold tracking-tight"
        >
          Exact source and methodology
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          Open these details for package versions, source commits, model configuration,
          compatibility coverage, and immutable artifacts.
        </p>
      </div>
      <div class="mt-7">
        <QualificationProfileTechnical
          attempts={effectiveAttempts}
          {profile}
          {releaseEvidence}
        />
      </div>
      <ActionLink
        class="mt-7 font-bold"
        href={withBase('/docs/adapter-qualification/', basePath)}
        variant="link"
      >
        Read the complete methodology
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
    </section>
  </div>
</BaseLayout>
