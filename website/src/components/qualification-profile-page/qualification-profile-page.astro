---
import { ArrowRight } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../adapter-company-logo/adapter-company-logo.astro';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import QualificationCaseEvidence from '../qualification-case-evidence/qualification-case-evidence.astro';
import QualificationProfileTechnical from '../qualification-profile-technical/qualification-profile-technical.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import {
  createQualificationJourneyCollection,
  type IQualificationProfileModel,
} from '../../lib/qualification/index.ts';
import { getQualificationReleaseEvidenceSummary } from '../../lib/release-evidence/index.ts';

interface Props {
  profile: IQualificationProfileModel;
}

const { profile } = Astro.props;
const { releaseEvidence } = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const releaseSummary = getQualificationReleaseEvidenceSummary(profile);
const journeyCollection = createQualificationJourneyCollection(profile);
const effectiveAttempts = journeyCollection.attempts;
const effectiveJourneys = journeyCollection.journeys;
const isCustomProfile = profile.adapterId === 'custom' && profile.implementationId === 'custom';
const currentCases = [
  ...profile.cases.map((profileCase) => ({
    origin: isCustomProfile ? 'Core behavior' : 'Adapter-specific',
    profileCase,
  })),
  ...profile.sharedCases.map((profileCase) => ({
    origin: 'Shared foundation',
    profileCase,
  })),
];
const firstJourney = effectiveJourneys[0];
const startRoute = firstJourney
  ? `#qualification-${firstJourney.profileCase.id}`
  : '#qualification-journeys';
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { href: '/evidence/qualification/', label: 'Qualification' },
  { label: profile.title },
];
---

<BaseLayout
  title={profile.title}
  description={effectiveJourneys.length === 0
    ? `Review the qualification cases currently available for ${profile.title}.`
    : `Follow the complete project journeys and verified result for ${profile.title}.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="mt-6 border-y border-border">
    <div class="page-shell py-12 sm:py-16 lg:py-20">
      <div class="max-w-5xl">
        <div class="flex items-center gap-4">
          <AdapterCompanyLogo
            adapterId={profile.adapterId}
            size="md"
          />
          <div class="flex flex-wrap items-center gap-3">
            <p class="eyebrow">Adapter qualification</p>
            <EvidenceStatus status={releaseSummary.status} />
          </div>
        </div>
        <h1 class="page-title mt-7 max-w-5xl">{profile.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
          {
            effectiveJourneys.length === 0
              ? 'This profile shows the qualification cases currently available. Recorded replays, project changes, evidence, and technical results will appear after a qualification attempt is selected.'
              : 'Every recorded journey is together on this page. Each one starts with a developer request, shows the coding agent’s work, and ends with project checks plus an independent verdict.'
          }
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ActionLink
            class="font-bold"
            href={startRoute}
            size="lg"
          >
            {
              effectiveJourneys.length === 0
                ? 'Review the available cases'
                : 'Open the first journey'
            }
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/evidence/qualification/', basePath)}
            size="lg"
            variant="outline"
          >
            Choose another integration
          </ActionLink>
        </div>
      </div>
    </div>
  </header>

  <div class="page-shell">
    <section
      id="qualification-journeys"
      class="scroll-mt-24 py-14 sm:py-18"
      aria-labelledby="qualification-journeys-title"
    >
      <div class="grid gap-5 lg:grid-cols-[minmax(0,0.8fr)_minmax(20rem,0.45fr)] lg:items-end">
        <div>
          <p class="eyebrow mb-3">
            {effectiveJourneys.length === 0 ? 'Current coverage' : 'One continuous result'}
          </p>
          <h2
            id="qualification-journeys-title"
            class="section-title"
          >
            {
              effectiveJourneys.length === 0
                ? `${currentCases.length} qualification cases are ready.`
                : `Browse all ${effectiveJourneys.length} journeys.`
            }
          </h2>
        </div>
        <p class="leading-7 text-muted-foreground">
          {
            effectiveJourneys.length === 0
              ? 'Case definitions remain visible before any result exists. Replays and project evidence appear only after they have been recorded.'
              : 'Open any journey. Replay tells the story first, then Project, Evidence, and Technical let you inspect as much detail as you need. Several journeys can stay open together.'
          }
        </p>
      </div>

      {
        effectiveJourneys.length === 0 ? (
          <div class="surface-card mt-8 p-5 sm:p-6">
            <p class="text-muted-foreground">
              No qualification attempt has been recorded for this profile.
            </p>
            <ol class="mt-5 grid gap-3 lg:grid-cols-2">
              {currentCases.map(({ origin, profileCase }, index) => (
                <li class="rounded-xl border border-border bg-muted/30 p-4">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <h3 class="font-semibold">
                      {String(index + 1).padStart(2, '0')} · {profileCase.title}
                    </h3>
                    <span class="text-xs font-semibold text-muted-foreground">{origin}</span>
                  </div>
                  <p class="mt-2 text-sm leading-6 text-muted-foreground">
                    <InlineBrandText
                      text={profileCase.purpose}
                      variant="compact"
                    />
                  </p>
                </li>
              ))}
            </ol>
          </div>
        ) : (
          <div class="mt-8 grid gap-3">
            {effectiveJourneys.map(({ evidence, presentation, profileCase }, index) => (
              <QualificationCaseEvidence
                evidence={evidence}
                group={`qualification-${profileCase.id}`}
                id={`qualification-${profileCase.id}`}
                number={index + 1}
                {presentation}
                {profileCase}
              />
            ))}
          </div>
        )
      }
    </section>

    <section
      class="border-t border-border py-12"
      aria-labelledby="qualification-technical-title"
    >
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">For technical review</p>
        <h2
          id="qualification-technical-title"
          class="section-title"
        >
          Exact source and methodology
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          Open these details for package versions, source commits, model configuration,
          compatibility coverage, and immutable artifacts.
        </p>
      </div>
      <div class="mt-7">
        <QualificationProfileTechnical
          attempts={effectiveAttempts}
          {profile}
          {releaseEvidence}
        />
      </div>
      <ActionLink
        class="mt-7 font-bold"
        href={withBase('/docs/adapter-qualification/', basePath)}
        variant="link"
      >
        Read the complete methodology
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
    </section>
  </div>
</BaseLayout>
