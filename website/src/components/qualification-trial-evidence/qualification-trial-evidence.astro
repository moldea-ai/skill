---
import { ExternalLink } from '@lucide/astro';
import { prettifyTime } from 'web-utils-kit';

import type {
  IQualificationAttemptTrialModel,
  IQualificationProfileCaseModel,
} from '../../lib/qualification/index.ts';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import EvidenceText from '../evidence-text/evidence-text.astro';

interface Props {
  caseId: string;
  evidence: IQualificationAttemptTrialModel;
  index: number;
  scenario: IQualificationProfileCaseModel['scenario'];
}

const { caseId, evidence, index, scenario } = Astro.props;
const { actor, deterministicAfter, deterministicBefore, judge, judgeSkipped, result } = evidence;
const isCurrentTrial = 'trialId' in result;
const trialId = isCurrentTrial ? result.trialId : 'initial';
const trialLabel =
  trialId === 'initial'
    ? 'Initial trial'
    : trialId === 'confirmation-1'
      ? 'Confirmation 1'
      : 'Confirmation 2';
const hasPassed = isCurrentTrial ? result.passed : result.status === 'passed';
const getTokenTotal = (usage: typeof result.actorUsage): number | null =>
  usage === null ? null : usage.inputTokens + usage.cachedInputTokens + usage.outputTokens;
const actorTokenTotal = getTokenTotal(result.actorUsage);
const judgeTokenTotal = getTokenTotal(result.judgeUsage);
const headingId = `${caseId}-${trialId}-title`;
const retryCount = evidence.retries.actor.length + evidence.retries.judge.length;
const deterministicRows = [
  { label: 'Before actor', verification: deterministicBefore },
  { label: 'After actor', verification: deterministicAfter },
];
const isCliCompositionValid = (
  verification: IQualificationAttemptTrialModel['deterministicBefore'],
): boolean =>
  'cliCompositionValid' in verification
    ? verification.cliCompositionValid
    : verification.cliCompatibilityValid;
const requirementsById = new Map(
  scenario.judgeRequirements.map((requirement) => [requirement.id, requirement]),
);
const requirementAssessments = isCurrentTrial ? result.requirementAssessments : null;
const getRequirementSourceLabel = (requirementId: string): string => {
  const requirement = requirementsById.get(requirementId);

  if (requirement === undefined) {
    return 'Unavailable';
  }

  return requirement.evaluation.kind === 'runner'
    ? requirement.evaluation.checks.join(', ')
    : requirement.evaluation.evidenceSources.join(', ');
};
const getArtifactLabel = (artifactPath: string): string =>
  isCurrentTrial && artifactPath.endsWith('-events.jsonl')
    ? `${artifactPath} (projected execution evidence)`
    : artifactPath;
---

<article
  class="min-w-0 rounded-xl border border-border bg-muted/20 p-4 sm:p-5"
  aria-labelledby={headingId}
>
  <header class="flex flex-wrap items-center gap-3">
    <span class="font-mono text-xs font-bold text-muted-foreground">
      {String(index + 1).padStart(2, '0')}
    </span>
    <h5
      id={headingId}
      class="text-lg font-semibold"
    >
      {trialLabel}
    </h5>
    <EvidenceStatus status={hasPassed ? 'passed' : 'failed'} />
    <time
      class="ms-auto text-sm text-muted-foreground"
      datetime={`PT${result.durationMs / 1_000}S`}
    >
      {prettifyTime(result.durationMs)}
    </time>
  </header>

  {
    result.failures.length > 0 && (
      <div class="mt-4 rounded-lg border border-destructive/30 bg-destructive/10 p-4">
        <p class="font-semibold">Trial failures</p>
        <ul class="mt-2 list-disc space-y-1 ps-5 text-sm leading-6">
          {result.failures.map((failure) => (
            <li>
              <EvidenceText text={failure} />
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="mt-5 grid gap-4 lg:grid-cols-2">
    <section
      class="lg:col-span-2"
      aria-labelledby={`${headingId}-deterministic`}
    >
      <h6
        id={`${headingId}-deterministic`}
        class="font-semibold"
      >
        <span class="sr-only">{trialLabel}: </span>
        Deterministic evidence
      </h6>
      <div class="mt-3 grid gap-3 xl:grid-cols-2">
        {
          deterministicRows.map(({ label, verification }) => (
            <article class="min-w-0 rounded-lg border border-border p-3 sm:p-4">
              <div class="flex flex-wrap items-center gap-2">
                <p class="font-semibold">{label}</p>
                <EvidenceStatus status={verification.passed ? 'passed' : 'failed'} />
              </div>
              <dl class="mt-3 grid gap-x-5 gap-y-2 text-sm sm:grid-cols-2">
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">Inspection</dt>
                  <dd class="font-mono">{verification.inspectionStatus}</dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">Repository FS</dt>
                  <dd class="font-mono">
                    {verification.repositoryFilesystemValid ? 'passed' : 'failed'}
                  </dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">Repository readers</dt>
                  <dd class="font-mono">
                    {verification.memoryRepositoryEquivalent ? 'equivalent' : 'different'}
                  </dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">Core</dt>
                  <dd class="font-mono">{verification.coreValid ? 'passed' : 'failed'}</dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">CLI composition</dt>
                  <dd class="font-mono">
                    {isCliCompositionValid(verification) ? 'passed' : 'failed'}
                  </dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">CLI identity</dt>
                  <dd class="font-mono">{verification.cliIdentityValid ? 'passed' : 'failed'}</dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">CLI package inventory</dt>
                  <dd class="font-mono">
                    {verification.cliPackageInventoryValid ? 'passed' : 'failed'}
                  </dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">CLI adapter inventory</dt>
                  <dd class="font-mono">
                    {verification.cliAdapterInventoryValid ? 'passed' : 'failed'}
                  </dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">CLI envelope</dt>
                  <dd class="font-mono">{verification.cliEnvelopeValid ? 'passed' : 'failed'}</dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">CLI validation</dt>
                  <dd class="font-mono">{verification.cliValidateStatus}</dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">CLI inspection</dt>
                  <dd class="font-mono">{verification.cliInspectStatus}</dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">Typecheck</dt>
                  <dd class="font-mono">{verification.typecheckPassed ? 'passed' : 'failed'}</dd>
                </div>
                <div class="flex min-w-0 justify-between gap-3">
                  <dt class="text-muted-foreground">Read-only check</dt>
                  <dd class="font-mono">
                    {verification.repositoryUnchanged ? 'passed' : 'failed'}
                  </dd>
                </div>
              </dl>
              {verification.failures.length > 0 && (
                <ul class="mt-3 list-disc space-y-1 ps-5 text-sm leading-6 text-muted-foreground">
                  {verification.failures.map((failure) => (
                    <li>
                      <EvidenceText text={failure} />
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby={`${headingId}-workspace`}>
      <h6
        id={`${headingId}-workspace`}
        class="font-semibold"
      >
        <span class="sr-only">{trialLabel}: </span>
        Workspace assertions
      </h6>
      <div class="mt-3 rounded-lg border border-border p-3 sm:p-4">
        <EvidenceStatus status={evidence.workspaceAssertions.passed ? 'passed' : 'failed'} />
        <p class="mt-3 text-sm leading-6 text-muted-foreground">
          {
            evidence.workspaceAssertions.changedPaths.length === 0
              ? 'No project-visible paths changed.'
              : `${evidence.workspaceAssertions.changedPaths.length} project-visible path(s) changed.`
          }
        </p>
        {
          evidence.workspaceAssertions.changedPaths.length > 0 && (
            <ul class="mt-2 grid gap-1 text-xs">
              {evidence.workspaceAssertions.changedPaths.map((path) => (
                <li>
                  <code class="break-all">{path}</code>
                </li>
              ))}
            </ul>
          )
        }
        {
          evidence.workspaceAssertions.failures.length > 0 && (
            <ul class="mt-3 list-disc space-y-1 ps-5 text-sm leading-6 text-muted-foreground">
              {evidence.workspaceAssertions.failures.map((failure) => (
                <li>
                  <EvidenceText text={failure} />
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <section aria-labelledby={`${headingId}-model`}>
      <h6
        id={`${headingId}-model`}
        class="font-semibold"
      >
        <span class="sr-only">{trialLabel}: </span>
        Model evidence
      </h6>
      <dl class="mt-3 grid gap-2 text-sm">
        <div class="rounded-lg border border-border p-3">
          <dt class="text-muted-foreground">Actor</dt>
          <dd class="mt-1"><EvidenceText text={actor.summary} /></dd>
          <dd class="mt-2 text-xs text-muted-foreground">
            Outcome: <span class="font-mono text-foreground">{actor.outcome}</span>
          </dd>
          <dd class="mt-1 text-xs text-muted-foreground">
            Evidence created: <time datetime={result.actorEvidenceCreatedAt}>
              {result.actorEvidenceCreatedAt}
            </time>
          </dd>
          <dd class="mt-2 font-mono text-xs break-all">
            {result.actorCacheSourceAttemptId ?? 'Fresh evidence'}
          </dd>
          <dd class="mt-1 text-xs text-muted-foreground">
            {actorTokenTotal === null ? 'Token usage unavailable' : `${actorTokenTotal} tokens`}
          </dd>
        </div>
        <div class="rounded-lg border border-border p-3">
          <dt class="text-muted-foreground">Judge</dt>
          <dd class="mt-1">
            {
              judge === null ? (
                <EvidenceText text={judgeSkipped?.reason ?? 'Judge unavailable.'} />
              ) : (
                <EvidenceText text={judge.summary} />
              )
            }
          </dd>
          <dd class="mt-2 text-xs text-muted-foreground">
            Verdict: <span class="font-mono text-foreground">{judge?.verdict ?? 'skipped'}</span>
          </dd>
          <dd class="mt-1 text-xs text-muted-foreground">
            Evidence created: {
              result.judgeEvidenceCreatedAt === null ? (
                'Unavailable'
              ) : (
                <time datetime={result.judgeEvidenceCreatedAt}>
                  {result.judgeEvidenceCreatedAt}
                </time>
              )
            }
          </dd>
          <dd class="mt-2 font-mono text-xs break-all">
            {result.judgeCacheSourceAttemptId ?? (judge === null ? 'Skipped' : 'Fresh evidence')}
          </dd>
          <dd class="mt-1 text-xs text-muted-foreground">
            {judgeTokenTotal === null ? 'Token usage unavailable' : `${judgeTokenTotal} tokens`}
          </dd>
        </div>
      </dl>
    </section>
  </div>

  {
    requirementAssessments !== null ? (
      <section
        class="mt-4"
        aria-labelledby={`${headingId}-requirements`}
      >
        <h6
          id={`${headingId}-requirements`}
          class="font-semibold"
        >
          <span class="sr-only">{trialLabel}: </span>
          Requirement assessments
        </h6>
        <ul class="mt-3 grid gap-3 lg:grid-cols-2">
          {requirementAssessments.map((requirement) => (
            <li class="min-w-0 rounded-lg border border-border p-3 sm:p-4">
              <div class="flex flex-wrap items-center gap-2">
                <code class="text-xs font-semibold break-all">{requirement.id}</code>
                <EvidenceStatus
                  status={
                    requirement.verdict === 'pass'
                      ? 'passed'
                      : requirement.verdict === 'not-evaluated'
                        ? 'skipped'
                        : 'failed'
                  }
                />
              </div>
              <dl class="mt-2 grid gap-1 text-xs text-muted-foreground">
                <div>
                  <dt class="inline">Owner: </dt>
                  <dd class="inline font-mono text-foreground">{requirement.evaluator}</dd>
                </div>
                <div>
                  <dt class="inline">Source: </dt>
                  <dd class="inline font-mono text-foreground">
                    {getRequirementSourceLabel(requirement.id)}
                  </dd>
                </div>
              </dl>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                <EvidenceText text={requirement.evidence} />
              </p>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      judge !== null && (
        <section
          class="mt-4"
          aria-labelledby={`${headingId}-requirements`}
        >
          <h6
            id={`${headingId}-requirements`}
            class="font-semibold"
          >
            <span class="sr-only">{trialLabel}: </span>
            Historical judge requirements
          </h6>
          <ul class="mt-3 grid gap-3 lg:grid-cols-2">
            {judge.requirements.map((requirement) => (
              <li class="min-w-0 rounded-lg border border-border p-3 sm:p-4">
                <div class="flex flex-wrap items-center gap-2">
                  <code class="text-xs font-semibold break-all">{requirement.id}</code>
                  <EvidenceStatus status={requirement.verdict === 'pass' ? 'passed' : 'failed'} />
                </div>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">
                  <EvidenceText text={requirement.evidence} />
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    )
  }

  <details class="mt-4 rounded-lg border border-border">
    <summary
      class="min-h-12 cursor-pointer px-4 py-3 font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
    >
      Operational retries ({retryCount}) and committed trial artifacts
    </summary>
    <div class="grid gap-5 border-t border-border p-4">
      {
        retryCount === 0 ? (
          <p class="text-sm text-muted-foreground">
            No retryable provider, network, or timeout failure was recorded.
          </p>
        ) : (
          <ol class="grid gap-2 text-sm">
            {[
              ...evidence.retries.actor.map((retry) => ({ ...retry, role: 'Actor' })),
              ...evidence.retries.judge.map((retry) => ({ ...retry, role: 'Judge' })),
            ].map((retry) => (
              <li class="rounded-lg border border-border p-3">
                <span class="font-semibold">
                  {retry.role} retry {retry.failureCount}
                </span>
                <span class="ms-2 font-mono text-xs">{retry.category}</span>
                <span class="ms-2 text-muted-foreground">{retry.retryDelayMs} ms</span>
              </li>
            ))}
          </ol>
        )
      }
      <ul class="grid gap-2 sm:grid-cols-2">
        {
          evidence.artifacts.map((artifact) => (
            <li class="min-w-0">
              <a
                class="inline-flex min-w-0 items-center gap-2 font-mono text-xs font-semibold text-link hover:underline"
                href={artifact.rawUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="break-all">{getArtifactLabel(artifact.path)}</span>
                <ExternalLink
                  class="size-3.5 shrink-0"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </details>
</article>
