---
import Conversation from '@moldea.ai/website-ui/conversation';
import ConversationMessage from '@moldea.ai/website-ui/conversation-message';
import StatusBadge from '@moldea.ai/website-ui/status-badge';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';
import { withBase } from '@moldea.ai/website-ui/site';

import type { ISemanticEvaluationCaseModel } from '../../lib/semantic-evaluation/index.ts';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import { getRecordedWorkspace, getRecordedMessages } from '../evidence-page/index.ts';
import { RecordedFileTree } from '../recorded-file-tree/index.ts';

interface Props {
  evaluationCase: ISemanticEvaluationCaseModel | null;
}
const { evaluationCase } = Astro.props;
const workspace = getRecordedWorkspace(
  evaluationCase?.replay ?? null,
  (path) =>
    path.startsWith('src/') || path.endsWith('/instruction.md') || path === 'moldea/moldea.yaml',
);
const messages = getRecordedMessages(evaluationCase?.replay ?? null);
const replyHtml =
  messages.reply === null
    ? null
    : await renderMarkdownFragment(messages.reply, {
        basePath: import.meta.env.BASE_URL,
        localLinks: 'unwrap',
      });
const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<article
  class="min-w-0"
  aria-label="Support agent instruction test"
  data-recorded-agent
>
  <Conversation ariaLabel="Support agent instruction test conversation">
    <ConversationMessage role="user">
      <p class="mb-2 text-xs text-muted-foreground">
        {messages.request === null ? 'Request summary' : 'Recorded request excerpt'}
      </p>
      <p class="line-clamp-3 text-sm leading-7 break-words whitespace-pre-wrap">
        {
          messages.request ??
            'Finish the support agent. Connect its maintained instructions to both model calls and verify the existing flow.'
        }
      </p>
    </ConversationMessage>
    {
      replyHtml !== null && (
        <ConversationMessage role="assistant">
          <img
            slot="avatar"
            src={skillMarkPath}
            width="207"
            height="215"
            alt=""
            class="dark:invert"
          />
          <p class="mb-2 text-xs text-muted-foreground">Recorded reply excerpt</p>
          <div
            class="markdown-content line-clamp-4 min-w-0 text-sm leading-7 break-words"
            set:html={replyHtml}
          />
          {workspace !== null && workspace.paths.length > 0 && (
            <div class="mt-4 border-t border-border pt-4">
              <p class="mb-2 text-xs font-semibold text-muted-foreground">File changes</p>
              <RecordedFileTree
                changes={workspace.paths}
                label="Recorded test files"
              />
            </div>
          )}
        </ConversationMessage>
      )
    }
  </Conversation>
  <div
    class="mt-5 border-t border-border pt-4"
    data-agent-result
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-xs font-semibold">What this tests</p>{
        evaluationCase === null ? (
          <StatusBadge
            label="No example result selected"
            tone="neutral"
          />
        ) : (
          <EvidenceStatus status={evaluationCase.status} />
        )
      }
    </div>
    <p class="mt-2 text-sm leading-7 text-muted-foreground">
      Both model calls should use the maintained instructions, while the existing support flow keeps
      working.
    </p>
    {
      replyHtml === null && workspace !== null && workspace.paths.length > 0 && (
        <div class="mt-3">
          <RecordedFileTree
            changes={workspace.paths}
            label="Recorded test files"
          />
        </div>
      )
    }
  </div>
</article>
