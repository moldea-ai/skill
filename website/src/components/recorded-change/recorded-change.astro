---
import Conversation from '@moldea.ai/website-ui/conversation';
import ConversationMessage from '@moldea.ai/website-ui/conversation-message';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';
import { withBase } from '@moldea.ai/website-ui/site';

import type { ISemanticEvaluationCaseModel } from '../../lib/semantic-evaluation/index.ts';
import { getRecordedWorkspace, getRecordedMessages } from '../evidence-page/index.ts';
import { RecordedFileTree } from '../recorded-file-tree/index.ts';

interface Props {
  evaluationCase: ISemanticEvaluationCaseModel | null;
}
const { evaluationCase } = Astro.props;
const workspace = getRecordedWorkspace(evaluationCase?.replay ?? null);
const messages = getRecordedMessages(evaluationCase?.replay ?? null);
const replyHtml =
  messages.reply === null
    ? null
    : await renderMarkdownFragment(messages.reply, {
        basePath: import.meta.env.BASE_URL,
        localLinks: 'unwrap',
      });
const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<article
  class="min-w-0"
  aria-label="Connected scheduler change test"
  data-recorded-change
>
  <Conversation ariaLabel="Connected scheduler change test conversation">
    <ConversationMessage role="user">
      {
        messages.request === null && (
          <p class="mb-2 text-xs text-muted-foreground">Request summary</p>
        )
      }
      <p class="line-clamp-3 text-sm leading-7 break-words whitespace-pre-wrap">
        {messages.request ?? 'Run document cleanup more often when the backlog grows.'}
      </p>
    </ConversationMessage>
    {
      replyHtml !== null && (
        <ConversationMessage role="assistant">
          <img
            slot="avatar"
            src={skillMarkPath}
            width="207"
            height="215"
            alt=""
            class="dark:invert"
          />
          <div
            class="markdown-content line-clamp-4 min-w-0 text-sm leading-7 break-words"
            data-code-copy="false"
            set:html={replyHtml}
          />
          {workspace !== null && workspace.paths.length > 0 && (
            <div class="conversation-message-footer">
              <p class="mb-2 text-xs font-semibold text-muted-foreground">File changes</p>
              <RecordedFileTree
                changes={workspace.paths}
                label="Recorded test files"
              />
            </div>
          )}
        </ConversationMessage>
      )
    }
  </Conversation>
  {
    replyHtml === null && workspace !== null && workspace.paths.length > 0 && (
      <div class="mt-4">
        <RecordedFileTree
          changes={workspace.paths}
          label="Recorded test files"
        />
      </div>
    )
  }
</article>
