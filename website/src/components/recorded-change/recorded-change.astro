---
import { FileCheck, UserRound } from '@lucide/astro';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import { withBase } from '@moldea.ai/website-ui/site';
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import type { ISemanticEvaluationCaseModel } from '../../lib/semantic-evaluation/index.ts';
import { getRecordedWorkspace } from '../evidence-page/index.ts';
import EvidenceStatus from '../evidence-status/evidence-status.astro';

interface Props {
  evaluationCase: ISemanticEvaluationCaseModel | null;
}
const { evaluationCase } = Astro.props;
const workspace = getRecordedWorkspace(evaluationCase?.replay ?? null);
const hasRecordedSchedule =
  evaluationCase?.replay?.trials
    .at(-1)
    ?.steps.some(
      (step) =>
        step.kind === 'message' &&
        step.role === 'coding-agent' &&
        step.content.includes('60 minutes when empty, 30 minutes at 100 pending documents'),
    ) ?? false;
const skillMarkPath = withBase('/logo/icon-xs-light.png', import.meta.env.BASE_URL);
---

<article
  class="min-w-0 rounded-2xl border border-border bg-card p-4 shadow-raised sm:p-6"
  aria-label="Connected scheduler change test"
  data-recorded-change
>
  <div class="flex items-start gap-3">
    <UserRound
      class="mt-1 size-4 shrink-0 text-muted-foreground"
      aria-hidden="true"
    />
    <div>
      <p class="text-xs font-semibold text-muted-foreground">Test request, shortened</p><p
        class="mt-1 text-sm leading-6 font-medium"
      >
        Run document cleanup more often when the backlog grows.
      </p>
    </div>
  </div>
  <div class="mt-5 border-t border-border pt-5">
    <div class="mb-4 flex items-center gap-3">
      <img
        src={skillMarkPath}
        width="207"
        height="215"
        alt=""
        class="h-5 w-auto dark:invert"
      /><p class="text-xs font-semibold text-muted-foreground">
        {evaluationCase === null ? 'What we check' : 'Files in the recorded change'}
      </p>
    </div>
    {
      workspace === null ? (
        <p class="text-sm leading-6 text-muted-foreground">
          Check the scheduler, its tests, and the project notes together.
        </p>
      ) : (
        <ul
          class="grid min-w-0 grid-cols-1 gap-2"
          aria-label="Recorded scheduler files"
        >
          {workspace.paths.map(({ path, status }) => (
            <li class="min-w-0">
              <FilePreview path={path}>
                <StatusBadge
                  slot="status"
                  label={status}
                  tone="neutral"
                  size="sm"
                />
              </FilePreview>
            </li>
          ))}
        </ul>
      )
    }
    {
      hasRecordedSchedule && (
        <div
          class="mt-4 grid grid-cols-2 gap-3"
          data-scheduler-observations
        >
          <div class="rounded-xl bg-secondary p-3">
            <>
              <p class="text-xs text-muted-foreground">Empty backlog</p>
              <p class="mt-1 text-2xl font-semibold">
                60 <span class="text-sm">min</span>
              </p>
              <div
                class="mt-3 h-1.5 rounded-full bg-foreground/70"
                aria-hidden="true"
              />
            </>
          </div>
          <div class="rounded-xl bg-secondary p-3">
            <>
              <p class="text-xs text-muted-foreground">100 documents waiting</p>
              <p class="mt-1 text-2xl font-semibold">
                30 <span class="text-sm">min</span>
              </p>
              <div
                class="mt-3 h-1.5 w-1/2 rounded-full bg-foreground/70"
                aria-hidden="true"
              />
            </>
          </div>
        </div>
      )
    }
  </div>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4">
    <p class="flex items-center gap-2 text-xs font-semibold">
      <FileCheck
        class="size-4"
        aria-hidden="true"
      />Code, tests, and project notes
    </p>
    {
      evaluationCase === null ? (
        <StatusBadge
          label="No example result selected"
          tone="neutral"
        />
      ) : (
        <EvidenceStatus status={evaluationCase.status} />
      )
    }
  </div>
</article>
