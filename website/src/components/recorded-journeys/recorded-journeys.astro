---
import Conversation from '@moldea.ai/website-ui/conversation';
import ConversationMessage from '@moldea.ai/website-ui/conversation-message';
import { renderMarkdownFragment } from '@moldea.ai/website-ui/markdown';

import { RecordedFileTree } from '../recorded-file-tree/index.ts';
import { PlatformMark } from '../platform-mark/index.ts';
import EvidenceStatus from '../evidence-status/evidence-status.astro';
import {
  getJourneyRevisions,
  type IScriptedJourneysWebsiteModel,
} from '../../lib/scripted-journeys/index.ts';

interface Props {
  model: IScriptedJourneysWebsiteModel;
}
const { model } = Astro.props;
const journey = model.journeys[0];
const step = (journey ? getJourneyRevisions(model, journey.id) : [])
  .flatMap((revision) => revision.steps)
  .find((step) => step.results.length > 0);
const result = step?.results[0];
const replyHtml = result
  ? await renderMarkdownFragment(result.reply, { localLinks: 'unwrap' })
  : null;
---

<div
  class="min-w-0 text-foreground"
  data-recorded-journeys
>
  {
    step && result ? (
      <>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <>
            <PlatformMark platform={result.platform} />
            <span class="text-xs text-muted-foreground">First run excerpt</span>
          </>
        </div>
        <Conversation ariaLabel="Recorded journey excerpt">
          <ConversationMessage role="user">
            <p class="line-clamp-3 text-sm leading-7 break-words whitespace-pre-wrap">
              {step.request}
            </p>
          </ConversationMessage>
          <ConversationMessage role="assistant">
            <div
              class="markdown-content line-clamp-3 text-sm leading-7 break-words"
              set:html={replyHtml!}
            />
            {result.files.length > 0 && (
              <div class="mt-4 border-t border-border pt-3">
                <RecordedFileTree
                  changes={result.files.slice(0, 4)}
                  label="Recorded journey file changes"
                />
              </div>
            )}
          </ConversationMessage>
        </Conversation>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4">
          <>
            <span class="text-xs font-semibold">Local checks for this request</span>
            <EvidenceStatus status={result.status} />
          </>
        </div>
      </>
    ) : (
      <p class="py-6 text-sm text-muted-foreground">No conversation has been recorded yet.</p>
    )
  }
</div>
