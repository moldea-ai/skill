---
import { FolderGit2, UserRound } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import FilePreview from '@moldea.ai/website-ui/file-preview';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import type { IProjectAttempt } from '../../lib/project-runs/index.ts';
import { getProjectPatchPaths } from '../evidence-page/index.ts';

interface Props {
  attempt: IProjectAttempt;
}
const { attempt } = Astro.props;
const paths = getProjectPatchPaths(attempt);
const basePath = import.meta.env.BASE_URL;
---

<article
  class="min-w-0 rounded-2xl border border-border bg-card p-4 shadow-raised sm:p-6"
  aria-label={`${attempt.title} project recording`}
  data-recorded-project
>
  <div class="mb-5 flex items-center gap-3">
    <FolderGit2
      class="size-5 shrink-0 text-muted-foreground"
      aria-hidden="true"
    /><div>
      <p class="text-xs text-muted-foreground">Recorded project</p><h3
        class="text-lg font-semibold"
      >
        <InlineBrandText text={attempt.title} />
      </h3>
    </div>
  </div>
  {
    attempt.initialRequest !== null && (
      <div class="mb-4 flex items-start gap-3 rounded-xl bg-secondary p-3">
        <>
          <UserRound
            class="mt-1 size-4 shrink-0"
            aria-hidden="true"
          />
          <div class="min-w-0">
            <>
              <p class="text-xs font-semibold text-muted-foreground">Request excerpt</p>
              <p class="mt-1 line-clamp-3 text-sm leading-6">
                <InlineBrandText text={attempt.initialRequest.text} />
              </p>
            </>
          </div>
        </>
      </div>
    )
  }
  {
    paths.length > 0 && (
      <div>
        <>
          <p class="mb-3 text-xs font-semibold text-muted-foreground">
            Some files in the recorded patches
          </p>
          <ul
            class="grid min-w-0 grid-cols-1 gap-2"
            aria-label="Recorded project patch paths"
          >
            {paths.map(({ path, action }) => (
              <li class="min-w-0">
                <FilePreview path={path}>
                  <StatusBadge
                    slot="status"
                    label={action}
                    tone="neutral"
                    size="sm"
                  />
                </FilePreview>
              </li>
            ))}
          </ul>
        </>
      </div>
    )
  }
  <p class="mt-4 text-sm leading-6 text-muted-foreground">
    <InlineBrandText text={attempt.excerpt} />
  </p>
  <div class="mt-5 border-t border-border pt-4">
    <ActionLink
      href={withBase(attempt.route, basePath)}
      variant="outline"
      class="w-full"
      >Open the recorded session</ActionLink
    >
  </div>
</article>
