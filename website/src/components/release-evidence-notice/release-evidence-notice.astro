---
import { ExternalLink } from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

import type { IReleaseEvidenceModel } from '../../lib/release-evidence/index.ts';

interface Props {
  evidence: IReleaseEvidenceModel;
}

const { evidence } = Astro.props;
---

{
  evidence.mode !== 'not-recorded' && (
    <aside
      class="mt-6 rounded-lg border border-border bg-muted/35 px-4 py-3 text-sm leading-6 text-muted-foreground"
      aria-label="Release evidence provenance"
    >
      {evidence.mode === 'pinned' ? (
        <p>
          Evidence for release <code>{evidence.targetVersion}</code> is pinned from{' '}
          <a
            class="font-bold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
            href={evidence.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {evidence.sourceTag}
            <ExternalLink
              class="ml-1 inline size-3.5"
              aria-hidden="true"
            />
          </a>
          . Reason:{' '}
          <InlineBrandText
            text={evidence.reason}
            variant="compact"
          />
        </p>
      ) : (
        <p>
          Fresh semantic and qualification evidence is recorded for release{' '}
          <code>{evidence.targetVersion}</code>.
        </p>
      )}
    </aside>
  )
}
