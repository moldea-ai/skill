---
import { ExternalLink } from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

import type {
  IReleaseEvidenceModel,
  IReleaseEvidenceSectionModel,
} from '../../lib/release-evidence/index.ts';

interface Props {
  evidence: IReleaseEvidenceModel;
  scope?: 'qualification' | 'semantic';
}

const { evidence, scope } = Astro.props;
const sections: Array<{
  kind: 'qualification' | 'semantic';
  section: IReleaseEvidenceSectionModel;
}> =
  evidence.mode === 'recorded'
    ? scope === undefined
      ? [
          { kind: 'semantic', section: evidence.semantic },
          { kind: 'qualification', section: evidence.qualification },
        ]
      : [{ kind: scope, section: evidence[scope] }]
    : [];
---

{
  evidence.mode !== 'not-recorded' && (
    <aside
      class="mt-6 rounded-lg border border-border bg-muted/35 px-4 py-3 text-sm leading-6 text-muted-foreground"
      aria-label="Release evidence provenance"
    >
      {sections.map(({ kind, section }) =>
        section.mode === 'pinned' ? (
          <p>
            {kind === 'semantic' ? 'Semantic' : 'Qualification'} release{' '}
            <code>{evidence.targetVersion}</code> uses verified prior evidence from{' '}
            <a
              class="font-bold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
              href={section.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {section.sourceLabel}
              <ExternalLink
                class="ml-1 inline size-3.5"
                aria-hidden="true"
              />
            </a>
            . Reason:{' '}
            <InlineBrandText
              text={section.reason}
              variant="compact"
            />
          </p>
        ) : (
          <p>
            Fresh {kind} evidence is recorded for release <code>{evidence.targetVersion}</code>.
          </p>
        ),
      )}
    </aside>
  )
}
