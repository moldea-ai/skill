---
import { ArrowRight, FileText, FolderTree, GitBranch, Link2, ShieldCheck } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import { REPOSITORY_FORMAT_EXAMPLE } from './constants.ts';

const organizationLayers = [
  {
    description: 'Reviewed project facts remain beside the implementation they describe.',
    detail: 'my-store/moldea/',
    icon: GitBranch,
    label: 'Project context',
    title: 'One visible home',
  },
  {
    description: 'Each agent owns focused instructions and the context it needs.',
    detail: 'agents/support/',
    icon: FileText,
    label: 'Agent behavior',
    title: 'Easy to inspect',
  },
  {
    description: 'The manifest records which instructions, tools, and code belong together.',
    detail: 'moldea.yaml',
    icon: Link2,
    label: 'Connections',
    title: 'Clear and checkable',
  },
] as const;
const basePath = import.meta.env.BASE_URL;
const getTreeConnector = (index: number, length: number): string =>
  index === length - 1 ? '└──' : '├──';
---

<section
  class="border-b border-border bg-sidebar py-12 sm:py-16"
  aria-labelledby="repository-format-title"
  data-repository-format
>
  <div class="page-shell">
    <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
      <div>
        <p class="eyebrow mb-4">Repository format</p>
        <h2
          id="repository-format-title"
          class="section-title max-w-4xl text-3xl font-semibold sm:text-4xl lg:text-5xl"
        >
          Project context lives beside the code.
        </h2>
      </div>
      <p class="text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        <InlineBrandText
          text="moldea starts with two files, then adds focused context and agent behavior only when the project needs them."
        />
      </p>
    </header>

    <div class="mt-8 grid items-stretch gap-4 lg:grid-cols-2">
      <div
        class="dark-surface-selection min-w-0 overflow-hidden rounded-2xl border border-primary bg-primary text-primary-foreground shadow-raised"
        data-repository-format-filesystem
      >
        <div
          class="flex items-center justify-between gap-3 border-b border-current/15 px-4 py-4 sm:px-6"
        >
          <div class="flex min-w-0 items-center gap-3">
            <span
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-current/10"
            >
              <FolderTree
                class="size-4"
                aria-hidden="true"
              />
            </span>
            <p class="min-w-0 font-mono text-sm font-bold">Project files</p>
          </div>
          <span
            class="rounded-full border border-current/20 px-2.5 py-1 text-xs font-semibold text-current/70"
          >
            in Git
          </span>
        </div>

        <div class="p-4 sm:p-6">
          <ul
            class="font-mono text-xs sm:text-sm"
            aria-label="Example project filesystem"
          >
            <li>
              <div class="flex min-w-0 items-center border-b border-current/10 px-2 pb-3 font-bold">
                <code class="min-w-0 break-all">{REPOSITORY_FORMAT_EXAMPLE.projectDirectory}</code>
                <span class="ml-auto shrink-0 text-[0.625rem] text-current/60">project root</span>
              </div>

              <ul class="mt-2 ml-1 grid gap-1 border-s border-current/20 ps-2 sm:ml-3 sm:ps-3">
                <li class="min-w-0 px-2 py-2">
                  <div class="flex min-w-0 items-center gap-2 font-bold">
                    <span
                      class="text-current/40"
                      aria-hidden="true"
                      >├──</span
                    >
                    <code class="min-w-0 break-all">moldea/</code>
                    <span class="ml-auto shrink-0 text-[0.625rem] text-current/60"
                      >project context</span
                    >
                  </div>
                  <ul
                    class="mt-1 ml-1 space-y-1 border-s border-current/15 ps-2 text-current/75 sm:ml-3 sm:ps-3"
                  >
                    {
                      REPOSITORY_FORMAT_EXAMPLE.foundationFiles.map((file) => (
                        <li class="flex min-w-0 items-center gap-2 px-3 py-1.5">
                          <span
                            class="text-current/40"
                            aria-hidden="true"
                          >
                            ├──
                          </span>
                          <code class="min-w-0 break-all">{file}</code>
                        </li>
                      ))
                    }
                    <li>
                      <div class="flex min-w-0 items-center gap-2 px-3 py-1.5">
                        <span
                          class="text-current/40"
                          aria-hidden="true"
                          >├──</span
                        >
                        <code class="min-w-0 break-all">context/</code>
                      </div>
                      <ul class="ml-3 border-s border-current/15 ps-3">
                        {
                          REPOSITORY_FORMAT_EXAMPLE.contextFiles.map((file, index) => (
                            <li class="flex min-w-0 items-center gap-2 py-1.5">
                              <span
                                class="text-current/40"
                                aria-hidden="true"
                              >
                                {getTreeConnector(
                                  index,
                                  REPOSITORY_FORMAT_EXAMPLE.contextFiles.length,
                                )}
                              </span>
                              <code class="min-w-0 break-all">{file}</code>
                            </li>
                          ))
                        }
                      </ul>
                    </li>
                    <li>
                      <div class="flex min-w-0 items-center gap-2 px-3 py-1.5">
                        <span
                          class="text-current/40"
                          aria-hidden="true"
                          >└──</span
                        >
                        <code class="min-w-0 break-all">agents/</code>
                      </div>
                      <ul class="ml-3 border-s border-current/15 ps-3">
                        <li>
                          <div class="flex min-w-0 items-center gap-2 py-1.5 font-bold">
                            <span
                              class="text-current/40"
                              aria-hidden="true"
                              >└──</span
                            >
                            <code class="min-w-0 break-all"
                              >{REPOSITORY_FORMAT_EXAMPLE.agent.id}/</code
                            >
                          </div>
                          <ul class="ml-3 border-s border-current/15 ps-3 text-current/70">
                            {
                              REPOSITORY_FORMAT_EXAMPLE.agent.behaviorFiles.map((file, index) => (
                                <li class="flex min-w-0 items-center gap-2 py-1.5">
                                  <span
                                    class="text-current/40"
                                    aria-hidden="true"
                                  >
                                    {getTreeConnector(
                                      index,
                                      REPOSITORY_FORMAT_EXAMPLE.agent.behaviorFiles.length,
                                    )}
                                  </span>
                                  <code class="min-w-0 break-all">{file}</code>
                                </li>
                              ))
                            }
                          </ul>
                        </li>
                      </ul>
                    </li>
                  </ul>
                </li>

                <li class="min-w-0 px-2 py-2">
                  <div class="flex min-w-0 items-center gap-2 font-bold">
                    <span
                      class="text-current/40"
                      aria-hidden="true"
                      >└──</span
                    >
                    <code class="min-w-0 break-all">src/</code>
                    <span class="ml-auto shrink-0 text-[0.625rem] text-current/60"
                      >implementation</span
                    >
                  </div>
                  <ul
                    class="mt-1 ml-1 space-y-1 border-s border-current/15 ps-2 text-current/75 sm:ml-3 sm:ps-3"
                  >
                    {
                      REPOSITORY_FORMAT_EXAMPLE.sourceFiles.map((file, index) => (
                        <li class="flex min-w-0 items-center gap-2 px-3 py-1.5">
                          <span
                            class="text-current/40"
                            aria-hidden="true"
                          >
                            {getTreeConnector(index, REPOSITORY_FORMAT_EXAMPLE.sourceFiles.length)}
                          </span>
                          <code class="min-w-0 break-all">{file}</code>
                        </li>
                      ))
                    }
                  </ul>
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>

      <ol
        class="grid h-full auto-rows-fr gap-3"
        aria-label="How the repository format helps"
        data-repository-format-benefits
      >
        {
          organizationLayers.map(({ description, detail, icon: LayerIcon, label, title }) => (
            <li class="flex h-full min-w-0 flex-col border-b border-border py-5 last:border-b-0 sm:rounded-xl sm:border sm:bg-card sm:p-6 sm:shadow-surface">
              <div class="flex items-center gap-3">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-muted">
                  <LayerIcon
                    class="size-5"
                    aria-hidden="true"
                  />
                </span>
                <p class="eyebrow">{label}</p>
              </div>
              <h3 class="mt-4 text-xl font-semibold tracking-tight">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
              <code class="mt-auto block pt-4 font-mono text-xs font-semibold text-muted-foreground">
                {detail}
              </code>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <ActionLink
        class="font-bold"
        href={withBase('/docs/repository-format/', basePath)}
        variant="link"
      >
        Explore the format
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
      <ActionLink
        class="font-bold"
        href={withBase('/docs/safety-and-privacy/', basePath)}
        variant="link"
      >
        <ShieldCheck
          class="size-4"
          aria-hidden="true"
        />
        Read the safety model
      </ActionLink>
    </div>
  </div>
</section>
