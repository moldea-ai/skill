---
import { ArrowRight, FileText, FolderTree, GitBranch, Link2, ShieldCheck } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { withBase } from '@moldea.ai/website-ui/site';

import { REPOSITORY_FORMAT_EXAMPLE } from './constants.ts';

const basePath = import.meta.env.BASE_URL;
const removePrefix = (path: string, prefix: string): string => path.slice(prefix.length);
const benefits = [
  {
    description: 'Project context and agent behavior stay reviewable beside the code.',
    icon: GitBranch,
    title: 'Owned in Git',
  },
  {
    description: 'See which instructions, tools, and code belong together.',
    icon: Link2,
    title: 'Connections are visible',
  },
  {
    description: 'Local checks inspect repository files without routine external transmission.',
    icon: ShieldCheck,
    title: 'Private by default',
  },
] as const;
---

<section
  class="border-b border-border bg-sidebar py-12 sm:py-16"
  aria-labelledby="repository-format-title"
  data-repository-format
>
  <div class="page-shell">
    <header
      class="grid gap-5 lg:grid-cols-[minmax(0,0.9fr)_minmax(20rem,0.6fr)] lg:items-end lg:gap-12"
    >
      <div>
        <p class="eyebrow mb-4">Repository format</p>
        <h2
          id="repository-format-title"
          class="section-title max-w-4xl text-3xl font-semibold sm:text-4xl lg:text-5xl"
        >
          Your project. Your files.
        </h2>
      </div>
      <p class="text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        Begin with <code>moldea/moldea.yaml</code> and <code>moldea/project.md</code>. Add focused
        context and agent files when real project work needs them.
      </p>
    </header>

    <div
      class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(19rem,0.65fr)] lg:items-start"
    >
      <div
        class="dark-surface-selection min-w-0 overflow-hidden rounded-2xl bg-primary text-primary-foreground shadow-raised"
        data-repository-format-filesystem
      >
        <div
          class="flex items-center justify-between gap-3 border-b border-current/15 px-4 py-4 sm:px-6"
        >
          <div class="flex items-center gap-3">
            <span class="inline-flex size-9 items-center justify-center rounded-lg bg-current/10">
              <FolderTree
                class="size-4"
                aria-hidden="true"
              />
            </span>
            <p class="font-mono text-sm font-bold">{REPOSITORY_FORMAT_EXAMPLE.projectDirectory}</p>
          </div>
          <span
            class="rounded-full border border-current/20 px-2.5 py-1 text-xs font-semibold text-current/70"
          >
            illustrative project
          </span>
        </div>

        <div class="grid gap-7 p-4 sm:grid-cols-2 sm:p-5">
          <section aria-labelledby="repository-moldea-directory">
            <div class="flex items-center gap-3">
              <FileText
                class="size-4 text-current/60"
                aria-hidden="true"
              />
              <h3
                id="repository-moldea-directory"
                class="font-mono text-sm font-bold"
              >
                <code>moldea/</code>
              </h3>
            </div>
            <div class="mt-4 border-s border-current/20 ps-4">
              <p class="text-[0.6875rem] font-bold tracking-wide text-current/50 uppercase">
                Created at initialization
              </p>
              <ul
                class="mt-2 grid gap-2 font-mono text-xs leading-5"
                aria-label="Files created at initialization"
              >
                {
                  REPOSITORY_FORMAT_EXAMPLE.initializedFiles.map((path) => (
                    <li>
                      <code>{removePrefix(path, '/moldea/')}</code>
                    </li>
                  ))
                }
              </ul>

              <p class="mt-5 text-[0.6875rem] font-bold tracking-wide text-current/50 uppercase">
                Added for this task
              </p>
              <ul
                class="mt-2 grid gap-2 font-mono text-xs leading-5 text-current/80"
                aria-label="Agent files added for the task"
              >
                {
                  [
                    ...REPOSITORY_FORMAT_EXAMPLE.taskContextFiles,
                    ...REPOSITORY_FORMAT_EXAMPLE.agentFiles,
                  ].map((path) => (
                    <li>
                      <code class="break-all">{removePrefix(path, '/moldea/')}</code>
                    </li>
                  ))
                }
              </ul>
            </div>
          </section>

          <section aria-labelledby="repository-source-directory">
            <div class="flex items-center gap-3">
              <FileText
                class="size-4 text-current/60"
                aria-hidden="true"
              />
              <h3
                id="repository-source-directory"
                class="font-mono text-sm font-bold"
              >
                src/
              </h3>
            </div>
            <div class="mt-4 border-s border-current/20 ps-4">
              <p class="text-[0.6875rem] font-bold tracking-wide text-current/50 uppercase">
                Application and agent code
              </p>
              <ul
                class="mt-2 grid gap-2 font-mono text-xs leading-5 text-current/80"
                aria-label="Application and agent source files"
              >
                {
                  REPOSITORY_FORMAT_EXAMPLE.sourceFiles.map((path) => (
                    <li>
                      <code class="break-all">{removePrefix(path, '/src/')}</code>
                    </li>
                  ))
                }
              </ul>
            </div>
          </section>
        </div>
      </div>

      <div
        class="flex min-w-0 flex-col"
        data-repository-format-benefits
      >
        <ul class="grid gap-5">
          {
            benefits.map(({ description, icon: BenefitIcon, title }) => (
              <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-xl border border-border bg-background">
                  <BenefitIcon
                    class="size-4"
                    aria-hidden="true"
                  />
                </span>
                <div>
                  <h3 class="font-semibold">{title}</h3>
                  <p class="mt-1 text-sm leading-6 text-muted-foreground">{description}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
          <ActionLink
            class="font-bold"
            href={withBase('/docs/repository-format/', basePath)}
            variant="link"
          >
            Explore the format
            <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            class="font-bold"
            href={withBase('/docs/safety-and-privacy/', basePath)}
            variant="link"
          >
            Read the safety model
          </ActionLink>
        </div>
      </div>
    </div>
  </div>
</section>
