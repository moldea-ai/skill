---
import { ChevronDown } from '@lucide/astro';

import type { ISemanticEvaluationCaseModel } from '../../lib/semantic-evaluation/index.ts';
import EvidenceText from '../evidence-text/evidence-text.astro';
import EvidenceStatus from '../evidence-status/evidence-status.astro';

interface Props {
  evaluationCase: ISemanticEvaluationCaseModel;
  number: number;
}

const { evaluationCase, number } = Astro.props;
const resultHeading =
  evaluationCase.status === 'failed'
    ? 'Why it failed'
    : evaluationCase.status === 'pending'
      ? 'Not evaluated in this attempt'
      : evaluationCase.status === 'recovered'
        ? 'Why it recovered'
        : 'Why it passed';
const resultClass =
  evaluationCase.status === 'failed'
    ? 'border-destructive/40 bg-destructive/10'
    : evaluationCase.status === 'pending'
      ? 'border-border bg-muted/30'
      : 'border-success/40 bg-success/10';
---

<details class="group surface-card min-w-0 overflow-hidden">
  <summary
    class="flex cursor-pointer list-none items-start gap-3 p-5 marker:content-none focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring sm:gap-4 sm:p-6"
  >
    <span class="mt-0.5 font-mono text-xs font-bold text-muted-foreground">
      {String(number).padStart(2, '0')}
    </span>
    <span class="min-w-0 flex-1">
      <span class="flex flex-wrap items-center gap-2">
        <span class="text-lg font-semibold tracking-tight">
          <EvidenceText text={evaluationCase.title} />
        </span>
        <EvidenceStatus status={evaluationCase.status} />
      </span>
      <span class="mt-2 block text-sm leading-6 text-muted-foreground">
        <EvidenceText text={evaluationCase.scenario} />
      </span>
    </span>
    <ChevronDown
      class="mt-1 size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180 motion-reduce:transition-none"
      aria-hidden="true"
    />
  </summary>

  <div class="border-t border-border px-5 py-6 sm:px-6">
    <div class="grid gap-6 lg:grid-cols-2">
      <section aria-labelledby={`${evaluationCase.id}-expected`}>
        <h3
          id={`${evaluationCase.id}-expected`}
          class="font-semibold"
        >
          What had to happen
        </h3>
        <ul class="mt-3 grid gap-3 text-sm leading-6">
          {
            evaluationCase.expectedCriteria.map(({ criterion }) => (
              <li class="rounded-lg border border-border bg-muted/30 p-3 text-muted-foreground">
                <EvidenceText text={criterion} />
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby={`${evaluationCase.id}-forbidden`}>
        <h3
          id={`${evaluationCase.id}-forbidden`}
          class="font-semibold"
        >
          What must not happen
        </h3>
        <ul class="mt-3 grid gap-3 text-sm leading-6">
          {
            evaluationCase.forbiddenCriteria.map(({ criterion }) => (
              <li class="rounded-lg border border-border bg-muted/30 p-3 text-muted-foreground">
                <EvidenceText text={criterion} />
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section
      class:list={['mt-6 rounded-xl border p-4 sm:p-5', resultClass]}
      aria-labelledby={`${evaluationCase.id}-result`}
    >
      <h3
        id={`${evaluationCase.id}-result`}
        class="font-semibold"
      >
        {resultHeading}
      </h3>
      {
        evaluationCase.rationale === null ? (
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            This scenario remains pending because the recorded run stopped at an earlier failure.
          </p>
        ) : (
          <>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              <EvidenceText text={evaluationCase.rationale} />
            </p>
            <p class="mt-3 font-mono text-xs text-muted-foreground">
              Evaluated{' '}
              <time datetime={evaluationCase.evaluatedAt ?? undefined}>
                {evaluationCase.evaluatedAt}
              </time>
            </p>
            {evaluationCase.confirmationStatus !== 'not-required' && (
              <p class="mt-2 text-sm text-muted-foreground">
                Confirmation status: {evaluationCase.confirmationStatus}. Recorded trials:{' '}
                {evaluationCase.trials.length}.
              </p>
            )}
          </>
        )
      }
    </section>
  </div>
</details>
