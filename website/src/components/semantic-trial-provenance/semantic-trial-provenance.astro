---
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

import type { ISemanticAttemptTrialModel } from '../../lib/semantic-evaluation/index.ts';
import EvidenceStatus from '../evidence-status/evidence-status.astro';

interface Props {
  scenarioId: string;
  trials: ISemanticAttemptTrialModel[];
}

const { scenarioId, trials } = Astro.props;
---

<section
  class="mt-6"
  aria-labelledby={`${scenarioId}-trial-provenance`}
>
  <h4
    id={`${scenarioId}-trial-provenance`}
    class="font-semibold"
  >
    Trial provenance
  </h4>
  <ol class="mt-3 grid gap-3">
    {
      trials.map((trial) => (
        <li class="rounded-xl border border-border bg-muted/30 p-4">
          <div class="flex flex-wrap items-center gap-2">
            <EvidenceStatus status={trial.passed ? 'passed' : 'failed'} />
            <span class="font-mono text-xs font-bold text-muted-foreground">
              {trial.kind === 'initial'
                ? 'Initial trial'
                : `Confirmation ${trial.confirmationIndex}`}
            </span>
          </div>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            <InlineBrandText
              text={trial.rationale}
              variant="compact"
            />
          </p>
          <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-muted-foreground">Actor host</dt>
              <dd class="mt-1 font-mono text-xs break-all">{trial.actorHost.version}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Judge host</dt>
              <dd class="mt-1 font-mono text-xs break-all">{trial.judgeHost.version}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Completed commands</dt>
              <dd class="mt-1 font-mono text-xs break-all">
                {trial.actorCommandPolicyEvidence.completedCommandCount}
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">moldea CLI use</dt>
              <dd class="mt-1">
                {trial.actorResourceEvidence.commandCount} commands,{' '}
                {trial.actorResourceEvidence.stdoutByteCount} stdout bytes,{' '}
                {trial.actorResourceEvidence.modelVisibleToolOutputByteCount} model-visible bytes
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Largest moldea response</dt>
              <dd class="mt-1 font-mono text-xs break-all">
                {trial.actorResourceEvidence.maximumInvocationByteCount} bytes
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Expected labels observed</dt>
              <dd class="mt-1">
                {trial.observed.length === 0 ? (
                  'None'
                ) : (
                  <ul class="grid gap-1">
                    {trial.observed.map((label) => (
                      <li>
                        <code class="text-xs break-all">{label}</code>
                      </li>
                    ))}
                  </ul>
                )}
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Forbidden labels triggered</dt>
              <dd class="mt-1">
                {trial.forbidden.length === 0 ? (
                  'None'
                ) : (
                  <ul class="grid gap-1">
                    {trial.forbidden.map((label) => (
                      <li>
                        <code class="text-xs break-all">{label}</code>
                      </li>
                    ))}
                  </ul>
                )}
              </dd>
            </div>
          </dl>
          <p class="mt-3 font-mono text-xs text-muted-foreground">
            Evaluated <time datetime={trial.evaluatedAt}>{trial.evaluatedAt}</time>
          </p>
        </li>
      ))
    }
  </ol>
</section>
