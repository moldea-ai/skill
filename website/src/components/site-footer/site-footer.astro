---
import { ExternalLink } from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import SiteFooterShell from '@moldea.ai/website-ui/site-footer';
import { withBase } from '@moldea.ai/website-ui/site';

import {
  CLOUD_WEBSITE_URL,
  PACKAGES_WEBSITE_URL,
  RELEASES_URL,
  SKILLS_DIRECTORY_URL,
  SOURCE_REPOSITORY_URL,
} from '../../lib/model/constants.ts';
import Logo from '../logo/logo.astro';

const basePath = import.meta.env.BASE_URL;
---

<SiteFooterShell hasTopSpacing={false}>
  <div slot="brand">
    <Logo />
    <p class="mt-4 text-sm leading-6 text-muted-foreground">
      Git-owned project context and grounded agent behavior, maintained by the coding agent you
      already use.
    </p>
  </div>
  <nav
    slot="primary-navigation"
    class="grid content-start gap-3 text-sm"
    aria-label="Explore"
  >
    <p class="font-bold">Explore</p>
    <a
      class="text-muted-foreground hover:text-foreground"
      href={withBase('/capabilities/', basePath)}
      >Capabilities</a
    >
    <a
      class="text-muted-foreground hover:text-foreground"
      href={withBase('/how-it-works/', basePath)}
      >How it works</a
    >
    <a
      class="text-muted-foreground hover:text-foreground"
      href={withBase('/evidence/', basePath)}
      >Evidence</a
    >
    <a
      class="text-muted-foreground hover:text-foreground"
      href={withBase('/docs/', basePath)}
      >Docs</a
    >
    <a
      class="text-muted-foreground hover:text-foreground"
      href={withBase('/docs/getting-started/', basePath)}
      >Getting started</a
    >
    <a
      class="text-muted-foreground hover:text-foreground"
      href={withBase('/llms.txt', basePath)}
      >llms.txt</a
    >
  </nav>
  <nav
    slot="secondary-navigation"
    class="grid content-start gap-3 text-sm"
    aria-label="Project links"
  >
    <p class="font-bold"><InlineBrandText text="Get moldea" /></p>
    <a
      class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground"
      href={SKILLS_DIRECTORY_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      skills.sh
      <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      />
    </a>
    <a
      class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground"
      href={SOURCE_REPOSITORY_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
      <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      />
    </a>
    <a
      class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground"
      href={RELEASES_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      Releases
      <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      />
    </a>
    <a
      class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground"
      href={CLOUD_WEBSITE_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      Cloud
      <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      />
    </a>
    <a
      class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground"
      href={PACKAGES_WEBSITE_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      Packages
      <ExternalLink
        class="size-3.5"
        aria-hidden="true"
        data-external-link-icon
      />
    </a>
    <span class="text-muted-foreground">MIT licensed</span>
  </nav>
</SiteFooterShell>
