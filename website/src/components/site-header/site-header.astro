---
import { ExternalLink, GitFork, Menu, Search } from '@lucide/astro';

import { SKILLS_DIRECTORY_URL, SOURCE_REPOSITORY_URL } from '../../lib/model/constants.ts';
import { withBase } from '../../lib/site/url.ts';
import Logo from '../logo/logo.astro';
import ThemeControl from '../theme-control/theme-control.astro';

const navigation = [
  { href: '/docs/capabilities/', label: 'Capabilities' },
  { href: '/docs/how-it-works/', label: 'How it works' },
  { href: '/examples/', label: 'Examples' },
  { href: '/docs/', label: 'Docs' },
] as const;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/92 backdrop-blur-xl">
  <div class="page-shell flex min-h-16 items-center justify-between gap-4">
    <Logo />

    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Primary navigation"
    >
      {
        navigation.map(({ href, label }) => (
          <a
            class="rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-muted"
            href={withBase(href)}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        class="inline-flex size-10 items-center justify-center rounded-lg hover:bg-muted"
        href={withBase('/search/')}
        aria-label="Search documentation"
      >
        <Search
          class="size-4"
          aria-hidden="true"
        />
      </a>
      <a
        class="inline-flex size-10 items-center justify-center rounded-lg hover:bg-muted"
        href={SOURCE_REPOSITORY_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="moldea skill on GitHub"
      >
        <GitFork
          class="size-4"
          aria-hidden="true"
        />
      </a>
      <ThemeControl />
      <a
        class="ms-1 inline-flex min-h-10 items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-bold text-primary-foreground transition-all hover:bg-primary/80 active:translate-y-px motion-reduce:transition-none motion-reduce:active:translate-y-0 dark:hover:bg-primary/30"
        href={SKILLS_DIRECTORY_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-primary-action
      >
        Get the skill
        <ExternalLink
          class="size-3.5"
          aria-hidden="true"
        />
      </a>
    </div>

    <details class="group relative lg:hidden">
      <summary
        class="flex size-11 list-none items-center justify-center rounded-lg border border-input bg-background hover:bg-muted [&::-webkit-details-marker]:hidden"
        aria-label="Open navigation"
      >
        <Menu
          class="size-5"
          aria-hidden="true"
        />
      </summary>
      <div
        class="surface-card absolute end-0 top-13 w-[min(20rem,calc(100vw-2rem))] space-y-1 p-3 shadow-raised"
      >
        <nav
          class="grid gap-1"
          aria-label="Mobile navigation"
        >
          {
            navigation.map(({ href, label }) => (
              <a
                class="rounded-lg px-3 py-3 font-semibold hover:bg-muted"
                href={withBase(href)}
              >
                {label}
              </a>
            ))
          }
          <a
            class="rounded-lg px-3 py-3 font-semibold hover:bg-muted"
            href={withBase('/search/')}
          >
            Search
          </a>
          <a
            class="rounded-lg px-3 py-3 font-semibold hover:bg-muted"
            href={SOURCE_REPOSITORY_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Source on GitHub
          </a>
          <a
            class="mt-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-4 font-bold text-primary-foreground transition-all hover:bg-primary/80 active:translate-y-px motion-reduce:transition-none motion-reduce:active:translate-y-0 dark:hover:bg-primary/30"
            href={SKILLS_DIRECTORY_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-primary-action
          >
            Get the skill on skills.sh
            <ExternalLink
              class="size-3.5"
              aria-hidden="true"
            />
          </a>
        </nav>
        <div class="mt-3 border-t border-border pt-3">
          <ThemeControl />
        </div>
      </div>
    </details>
  </div>
</header>
