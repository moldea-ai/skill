---
import { ExternalLink } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import SiteHeaderShell from '@moldea.ai/website-ui/site-header';
import { isPublicRouteActive, withBase } from '@moldea.ai/website-ui/site';

import { SKILLS_DIRECTORY_URL, SOURCE_REPOSITORY_URL } from '../../lib/model/constants.ts';
import { THEME_STORAGE_KEY } from '../../lib/site/constants.ts';
import Logo from '../logo/logo.astro';

const navigation = [
  { href: '/docs/capabilities/', label: 'Capabilities' },
  { href: '/docs/how-it-works/', label: 'How it works' },
  { href: '/evidence/', label: 'Evidence' },
  { href: '/examples/', label: 'Examples' },
  { href: '/docs/', label: 'Docs' },
] as const;
const currentPathname = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL;
const activeNavigationRoute = navigation.reduce<string | undefined>(
  (activeRoute, { href }) =>
    isPublicRouteActive(currentPathname, href, basePath) &&
    (activeRoute === undefined || href.length > activeRoute.length)
      ? href
      : activeRoute,
  undefined,
);
const navigationItems = navigation.map(({ href, label }) => ({
  href: withBase(href, basePath),
  isActive: href === activeNavigationRoute,
  label,
}));
const searchHref = withBase('/search/', basePath);
const isSearchActive = isPublicRouteActive(currentPathname, '/search/', basePath);
---

<SiteHeaderShell
  breakpoint="lg"
  mobileNavigationAriaLabel="Mobile navigation"
  {navigationItems}
  searchAriaLabel="Search documentation"
  {searchHref}
  searchIsActive={isSearchActive}
  sourceAriaLabel="moldea skill on GitHub"
  sourceHref={SOURCE_REPOSITORY_URL}
  themeStorageKey={THEME_STORAGE_KEY}
>
  <Logo slot="brand" />
  <ActionLink
    slot="desktop-actions"
    class="ms-1 font-bold"
    href={SKILLS_DIRECTORY_URL}
    size="md"
    target="_blank"
    rel="noopener noreferrer"
    data-primary-action
  >
    Get the skill
    <ExternalLink
      class="size-3.5"
      aria-hidden="true"
    />
  </ActionLink>
  <ActionLink
    slot="mobile-actions"
    class="mt-2 w-full font-bold"
    href={SKILLS_DIRECTORY_URL}
    size="lg"
    target="_blank"
    rel="noopener noreferrer"
    data-primary-action
  >
    Get the skill on skills.sh
    <ExternalLink
      class="size-3.5"
      aria-hidden="true"
    />
  </ActionLink>
</SiteHeaderShell>
