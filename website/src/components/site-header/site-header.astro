---
import ActionLink from '@moldea.ai/website-ui/action-link';
import SiteHeaderShell from '@moldea.ai/website-ui/site-header';
import { isPublicRouteActive, withBase } from '@moldea.ai/website-ui/site';

import { SOURCE_REPOSITORY_URL } from '../../lib/model/constants.ts';
import { THEME_STORAGE_KEY } from '../../lib/site/constants.ts';
import Logo from '../logo/logo.astro';

const navigation = [
  { activeRoutes: ['/capabilities/'], href: '/capabilities/', label: 'Capabilities' },
  { activeRoutes: ['/how-it-works/'], href: '/how-it-works/', label: 'How it works' },
  { activeRoutes: ['/evidence/'], href: '/evidence/', label: 'Evidence' },
  { activeRoutes: ['/docs/', '/examples/'], href: '/docs/', label: 'Docs' },
] as const;
const currentPathname = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL;
const navigationItems = navigation.map(({ activeRoutes, href, label }) => ({
  href: withBase(href, basePath),
  isActive: activeRoutes.some((route) => isPublicRouteActive(currentPathname, route, basePath)),
  label,
}));
const getStartedHref = withBase('/get-started/', basePath);
const searchHref = withBase('/search/', basePath);
const isSearchActive = isPublicRouteActive(currentPathname, '/search/', basePath);
---

<SiteHeaderShell
  breakpoint="lg"
  mobileNavigationAriaLabel="Mobile navigation"
  {navigationItems}
  searchAriaLabel="Search documentation"
  {searchHref}
  searchIsActive={isSearchActive}
  sourceAriaLabel="moldea skill on GitHub"
  sourceHref={SOURCE_REPOSITORY_URL}
  themeStorageKey={THEME_STORAGE_KEY}
>
  <Logo slot="brand" />
  <ActionLink
    slot="desktop-actions"
    class="ms-1 font-bold"
    href={getStartedHref}
    size="md"
    data-primary-action
  >
    Get started
  </ActionLink>
  <ActionLink
    slot="mobile-actions"
    class="mt-2 w-full font-bold"
    href={getStartedHref}
    size="lg"
    data-primary-action
  >
    Get started
  </ActionLink>
</SiteHeaderShell>
