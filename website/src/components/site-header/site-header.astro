---
import { ExternalLink, GitFork, Menu, Search } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import ThemeControl from '@moldea.ai/website-ui/theme-control';
import { isPublicRouteActive, withBase } from '@moldea.ai/website-ui/site';

import { SKILLS_DIRECTORY_URL, SOURCE_REPOSITORY_URL } from '../../lib/model/constants.ts';
import { THEME_STORAGE_KEY } from '../../lib/site/constants.ts';
import Logo from '../logo/logo.astro';

const navigation = [
  { href: '/docs/capabilities/', label: 'Capabilities' },
  { href: '/docs/how-it-works/', label: 'How it works' },
  { href: '/examples/', label: 'Examples' },
  { href: '/docs/', label: 'Docs' },
] as const;
const currentPathname = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL;
const activeNavigationRoute = navigation.reduce<string | undefined>(
  (activeRoute, { href }) =>
    isPublicRouteActive(currentPathname, href, basePath) &&
    (activeRoute === undefined || href.length > activeRoute.length)
      ? href
      : activeRoute,
  undefined,
);
const navigationItems = navigation.map(({ href, label }) => ({
  href: withBase(href, basePath),
  isActive: href === activeNavigationRoute,
  label,
}));
const searchHref = withBase('/search/', basePath);
const isSearchActive = isPublicRouteActive(currentPathname, '/search/', basePath);
---

<header class="sticky top-0 z-50 border-b border-border bg-background/92 backdrop-blur-xl">
  <div class="page-shell flex min-h-16 items-center justify-between gap-4">
    <Logo />

    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Primary navigation"
    >
      {
        navigationItems.map(({ href, isActive, label }) => (
          <a
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition-colors',
              isActive
                ? 'bg-secondary/70 font-bold text-foreground dark:bg-secondary/50'
                : 'font-semibold text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
            href={href}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <ActionLink
        class={isSearchActive ? 'bg-secondary/70 dark:bg-secondary/50' : ''}
        href={searchHref}
        size="icon"
        variant="ghost"
        aria-label="Search documentation"
        aria-current={isSearchActive ? 'page' : undefined}
      >
        <Search
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
      <ActionLink
        href={SOURCE_REPOSITORY_URL}
        size="icon"
        target="_blank"
        rel="noopener noreferrer"
        variant="ghost"
        aria-label="moldea skill on GitHub"
      >
        <GitFork
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
      <ThemeControl storageKey={THEME_STORAGE_KEY} />
      <ActionLink
        class="ms-1 font-bold"
        href={SKILLS_DIRECTORY_URL}
        size="md"
        target="_blank"
        rel="noopener noreferrer"
        data-primary-action
      >
        Get the skill
        <ExternalLink
          class="size-3.5"
          aria-hidden="true"
        />
      </ActionLink>
    </div>

    <details class="group relative lg:hidden">
      <summary
        class="flex size-11 list-none items-center justify-center rounded-lg border border-input bg-background hover:bg-muted [&::-webkit-details-marker]:hidden"
        aria-label="Open navigation"
      >
        <Menu
          class="size-5"
          aria-hidden="true"
        />
      </summary>
      <div
        class="surface-card absolute end-0 top-13 w-[min(20rem,calc(100vw-2rem))] space-y-1 p-3 shadow-raised"
      >
        <nav
          class="grid gap-1"
          aria-label="Mobile navigation"
        >
          {
            navigationItems.map(({ href, isActive, label }) => (
              <a
                class:list={[
                  'rounded-lg px-3 py-3 transition-colors',
                  isActive
                    ? 'bg-secondary/70 font-bold text-foreground dark:bg-secondary/50'
                    : 'font-semibold text-muted-foreground hover:bg-muted hover:text-foreground',
                ]}
                href={href}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
          <a
            class:list={[
              'rounded-lg px-3 py-3 transition-colors',
              isSearchActive
                ? 'bg-secondary/70 font-bold text-foreground dark:bg-secondary/50'
                : 'font-semibold text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
            href={searchHref}
            aria-current={isSearchActive ? 'page' : undefined}
          >
            Search
          </a>
          <a
            class="rounded-lg px-3 py-3 font-semibold hover:bg-muted"
            href={SOURCE_REPOSITORY_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Source on GitHub
          </a>
          <ActionLink
            class="mt-2 w-full font-bold"
            href={SKILLS_DIRECTORY_URL}
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
            data-primary-action
          >
            Get the skill on skills.sh
            <ExternalLink
              class="size-3.5"
              aria-hidden="true"
            />
          </ActionLink>
        </nav>
        <div class="mt-3 border-t border-border pt-3">
          <ThemeControl storageKey={THEME_STORAGE_KEY} />
        </div>
      </div>
    </details>
  </div>
</header>
