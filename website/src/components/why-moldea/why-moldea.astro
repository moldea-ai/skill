---
import { BookOpen, Link2, SearchCheck } from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

const benefits = [
  {
    icon: BookOpen,
    title: 'Context that carries over',
    description: 'Saved project rules and decisions give the next session a place to start.',
  },
  {
    icon: Link2,
    title: 'Connections you can follow',
    description:
      'A change to a rule points your coding agent to the instructions and code that depend on it.',
  },
  {
    icon: SearchCheck,
    title: 'Checks you can repeat',
    description:
      'Software verifies supported connections, independently of the coding agent’s judgment.',
  },
] as const;
---

<section
  id="why-moldea"
  class="scroll-mt-24 border-b border-border bg-background py-12 sm:py-16"
  aria-labelledby="why-moldea-title"
  data-why-moldea
>
  <div class="page-shell">
    <header class="grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-12">
      <h2
        id="why-moldea-title"
        class="section-title text-3xl font-semibold sm:text-4xl lg:text-5xl"
      >
        Can't my coding agent already do this?
      </h2>
      <p class="text-lg leading-8 text-muted-foreground">
        It can write the code. Your team still needs a way to preserve the context, track
        connections, and check them as the project changes.
      </p>
    </header>
    <ul
      class="mt-8 grid gap-7 sm:grid-cols-3 sm:gap-8"
      aria-label="What moldea adds"
    >
      {
        benefits.map(({ icon: Icon, title, description }) => (
          <li class="min-w-0">
            <Icon
              class="mb-3 size-5 text-muted-foreground"
              aria-hidden="true"
            />
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-7 text-sm leading-6 text-muted-foreground">
      <InlineBrandText
        text="You could build and maintain that system yourself. moldea gives your team one to start with."
      />
    </p>
  </div>
</section>
