---
import {
  ArrowRight,
  Bot,
  BrainCircuit,
  Braces,
  GitBranch,
  Link2,
  RefreshCw,
  Search,
} from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

const agentStrengths = [
  { icon: Search, title: 'Reads the repository' },
  { icon: BrainCircuit, title: 'Remembers useful context' },
  { icon: Braces, title: 'Builds the requested change' },
] as const;

const durableOutcomes = [
  {
    description:
      'Relevant project rules guide planning and development across supported coding agents.',
    icon: GitBranch,
    label: 'Project truth',
    title: 'The project owns the truth',
  },
  {
    description:
      'Declared relationships connect context to the instructions, code, and tests that need review.',
    icon: Link2,
    label: 'Explicit connections',
    title: 'Every connection is explicit',
  },
  {
    description: 'The same files produce the same result, with evidence the team can inspect.',
    icon: RefreshCw,
    label: 'Deterministic checks',
    title: 'Validation does not depend on memory',
  },
] as const;
---

<section
  id="why-moldea"
  class="scroll-mt-24 border-b border-border bg-secondary py-12 sm:py-16"
  aria-labelledby="why-moldea-title"
  data-why-moldea
>
  <div class="page-shell">
    <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-end">
      <div>
        <p class="eyebrow mb-4">Can't my coding agent already do this?</p>
        <h2
          id="why-moldea-title"
          class="section-title max-w-4xl"
        >
          Your coding agent can remember. Your project still needs a system.
        </h2>
      </div>
      <p class="text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
        <InlineBrandText
          text="moldea keeps reviewed project knowledge in Git, brings relevant context into the task, and checks declared connections to code."
        />
      </p>
    </header>

    <div
      class="-mx-4 mt-8 grid overflow-hidden border-y border-border bg-border sm:mx-0 sm:rounded-2xl sm:border sm:shadow-raised lg:grid-cols-[minmax(0,0.86fr)_4rem_minmax(0,1.14fr)]"
      data-why-moldea-comparison
    >
      <article
        class="dark-surface-selection flex min-w-0 flex-col bg-primary p-5 text-primary-foreground sm:p-7"
      >
        <div class="flex items-center gap-3">
          <span
            class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary-foreground/10"
          >
            <Bot
              class="size-5"
              aria-hidden="true"
            />
          </span>
          <div>
            <p class="text-xs font-semibold tracking-[0.12em] text-primary-foreground/60 uppercase">
              What coding agents already do
            </p>
            <h3 class="mt-1 text-lg font-semibold">Capable work inside the session</h3>
          </div>
        </div>

        <ul
          class="mt-6 grid border-y border-primary-foreground/15"
          aria-label="What coding agents already do"
        >
          {
            agentStrengths.map(({ icon: StrengthIcon, title }) => (
              <li class="flex items-center gap-3 border-b border-primary-foreground/15 py-4 last:border-b-0">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary-foreground/10">
                  <StrengthIcon
                    class="size-4"
                    aria-hidden="true"
                  />
                </span>
                <span class="text-sm font-semibold">{title}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-auto pt-6 text-sm leading-6 text-primary-foreground/65">
          Memory makes this work faster and better informed.
        </p>
      </article>

      <div
        class="flex items-center justify-center bg-background py-3 lg:py-0"
        aria-hidden="true"
      >
        <span
          class="inline-flex size-9 rotate-90 items-center justify-center rounded-full border border-border bg-background shadow-surface lg:rotate-0"
        >
          <ArrowRight class="size-4" />
        </span>
      </div>

      <div class="min-w-0 bg-background">
        <div class="border-b border-border p-5 sm:px-6 sm:py-5">
          <p class="eyebrow">What the project still needs</p>
          <p class="mt-1 text-lg font-semibold">Rules and proof the team can inspect</p>
        </div>
        <ol
          class="divide-y divide-border"
          aria-label="What the skill adds"
        >
          {
            durableOutcomes.map(({ description, icon: OutcomeIcon, label, title }) => (
              <li class="grid min-w-0 grid-cols-[2.5rem_minmax(0,1fr)] gap-x-4 p-5 sm:p-6">
                <span class="row-span-3 inline-flex size-10 items-center justify-center rounded-xl bg-muted">
                  <OutcomeIcon
                    class="size-5"
                    aria-hidden="true"
                  />
                </span>
                <p class="eyebrow">{label}</p>
                <h3 class="mt-1 font-semibold">{title}</h3>
                <p class="mt-1 text-sm leading-6 text-muted-foreground">{description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <p class="mt-6 max-w-4xl text-sm leading-6 text-muted-foreground">
      <InlineBrandText
        text="Start with durable context for ordinary software work. Add runtime agents and reusable skills when your project needs them."
      />
    </p>
  </div>
</section>
