---
import { renderMarkdownDocument } from '@moldea.ai/website-ui/markdown';

import DocumentationContent from '../../components/documentation-content/documentation-content.astro';
import DocumentationPage from '../../components/documentation-page/documentation-page.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { createDocumentationBreadcrumbs } from '../../lib/documentation-navigation/index.ts';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import type { IWebsiteDocument } from '../../lib/model/types.ts';

interface Props {
  document: IWebsiteDocument;
}

export const getStaticPaths = () => {
  const model = loadWebsiteModel();

  return model.documents
    .filter(({ route }) => route.startsWith('/docs/'))
    .map((document) => ({
      params: { path: document.slug || undefined },
      props: { document },
    }));
};

const { document } = Astro.props;
const model = loadWebsiteModel();
const rendered = await renderMarkdownDocument(document.markdown, {
  basePath: import.meta.env.BASE_URL,
  conversations: true,
  strongLabelBadges:
    document.route === '/docs/limitations/'
      ? [
          { id: 'result-completed', label: 'Completed', tone: 'info' },
          { id: 'result-error', label: 'Error', tone: 'danger' },
          { id: 'result-not-checked', label: 'Not checked', tone: 'warning' },
          { id: 'result-unfinished', label: 'Unfinished', tone: 'neutral' },
        ]
      : [],
});
// the installed renderer labels table regions generically; distinguish this guide’s three tables
const tableLabels = ['Result meanings', 'Common situations', 'Resource boundaries'];
let tableIndex = 0;
const blocks = rendered.blocks.map((block) =>
  document.route === '/docs/limitations/' && block.kind === 'html'
    ? {
        ...block,
        html: block.html.replaceAll('aria-label="Scrollable table"', () => {
          const label = tableLabels[tableIndex++];
          if (label === undefined)
            throw new Error('The limitations guide has an unlabelled table.');
          return `aria-label="${label}"`;
        }),
      }
    : block,
);
const breadcrumbs = createDocumentationBreadcrumbs(document);
---

<BaseLayout
  title={document.title}
  description={document.description}
  {breadcrumbs}
>
  <DocumentationPage
    {breadcrumbs}
    currentDocument={document}
    headings={rendered.headings}
    navigation={model.navigation}
    orderedDocuments={model.documents}
    skill={model.skill}
  >
    <DocumentationContent
      class={document.route === '/docs/limitations/' ? '[&_table]:min-w-xl' : ''}
      {blocks}
    />
  </DocumentationPage>
</BaseLayout>
