---
import { FlaskConical, PanelsTopLeft } from '@lucide/astro';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';

import EvidenceOptionCard from '../../components/evidence-option-card/evidence-option-card.astro';
import ReleaseEvidenceNotice from '../../components/release-evidence-notice/release-evidence-notice.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import {
  getQualificationReleaseEvidenceSummary,
  getSemanticReleaseEvidenceSummary,
} from '../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const { qualification, semanticEvaluation } = model;
const basePath = import.meta.env.BASE_URL;
const semanticReleaseSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  model.currentSemanticAssurance,
);
const successfulSemanticCaseCount =
  (semanticReleaseSummary.result?.passedCaseCount ?? 0) +
  (semanticReleaseSummary.result?.recoveredCaseCount ?? 0);
const qualificationSummaries = qualification.profiles.map(getQualificationReleaseEvidenceSummary);
const qualificationStatuses = qualificationSummaries.map(({ status }) => status);
const qualificationStatus = qualificationStatuses.includes('errored')
  ? 'errored'
  : qualificationStatuses.includes('failed')
    ? 'failed'
    : qualificationStatuses.includes('incomplete')
      ? 'incomplete'
      : qualificationStatuses.includes('not-recorded')
        ? 'not-recorded'
        : 'passed';
const qualifiedProfileCount = qualification.profiles.filter(
  (_, index) => qualificationSummaries[index]?.status === 'passed',
).length;
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Evidence' }];
---

<BaseLayout
  title="Evidence"
  description="Choose between behavioral semantic evaluation and real-project adapter qualification evidence."
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />

    <ReleaseEvidenceNotice evidence={model.releaseEvidence} />

    <header class="mt-7 border-b border-border pb-10">
      <p class="eyebrow mb-4">Tested before release</p>
      <h1 class="section-title max-w-5xl font-semibold">Choose the evidence you need.</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
        Semantic evaluation answers whether the skill behaves correctly across difficult situations.
        Qualification answers whether the published packages, adapter, CLI, and skill work together
        in realistic projects. Each card shows the evidence accepted for this release and identifies
        whether it is fresh current-contract evidence or a verified source retained by an explicit
        release pin.
      </p>
    </header>

    <section
      class="grid gap-5 py-12 lg:grid-cols-2"
      aria-label="Evidence types"
    >
      <EvidenceOptionCard
        title="Semantic evaluation"
        description="Review the behavioral scenarios, exact success and failure criteria, and evidence-based rationale for every current-contract outcome."
        href={semanticEvaluation.route}
        metric={`${successfulSemanticCaseCount} of ${semanticEvaluation.caseCount} scenarios have verified release evidence`}
        status={semanticReleaseSummary.result?.status ?? 'not-recorded'}
        questions={[
          'Does the skill make the right decision when context is incomplete or conflicting?',
          'Does it respect repository truth, host constraints, and safety boundaries?',
        ]}
      >
        <FlaskConical
          slot="icon"
          class="size-5"
          aria-hidden="true"
        />
      </EvidenceOptionCard>

      <EvidenceOptionCard
        title="Adapter qualification"
        description="Review realistic project journeys, compatibility claims, deterministic checks, independent judgment, and raw attempt artifacts."
        href={qualification.route}
        metric={`${qualifiedProfileCount} of ${qualification.profiles.length} profiles have passing release evidence`}
        status={qualificationStatus}
        questions={[
          'Does this adapter implementation work with the exact published package artifacts?',
          'Which project journeys and compatibility claims were exercised end to end?',
        ]}
      >
        <PanelsTopLeft
          slot="icon"
          class="size-5"
          aria-hidden="true"
        />
      </EvidenceOptionCard>
    </section>
  </div>
</BaseLayout>
