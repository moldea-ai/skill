---
import { ArrowDown, ArrowRight, ShieldCheck } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import ResultSummary from '@moldea.ai/website-ui/result-summary';
import { withBase } from '@moldea.ai/website-ui/site';
import StatusBadge from '@moldea.ai/website-ui/status-badge';

import EvidenceStatus from '../../../../../components/evidence-status/evidence-status.astro';
import QualificationCaseEvidence from '../../../../../components/qualification-case-evidence/qualification-case-evidence.astro';
import QualificationProfileTechnical from '../../../../../components/qualification-profile-technical/qualification-profile-technical.astro';
import BaseLayout from '../../../../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../../../../lib/generation/generation.ts';
import type {
  IQualificationAttemptCaseModel,
  IQualificationAttemptModel,
  IQualificationProfileCaseModel,
  IQualificationProfileModel,
} from '../../../../../lib/qualification/index.ts';
import { getQualificationReleaseEvidenceSummary } from '../../../../../lib/release-evidence/index.ts';

interface Props {
  profile: IQualificationProfileModel;
}

interface IEffectiveJourney {
  evidence: IQualificationAttemptCaseModel;
  origin: string;
  profileCase: IQualificationProfileCaseModel;
}

export const getStaticPaths = () => {
  return loadWebsiteModel().qualification.profiles.map((profile) => ({
    params: {
      adapterId: profile.adapterId,
      implementationId: profile.implementationId,
    },
    props: { profile },
  }));
};

const { profile } = Astro.props;
const { releaseEvidence } = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const releaseSummary = getQualificationReleaseEvidenceSummary(profile);
const isCustomProfile = profile.adapterId === 'custom' && profile.implementationId === 'custom';
const effectiveAttempts: IQualificationAttemptModel[] =
  profile.currentAssurance === null
    ? profile.currentLatest === null
      ? []
      : [profile.currentLatest]
    : profile.currentAssurance.baselineAttempt === null
      ? [profile.currentAssurance.directAttempt]
      : [profile.currentAssurance.baselineAttempt, profile.currentAssurance.directAttempt];

const pairAttemptWithDefinitions = (
  attempt: IQualificationAttemptModel,
  profileCases: IQualificationProfileCaseModel[],
  origin: string,
): IEffectiveJourney[] => {
  const profileCasesById = new Map(
    profileCases.map((profileCase) => [profileCase.id, profileCase]),
  );
  return attempt.cases.map((evidence) => {
    const profileCase = profileCasesById.get(evidence.result.caseId);
    if (profileCase === undefined) {
      throw new Error(`Qualification case ${evidence.result.caseId} has no profile definition.`);
    }
    return { evidence, origin, profileCase };
  });
};

const effectiveJourneys: IEffectiveJourney[] =
  profile.currentAssurance?.baselineAttempt === null ||
  profile.currentAssurance?.baselineAttempt === undefined
    ? effectiveAttempts.flatMap((attempt) =>
        pairAttemptWithDefinitions(
          attempt,
          profile.cases,
          isCustomProfile ? 'Core behavior' : 'Adapter-specific',
        ),
      )
    : [
        ...pairAttemptWithDefinitions(
          profile.currentAssurance.baselineAttempt,
          profile.sharedCases,
          'Shared foundation',
        ),
        ...pairAttemptWithDefinitions(
          profile.currentAssurance.directAttempt,
          profile.cases,
          'Adapter-specific',
        ),
      ];
const successfulJourneyCount = effectiveJourneys.filter(
  ({ evidence }) => evidence.result.status === 'passed' || evidence.result.status === 'recovered',
).length;
const recoveredJourneyCount = effectiveJourneys.filter(
  ({ evidence }) => evidence.result.status === 'recovered',
).length;
const resultTone =
  releaseSummary.status === 'passed'
    ? 'success'
    : releaseSummary.status === 'failed' || releaseSummary.status === 'errored'
      ? 'danger'
      : 'warning';
const resultTitle =
  releaseSummary.status === 'passed'
    ? 'Qualification passed'
    : releaseSummary.status === 'failed'
      ? 'Qualification failed'
      : releaseSummary.status === 'errored'
        ? 'Evidence unavailable'
        : releaseSummary.status === 'not-recorded'
          ? 'No release result'
          : 'Result incomplete';
const resultStatusLabel =
  releaseSummary.status === 'passed'
    ? 'Verified'
    : releaseSummary.status === 'failed'
      ? 'Failed'
      : releaseSummary.status === 'errored'
        ? 'Unavailable'
        : 'Review';
const resultDescription =
  releaseSummary.status === 'passed'
    ? `All ${effectiveJourneys.length} project journeys reached the expected result.`
    : effectiveJourneys.length === 0
      ? 'No complete project result is available for this integration.'
      : `${successfulJourneyCount} of ${effectiveJourneys.length} project journeys reached the expected result.`;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { href: '/evidence/qualification/', label: 'Qualification' },
  { label: profile.title },
];
---

<BaseLayout
  title={profile.title}
  description={`Follow the complete project journeys and verified result for ${profile.title}.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="relative mt-6 overflow-hidden border-y border-border">
    <HeroBackdrop />
    <div class="page-shell relative py-14 sm:py-18 lg:py-20">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3">
          <EvidenceStatus status={releaseSummary.status} />
          <span class="text-sm font-semibold text-muted-foreground">
            {successfulJourneyCount}/{effectiveJourneys.length} journeys verified
          </span>
        </div>
        <p class="eyebrow mt-6 mb-4">Complete qualification result</p>
        <h1 class="section-title font-semibold">{profile.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
          <InlineBrandText
            text={profile.description}
            variant="compact"
          />
        </p>
        <p class="mt-3 max-w-3xl leading-7 text-muted-foreground">
          Open any journey to follow the developer request, coding-agent work, project changes, and
          independent verdict in one place.
        </p>
        <ActionLink
          class="mt-7 font-bold"
          href="#qualification-journeys"
          variant="primary"
        >
          Follow the journeys
          <ArrowDown
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>

      <div class="mt-9 grid max-w-4xl gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <p class="text-xs font-semibold text-muted-foreground">Project journeys</p>
          <p class="mt-2 font-mono text-2xl font-bold">{effectiveJourneys.length}</p>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <p class="text-xs font-semibold text-muted-foreground">Verified results</p>
          <p class="mt-2 font-mono text-2xl font-bold">{successfulJourneyCount}</p>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <p class="text-xs font-semibold text-muted-foreground">Recovered after confirmation</p>
          <p class="mt-2 font-mono text-2xl font-bold">{recoveredJourneyCount}</p>
        </div>
      </div>
    </div>
  </header>

  <div class="page-shell">
    <section
      id="qualification-journeys"
      class="scroll-mt-24 py-12"
      aria-labelledby="qualification-journeys-title"
    >
      <div class="grid gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(18rem,0.45fr)] lg:items-end">
        <div>
          <p class="eyebrow mb-3">The proof</p>
          <h2
            id="qualification-journeys-title"
            class="text-3xl font-semibold tracking-tight"
          >
            What happened in every project
          </h2>
        </div>
        <ResultSummary
          title={resultTitle}
          description={resultDescription}
          tone={resultTone}
        >
          <ShieldCheck
            slot="icon"
            class="size-5"
            aria-hidden="true"
          />
          <StatusBadge
            slot="status"
            label={resultStatusLabel}
            size="sm"
            tone={resultTone}
          />
        </ResultSummary>
      </div>

      {
        effectiveJourneys.length === 0 ? (
          <div class="mt-8 rounded-xl border border-dashed border-border bg-muted/30 p-6">
            <p class="font-semibold">No complete journey evidence is available.</p>
            <p class="mt-2 max-w-3xl leading-7 text-muted-foreground">
              The profile contract remains inspectable in the technical details below.
            </p>
          </div>
        ) : (
          <div class="mt-8 grid gap-3">
            {effectiveJourneys.map(({ evidence, origin, profileCase }, index) => (
              <QualificationCaseEvidence
                evidence={evidence}
                number={index + 1}
                origin={origin}
                profileCase={profileCase}
              />
            ))}
          </div>
        )
      }
    </section>

    <section
      class="border-t border-border py-12"
      aria-labelledby="qualification-technical-title"
    >
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">For technical review</p>
        <h2
          id="qualification-technical-title"
          class="text-3xl font-semibold tracking-tight"
        >
          Exact source and methodology
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          Open these details for package versions, source commits, model configuration,
          compatibility coverage, and immutable artifacts.
        </p>
      </div>
      <div class="mt-7">
        <QualificationProfileTechnical
          attempts={effectiveAttempts}
          {profile}
          {releaseEvidence}
        />
      </div>
      <ActionLink
        class="mt-7 font-bold"
        href={withBase('/docs/adapter-qualification/', basePath)}
        variant="link"
      >
        Read the complete methodology
        <ArrowRight
          class="size-4"
          aria-hidden="true"
        />
      </ActionLink>
    </section>
  </div>
</BaseLayout>
