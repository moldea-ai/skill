---
import QualificationProfilePage from '../../../../../components/qualification-profile-page/qualification-profile-page.astro';
import { loadWebsiteModel } from '../../../../../lib/generation/generation.ts';
import type { IQualificationProfileModel } from '../../../../../lib/qualification/index.ts';

interface Props {
  profile: IQualificationProfileModel;
}
export const getStaticPaths = () =>
  loadWebsiteModel().qualification.profiles.map((profile) => ({
    params: { adapterId: profile.adapterId, implementationId: profile.implementationId },
    props: { profile },
  }));
const { profile } = Astro.props;
---

<QualificationProfilePage {profile} />
