---
import { ArrowRight, ExternalLink, FileCheck, GitCompareArrows, Scale } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import EvidenceStatus from '../../../components/evidence-status/evidence-status.astro';
import QualificationText from '../../../components/qualification-text/qualification-text.astro';
import BaseLayout from '../../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../../lib/generation/generation.ts';
import { SOURCE_REPOSITORY_URL } from '../../../lib/model/constants.ts';

const model = loadWebsiteModel();
const { qualification } = model;
const basePath = import.meta.env.BASE_URL;
const profileCount = qualification.profiles.length;
const attemptCount = qualification.profiles.reduce(
  (total, profile) => total + profile.attempts.length,
  0,
);
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { label: 'Qualification' },
];
const evidenceLayers = [
  {
    description:
      'Every behavior-affecting compatibility claim must map to one or more transparent project cases.',
    icon: GitCompareArrows,
    title: 'Matrix coverage',
  },
  {
    description:
      'Repository readers, Core, CLI, package provenance, typechecking, and workspace integrity run before and after the actor.',
    icon: FileCheck,
    title: 'Deterministic verification',
  },
  {
    description:
      'A fixed actor using a balanced-tier model completes the natural task, and an independent judge using the same configuration evaluates a read-only copy against explicit requirements.',
    icon: Scale,
    title: 'Semantic judgment',
  },
] as const;
---

<BaseLayout
  title="Adapter qualification"
  description="Inspect the transparent adapter support gate, exact project profiles, complete attempt history, and raw committed evidence."
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />

    <header class="mt-7 border-b border-border pb-10">
      <p class="eyebrow mb-4">Transparent support gate</p>
      <h1 class="display-title max-w-5xl font-semibold">Adapter qualification evidence</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
        Realistic projects exercise exact published package artifacts, the portable skill,
        deterministic repository behavior, and separate actor and judge stages using a balanced-tier
        model. Profiles and every recorded outcome remain inspectable in Git.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <ActionLink
          class="font-bold"
          href={withBase('/docs/adapter-qualification/', basePath)}
          size="lg"
        >
          Read the methodology
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={`${SOURCE_REPOSITORY_URL}/tree/main/qualification`}
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >
          Inspect qualification source
          <ExternalLink
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </header>

    <section
      class="py-12"
      aria-labelledby="qualification-profiles-title"
    >
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3">Committed profiles</p>
          <h2
            id="qualification-profiles-title"
            class="section-title font-semibold"
          >
            Evidence by implementation
          </h2>
        </div>
        <p class="text-sm text-muted-foreground">
          {
            `${profileCount} ${profileCount === 1 ? 'profile' : 'profiles'} · ${attemptCount} recorded ${attemptCount === 1 ? 'attempt' : 'attempts'}`
          }
        </p>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        {
          qualification.profiles.map((profile) => (
            <a
              class="surface-card interactive-card flex min-w-0 flex-col p-5 sm:p-6"
              href={withBase(profile.route, basePath)}
            >
              <div class="flex flex-wrap items-center gap-2">
                <EvidenceStatus status={profile.latest?.latestStatus ?? 'not-recorded'} />
                <code class="text-xs text-muted-foreground">
                  {profile.adapterId}/{profile.implementationId}
                </code>
              </div>
              <h3 class="mt-5 text-2xl font-semibold tracking-tight">{profile.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-muted-foreground">
                <QualificationText text={profile.description} />
              </p>
              <dl class="mt-6 grid grid-cols-3 gap-3 border-t border-border pt-4 text-sm">
                <div>
                  <dt class="text-muted-foreground">Projects</dt>
                  <dd class="mt-1 font-mono font-bold">{profile.cases.length}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground">Claims</dt>
                  <dd class="mt-1 font-mono font-bold">{profile.probes.length}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground">Attempts</dt>
                  <dd class="mt-1 font-mono font-bold">{profile.attempts.length}</dd>
                </div>
              </dl>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-link">
                Inspect profile and history
                <ArrowRight
                  class="size-4"
                  aria-hidden="true"
                />
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      class="border-y border-border py-12"
      aria-labelledby="qualification-layers-title"
    >
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">One gate, three evidence layers</p>
        <h2
          id="qualification-layers-title"
          class="section-title font-semibold"
        >
          A pass requires the complete system to agree.
        </h2>
      </div>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {
          evidenceLayers.map(({ description, icon: LayerIcon, title }, index) => (
            <li class="surface-card p-5 sm:p-6">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted">
                  <LayerIcon
                    class="size-5"
                    aria-hidden="true"
                  />
                </span>
                <span class="font-mono text-xs font-bold text-muted-foreground">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-5 text-lg font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="py-12">
      <div
        class="surface-card grid gap-5 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
      >
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">Everything shown here passed.</h2>
          <p class="mt-3 max-w-3xl leading-7 text-muted-foreground">
            Website generation requires every current profile to point to a complete passing
            attempt. Each result still links to its raw committed artifacts so you can inspect the
            conclusion instead of taking it on trust.
          </p>
        </div>
        <ActionLink
          class="font-bold"
          href={withBase('/docs/adapter-qualification/#attempts-and-status', basePath)}
          variant="outline"
        >
          Read the methodology
          <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </section>
  </div>
</BaseLayout>
