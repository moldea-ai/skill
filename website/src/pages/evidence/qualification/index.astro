---
import { ArrowRight, Bot, ExternalLink, FileCheck, FolderGit2, Scale } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCompanyLogo from '../../../components/adapter-company-logo/adapter-company-logo.astro';
import EvidenceStatus from '../../../components/evidence-status/evidence-status.astro';
import BaseLayout from '../../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../../lib/generation/generation.ts';
import { SOURCE_REPOSITORY_URL } from '../../../lib/model/constants.ts';
import { getQualificationReleaseEvidenceSummary } from '../../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const { qualification } = model;
const basePath = import.meta.env.BASE_URL;
const profilesWithSummary = qualification.profiles.map((profile) => ({
  profile,
  summary: getQualificationReleaseEvidenceSummary(profile),
}));
const qualifiedProfileCount = profilesWithSummary.filter(
  ({ summary }) => summary.status === 'passed',
).length;
const adapterCount = qualification.profiles.filter(
  ({ adapterId }) => adapterId !== 'custom',
).length;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { label: 'Qualification' },
];
const proofSteps = [
  {
    description: 'A coding agent receives an ordinary task inside a realistic repository.',
    icon: FolderGit2,
    title: 'Start with a real project',
  },
  {
    description: 'The exact published skill, tools, packages, and integration complete the work.',
    icon: Bot,
    title: 'Run the complete system',
  },
  {
    description:
      'Project checks and a separate judge confirm what changed and whether it is right.',
    icon: Scale,
    title: 'Verify the result',
  },
] as const;
---

<BaseLayout
  title="Adapter qualification evidence"
  description="Explore realistic project journeys that prove moldea works with each supported coding-agent integration."
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="relative mt-6 overflow-hidden border-y border-border">
    <HeroBackdrop />
    <div class="page-shell relative py-14 sm:py-18 lg:py-20">
      <div class="max-w-4xl">
        <p class="eyebrow mb-4">Real projects, complete system</p>
        <h1 class="section-title font-semibold">Adapter qualification</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
          Every supported integration must help a coding agent complete realistic project work.
          Follow each journey from the developer request through the code changes and independent
          verdict.
        </p>
      </div>
      <dl class="mt-9 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Integrations verified</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">
            {qualifiedProfileCount}/{qualification.profiles.length}
          </dd>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Unique projects</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{qualification.uniqueJourneyCount}</dd>
        </div>
        <div
          class="col-span-2 rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm sm:col-span-1"
        >
          <dt class="text-xs font-semibold text-muted-foreground">Supported adapters</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{adapterCount}</dd>
        </div>
      </dl>
    </div>
  </header>

  <div class="page-shell">
    <section
      class="py-12"
      aria-labelledby="qualification-profiles-title"
    >
      <div class="grid gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(18rem,0.45fr)] lg:items-end">
        <div>
          <p class="eyebrow mb-3">Choose an integration</p>
          <h2
            id="qualification-profiles-title"
            class="text-3xl font-semibold tracking-tight"
          >
            Open one result. See every journey.
          </h2>
        </div>
        <p class="leading-7 text-muted-foreground lg:justify-self-end">
          Adapter results combine 12 shared <code class="inline-code">moldea</code> journeys with 2 integration-specific
          journeys. Custom shows the 12 shared journeys directly.
        </p>
      </div>

      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {
          profilesWithSummary.map(({ profile, summary }) => {
            const journeyCount = profile.sharedCases.length + profile.cases.length;
            return (
              <a
                class="surface-card interactive-card group flex min-w-0 flex-col p-5 sm:p-6"
                href={withBase(profile.route, basePath)}
              >
                <div class="flex items-start justify-between gap-3">
                  <AdapterCompanyLogo adapterId={profile.adapterId} />
                  <EvidenceStatus status={summary.status} />
                </div>
                <h3 class="mt-5 text-2xl font-semibold tracking-tight">{profile.title}</h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-muted-foreground">
                  {profile.adapterId === 'custom'
                    ? 'Universal repository behavior, tested without depending on a provider SDK.'
                    : 'The complete shared foundation plus the code paths unique to this integration.'}
                </p>
                <dl class="mt-6 grid grid-cols-2 gap-3 border-t border-border pt-4 text-sm">
                  <div>
                    <dt class="text-muted-foreground">Project journeys</dt>
                    <dd class="mt-1 font-mono text-lg font-bold">{journeyCount}</dd>
                  </div>
                  <div>
                    <dt class="text-muted-foreground">Verified</dt>
                    <dd class="mt-1 font-mono text-lg font-bold">
                      {summary.status === 'passed' ? journeyCount : 0}/{journeyCount}
                    </dd>
                  </div>
                </dl>
                <span class="mt-5 inline-flex items-center gap-2 text-link font-semibold">
                  Follow the journeys
                  <ArrowRight
                    class="size-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none motion-reduce:transition-none"
                    aria-hidden="true"
                  />
                </span>
              </a>
            );
          })
        }
      </div>
      <p class="mt-5 text-xs leading-5 text-muted-foreground">
        Company names and marks belong to their respective owners. Compatibility does not imply
        endorsement.
      </p>
    </section>

    <section
      class="border-y border-border py-12"
      aria-labelledby="qualification-proof-title"
    >
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">What a passing result means</p>
        <h2
          id="qualification-proof-title"
          class="text-3xl font-semibold tracking-tight"
        >
          More than a package check.
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          Qualification tests the experience a developer depends on, not one isolated library.
        </p>
      </div>
      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        {
          proofSteps.map(({ description, icon: StepIcon, title }, index) => (
            <li class="surface-card p-5 sm:p-6">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted">
                  <StepIcon
                    class="size-5"
                    aria-hidden="true"
                  />
                </span>
                <span class="font-mono text-xs font-bold text-muted-foreground">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-5 text-lg font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="py-12">
      <details class="surface-card p-5 sm:p-6">
        <summary
          class="cursor-pointer font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          Methodology and technical source
        </summary>
        <div class="mt-5 border-t border-border pt-5">
          <p class="max-w-3xl leading-7 text-muted-foreground">
            The technical record includes the project matrix, deterministic checks, exact package
            versions, model configuration, immutable artifacts, and release provenance.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <ActionLink
              class="font-bold"
              href={withBase('/docs/adapter-qualification/', basePath)}
              variant="outline"
            >
              Read the methodology
              <FileCheck
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
            <ActionLink
              class="font-bold"
              href={`${SOURCE_REPOSITORY_URL}/tree/main/qualification`}
              target="_blank"
              rel="noopener noreferrer"
              variant="outline"
            >
              Inspect qualification source
              <ExternalLink
                class="size-4"
                aria-hidden="true"
              />
            </ActionLink>
          </div>
        </div>
      </details>
    </section>
  </div>
</BaseLayout>
