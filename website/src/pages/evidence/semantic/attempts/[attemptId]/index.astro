---
import { ExternalLink } from '@lucide/astro';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';

import EvidenceStatus from '../../../../../components/evidence-status/evidence-status.astro';
import SemanticEvaluationCase from '../../../../../components/semantic-evaluation-case/semantic-evaluation-case.astro';
import BaseLayout from '../../../../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../../../../lib/generation/generation.ts';
import type { ISemanticAttemptModel } from '../../../../../lib/semantic-evaluation/index.ts';

interface Props {
  attempt: ISemanticAttemptModel;
}

export const getStaticPaths = () =>
  loadWebsiteModel().semanticEvaluation.attempts.map((attempt) => ({
    params: { attemptId: attempt.result.attemptId },
    props: { attempt },
  }));

const { attempt } = Astro.props;
const { releaseEvidence } = loadWebsiteModel();
const { result } = attempt;
const evaluationModel = result.hostContract.actor.model;
const basePath = import.meta.env.BASE_URL;
const successfulCaseCount = result.passedCaseCount + result.recoveredCaseCount;
const semanticReleaseSection =
  releaseEvidence.mode === 'recorded' ? releaseEvidence.semantic : null;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { href: '/evidence/semantic/', label: 'Semantic evaluation' },
  { label: result.attemptId },
];
---

<BaseLayout
  title={`Semantic attempt: ${result.attemptId}`}
  description={`Follow ${result.totalCaseCount} coding-agent decisions and the independent verdicts recorded by this semantic evaluation.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="relative mt-6 overflow-hidden border-y border-border">
    <HeroBackdrop />
    <div class="page-shell relative py-14 sm:py-18 lg:py-20">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3">
          <EvidenceStatus status={result.status} />
          <span class="text-sm font-semibold text-muted-foreground">
            {successfulCaseCount}/{result.totalCaseCount} decisions verified
          </span>
        </div>
        <p class="eyebrow mt-6 mb-4">Complete semantic evaluation</p>
        <h1 class="section-title font-semibold">
          {result.totalCaseCount} decisions, one verified result.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
          Open a decision to replay the developer request, the coding agent's response, project
          changes, and the independent verdict. Trial confirmations and technical evidence remain
          attached to each result.
        </p>
        <p class="mt-5 font-mono text-xs break-all text-muted-foreground">{result.attemptId}</p>
      </div>

      <dl class="mt-9 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Passed</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{result.passedCaseCount}</dd>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Confirmed on retry</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{result.recoveredCaseCount}</dd>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Failed</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{result.failedCaseCount}</dd>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Pending</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{result.pendingCaseCount}</dd>
        </div>
      </dl>
    </div>
  </header>

  <div class="page-shell">
    <section
      class="py-12"
      aria-labelledby="semantic-attempt-cases-title"
    >
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">Decision replays</p>
        <h2
          id="semantic-attempt-cases-title"
          class="text-3xl font-semibold tracking-tight"
        >
          Follow every trial in this evaluation.
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          The first tab tells the story. The evidence tab shows the exact criteria, verdict, and
          confirmation history.
        </p>
      </div>
      <div class="mt-8 grid gap-3">
        {
          attempt.cases.map((evaluationCase, index) => (
            <SemanticEvaluationCase
              evaluationCase={evaluationCase}
              number={index + 1}
              showTrialProvenance
            />
          ))
        }
      </div>
    </section>

    <section class="border-t border-border py-12">
      <details class="surface-card p-5 sm:p-6">
        <summary
          class="cursor-pointer font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          Attempt identity, provenance, and raw artifacts
        </summary>
        <div class="mt-5 border-t border-border pt-5">
          {
            attempt.evidenceSource.kind === 'pinned' &&
              semanticReleaseSection?.mode === 'pinned' && (
                <p class="mb-5 max-w-4xl text-sm leading-6 text-muted-foreground">
                  This release uses authenticated passing evidence from{' '}
                  <a
                    class="text-link font-semibold"
                    href={semanticReleaseSection.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {semanticReleaseSection.sourceLabel}
                  </a>
                  .{' '}
                  <InlineBrandText
                    text={semanticReleaseSection.reason}
                    variant="compact"
                  />
                </p>
              )
          }
          <dl class="grid min-w-0 gap-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-muted-foreground">Attempt</dt>
              <dd class="mt-1 font-mono text-xs break-all">{result.attemptId}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Recorded at</dt>
              <dd class="mt-1 font-mono text-xs break-all">{result.recordedAt}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Evidence source</dt>
              <dd class="mt-1 font-mono text-xs break-all">
                {
                  attempt.evidenceSource.kind === 'pinned'
                    ? `Verified commit ${attempt.evidenceSource.commit}`
                    : 'Current release'
                }
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Model configuration</dt>
              <dd class="mt-1 font-mono text-xs break-all">
                {evaluationModel}, actor {result.hostContract.actor.reasoningEffort}, judge{' '}
                {result.hostContract.judge.reasoningEffort}
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Portable artifact digest</dt>
              <dd class="mt-1 font-mono text-xs break-all">{result.artifactDigest}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Evidence digest</dt>
              <dd class="mt-1 font-mono text-xs break-all">{result.evidence.sha256}</dd>
            </div>
          </dl>
          <div class="mt-5 flex flex-wrap gap-4 text-sm">
            <a
              class="inline-flex items-center gap-1.5 text-link font-semibold"
              href={attempt.rawAttemptUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Raw attempt summary
              <ExternalLink
                class="size-3.5"
                aria-hidden="true"
              />
            </a>
            <a
              class="inline-flex items-center gap-1.5 text-link font-semibold"
              href={attempt.rawEvidenceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Exact evidence artifact
              <ExternalLink
                class="size-3.5"
                aria-hidden="true"
              />
            </a>
          </div>
        </div>
      </details>
    </section>
  </div>
</BaseLayout>
