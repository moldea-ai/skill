---
import SemanticAttemptPage from '../../../../../components/semantic-attempt-page/semantic-attempt-page.astro';
import { loadWebsiteModel } from '../../../../../lib/generation/generation.ts';
import type { ISemanticAttemptModel } from '../../../../../lib/semantic-evaluation/index.ts';

interface Props {
  attempt: ISemanticAttemptModel;
}
export const getStaticPaths = () =>
  loadWebsiteModel().semanticEvaluation.attempts.map((attempt) => ({
    params: { attemptId: attempt.result.attemptId },
    props: { attempt },
  }));
const { attempt } = Astro.props;
---

<SemanticAttemptPage {attempt} />
