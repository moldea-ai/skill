---
import { BookOpen, ExternalLink } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';

import EvidenceStatus from '../../../components/evidence-status/evidence-status.astro';
import EvidenceText from '../../../components/evidence-text/evidence-text.astro';
import SemanticEvaluationCase from '../../../components/semantic-evaluation-case/semantic-evaluation-case.astro';
import BaseLayout from '../../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../../lib/generation/generation.ts';

const { semanticEvaluation } = loadWebsiteModel();
const basePath = import.meta.env.BASE_URL;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { label: 'Semantic evaluation' },
];
let caseNumber = 0;
---

<BaseLayout
  title="Semantic evaluation"
  description={`Review ${semanticEvaluation.caseCount} passing behavioral scenarios and the criteria used to judge them.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />

    <header class="mt-7 border-b border-border pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <EvidenceStatus status="passed" />
        <span class="font-mono text-sm font-bold">
          {semanticEvaluation.caseCount}/{semanticEvaluation.caseCount} scenarios
        </span>
      </div>
      <p class="eyebrow mt-5">Behavioral release evidence</p>
      <h1 class="display-title mt-3 max-w-5xl font-semibold">Semantic evaluation</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
        An actor handled each realistic scenario without seeing the answer key. An independent judge
        then checked the response and workspace evidence against explicit criteria. Every expected
        behavior was observed, and no forbidden behavior was triggered.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <ActionLink
          class="font-bold"
          href={semanticEvaluation.methodologyUrl}
          variant="primary"
        >
          Read the methodology
          <BookOpen
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={semanticEvaluation.rawResultUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >
          Inspect raw result
          <ExternalLink
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={semanticEvaluation.coverageUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >
          Inspect coverage map
          <ExternalLink
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </header>

    <section
      class="grid gap-3 border-b border-border py-10 sm:grid-cols-2 lg:grid-cols-4"
      aria-label="Semantic evaluation summary"
    >
      <div class="surface-card p-4">
        <p class="text-sm text-muted-foreground">Scenarios passed</p>
        <p class="mt-2 font-mono text-2xl font-bold">{semanticEvaluation.caseCount}</p>
      </div>
      <div class="surface-card p-4">
        <p class="text-sm text-muted-foreground">Behavior groups</p>
        <p class="mt-2 font-mono text-2xl font-bold">{semanticEvaluation.groups.length}</p>
      </div>
      <div class="surface-card p-4">
        <p class="text-sm text-muted-foreground">Actor and judge model</p>
        <p class="mt-2 font-mono text-sm font-bold">gpt-5.6-terra</p>
      </div>
      <div class="surface-card p-4">
        <p class="text-sm text-muted-foreground">Reasoning effort</p>
        <p class="mt-2 font-mono text-sm font-bold">medium</p>
      </div>
    </section>

    <div class="py-12">
      {
        semanticEvaluation.groups.map((group) => (
          <section
            id={group.id}
            class="scroll-mt-24 border-b border-border py-10 first:pt-0 last:border-0 last:pb-0"
            aria-labelledby={`${group.id}-title`}
          >
            <div class="max-w-3xl">
              <p class="eyebrow mb-3">
                {group.cases.length} {group.cases.length === 1 ? 'scenario' : 'scenarios'}
              </p>
              <h2
                id={`${group.id}-title`}
                class="section-title font-semibold"
              >
                {group.title}
              </h2>
              <p class="mt-3 leading-7 text-muted-foreground">
                <EvidenceText text={group.description} />
              </p>
            </div>
            <div class="mt-7 grid gap-3">
              {group.cases.map((evaluationCase) => {
                caseNumber += 1;
                return (
                  <SemanticEvaluationCase
                    evaluationCase={evaluationCase}
                    number={caseNumber}
                  />
                );
              })}
            </div>
          </section>
        ))
      }
    </div>

    <section class="border-t border-border py-10">
      <details class="surface-card p-5 sm:p-6">
        <summary
          class="cursor-pointer font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          Technical provenance
        </summary>
        <dl class="mt-5 grid min-w-0 gap-4 text-sm sm:grid-cols-2">
          <div>
            <dt class="text-muted-foreground">Evaluated at</dt>
            <dd class="mt-1 font-mono break-all">{semanticEvaluation.evaluatedAt}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">CLI</dt>
            <dd class="mt-1 font-mono break-all">{semanticEvaluation.cli.version}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Portable artifact digest</dt>
            <dd class="mt-1 font-mono text-xs break-all">
              {semanticEvaluation.artifactDigest}
            </dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Case suite digest</dt>
            <dd class="mt-1 font-mono text-xs break-all">
              {semanticEvaluation.caseSuiteDigest}
            </dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Coverage digest</dt>
            <dd class="mt-1 font-mono text-xs break-all">
              {semanticEvaluation.coverageDigest}
            </dd>
          </div>
        </dl>
      </details>
    </section>
  </div>
</BaseLayout>
