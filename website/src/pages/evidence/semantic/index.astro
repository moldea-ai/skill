---
import { ArrowRight, BookOpen, ExternalLink } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import HeroBackdrop from '@moldea.ai/website-ui/hero-backdrop';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import EvidenceStatus from '../../../components/evidence-status/evidence-status.astro';
import SemanticEvaluationCase from '../../../components/semantic-evaluation-case/semantic-evaluation-case.astro';
import BaseLayout from '../../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../../lib/generation/generation.ts';
import { getSemanticReleaseEvidenceSummary } from '../../../lib/release-evidence/index.ts';

const model = loadWebsiteModel();
const { currentSemanticAssurance, semanticEvaluation } = model;
const releaseSummary = getSemanticReleaseEvidenceSummary(
  model.releaseEvidence,
  currentSemanticAssurance,
);
const releaseResult = releaseSummary.result;
const basePath = import.meta.env.BASE_URL;
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/evidence/', label: 'Evidence' },
  { label: 'Semantic evaluation' },
];
let caseNumber = 0;
const successfulCaseCount =
  (releaseResult?.passedCaseCount ?? 0) + (releaseResult?.recoveredCaseCount ?? 0);
const presentationAttempt = semanticEvaluation.currentAssurance;
const presentationGroups =
  presentationAttempt === null
    ? semanticEvaluation.groups
    : semanticEvaluation.groups.map((group) => ({
        ...group,
        cases: presentationAttempt.cases.filter(({ groupId }) => groupId === group.id),
      }));
const semanticReleaseSection =
  model.releaseEvidence.mode === 'recorded' ? model.releaseEvidence.semantic : null;
---

<BaseLayout
  title="Semantic evaluation evidence"
  description={`Explore ${semanticEvaluation.caseCount} difficult decisions used to verify how coding agents apply moldea.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
  </div>

  <header class="relative mt-6 overflow-hidden border-y border-border">
    <HeroBackdrop />
    <div class="page-shell relative py-14 sm:py-18 lg:py-20">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3">
          <EvidenceStatus status={releaseResult?.status ?? semanticEvaluation.status} />
          <span class="text-sm font-semibold text-muted-foreground">
            {successfulCaseCount}/{semanticEvaluation.caseCount} decisions verified
          </span>
        </div>
        <p class="eyebrow mt-6 mb-4">Behavior under pressure</p>
        <h1 class="section-title font-semibold">Semantic evaluation</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
          We place the skill in difficult, realistic situations and ask a coding agent to use it. A
          separate judge checks whether the agent made the right decision and respected the
          repository.
        </p>
        <ActionLink
          class="mt-7 font-bold"
          href={withBase(semanticEvaluation.methodologyUrl, basePath)}
          variant="outline"
        >
          How the evaluation works
          <BookOpen
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>

      <dl class="mt-9 grid max-w-3xl grid-cols-3 gap-3">
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Passed directly</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{releaseResult?.passedCaseCount ?? 0}</dd>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Confirmed on retry</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">
            {releaseResult?.recoveredCaseCount ?? 0}
          </dd>
        </div>
        <div class="rounded-xl border border-border bg-background/80 p-4 backdrop-blur-sm">
          <dt class="text-xs font-semibold text-muted-foreground">Failed</dt>
          <dd class="mt-2 font-mono text-2xl font-bold">{releaseResult?.failedCaseCount ?? 0}</dd>
        </div>
      </dl>
    </div>
  </header>

  <div class="page-shell">
    <section
      class="py-12"
      aria-labelledby="semantic-scenarios-title"
    >
      <div class="grid gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(18rem,0.45fr)] lg:items-end">
        <div>
          <p class="eyebrow mb-3">Explore the proof</p>
          <h2
            id="semantic-scenarios-title"
            class="text-3xl font-semibold tracking-tight"
          >
            Open any decision from request to verdict.
          </h2>
        </div>
        <p class="leading-7 text-muted-foreground">
          Each replay shows the developer request, coding-agent response, workspace changes, and
          independent reasoning behind the result.
        </p>
      </div>

      <div class="mt-8">
        {
          presentationGroups.map((group) => (
            <section
              id={group.id}
              class="scroll-mt-24 border-b border-border py-10 first:pt-0 last:border-0 last:pb-0"
              aria-labelledby={`${group.id}-title`}
            >
              <div class="max-w-3xl">
                <p class="eyebrow mb-3">
                  {group.cases.length} {group.cases.length === 1 ? 'decision' : 'decisions'}
                </p>
                <h3
                  id={`${group.id}-title`}
                  class="text-2xl font-semibold tracking-tight sm:text-3xl"
                >
                  {group.title}
                </h3>
                <p class="mt-3 leading-7 text-muted-foreground">
                  <InlineBrandText
                    text={group.description}
                    variant="compact"
                  />
                </p>
              </div>
              <div class="mt-7 grid gap-3">
                {group.cases.map((evaluationCase) => {
                  caseNumber += 1;
                  return (
                    <SemanticEvaluationCase
                      evaluationCase={evaluationCase}
                      number={caseNumber}
                    />
                  );
                })}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <section
      class="border-t border-border py-12"
      aria-labelledby="semantic-attempts-title"
    >
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">The recorded evaluation</p>
        <h2
          id="semantic-attempts-title"
          class="text-3xl font-semibold tracking-tight"
        >
          Every trial remains available.
        </h2>
        <p class="mt-4 leading-7 text-muted-foreground">
          Open an attempt to inspect trial confirmations and the complete result behind these
          decision replays.
        </p>
      </div>
      {
        semanticEvaluation.attempts.length === 0 ? (
          <p class="surface-card mt-7 p-5 text-muted-foreground sm:p-6">
            No semantic evaluation has been recorded yet.
          </p>
        ) : (
          <ol class="mt-7 grid gap-3">
            {[...semanticEvaluation.attempts].reverse().map(({ evidenceSource, result, route }) => (
              <li>
                <a
                  class="surface-card interactive-card group flex min-w-0 flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
                  href={withBase(route, basePath)}
                >
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-center gap-2">
                      <EvidenceStatus status={result.status} />
                      <span class="text-xs font-bold text-muted-foreground">
                        {evidenceSource.kind === 'pinned'
                          ? 'Verified release source'
                          : 'Current release attempt'}
                      </span>
                    </span>
                    <span class="mt-3 block text-lg font-semibold">
                      {result.passedCaseCount + result.recoveredCaseCount}/{result.totalCaseCount}{' '}
                      decisions verified
                    </span>
                    <span class="mt-2 block font-mono text-xs break-all text-muted-foreground">
                      {result.attemptId}
                    </span>
                  </span>
                  <span class="inline-flex shrink-0 items-center gap-2 text-link font-semibold">
                    Open the complete attempt
                    <ArrowRight
                      class="size-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none motion-reduce:transition-none"
                      aria-hidden="true"
                    />
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section class="border-t border-border py-12">
      <details class="surface-card p-5 sm:p-6">
        <summary
          class="cursor-pointer font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          Technical provenance and raw sources
        </summary>
        <div class="mt-5 border-t border-border pt-5">
          {
            semanticReleaseSection?.mode === 'pinned' && (
              <p class="mb-5 max-w-4xl text-sm leading-6 text-muted-foreground">
                This release uses authenticated passing evidence from{' '}
                <a
                  class="text-link font-semibold"
                  href={semanticReleaseSection.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {semanticReleaseSection.sourceLabel}
                </a>
                .{' '}
                <InlineBrandText
                  text={semanticReleaseSection.reason}
                  variant="compact"
                />
              </p>
            )
          }
          <dl class="grid min-w-0 gap-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-muted-foreground">Evidence source</dt>
              <dd class="mt-1 font-mono break-all">
                {
                  releaseSummary.kind === 'pinned'
                    ? 'Verified release source'
                    : releaseSummary.kind === 'not-recorded'
                      ? 'Not recorded'
                      : 'Current release'
                }
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Source attempt</dt>
              <dd class="mt-1 font-mono break-all">
                {
                  releaseSummary.kind === 'not-recorded' ? (
                    'Not recorded'
                  ) : (
                    <a
                      class="text-link"
                      href={releaseSummary.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {releaseSummary.result.attemptId}
                      <ExternalLink
                        class="ml-1 inline size-3"
                        aria-hidden="true"
                      />
                    </a>
                  )
                }
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Model configuration</dt>
              <dd class="mt-1 font-mono break-all">
                {semanticEvaluation.evaluationModel}, actor xhigh, judge xhigh
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">CLI</dt>
              <dd class="mt-1 font-mono break-all">{semanticEvaluation.cli.version}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Evaluated artifact digest</dt>
              <dd class="mt-1 font-mono text-xs break-all">
                {releaseResult?.artifactDigest ?? 'Not recorded'}
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground">Case suite digest</dt>
              <dd class="mt-1 font-mono text-xs break-all">
                {semanticEvaluation.caseSuiteDigest}
              </dd>
            </div>
          </dl>
          <a
            class="mt-5 inline-flex items-center gap-2 text-link font-semibold"
            href={semanticEvaluation.coverageUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Inspect the coverage map
            <ExternalLink
              class="size-4"
              aria-hidden="true"
            />
          </a>
        </div>
      </details>
    </section>
  </div>
</BaseLayout>
