---
import { renderMarkdownDocument } from '@moldea.ai/website-ui/markdown';

import DocumentationContent from '../../components/documentation-content/documentation-content.astro';
import DocumentationPage from '../../components/documentation-page/documentation-page.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { createDocumentationBreadcrumbs } from '../../lib/documentation-navigation/index.ts';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';
import type { IWebsiteDocument } from '../../lib/model/types.ts';

interface Props {
  document: IWebsiteDocument;
}

export const getStaticPaths = () => {
  const model = loadWebsiteModel();

  return model.documents
    .filter(({ route }) => route.startsWith('/examples/'))
    .map((document) => ({
      params: { path: document.route === '/examples/' ? undefined : document.slug },
      props: { document },
    }));
};

const { document } = Astro.props;
const model = loadWebsiteModel();
const rendered = await renderMarkdownDocument(document.markdown, {
  basePath: import.meta.env.BASE_URL,
  conversations: true,
});
const breadcrumbs = createDocumentationBreadcrumbs(document);
---

<BaseLayout
  title={document.title}
  description={document.description}
  {breadcrumbs}
>
  <DocumentationPage
    {breadcrumbs}
    currentDocument={document}
    headings={rendered.headings}
    navigation={model.navigation}
    orderedDocuments={model.documents}
    skill={model.skill}
  >
    <DocumentationContent blocks={rendered.blocks} />
  </DocumentationPage>
</BaseLayout>
