---
import { ExternalLink } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';

import QualificationCaseEvidence from '../../../../../../components/qualification-case-evidence/qualification-case-evidence.astro';
import QualificationStatus from '../../../../../../components/qualification-status/qualification-status.astro';
import QualificationText from '../../../../../../components/qualification-text/qualification-text.astro';
import BaseLayout from '../../../../../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../../../../../lib/generation/generation.ts';
import type {
  IQualificationAttemptModel,
  IQualificationProfileModel,
} from '../../../../../../lib/qualification/index.ts';

interface Props {
  attempt: IQualificationAttemptModel;
  profile: IQualificationProfileModel;
}

export const getStaticPaths = () => {
  return loadWebsiteModel().qualification.profiles.flatMap((profile) =>
    profile.attempts.map((attempt) => ({
      params: {
        adapterId: profile.adapterId,
        attemptId: attempt.result.attemptId,
        implementationId: profile.implementationId,
      },
      props: { attempt, profile },
    })),
  );
};

const { attempt, profile } = Astro.props;
const { result } = attempt;
const basePath = import.meta.env.BASE_URL;
const isLatest = profile.latest?.latestAttemptId === result.attemptId;
const isLastPassing = profile.latest?.lastPassingAttemptId === result.attemptId;
const totalReportedTokens = result.cases.reduce(
  (total, caseResult) =>
    total +
    (caseResult.actorUsage?.inputTokens ?? 0) +
    (caseResult.actorUsage?.cachedInputTokens ?? 0) +
    (caseResult.actorUsage?.outputTokens ?? 0) +
    (caseResult.judgeUsage?.inputTokens ?? 0) +
    (caseResult.judgeUsage?.cachedInputTokens ?? 0) +
    (caseResult.judgeUsage?.outputTokens ?? 0),
  0,
);
const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/qualification/', label: 'Qualification' },
  { href: profile.route, label: profile.title },
  { label: result.attemptId },
];
---

<BaseLayout
  title={`${profile.title}: ${result.attemptId}`}
  description={`Immutable ${result.status} qualification evidence for ${profile.adapterId}/${profile.implementationId}.`}
  {breadcrumbs}
>
  <div class="page-shell pt-7">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />

    <header class="mt-7 border-b border-border pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <QualificationStatus status={result.status} />
        {
          isLatest && (
            <span class="rounded-full border border-border px-2.5 py-1 text-xs font-bold">
              Latest
            </span>
          )
        }
        {
          isLastPassing && (
            <span class="rounded-full border border-success px-2.5 py-1 text-xs font-bold">
              Last passing baseline
            </span>
          )
        }
      </div>
      <p class="eyebrow mt-5">Immutable qualification attempt</p>
      <h1
        class="mt-3 max-w-5xl font-mono text-3xl leading-tight font-semibold break-all sm:text-4xl"
      >
        {result.attemptId}
      </h1>
      <p class="mt-5 max-w-4xl text-lg leading-8 text-muted-foreground">
        <QualificationText text={result.summary} />
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <ActionLink
          class="font-bold"
          href={attempt.rawAttemptUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >
          Raw attempt.json
          <ExternalLink
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
        <ActionLink
          class="font-bold"
          href={profile.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >
          Profile source
          <ExternalLink
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </header>

    <section
      class="py-10"
      aria-labelledby="attempt-identity-title"
    >
      <p class="eyebrow mb-3">Attempt identity</p>
      <h2
        id="attempt-identity-title"
        class="section-title font-semibold"
      >
        Exact recorded context
      </h2>
      <dl class="mt-7 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {
          [
            ['Created', result.createdAt],
            ['Completed', result.completedAt ?? 'Not completed'],
            ['Evidence generated', result.evidenceGeneratedAt ?? 'Unavailable'],
            ['Parent attempt', result.parentAttemptId ?? 'None'],
            ['Protocol', String(result.protocolVersion)],
            ['Cases', String(result.cases.length)],
            ['Artifacts', String(attempt.artifacts.length)],
            [
              'Reported tokens',
              totalReportedTokens === 0 ? 'Unavailable' : String(totalReportedTokens),
            ],
          ].map(([label, value]) => (
            <div class="surface-card min-w-0 p-4">
              <dt class="text-sm text-muted-foreground">{label}</dt>
              <dd class="mt-2 font-mono text-sm break-all">{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      attempt.error && (
        <section
          class="rounded-xl border border-destructive/30 bg-destructive/10 p-5 sm:p-6"
          aria-labelledby="attempt-error-title"
        >
          <h2
            id="attempt-error-title"
            class="text-xl font-semibold text-foreground"
          >
            Recorded execution failure
          </h2>
          <p class="mt-3 leading-7 text-foreground">
            <QualificationText text={attempt.error.message} />
          </p>
          <p class="mt-2 text-sm text-muted-foreground">
            Stage: <code>{attempt.error.stageId ?? 'No active stage'}</code>
          </p>
        </section>
      )
    }

    <section
      class="border-t border-border py-10"
      aria-labelledby="source-state-title"
    >
      <div class="flex flex-wrap items-center gap-3">
        <div>
          <p class="eyebrow mb-3">Preflight evidence</p>
          <h2
            id="source-state-title"
            class="section-title font-semibold"
          >
            Source and host state
          </h2>
        </div>
        {
          attempt.sourceState && (
            <QualificationStatus status={attempt.sourceState.passed ? 'passed' : 'failed'} />
          )
        }
      </div>
      {
        attempt.sourceState ? (
          <div class="mt-7 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <dl class="surface-card grid gap-3 p-5 text-sm">
              <div class="flex justify-between gap-3">
                <dt class="text-muted-foreground">Clean inputs required</dt>
                <dd>{attempt.sourceState.requiresCleanInputs ? 'Yes' : 'No'}</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-muted-foreground">Execution host trusted</dt>
                <dd>{attempt.sourceState.isExecutionHostTrusted ? 'Yes' : 'No'}</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-muted-foreground">Packages repository dirty</dt>
                <dd>{attempt.sourceState.packagesRepositoryDirty ? 'Yes' : 'No'}</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-muted-foreground">Qualification repository dirty</dt>
                <dd>{attempt.sourceState.qualificationRepositoryDirty ? 'Yes' : 'No'}</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt class="text-muted-foreground">Portable skill dirty</dt>
                <dd>{attempt.sourceState.skillRepositoryDirty ? 'Yes' : 'No'}</dd>
              </div>
            </dl>
            <div class="surface-card p-5">
              <h3 class="font-semibold">Preflight failures</h3>
              {attempt.sourceState.failures.length === 0 ? (
                <p class="mt-3 text-sm leading-6 text-muted-foreground">
                  No source-state or host-boundary failures were recorded.
                </p>
              ) : (
                <ul class="mt-3 list-disc space-y-2 ps-5 text-sm leading-6">
                  {attempt.sourceState.failures.map((failure) => (
                    <li>
                      <QualificationText text={failure} />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ) : (
          <div class="mt-7 rounded-xl border border-dashed border-border bg-muted/30 p-5">
            <p class="text-muted-foreground">
              This recorded attempt contains no source-state artifact at its interruption point.
            </p>
          </div>
        )
      }
    </section>

    <section
      class="border-t border-border py-10"
      aria-labelledby="attempt-coverage-title"
    >
      <div class="flex flex-wrap items-center gap-3">
        <div>
          <p class="eyebrow mb-3">Compatibility matrix</p>
          <h2
            id="attempt-coverage-title"
            class="section-title font-semibold"
          >
            Behavior claim coverage
          </h2>
        </div>
        {
          attempt.coverage && (
            <QualificationStatus status={attempt.coverage.passed ? 'passed' : 'failed'} />
          )
        }
      </div>
      {
        attempt.coverage ? (
          <>
            <dl class="mt-7 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              {[
                { count: attempt.coverage.requiredClaims.length, label: 'Required claims' },
                { count: attempt.coverage.declaredClaims.length, label: 'Declared claims' },
                { count: attempt.coverage.missingClaims.length, label: 'Missing claims' },
                { count: attempt.coverage.unknownClaims.length, label: 'Unknown claims' },
              ].map(({ count, label }) => (
                <div class="surface-card p-4">
                  <dt class="text-sm text-muted-foreground">{label}</dt>
                  <dd class="mt-2 font-mono text-xl font-bold">{count}</dd>
                </div>
              ))}
            </dl>
            {attempt.coverage.uncoveredCaseIds.length > 0 && (
              <div class="mt-4 rounded-xl border border-destructive/30 bg-destructive/10 p-4">
                <p class="font-semibold text-foreground">Uncovered project cases</p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {attempt.coverage.uncoveredCaseIds.map((caseId) => (
                    <li>
                      <code>{caseId}</code>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {(attempt.coverage.missingClaims.length > 0 ||
              attempt.coverage.unknownClaims.length > 0) && (
              <div class="mt-4 grid gap-4 lg:grid-cols-2">
                {[
                  { claims: attempt.coverage.missingClaims, label: 'Missing claims' },
                  { claims: attempt.coverage.unknownClaims, label: 'Unknown claims' },
                ].map(({ claims, label }) => (
                  <div class="rounded-xl border border-destructive/30 bg-destructive/10 p-4">
                    <h3 class="font-semibold text-foreground">{label}</h3>
                    {claims.length === 0 ? (
                      <p class="mt-2 text-sm text-muted-foreground">None recorded.</p>
                    ) : (
                      <ul class="mt-2 grid gap-2 text-sm">
                        {claims.map((claim) => (
                          <li>
                            <code class="break-all">{claim}</code>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="mt-7 rounded-xl border border-dashed border-border bg-muted/30 p-5">
            <p class="text-muted-foreground">
              This attempt stopped before compatibility coverage evidence was recorded.
            </p>
          </div>
        )
      }
    </section>

    <section
      class="border-t border-border py-10"
      aria-labelledby="attempt-provenance-title"
    >
      <p class="eyebrow mb-3">Content-addressed provenance</p>
      <h2
        id="attempt-provenance-title"
        class="section-title font-semibold"
      >
        Repositories, host, and candidate
      </h2>
      <div class="mt-7 grid gap-4 lg:grid-cols-2">
        <dl class="surface-card grid min-w-0 gap-3 p-5 text-sm">
          <div>
            <dt class="text-muted-foreground">Packages commit</dt>
            <dd class="mt-1 font-mono break-all">{result.provenance.packagesRepositoryCommit}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Packages fingerprint</dt>
            <dd class="mt-1 font-mono text-xs break-all">
              {result.provenance.packagesRepositoryFingerprint}
            </dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Qualification commit</dt>
            <dd class="mt-1 font-mono break-all">
              {result.provenance.qualificationRepositoryCommit}
            </dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Skill commit</dt>
            <dd class="mt-1 font-mono break-all">{result.provenance.skillRepositoryCommit}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Profile digest</dt>
            <dd class="mt-1 font-mono text-xs break-all">{result.provenance.profileDigest}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Qualification digest</dt>
            <dd class="mt-1 font-mono text-xs break-all">
              {result.provenance.qualificationDigest}
            </dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Portable skill fingerprint</dt>
            <dd class="mt-1 font-mono text-xs break-all">
              {result.provenance.skillRepositoryFingerprint}
            </dd>
          </div>
        </dl>
        <dl class="surface-card grid min-w-0 gap-3 p-5 text-sm">
          <div class="flex flex-wrap justify-between gap-3">
            <dt class="text-muted-foreground">Model</dt>
            <dd class="font-mono">{result.provenance.model}</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-3">
            <dt class="text-muted-foreground">Reasoning effort</dt>
            <dd class="font-mono">{result.provenance.reasoningEffort}</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-3">
            <dt class="text-muted-foreground">Codex</dt>
            <dd class="font-mono">{result.provenance.codexVersion}</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-3">
            <dt class="text-muted-foreground">Node.js</dt>
            <dd class="font-mono">{result.provenance.nodeVersion}</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-3">
            <dt class="text-muted-foreground">pnpm</dt>
            <dd class="font-mono">{result.provenance.pnpmVersion}</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-3">
            <dt class="text-muted-foreground">Git</dt>
            <dd class="font-mono">{result.provenance.gitVersion}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Allowed model egress</dt>
            <dd class="mt-1 font-mono text-xs break-all">
              {result.provenance.allowedEgressHosts.join(', ')}
            </dd>
          </div>
          <div>
            <dt class="text-muted-foreground">Target maturity at execution</dt>
            <dd class="mt-1 font-mono">{result.provenance.targetSupportLevel}</dd>
          </div>
        </dl>
      </div>

      <h3 class="mt-8 text-xl font-semibold">Exact candidate packages</h3>
      <div
        class="table-scroll mt-4 overflow-x-auto rounded-xl border border-border"
        tabindex="0"
        role="region"
        aria-label="Scrollable candidate package inventory"
      >
        <table class="w-full min-w-[58rem] border-collapse text-left text-sm">
          <thead class="bg-muted">
            <tr>
              <th class="px-4 py-3 font-semibold">Package</th>
              <th class="px-4 py-3 font-semibold">Version</th>
              <th class="px-4 py-3 font-semibold">Source project</th>
              <th class="px-4 py-3 font-semibold">Tarball</th>
              <th class="px-4 py-3 font-semibold">SHA-256</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {
              result.provenance.packages.map((candidatePackage) => (
                <tr>
                  <td class="px-4 py-3 align-top">
                    <code>{candidatePackage.name}</code>
                  </td>
                  <td class="px-4 py-3 align-top font-mono">{candidatePackage.version}</td>
                  <td class="px-4 py-3 align-top">
                    <code>{candidatePackage.projectDirectory}</code>
                  </td>
                  <td class="px-4 py-3 align-top">
                    <code>{candidatePackage.tarballName}</code>
                  </td>
                  <td class="px-4 py-3 align-top font-mono text-xs break-all">
                    {candidatePackage.sha256}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section
      class="border-t border-border py-10"
      aria-labelledby="attempt-stages-title"
    >
      <p class="eyebrow mb-3">Checkpointed execution</p>
      <h2
        id="attempt-stages-title"
        class="section-title font-semibold"
      >
        Stage outcomes
      </h2>
      <ol class="mt-7 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {
          result.stages.map((stage) => (
            <li class="surface-card min-w-0 p-4">
              <div class="flex flex-wrap items-center gap-2">
                <QualificationStatus status={stage.status} />
                <code class="text-xs break-all">{stage.id}</code>
              </div>
              <dl class="mt-3 grid gap-2 text-sm">
                <div class="flex justify-between gap-3">
                  <dt class="text-muted-foreground">Duration</dt>
                  <dd>{stage.durationMs === null ? 'Unavailable' : `${stage.durationMs} ms`}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground">Cache source</dt>
                  <dd class="mt-1 font-mono text-xs break-all">
                    {stage.cacheSourceAttemptId ?? 'Fresh or not applicable'}
                  </dd>
                </div>
                <div>
                  <dt class="text-muted-foreground">Cache key</dt>
                  <dd class="mt-1 font-mono text-xs break-all">
                    {stage.cacheKey ?? 'Not applicable'}
                  </dd>
                </div>
              </dl>
              {stage.error && (
                <p class="mt-3 text-sm leading-6 text-destructive">
                  <QualificationText text={stage.error} />
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="border-t border-border py-10"
      aria-labelledby="attempt-cases-title"
    >
      <p class="eyebrow mb-3">Project outcomes</p>
      <h2
        id="attempt-cases-title"
        class="section-title font-semibold"
      >
        Deterministic and semantic evidence
      </h2>
      {
        attempt.cases.length === 0 ? (
          <div class="mt-7 rounded-xl border border-dashed border-border bg-muted/30 p-5">
            <p class="text-muted-foreground">
              This attempt stopped before any case produced a complete result.
            </p>
          </div>
        ) : (
          <div class="mt-7 grid gap-6">
            {attempt.cases.map((caseEvidence) => (
              <QualificationCaseEvidence evidence={caseEvidence} />
            ))}
          </div>
        )
      }
    </section>

    <section
      class="border-t border-border py-10"
      aria-labelledby="attempt-artifacts-title"
    >
      <p class="eyebrow mb-3">Raw committed evidence</p>
      <h2
        id="attempt-artifacts-title"
        class="section-title font-semibold"
      >
        Complete artifact inventory
      </h2>
      <p class="mt-4 max-w-3xl leading-7 text-muted-foreground">
        Every public artifact is linked directly to committed source. SHA-256 values come from the
        immutable attempt record; <code>attempt.json</code> is the record that owns those digests.
      </p>
      <div
        class="table-scroll mt-7 overflow-x-auto rounded-xl border border-border"
        tabindex="0"
        role="region"
        aria-label="Scrollable raw artifact inventory"
      >
        <table class="w-full min-w-[58rem] border-collapse text-left text-sm">
          <thead class="bg-muted">
            <tr>
              <th class="px-4 py-3 font-semibold">Artifact</th>
              <th class="px-4 py-3 font-semibold">SHA-256</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {
              attempt.artifacts.map((artifact) => (
                <tr>
                  <td class="px-4 py-3 align-top">
                    <a
                      class="inline-flex items-start gap-2 font-semibold text-link hover:underline"
                      href={artifact.rawUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <code class="break-all">{artifact.path}</code>
                      <ExternalLink
                        class="mt-0.5 size-3.5 shrink-0"
                        aria-hidden="true"
                      />
                    </a>
                  </td>
                  <td class="px-4 py-3 align-top font-mono text-xs break-all">
                    {artifact.sha256 ?? 'Digest owner'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
