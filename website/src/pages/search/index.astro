---
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import LocalSearch from '@moldea.ai/website-ui/local-search';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../../layouts/base-layout.astro';

const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Search' }];
const basePath = import.meta.env.BASE_URL;
const searchIndexUrl = withBase('/search-index.json', basePath);
---

<BaseLayout
  title="Search documentation"
  description="Search the complete Agent Skill documentation and interaction examples locally with no hosted search service."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs
      basePath={basePath}
      items={breadcrumbs}
    />
    <div class="mx-auto max-w-4xl pt-16">
      <p class="eyebrow mb-5">Local static search</p>
      <h1 class="section-title font-semibold">Find the behavior, not a copy.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
        Search repository-owned documentation and examples. The generated index sends no query to a
        hosted service.
      </p>

      <LocalSearch
        action={withBase('/search/', basePath)}
        failureMessage="The local search index could not be loaded. Use documentation navigation instead."
        initialPrompt="Enter an operation, agent concept, safety rule, or example."
        inputId="documentation-search"
        placeholder="e.g. create a support agent"
        {searchIndexUrl}
      />

      <noscript>
        <div class="mt-8 rounded-xl border bg-accent p-5 leading-7 text-accent-foreground">
          Interactive search requires JavaScript. All content remains available through the <a
            class="font-bold underline"
            href={withBase('/docs/', basePath)}
            >documentation</a
          > and <a
            class="font-bold underline"
            href={withBase('/examples/', basePath)}
            >examples</a
          > navigation.
        </div>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script>
  const focusDocumentationSearch = (): void => {
    document.getElementById('documentation-search')?.focus();
  };

  document.addEventListener('astro:page-load', focusDocumentationSearch);
  focusDocumentationSearch();
</script>
