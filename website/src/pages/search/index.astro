---
import { Search } from '@lucide/astro';

import Breadcrumbs from '../../components/breadcrumbs/breadcrumbs.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { withBase } from '../../lib/site/url.ts';

const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Search' }];
const searchIndexUrl = withBase('/search-index.json');
---

<BaseLayout
  title="Search documentation"
  description="Search the complete Agent Skill documentation and interaction examples locally with no hosted search service."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <div class="mx-auto max-w-4xl pt-16">
      <p class="eyebrow mb-5">Local static search</p>
      <h1 class="section-title font-semibold">Find the behavior, not a copy.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
        Search repository-owned documentation and examples. The generated index sends no query to a
        hosted service.
      </p>

      <form
        class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center"
        data-search-form
        data-search-index-url={searchIndexUrl}
        action={withBase('/search/')}
        method="get"
        role="search"
      >
        <label
          class="sr-only"
          for="documentation-search"
          >Search documentation</label
        >
        <div class="relative min-w-0 flex-1">
          <Search
            class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground"
            aria-hidden="true"
          />
          <input
            id="documentation-search"
            class="h-12 w-full min-w-0 rounded-lg border border-border bg-background py-1 pr-3 pl-10 text-sm shadow-inset transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-transparent focus-visible:shadow-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background dark:bg-border/30"
            type="search"
            name="query"
            placeholder="e.g. create a support agent"
            autocomplete="off"
            data-slot="input"
            data-search-input
          />
        </div>
        <button
          class="h-12 rounded-lg bg-primary px-5 font-bold text-primary-foreground transition-all hover:bg-primary/80 active:translate-y-px motion-reduce:transition-none motion-reduce:active:translate-y-0 dark:hover:bg-primary/30"
          type="submit"
          data-primary-action
        >
          Search
        </button>
      </form>

      <p
        class="mt-4 text-sm text-muted-foreground"
        aria-live="polite"
        data-search-status
      >
        Enter an operation, agent concept, safety rule, or example.
      </p>
      <ol
        class="mt-8 grid gap-4"
        data-search-results
      >
      </ol>

      <noscript>
        <div class="mt-8 rounded-xl border bg-accent p-5 leading-7 text-accent-foreground">
          Interactive search requires JavaScript. All content remains available through the <a
            class="font-bold underline"
            href={withBase('/docs/')}
            >documentation</a
          > and <a
            class="font-bold underline"
            href={withBase('/examples/')}
            >examples</a
          > navigation.
        </div>
      </noscript>
    </div>
  </section>

  <script>
    import {
      parseSearchDocuments,
      searchDocuments,
      type ISearchDocument,
    } from '../../lib/search/search.ts';

    const createResult = (searchDocument: ISearchDocument): HTMLLIElement => {
      const item = document.createElement('li');
      const link = document.createElement('a');
      const title = document.createElement('h2');
      const excerpt = document.createElement('p');

      item.className = 'surface-card interactive-card p-5';
      link.className = 'block rounded-md';
      link.href = searchDocument.url;
      title.className = 'text-xl font-semibold tracking-tight';
      title.textContent = searchDocument.title;
      excerpt.className = 'text-muted-foreground mt-2 leading-6';
      excerpt.textContent = searchDocument.description;
      link.append(title, excerpt);
      item.append(link);

      return item;
    };

    const initializeSearch = (): void => {
      const form = document.querySelector<HTMLFormElement>('[data-search-form]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const status = document.querySelector<HTMLElement>('[data-search-status]');
      const results = document.querySelector<HTMLOListElement>('[data-search-results]');

      if (
        !form ||
        !input ||
        !status ||
        !results ||
        form.getAttribute('data-search-initialized') === 'true'
      ) {
        return;
      }

      const searchIndexUrl = form.getAttribute('data-search-index-url');

      if (!searchIndexUrl) return;

      form.setAttribute('data-search-initialized', 'true');
      const documentsPromise = fetch(searchIndexUrl).then(async (response) => {
        if (!response.ok) throw new Error('The documentation search index could not be loaded.');

        return parseSearchDocuments(await response.json());
      });

      const runSearch = async (query: string): Promise<void> => {
        results.replaceChildren();

        if (!query.trim()) {
          status.textContent = 'Enter an operation, agent concept, safety rule, or example.';
          return;
        }

        status.textContent = 'Searching the local documentation index…';

        try {
          const matches = searchDocuments(query, await documentsPromise);

          for (const match of matches) results.append(createResult(match));
          status.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'} for “${query}”.`;
        } catch {
          status.textContent =
            'The local search index could not be loaded. Use documentation navigation instead.';
        }
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        void runSearch(input.value);
      });

      const query = new URLSearchParams(window.location.search).get('query');

      if (query) {
        input.value = query;
        void runSearch(query);
      }
    };

    document.addEventListener('astro:page-load', initializeSearch);
    initializeSearch();
  </script>
</BaseLayout>
